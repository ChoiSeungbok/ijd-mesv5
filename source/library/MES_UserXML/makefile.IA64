#### Name of created component ####
LIB_NAME = libMES_UserXML
TARGET   = ${LIB_NAME}.a

#### Get options depending on OS and platform ####
include ../../makefile.cmm 

##### Libraries #####
LIB     = ${MES_SLC_LIB}

##### Include files #####
PARSER_INC  = ${MES_HOME}/inc/xmlparser
INCLUDE = -I${MES_INC} -I${MES_DBINC} -I${ORACLE_INC} -I${H101_INC} -I${PARSER_INC}

##### Compile options #####
CFLAGS  =  ${_DEB} ${_ARC} ${_OPT} ${_OPTDB} ${INCLUDE} ${MES_DEFINES} -D_H101


##### Object files #####
OBJS = UXML_common.o \
	UXML_parse.o \
	UXML_generate.o \
	UXML_parse_custom_xml.o \
	UXML_generate_custom_xml.o \
	UXML_set_user_channel.o \


###### Build Rules ######
default : ${TARGET}

build : clean ${TARGET}


###### Compile all source files ######
.c.o :
	${CC} ${CFLAGS} $?

###### Make a library ######
${TARGET} : ${OBJS}
	ar -r  $@ ${OBJS}
	mv -f ${TARGET} ${MES_HOME}/lib/.
	cp -f *.h ${MES_INC}/.
###### Remove all object files ######
clean :
	rm -f ${OBJS}

