    MWIPLOTLOS->MAT_VER = MWIPLOTLOS_N->MAT_VER;
    MEMCPY_DN(MWIPLOTLOS->FLOW, MWIPLOTLOS_N->FLOW, sizeof(MWIPLOTLOS->FLOW));
    MWIPLOTLOS->FLOW_SEQ_NUM = MWIPLOTLOS_N->FLOW_SEQ_NUM;
