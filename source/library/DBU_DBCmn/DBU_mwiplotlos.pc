    MEMCPY_DN(MWIPLOTLOS->LOSS_CODE_6, MWIPLOTLOS_N->LOSS_CODE_6, sizeof(MWIPLOTLOS->LOSS_CODE_6));
    MEMCPY_DN(MWIPLOTLOS->LOSS_CODE_7, MWIPLOTLOS_N->LOSS_CODE_7, sizeof(MWIPLOTLOS->LOSS_CODE_7));
