    MEMCPY_AN(CPAKLOTHIS_N->ORG_LOT_ID, CPAKLOTHIS->ORG_LOT_ID, sizeof(CPAKLOTHIS->ORG_LOT_ID));
    MEMCPY_AN(CPAKLOTHIS_N->PACK_LOT_ID, CPAKLOTHIS->PACK_LOT_ID, sizeof(CPAKLOTHIS->PACK_LOT_ID));
    MEMCPY_AN(CPAKLOTHIS_N->MAT_ID, CPAKLOTHIS->MAT_ID, sizeof(CPAKLOTHIS->MAT_ID));
    CPAKLOTHIS_N->MAT_VER = CPAKLOTHIS->MAT_VER;
    CPAKLOTHIS_N->QTY = CPAKLOTHIS->QTY;
    MEMCPY_AN(CPAKLOTHIS_N->UNIT, CPAKLOTHIS->UNIT, sizeof(CPAKLOTHIS->UNIT));
    CPAKLOTHIS_N->PACK_FLAG[0] = CPAKLOTHIS->PACK_FLAG;
    MEMCPY_AN(CPAKLOTHIS_N->PACK_DATE, CPAKLOTHIS->PACK_DATE, sizeof(CPAKLOTHIS->PACK_DATE));
    MEMCPY_AN(CPAKLOTHIS_N->PACK_ORDER_ID, CPAKLOTHIS->PACK_ORDER_ID, sizeof(CPAKLOTHIS->PACK_ORDER_ID));
    CPAKLOTHIS_N->PACK_LINE_NO = CPAKLOTHIS->PACK_LINE_NO;
    CPAKLOTHIS_N->SHIP_FLAG[0] = CPAKLOTHIS->SHIP_FLAG;
