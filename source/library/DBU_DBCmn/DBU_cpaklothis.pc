}


/* Del Null Function */
void DBU_del_null_cpaklothis(struct CPAKLOTHIS_N_TAG *CPAKLOTHIS_N, struct CPAKLOTHIS_TAG *CPAKLOTHIS)
{
    MEMCPY_DN(CPAKLOTHIS->FACTORY, CPAKLOTHIS_N->FACTORY, sizeof(CPAKLOTHIS->FACTORY));
