void DBU_close_if_om_txns(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_IF_OM_TXNS_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_if_om_txns", sel_type);
}


/* Initialize Function */
void DBU_init_if_om_txns(struct IF_OM_TXNS_TAG *IF_OM_TXNS)
{
    /* memset by Space */
    memset(IF_OM_TXNS, ' ', sizeof(struct IF_OM_TXNS_TAG));
    
    IF_OM_TXNS->IF_SEQ = 0;
    IF_OM_TXNS->TRAN_TYPE_ID = 0;
    IF_OM_TXNS->ERP_AREA_ID = 0;
    IF_OM_TXNS->ERP_MAT_ID = 0;
    IF_OM_TXNS->QTY = 0;
    IF_OM_TXNS->TO_ERP_AREA_ID = 0;
    IF_OM_TXNS->HEADER_ID = 0;
    IF_OM_TXNS->LINE_NUMBER = 0;
    IF_OM_TXNS->SRC_TRAN_ID = 0;
    IF_OM_TXNS->SRC_IF_SEQ = 0;
}


