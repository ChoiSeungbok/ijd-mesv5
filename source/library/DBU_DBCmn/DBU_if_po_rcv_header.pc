        DBU_del_null_if_po_rcv_header(&IF_PO_RCV_HEADER_N, IF_PO_RCV_HEADER);
    }

    DB_stop_query_timer("DBU_fetch_if_po_rcv_header", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_if_po_rcv_header(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_IF_PO_RCV_HEADER_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_if_po_rcv_header", sel_type);
}


/* Initialize Function */
void DBU_init_if_po_rcv_header(struct IF_PO_RCV_HEADER_TAG *IF_PO_RCV_HEADER)
{
    /* memset by Space */
    memset(IF_PO_RCV_HEADER, ' ', sizeof(struct IF_PO_RCV_HEADER_TAG));
    
    IF_PO_RCV_HEADER->IF_SEQ = 0;
    IF_PO_RCV_HEADER->TRAN_TYPE_ID = 0;
    IF_PO_RCV_HEADER->VENDOR_ID = 0;
    IF_PO_RCV_HEADER->VENDOR_SITE_ID = 0;
    IF_PO_RCV_HEADER->ERP_AREA_ID = 0;
    IF_PO_RCV_HEADER->SRC_IF_SEQ = 0;
}


