    MEMCPY_AN(IF_OM_PROMISE_DATE_N->CREATE_TIME, IF_OM_PROMISE_DATE->CREATE_TIME, sizeof(IF_OM_PROMISE_DATE->CREATE_TIME));
    MEMCPY_AN(IF_OM_PROMISE_DATE_N->UPDATE_USER_ID, IF_OM_PROMISE_DATE->UPDATE_USER_ID, sizeof(IF_OM_PROMISE_DATE->UPDATE_USER_ID));
    MEMCPY_AN(IF_OM_PROMISE_DATE_N->UPDATE_TIME, IF_OM_PROMISE_DATE->UPDATE_TIME, sizeof(IF_OM_PROMISE_DATE->UPDATE_TIME));
}


