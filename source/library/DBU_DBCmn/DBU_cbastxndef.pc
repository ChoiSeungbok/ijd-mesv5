    CBASTXNDEF->TRAN_ACTION_ID = CBASTXNDEF_N->TRAN_ACTION_ID;
    CBASTXNDEF->TRAN_SRC_TYPE_ID = CBASTXNDEF_N->TRAN_SRC_TYPE_ID;
    MEMCPY_DN(CBASTXNDEF->TRAN_SRC_TYPE_NAME, CBASTXNDEF_N->TRAN_SRC_TYPE_NAME, sizeof(CBASTXNDEF->TRAN_SRC_TYPE_NAME));
    CBASTXNDEF->MRO_FLAG = CBASTXNDEF_N->MRO_FLAG[0];
    CBASTXNDEF->ENABLED_FLAG = CBASTXNDEF_N->ENABLED_FLAG[0];
    MEMCPY_DN(CBASTXNDEF->DISABLE_DATE, CBASTXNDEF_N->DISABLE_DATE, sizeof(CBASTXNDEF->DISABLE_DATE));
    MEMCPY_DN(CBASTXNDEF->CREATE_USER_ID, CBASTXNDEF_N->CREATE_USER_ID, sizeof(CBASTXNDEF->CREATE_USER_ID));
    MEMCPY_DN(CBASTXNDEF->CREATE_TIME, CBASTXNDEF_N->CREATE_TIME, sizeof(CBASTXNDEF->CREATE_TIME));
    MEMCPY_DN(CBASTXNDEF->UPDATE_USER_ID, CBASTXNDEF_N->UPDATE_USER_ID, sizeof(CBASTXNDEF->UPDATE_USER_ID));
    MEMCPY_DN(CBASTXNDEF->UPDATE_TIME, CBASTXNDEF_N->UPDATE_TIME, sizeof(CBASTXNDEF->UPDATE_TIME));
}


