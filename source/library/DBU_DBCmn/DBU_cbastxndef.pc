    MEMCPY_AN(CBASTXNDEF_N->CREATE_USER_ID, CBASTXNDEF->CREATE_USER_ID, sizeof(CBASTXNDEF->CREATE_USER_ID));
    MEMCPY_AN(CBASTXNDEF_N->CREATE_TIME, CBASTXNDEF->CREATE_TIME, sizeof(CBASTXNDEF->CREATE_TIME));
    MEMCPY_AN(CBASTXNDEF_N->UPDATE_USER_ID, CBASTXNDEF->UPDATE_USER_ID, sizeof(CBASTXNDEF->UPDATE_USER_ID));
    MEMCPY_AN(CBASTXNDEF_N->UPDATE_TIME, CBASTXNDEF->UPDATE_TIME, sizeof(CBASTXNDEF->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_cbastxndef(struct CBASTXNDEF_N_TAG *CBASTXNDEF_N, struct CBASTXNDEF_TAG *CBASTXNDEF)
{
    MEMCPY_DN(CBASTXNDEF->FACTORY, CBASTXNDEF_N->FACTORY, sizeof(CBASTXNDEF->FACTORY));
