                    :MWIPLOTHISX_N.HM_CMF_19,
                    :MWIPLOTHISX_N.HM_CMF_20,
                    :MWIPLOTHISX_N.GRT_CMF_1,
                    :MWIPLOTHISX_N.GRT_CMF_2,
                    :MWIPLOTHISX_N.GRT_CMF_3,
                    :MWIPLOTHISX_N.GRT_CMF_4,
                    :MWIPLOTHISX_N.GRT_CMF_5,
                    :MWIPLOTHISX_N.GRT_CMF_6,
                    :MWIPLOTHISX_N.GRT_CMF_7,
                    :MWIPLOTHISX_N.GRT_CMF_8,
                    :MWIPLOTHISX_N.GRT_CMF_9,
                    :MWIPLOTHISX_N.GRT_CMF_10,
                    :MWIPLOTHISX_N.GRT_CMF_11,
                    :MWIPLOTHISX_N.GRT_CMF_12,
                    :MWIPLOTHISX_N.GRT_CMF_13,
                    :MWIPLOTHISX_N.GRT_CMF_14,
                    :MWIPLOTHISX_N.GRT_CMF_15,
                    :MWIPLOTHISX_N.GRT_CMF_16,
                    :MWIPLOTHISX_N.GRT_CMF_17,
                    :MWIPLOTHISX_N.GRT_CMF_18,
                    :MWIPLOTHISX_N.GRT_CMF_19,
                    :MWIPLOTHISX_N.GRT_CMF_20
                 FROM MWIPLOTHIS
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                    AND HIST_SEQ = (SELECT NVL(MAX(HIST_SEQ),0)
                                      FROM MWIPLOTHIS 
                                     WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                                       AND HIST_SEQ < :MWIPLOTHISX_N.HIST_SEQ
                                       AND HIST_DEL_FLAG = ' '
                                       AND OPER IN (SELECT OPER FROM MWIPOPRDEF WHERE OPER_GRP_1 != 'NO_STORE')
                                    )
                ORDER BY HIST_SEQ;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_mwiplothisx(&MWIPLOTHISX_N, MWIPLOTHISX);
    }

    DB_stop_query_timer("DBU_select_mwiplothisx", sel_type);
}


