    }

    DB_stop_query_timer("DBU_select_mwiplothisx_for_update", sel_type);
}


/* SQL SELECT_SCALAR Function */
double DBU_select_mwiplothisx_scalar(int sel_type, struct MWIPLOTHISX_TAG *MWIPLOTHISX)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MWIPLOTHISX_N_TAG MWIPLOTHISX_N;
        double d_value;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_mwiplothisx(&MWIPLOTHISX_N, MWIPLOTHISX);
    DB_error_code = 0;
    d_value = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MWIPLOTHIS
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                    AND HIST_SEQ = :MWIPLOTHISX_N.HIST_SEQ;
            break;

        case 2:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MWIPLOTHIS
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                    AND OPER = :MWIPLOTHISX_N.OPER
                    AND TRAN_CODE = :MWIPLOTHISX_N.TRAN_CODE
                    AND HIST_DEL_FLAG = ' ';
            break;

        case 3:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MWIPLOTHIS
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                  AND ORDER_ID = :MWIPLOTHISX_N.ORDER_ID
                  AND TRAN_CODE = :MWIPLOTHISX_N.TRAN_CODE
                  AND HIST_DEL_FLAG = ' ';
            break;

        case 4:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MWIPLOTHIS
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                  AND TRAN_CODE = :MWIPLOTHISX_N.TRAN_CODE
                  AND HIST_DEL_FLAG = ' ';
            break;

        case 5:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MWIPLOTHIS
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                    AND OLD_OPER = :MWIPLOTHISX_N.OLD_OPER
                    AND ORDER_ID = :MWIPLOTHISX_N.ORDER_ID
                    AND TRAN_CODE = :MWIPLOTHISX_N.TRAN_CODE
                    AND HIST_DEL_FLAG = ' ';
            break;

        case 6:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MWIPLOTHIS
                WHERE ORDER_ID = :MWIPLOTHISX_N.ORDER_ID
                  AND TRAN_CODE = :MWIPLOTHISX_N.TRAN_CODE
                  AND HIST_DEL_FLAG = ' ';
            break;

        case 7:
            EXEC SQL SELECT MAX(case when TRAN_TIME > to_char(SYSDATE -20/(24*60),'YYYYMMDDHH24MISS') then 1 else 0 end)
                INTO :d_value
                FROM MWIPLOTHIS
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                    AND HIST_SEQ = :MWIPLOTHISX_N.HIST_SEQ;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_select_mwiplothisx_scalar", sel_type);

    return d_value;
}


/* SQL DELETE Function */
void DBU_delete_mwiplothisx(int sel_type, struct MWIPLOTHISX_TAG *MWIPLOTHISX)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MWIPLOTHISX_N_TAG MWIPLOTHISX_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_mwiplothisx(&MWIPLOTHISX_N, MWIPLOTHISX);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DELETE FROM MWIPLOTHIS
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                    AND HIST_SEQ = :MWIPLOTHISX_N.HIST_SEQ;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_delete_mwiplothisx", sel_type);
}


