                    :MWIPLOTHISX_N.GRT_CMF_20
                FROM MWIPLOTHIS
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                    AND HIST_SEQ = :MWIPLOTHISX_N.HIST_SEQ;
            break;

        case 2:
            EXEC SQL SELECT 
                    OLD_MAT_ID
                INTO 
                    :MWIPLOTHISX_N.MAT_ID 
                 FROM MWIPLOTHIS
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                    AND HIST_SEQ = (SELECT MAX(HIST_SEQ) 
                                      FROM MWIPLOTHIS 
                                     WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                                       AND TRAN_CODE = :MWIPLOTHISX_N.TRAN_CODE)
                ORDER BY HIST_SEQ;
            break;

