/* Del Null Function */
void DBU_del_null_mwiplothisx(struct MWIPLOTHISX_N_TAG *MWIPLOTHISX_N, struct MWIPLOTHISX_TAG *MWIPLOTHISX)
{
    MEMCPY_DN(MWIPLOTHISX->LOT_ID, MWIPLOTHISX_N->LOT_ID, sizeof(MWIPLOTHISX->LOT_ID));
    MWIPLOTHISX->HIST_SEQ = MWIPLOTHISX_N->HIST_SEQ;
    MEMCPY_DN(MWIPLOTHISX->TRAN_TIME, MWIPLOTHISX_N->TRAN_TIME, sizeof(MWIPLOTHISX->TRAN_TIME));
    MEMCPY_DN(MWIPLOTHISX->SYS_TRAN_TIME, MWIPLOTHISX_N->SYS_TRAN_TIME, sizeof(MWIPLOTHISX->SYS_TRAN_TIME));
    MEMCPY_DN(MWIPLOTHISX->TRAN_CODE, MWIPLOTHISX_N->TRAN_CODE, sizeof(MWIPLOTHISX->TRAN_CODE));
    MEMCPY_DN(MWIPLOTHISX->LOT_DESC, MWIPLOTHISX_N->LOT_DESC, sizeof(MWIPLOTHISX->LOT_DESC));
    MEMCPY_DN(MWIPLOTHISX->FACTORY, MWIPLOTHISX_N->FACTORY, sizeof(MWIPLOTHISX->FACTORY));
    MEMCPY_DN(MWIPLOTHISX->MAT_ID, MWIPLOTHISX_N->MAT_ID, sizeof(MWIPLOTHISX->MAT_ID));
    MWIPLOTHISX->MAT_VER = MWIPLOTHISX_N->MAT_VER;
    MEMCPY_DN(MWIPLOTHISX->FLOW, MWIPLOTHISX_N->FLOW, sizeof(MWIPLOTHISX->FLOW));
    MWIPLOTHISX->FLOW_SEQ_NUM = MWIPLOTHISX_N->FLOW_SEQ_NUM;
    MEMCPY_DN(MWIPLOTHISX->OPER, MWIPLOTHISX_N->OPER, sizeof(MWIPLOTHISX->OPER));
    MWIPLOTHISX->QTY_1 = MWIPLOTHISX_N->QTY_1;
    MWIPLOTHISX->QTY_2 = MWIPLOTHISX_N->QTY_2;
    MWIPLOTHISX->QTY_3 = MWIPLOTHISX_N->QTY_3;
    MEMCPY_DN(MWIPLOTHISX->CRR_ID, MWIPLOTHISX_N->CRR_ID, sizeof(MWIPLOTHISX->CRR_ID));
