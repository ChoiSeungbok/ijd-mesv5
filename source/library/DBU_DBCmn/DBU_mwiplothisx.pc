                    :MWIPLOTHISX_N.GRT_CMF_18,
                    :MWIPLOTHISX_N.GRT_CMF_19,
                    :MWIPLOTHISX_N.GRT_CMF_20
                  FROM MWIPLOTHIS
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                  AND HIST_SEQ = (
                                  SELECT MAX(HIST_SEQ)
                                    FROM MWIPLOTHIS
                                   WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                                     AND TRAN_CODE = :MWIPLOTHISX_N.TRAN_CODE
                                     AND HIST_DEL_FLAG = ' '
                                     AND HIST_SEQ < (
                                                     SELECT HIST_SEQ
                                                       FROM MWIPLOTHIS
                                                      WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                                                        AND TRAN_CODE = 'SPLIT'
                                                        AND FROM_TO_LOT_ID = :MWIPLOTHISX_N.FROM_TO_LOT_ID
                                                        AND FROM_TO_FLAG = 'F'
                                                        AND HIST_DEL_FLAG = ' '
                                                    )
                                     AND OLD_OPER = :MWIPLOTHISX_N.OLD_OPER
                                     AND RESV_FLAG_1 = :MWIPLOTHISX_N.RESV_FLAG_1
                                 );

            break;

        case 5:
            EXEC SQL SELECT 
                    OLD_OPER
                INTO 
                    :MWIPLOTHISX_N.OLD_OPER
                 FROM MWIPLOTHIS
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                    AND HIST_SEQ = (SELECT MAX(HIST_SEQ) 
                                      FROM MWIPLOTHIS 
                                     WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                                       AND TRAN_CODE = :MWIPLOTHISX_N.TRAN_CODE
                                       AND HIST_DEL_FLAG = ' ')
                ORDER BY HIST_SEQ;
            break;

