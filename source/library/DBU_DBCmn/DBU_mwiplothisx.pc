                                     AND HIST_DEL_FLAG = ' '
                                     AND HIST_SEQ < :MWIPLOTHISX_N.HIST_SEQ
                                     AND OLD_OPER = :MWIPLOTHISX_N.OLD_OPER
                                     AND RESV_FLAG_1 = :MWIPLOTHISX_N.RESV_FLAG_1
