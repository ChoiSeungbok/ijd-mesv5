/* SQL UPDATE Function */
void DBU_update_mwiplothisx(int sel_type, struct MWIPLOTHISX_TAG *MWIPLOTHISX)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MWIPLOTHISX_N_TAG MWIPLOTHISX_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_mwiplothisx(&MWIPLOTHISX_N, MWIPLOTHISX);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL UPDATE MWIPLOTHIS SET
                    TRAN_TIME = :MWIPLOTHISX_N.TRAN_TIME,
                    SYS_TRAN_TIME = :MWIPLOTHISX_N.SYS_TRAN_TIME,
                    TRAN_CODE = :MWIPLOTHISX_N.TRAN_CODE,
