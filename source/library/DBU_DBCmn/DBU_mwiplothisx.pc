                    GRT_CMF_19 = :MWIPLOTHISX_N.GRT_CMF_19,
                    GRT_CMF_20 = :MWIPLOTHISX_N.GRT_CMF_20
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                    AND HIST_SEQ = :MWIPLOTHISX_N.HIST_SEQ;
            break;

        case 2:
            EXEC SQL UPDATE MWIPLOTHIS SET
                       FLOW = :MWIPLOTHISX_N.FLOW
                WHERE ORDER_ID = :MWIPLOTHISX_N.ORDER_ID;
            break;

        case 3:
            EXEC SQL UPDATE MWIPLOTHIS SET
                       LOT_CMF_17 = :MWIPLOTHISX_N.LOT_CMF_17,
                       LOT_CMF_18 = :MWIPLOTHISX_N.LOT_CMF_18
                WHERE LOT_ID = :MWIPLOTHISX_N.LOT_ID
                  AND(START_RES_ID = :MWIPLOTHISX_N.START_RES_ID OR END_RES_ID = :MWIPLOTHISX_N.START_RES_ID);
            break;




        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_update_mwiplothisx", sel_type);
}


/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_mwiplothisx(int sel_type, struct MWIPLOTHISX_TAG *MWIPLOTHISX)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MWIPLOTHISX_N_TAG MWIPLOTHISX_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_mwiplothisx(&MWIPLOTHISX_N, MWIPLOTHISX);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
