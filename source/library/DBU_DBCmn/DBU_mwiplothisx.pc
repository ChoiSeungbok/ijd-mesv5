                :MWIPLOTHISX_N.GRT_CMF_7,
                :MWIPLOTHISX_N.GRT_CMF_8,
                :MWIPLOTHISX_N.GRT_CMF_9,
                :MWIPLOTHISX_N.GRT_CMF_10,
                :MWIPLOTHISX_N.GRT_CMF_11,
                :MWIPLOTHISX_N.GRT_CMF_12,
                :MWIPLOTHISX_N.GRT_CMF_13,
                :MWIPLOTHISX_N.GRT_CMF_14,
                :MWIPLOTHISX_N.GRT_CMF_15,
                :MWIPLOTHISX_N.GRT_CMF_16,
                :MWIPLOTHISX_N.GRT_CMF_17,
                :MWIPLOTHISX_N.GRT_CMF_18,
                :MWIPLOTHISX_N.GRT_CMF_19,
                :MWIPLOTHISX_N.GRT_CMF_20;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_mwiplothisx(&MWIPLOTHISX_N, MWIPLOTHISX);
    }

    DB_stop_query_timer("DBU_fetch_mwiplothisx", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_mwiplothisx(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_MWIPLOTHISX_CUR_1;
            break;

        case 2:
            EXEC SQL CLOSE DBU_MWIPLOTHISX_CUR_2;
            break;

        case 3:
            EXEC SQL CLOSE DBU_MWIPLOTHISX_CUR_3;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_mwiplothisx", sel_type);
}


