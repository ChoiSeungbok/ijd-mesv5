				  AND DOWN_STATUS = 'E'
				  AND SEQ < :CWIPDWNSTS_N.SEQ
				  AND DOWN_END_TIME > :CWIPDWNSTS_N.DOWN_START_TIME;
            break;

		case 7:
            EXEC SQL SELECT COUNT(*)
                INTO :d_value
                FROM CWIPDWNSTS
				WHERE FACTORY = :CWIPDWNSTS_N.FACTORY
				  AND RES_ID = :CWIPDWNSTS_N.RES_ID
