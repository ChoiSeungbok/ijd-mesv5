        struct CRASDSPREQ_N_TAG CRASDSPREQ_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_crasdspreq(&CRASDSPREQ_N, CRASDSPREQ);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CRASDSPREQ_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    REQ_NO,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    REQ_USER_ID,
                    REQ_TIME,
                    REQ_COMMENT,
                    CONFIRM_USER_ID,
                    CONFIRM_TIME,
                    CONFIRM_COMMENT,
                    REQ_STATUS,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CRASDSPREQ
                ORDER BY FACTORY ASC,
                    REQ_NO ASC;
            EXEC SQL OPEN DBU_CRASDSPREQ_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
