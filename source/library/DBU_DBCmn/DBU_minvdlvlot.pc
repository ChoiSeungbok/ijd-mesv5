    MINVDLVLOT->BL_SEQ = MINVDLVLOT_N->BL_SEQ;
	MINVDLVLOT->PO_DISTRIBUTION_ID = MINVDLVLOT_N->PO_DISTRIBUTION_ID;
    MEMCPY_DN(MINVDLVLOT->INSP_ID, MINVDLVLOT_N->INSP_ID, sizeof(MINVDLVLOT->INSP_ID));
