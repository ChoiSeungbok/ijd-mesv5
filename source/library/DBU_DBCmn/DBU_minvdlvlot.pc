        case 1:
            EXEC SQL DECLARE DBU_MINVDLVLOT_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    DLV_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    QTY_2,
                    QTY_3,
                    UNIT,
                    UNIT_2,
