    MEMCPY_AN(CSUMLOTDAT_N->FLOW, CSUMLOTDAT->FLOW, sizeof(CSUMLOTDAT->FLOW));
    CSUMLOTDAT_N->FLOW_SEQ_NUM = CSUMLOTDAT->FLOW_SEQ_NUM;
    CSUMLOTDAT_N->IN_QTY = CSUMLOTDAT->IN_QTY;
    CSUMLOTDAT_N->OUT_QTY = CSUMLOTDAT->OUT_QTY;
    CSUMLOTDAT_N->LOSS_QTY = CSUMLOTDAT->LOSS_QTY;
    MEMCPY_AN(CSUMLOTDAT_N->UNIT, CSUMLOTDAT->UNIT, sizeof(CSUMLOTDAT->UNIT));
    MEMCPY_AN(CSUMLOTDAT_N->ORDER_ID, CSUMLOTDAT->ORDER_ID, sizeof(CSUMLOTDAT->ORDER_ID));
    MEMCPY_AN(CSUMLOTDAT_N->START_DATE, CSUMLOTDAT->START_DATE, sizeof(CSUMLOTDAT->START_DATE));
    MEMCPY_AN(CSUMLOTDAT_N->START_TIME, CSUMLOTDAT->START_TIME, sizeof(CSUMLOTDAT->START_TIME));
    MEMCPY_AN(CSUMLOTDAT_N->START_DAY_NIGHT, CSUMLOTDAT->START_DAY_NIGHT, sizeof(CSUMLOTDAT->START_DAY_NIGHT));
    CSUMLOTDAT_N->END_HIST_SEQ = CSUMLOTDAT->END_HIST_SEQ;
    MEMCPY_AN(CSUMLOTDAT_N->END_DATE, CSUMLOTDAT->END_DATE, sizeof(CSUMLOTDAT->END_DATE));
    MEMCPY_AN(CSUMLOTDAT_N->END_TIME, CSUMLOTDAT->END_TIME, sizeof(CSUMLOTDAT->END_TIME));
    MEMCPY_AN(CSUMLOTDAT_N->END_DAY_NIGHT, CSUMLOTDAT->END_DAY_NIGHT, sizeof(CSUMLOTDAT->END_DAY_NIGHT));
    CSUMLOTDAT_N->ONLY_END_FLAG[0] = CSUMLOTDAT->ONLY_END_FLAG;
    MEMCPY_AN(CSUMLOTDAT_N->CMF_1, CSUMLOTDAT->CMF_1, sizeof(CSUMLOTDAT->CMF_1));
    MEMCPY_AN(CSUMLOTDAT_N->CMF_2, CSUMLOTDAT->CMF_2, sizeof(CSUMLOTDAT->CMF_2));
    MEMCPY_AN(CSUMLOTDAT_N->CMF_3, CSUMLOTDAT->CMF_3, sizeof(CSUMLOTDAT->CMF_3));
    MEMCPY_AN(CSUMLOTDAT_N->CMF_4, CSUMLOTDAT->CMF_4, sizeof(CSUMLOTDAT->CMF_4));
    MEMCPY_AN(CSUMLOTDAT_N->CMF_5, CSUMLOTDAT->CMF_5, sizeof(CSUMLOTDAT->CMF_5));
    MEMCPY_AN(CSUMLOTDAT_N->CREATE_USER_ID, CSUMLOTDAT->CREATE_USER_ID, sizeof(CSUMLOTDAT->CREATE_USER_ID));
    MEMCPY_AN(CSUMLOTDAT_N->CREATE_TIME, CSUMLOTDAT->CREATE_TIME, sizeof(CSUMLOTDAT->CREATE_TIME));
    MEMCPY_AN(CSUMLOTDAT_N->UPDATE_USER_ID, CSUMLOTDAT->UPDATE_USER_ID, sizeof(CSUMLOTDAT->UPDATE_USER_ID));
    MEMCPY_AN(CSUMLOTDAT_N->UPDATE_TIME, CSUMLOTDAT->UPDATE_TIME, sizeof(CSUMLOTDAT->UPDATE_TIME));
}


