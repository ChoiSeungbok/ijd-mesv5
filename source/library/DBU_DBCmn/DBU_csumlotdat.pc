/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_csumlotdat(int sel_type, struct CSUMLOTDAT_TAG *CSUMLOTDAT)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CSUMLOTDAT_N_TAG CSUMLOTDAT_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_csumlotdat(&CSUMLOTDAT_N, CSUMLOTDAT);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CSUMLOTDAT_CUR_1 CURSOR FOR
                SELECT 
                    LOT_ID,
                    OPER,
                    START_HIST_SEQ,
                    RWK_FLAG,
                    RES_ID,
                    AREA_ID,
                    SUB_AREA_ID,
                    FACTORY,
                    MAT_ID,
                    FLOW,
                    FLOW_SEQ_NUM,
                    IN_QTY,
                    OUT_QTY,
                    LOSS_QTY,
                    UNIT,
                    ORDER_ID,
                    START_DATE,
                    START_TIME,
                    START_DAY_NIGHT,
                    END_HIST_SEQ,
                    END_DATE,
                    END_TIME,
                    END_DAY_NIGHT,
                    ONLY_END_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CSUMLOTDAT
                ORDER BY LOT_ID ASC,
                    OPER ASC,
                    START_HIST_SEQ ASC;
            EXEC SQL OPEN DBU_CSUMLOTDAT_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_csumlotdat", sel_type);
}


