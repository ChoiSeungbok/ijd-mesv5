            break;
    }

    DB_stop_query_timer("DBU_close_csumlotdat", sel_type);
}


/* Initialize Function */
void DBU_init_csumlotdat(struct CSUMLOTDAT_TAG *CSUMLOTDAT)
{
    /* memset by Space */
    memset(CSUMLOTDAT, ' ', sizeof(struct CSUMLOTDAT_TAG));
    
    CSUMLOTDAT->START_HIST_SEQ = 0;
    CSUMLOTDAT->FLOW_SEQ_NUM = 0;
    CSUMLOTDAT->IN_QTY = 0;
    CSUMLOTDAT->OUT_QTY = 0;
    CSUMLOTDAT->LOSS_QTY = 0;
    CSUMLOTDAT->END_HIST_SEQ = 0;
}


/* Add Null Function */
void DBU_add_null_csumlotdat(struct CSUMLOTDAT_N_TAG *CSUMLOTDAT_N, struct CSUMLOTDAT_TAG *CSUMLOTDAT)
{
    /* memset by NULL */
    memset(CSUMLOTDAT_N, '\0', sizeof(struct CSUMLOTDAT_N_TAG));
    
    MEMCPY_AN(CSUMLOTDAT_N->LOT_ID, CSUMLOTDAT->LOT_ID, sizeof(CSUMLOTDAT->LOT_ID));
    MEMCPY_AN(CSUMLOTDAT_N->OPER, CSUMLOTDAT->OPER, sizeof(CSUMLOTDAT->OPER));
    CSUMLOTDAT_N->START_HIST_SEQ = CSUMLOTDAT->START_HIST_SEQ;
