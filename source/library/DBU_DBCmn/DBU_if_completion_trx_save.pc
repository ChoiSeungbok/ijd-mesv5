			CMF_10,
			CREATE_USER_ID,
			CREATE_TIME,
			UPDATE_USER_ID,
			UPDATE_TIME
			FROM IF_COMPLETION_TRX_SAVE
			ORDER BY IF_SEQ ASC;
		EXEC SQL OPEN DBU_IF_COMPLETION_TRX_SAVE_CUR_1;
		break;


	default:
		DB_error_code = 9999;
		memset(DB_error_msg, ' ', sizeof(DB_error_msg));
		memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
		break;
	}

	DB_stop_query_timer("DBU_open_if_completion_trx_save", sel_type);
}


