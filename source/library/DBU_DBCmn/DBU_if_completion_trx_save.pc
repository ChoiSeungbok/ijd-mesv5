		EXEC SQL DECLARE DBU_IF_COMPLETION_TRX_SAVE_CUR_1 CURSOR FOR
			SELECT
			IF_SEQ,
			IF_TIME,
			IF_CODE,
			IF_MSG,
			FACTORY,
			TRAN_TYPE_ID,
			TRAN_TYPE,
			TRAN_TIME,
