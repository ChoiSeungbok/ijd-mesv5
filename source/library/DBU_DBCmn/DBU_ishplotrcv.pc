/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_ishplotrcv(int sel_type, struct ISHPLOTRCV_TAG *ISHPLOTRCV)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct ISHPLOTRCV_N_TAG ISHPLOTRCV_N;
