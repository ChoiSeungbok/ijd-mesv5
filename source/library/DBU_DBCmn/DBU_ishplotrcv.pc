    MEMCPY_DN(ISHPLOTRCV->DELIVERY_USER_ID, ISHPLOTRCV_N->DELIVERY_USER_ID, sizeof(ISHPLOTRCV->DELIVERY_USER_ID));
    ISHPLOTRCV->SHIPPING_LINE_ID = ISHPLOTRCV_N->SHIPPING_LINE_ID;
    MEMCPY_DN(ISHPLOTRCV->PRS_WORK_DATE, ISHPLOTRCV_N->PRS_WORK_DATE, sizeof(ISHPLOTRCV->PRS_WORK_DATE));
    MEMCPY_DN(ISHPLOTRCV->RES_ID, ISHPLOTRCV_N->RES_ID, sizeof(ISHPLOTRCV->RES_ID));
