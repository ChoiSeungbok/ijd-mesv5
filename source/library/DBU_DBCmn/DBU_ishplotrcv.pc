    DB_start_query_timer();

    DBU_add_null_ishplotrcv(&ISHPLOTRCV_N, ISHPLOTRCV);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_ISHPLOTRCV_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    ORG_LOT_ID,
                    PACK_LOT_ID,
                    FROM_FACTORY,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
                    CUSTOMER_ID,
