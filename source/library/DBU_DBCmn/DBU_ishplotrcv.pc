    MEMCPY_DN(ISHPLOTRCV->CUSTOMER_NAME, ISHPLOTRCV_N->CUSTOMER_NAME, sizeof(ISHPLOTRCV->CUSTOMER_NAME));
    MEMCPY_DN(ISHPLOTRCV->DELIVERY, ISHPLOTRCV_N->DELIVERY, sizeof(ISHPLOTRCV->DELIVERY));
