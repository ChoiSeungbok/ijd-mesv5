    MEMCPY_DN(ISHPLOTRCV->UPDATE_USER_ID, ISHPLOTRCV_N->UPDATE_USER_ID, sizeof(ISHPLOTRCV->UPDATE_USER_ID));
    MEMCPY_DN(ISHPLOTRCV->UPDATE_TIME, ISHPLOTRCV_N->UPDATE_TIME, sizeof(ISHPLOTRCV->UPDATE_TIME));
	ISHPLOTRCV->RECEIVE_FLAG = ISHPLOTRCV_N->RECEIVE_FLAG[0];
	ISHPLOTRCV->DELETE_FLAG = ISHPLOTRCV_N->DELETE_FLAG[0];
}


