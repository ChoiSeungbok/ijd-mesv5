                    MAPPING_SEQ,
                    CAR,
                    DAY_NIGHT,
                    PRS_TRAN_TIME,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME,
					RECEIVE_FLAG,
					DELETE_FLAG
                FROM ISHPLOTRCV
                ORDER BY FACTORY ASC,
                    ORG_LOT_ID ASC,
                    PACK_LOT_ID ASC;
            EXEC SQL OPEN DBU_ISHPLOTRCV_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_ishplotrcv", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_ishplotrcv(int sel_type, struct ISHPLOTRCV_TAG *ISHPLOTRCV)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct ISHPLOTRCV_N_TAG ISHPLOTRCV_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_ISHPLOTRCV_CUR_1 INTO
                :ISHPLOTRCV_N.FACTORY,
                :ISHPLOTRCV_N.ORG_LOT_ID,
                :ISHPLOTRCV_N.PACK_LOT_ID,
                :ISHPLOTRCV_N.FROM_FACTORY,
                :ISHPLOTRCV_N.MAT_ID,
                :ISHPLOTRCV_N.MAT_VER,
                :ISHPLOTRCV_N.QTY,
                :ISHPLOTRCV_N.UNIT,
                :ISHPLOTRCV_N.PACK_ORDER_ID,
                :ISHPLOTRCV_N.PACK_LINE_NO,
                :ISHPLOTRCV_N.SHIP_DATE,
                :ISHPLOTRCV_N.SHIP_ORDER_ID,
                :ISHPLOTRCV_N.SHIP_ORDER_SEQ,
                :ISHPLOTRCV_N.CUSTOMER_ID,
                :ISHPLOTRCV_N.CUSTOMER_SITE_ID,
                :ISHPLOTRCV_N.CUSTOMER_NUMBER,
                :ISHPLOTRCV_N.CUSTOMER_NAME,
                :ISHPLOTRCV_N.DELIVERY,
                :ISHPLOTRCV_N.DELIVERY_ID,
                :ISHPLOTRCV_N.DELIVERY_NAME,
                :ISHPLOTRCV_N.DELIVERY_LOCATION,
                :ISHPLOTRCV_N.DELIVERY_PHONE_NO,
                :ISHPLOTRCV_N.DELIVERY_USER_ID,
                :ISHPLOTRCV_N.SHIPPING_LINE_ID,
                :ISHPLOTRCV_N.PRS_WORK_DATE,
                :ISHPLOTRCV_N.RES_ID,
                :ISHPLOTRCV_N.RES_DESC,
                :ISHPLOTRCV_N.RUN_COUNT,
                :ISHPLOTRCV_N.CELL_ID,
                :ISHPLOTRCV_N.MAPPING_SEQ,
                :ISHPLOTRCV_N.CAR,
                :ISHPLOTRCV_N.DAY_NIGHT,
                :ISHPLOTRCV_N.PRS_TRAN_TIME,
                :ISHPLOTRCV_N.CMF_1,
                :ISHPLOTRCV_N.CMF_2,
                :ISHPLOTRCV_N.CMF_3,
                :ISHPLOTRCV_N.CMF_4,
                :ISHPLOTRCV_N.CMF_5,
                :ISHPLOTRCV_N.CMF_6,
                :ISHPLOTRCV_N.CMF_7,
                :ISHPLOTRCV_N.CMF_8,
                :ISHPLOTRCV_N.CMF_9,
                :ISHPLOTRCV_N.CMF_10,
                :ISHPLOTRCV_N.CREATE_USER_ID,
                :ISHPLOTRCV_N.CREATE_TIME,
                :ISHPLOTRCV_N.UPDATE_USER_ID,
                :ISHPLOTRCV_N.UPDATE_TIME,
				:ISHPLOTRCV_N.RECEIVE_FLAG,
				:ISHPLOTRCV_N.DELETE_FLAG;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_ishplotrcv(&ISHPLOTRCV_N, ISHPLOTRCV);
    }

    DB_stop_query_timer("DBU_fetch_ishplotrcv", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_ishplotrcv(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_ISHPLOTRCV_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_ishplotrcv", sel_type);
}


/* Initialize Function */
void DBU_init_ishplotrcv(struct ISHPLOTRCV_TAG *ISHPLOTRCV)
{
    /* memset by Space */
    memset(ISHPLOTRCV, ' ', sizeof(struct ISHPLOTRCV_TAG));
    
    ISHPLOTRCV->MAT_VER = 0;
    ISHPLOTRCV->QTY = 0;
    ISHPLOTRCV->PACK_LINE_NO = 0;
    ISHPLOTRCV->SHIP_ORDER_SEQ = 0;
    ISHPLOTRCV->CUSTOMER_SITE_ID = 0;
    ISHPLOTRCV->DELIVERY_ID = 0;
    ISHPLOTRCV->SHIPPING_LINE_ID = 0;
    ISHPLOTRCV->RUN_COUNT = 0;
    ISHPLOTRCV->MAPPING_SEQ = 0;
}


/* Add Null Function */
void DBU_add_null_ishplotrcv(struct ISHPLOTRCV_N_TAG *ISHPLOTRCV_N, struct ISHPLOTRCV_TAG *ISHPLOTRCV)
{
    /* memset by NULL */
    memset(ISHPLOTRCV_N, '\0', sizeof(struct ISHPLOTRCV_N_TAG));
    
    MEMCPY_AN(ISHPLOTRCV_N->FACTORY, ISHPLOTRCV->FACTORY, sizeof(ISHPLOTRCV->FACTORY));
    MEMCPY_AN(ISHPLOTRCV_N->ORG_LOT_ID, ISHPLOTRCV->ORG_LOT_ID, sizeof(ISHPLOTRCV->ORG_LOT_ID));
    MEMCPY_AN(ISHPLOTRCV_N->PACK_LOT_ID, ISHPLOTRCV->PACK_LOT_ID, sizeof(ISHPLOTRCV->PACK_LOT_ID));
    MEMCPY_AN(ISHPLOTRCV_N->FROM_FACTORY, ISHPLOTRCV->FROM_FACTORY, sizeof(ISHPLOTRCV->FROM_FACTORY));
    MEMCPY_AN(ISHPLOTRCV_N->MAT_ID, ISHPLOTRCV->MAT_ID, sizeof(ISHPLOTRCV->MAT_ID));
    ISHPLOTRCV_N->MAT_VER = ISHPLOTRCV->MAT_VER;
    ISHPLOTRCV_N->QTY = ISHPLOTRCV->QTY;
    MEMCPY_AN(ISHPLOTRCV_N->UNIT, ISHPLOTRCV->UNIT, sizeof(ISHPLOTRCV->UNIT));
    MEMCPY_AN(ISHPLOTRCV_N->PACK_ORDER_ID, ISHPLOTRCV->PACK_ORDER_ID, sizeof(ISHPLOTRCV->PACK_ORDER_ID));
    ISHPLOTRCV_N->PACK_LINE_NO = ISHPLOTRCV->PACK_LINE_NO;
    MEMCPY_AN(ISHPLOTRCV_N->SHIP_DATE, ISHPLOTRCV->SHIP_DATE, sizeof(ISHPLOTRCV->SHIP_DATE));
    MEMCPY_AN(ISHPLOTRCV_N->SHIP_ORDER_ID, ISHPLOTRCV->SHIP_ORDER_ID, sizeof(ISHPLOTRCV->SHIP_ORDER_ID));
    ISHPLOTRCV_N->SHIP_ORDER_SEQ = ISHPLOTRCV->SHIP_ORDER_SEQ;
    MEMCPY_AN(ISHPLOTRCV_N->CUSTOMER_ID, ISHPLOTRCV->CUSTOMER_ID, sizeof(ISHPLOTRCV->CUSTOMER_ID));
    ISHPLOTRCV_N->CUSTOMER_SITE_ID = ISHPLOTRCV->CUSTOMER_SITE_ID;
    MEMCPY_AN(ISHPLOTRCV_N->CUSTOMER_NUMBER, ISHPLOTRCV->CUSTOMER_NUMBER, sizeof(ISHPLOTRCV->CUSTOMER_NUMBER));
    MEMCPY_AN(ISHPLOTRCV_N->CUSTOMER_NAME, ISHPLOTRCV->CUSTOMER_NAME, sizeof(ISHPLOTRCV->CUSTOMER_NAME));
    MEMCPY_AN(ISHPLOTRCV_N->DELIVERY, ISHPLOTRCV->DELIVERY, sizeof(ISHPLOTRCV->DELIVERY));
    ISHPLOTRCV_N->DELIVERY_ID = ISHPLOTRCV->DELIVERY_ID;
    MEMCPY_AN(ISHPLOTRCV_N->DELIVERY_NAME, ISHPLOTRCV->DELIVERY_NAME, sizeof(ISHPLOTRCV->DELIVERY_NAME));
    MEMCPY_AN(ISHPLOTRCV_N->DELIVERY_LOCATION, ISHPLOTRCV->DELIVERY_LOCATION, sizeof(ISHPLOTRCV->DELIVERY_LOCATION));
    MEMCPY_AN(ISHPLOTRCV_N->DELIVERY_PHONE_NO, ISHPLOTRCV->DELIVERY_PHONE_NO, sizeof(ISHPLOTRCV->DELIVERY_PHONE_NO));
    MEMCPY_AN(ISHPLOTRCV_N->DELIVERY_USER_ID, ISHPLOTRCV->DELIVERY_USER_ID, sizeof(ISHPLOTRCV->DELIVERY_USER_ID));
    ISHPLOTRCV_N->SHIPPING_LINE_ID = ISHPLOTRCV->SHIPPING_LINE_ID;
    MEMCPY_AN(ISHPLOTRCV_N->PRS_WORK_DATE, ISHPLOTRCV->PRS_WORK_DATE, sizeof(ISHPLOTRCV->PRS_WORK_DATE));
    MEMCPY_AN(ISHPLOTRCV_N->RES_ID, ISHPLOTRCV->RES_ID, sizeof(ISHPLOTRCV->RES_ID));
    MEMCPY_AN(ISHPLOTRCV_N->RES_DESC, ISHPLOTRCV->RES_DESC, sizeof(ISHPLOTRCV->RES_DESC));
    ISHPLOTRCV_N->RUN_COUNT = ISHPLOTRCV->RUN_COUNT;
    MEMCPY_AN(ISHPLOTRCV_N->CELL_ID, ISHPLOTRCV->CELL_ID, sizeof(ISHPLOTRCV->CELL_ID));
    ISHPLOTRCV_N->MAPPING_SEQ = ISHPLOTRCV->MAPPING_SEQ;
    MEMCPY_AN(ISHPLOTRCV_N->CAR, ISHPLOTRCV->CAR, sizeof(ISHPLOTRCV->CAR));
    ISHPLOTRCV_N->DAY_NIGHT[0] = ISHPLOTRCV->DAY_NIGHT;
    MEMCPY_AN(ISHPLOTRCV_N->PRS_TRAN_TIME, ISHPLOTRCV->PRS_TRAN_TIME, sizeof(ISHPLOTRCV->PRS_TRAN_TIME));
    MEMCPY_AN(ISHPLOTRCV_N->CMF_1, ISHPLOTRCV->CMF_1, sizeof(ISHPLOTRCV->CMF_1));
    MEMCPY_AN(ISHPLOTRCV_N->CMF_2, ISHPLOTRCV->CMF_2, sizeof(ISHPLOTRCV->CMF_2));
    MEMCPY_AN(ISHPLOTRCV_N->CMF_3, ISHPLOTRCV->CMF_3, sizeof(ISHPLOTRCV->CMF_3));
    MEMCPY_AN(ISHPLOTRCV_N->CMF_4, ISHPLOTRCV->CMF_4, sizeof(ISHPLOTRCV->CMF_4));
    MEMCPY_AN(ISHPLOTRCV_N->CMF_5, ISHPLOTRCV->CMF_5, sizeof(ISHPLOTRCV->CMF_5));
    MEMCPY_AN(ISHPLOTRCV_N->CMF_6, ISHPLOTRCV->CMF_6, sizeof(ISHPLOTRCV->CMF_6));
    MEMCPY_AN(ISHPLOTRCV_N->CMF_7, ISHPLOTRCV->CMF_7, sizeof(ISHPLOTRCV->CMF_7));
    MEMCPY_AN(ISHPLOTRCV_N->CMF_8, ISHPLOTRCV->CMF_8, sizeof(ISHPLOTRCV->CMF_8));
    MEMCPY_AN(ISHPLOTRCV_N->CMF_9, ISHPLOTRCV->CMF_9, sizeof(ISHPLOTRCV->CMF_9));
    MEMCPY_AN(ISHPLOTRCV_N->CMF_10, ISHPLOTRCV->CMF_10, sizeof(ISHPLOTRCV->CMF_10));
    MEMCPY_AN(ISHPLOTRCV_N->CREATE_USER_ID, ISHPLOTRCV->CREATE_USER_ID, sizeof(ISHPLOTRCV->CREATE_USER_ID));
    MEMCPY_AN(ISHPLOTRCV_N->CREATE_TIME, ISHPLOTRCV->CREATE_TIME, sizeof(ISHPLOTRCV->CREATE_TIME));
    MEMCPY_AN(ISHPLOTRCV_N->UPDATE_USER_ID, ISHPLOTRCV->UPDATE_USER_ID, sizeof(ISHPLOTRCV->UPDATE_USER_ID));
    MEMCPY_AN(ISHPLOTRCV_N->UPDATE_TIME, ISHPLOTRCV->UPDATE_TIME, sizeof(ISHPLOTRCV->UPDATE_TIME));
	ISHPLOTRCV_N->RECEIVE_FLAG[0] = ISHPLOTRCV->RECEIVE_FLAG;
	ISHPLOTRCV_N->DELETE_FLAG[0] = ISHPLOTRCV->DELETE_FLAG;
}


/* Del Null Function */
void DBU_del_null_ishplotrcv(struct ISHPLOTRCV_N_TAG *ISHPLOTRCV_N, struct ISHPLOTRCV_TAG *ISHPLOTRCV)
{
    MEMCPY_DN(ISHPLOTRCV->FACTORY, ISHPLOTRCV_N->FACTORY, sizeof(ISHPLOTRCV->FACTORY));
    MEMCPY_DN(ISHPLOTRCV->ORG_LOT_ID, ISHPLOTRCV_N->ORG_LOT_ID, sizeof(ISHPLOTRCV->ORG_LOT_ID));
    MEMCPY_DN(ISHPLOTRCV->PACK_LOT_ID, ISHPLOTRCV_N->PACK_LOT_ID, sizeof(ISHPLOTRCV->PACK_LOT_ID));
    MEMCPY_DN(ISHPLOTRCV->FROM_FACTORY, ISHPLOTRCV_N->FROM_FACTORY, sizeof(ISHPLOTRCV->FROM_FACTORY));
    MEMCPY_DN(ISHPLOTRCV->MAT_ID, ISHPLOTRCV_N->MAT_ID, sizeof(ISHPLOTRCV->MAT_ID));
    ISHPLOTRCV->MAT_VER = ISHPLOTRCV_N->MAT_VER;
    ISHPLOTRCV->QTY = ISHPLOTRCV_N->QTY;
