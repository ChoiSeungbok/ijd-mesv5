    MEMCPY_DN(ISHPLOTRCV->CELL_ID, ISHPLOTRCV_N->CELL_ID, sizeof(ISHPLOTRCV->CELL_ID));
    ISHPLOTRCV->MAPPING_SEQ = ISHPLOTRCV_N->MAPPING_SEQ;
    MEMCPY_DN(ISHPLOTRCV->CAR, ISHPLOTRCV_N->CAR, sizeof(ISHPLOTRCV->CAR));
