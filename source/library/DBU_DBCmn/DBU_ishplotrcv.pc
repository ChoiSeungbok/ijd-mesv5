    MEMCPY_DN(ISHPLOTRCV->PRS_TRAN_TIME, ISHPLOTRCV_N->PRS_TRAN_TIME, sizeof(ISHPLOTRCV->PRS_TRAN_TIME));
    MEMCPY_DN(ISHPLOTRCV->CMF_1, ISHPLOTRCV_N->CMF_1, sizeof(ISHPLOTRCV->CMF_1));
    MEMCPY_DN(ISHPLOTRCV->CMF_2, ISHPLOTRCV_N->CMF_2, sizeof(ISHPLOTRCV->CMF_2));
