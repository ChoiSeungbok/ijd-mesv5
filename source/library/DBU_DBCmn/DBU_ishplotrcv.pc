                    DELIVERY,
                    DELIVERY_ID,
                    DELIVERY_NAME,
                    DELIVERY_LOCATION,
                    DELIVERY_PHONE_NO,
                    DELIVERY_USER_ID,
                    SHIPPING_LINE_ID,
                    PRS_WORK_DATE,
