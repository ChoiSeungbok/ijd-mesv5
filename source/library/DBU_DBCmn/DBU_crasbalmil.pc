    MEMCPY_AN(CRASBALMIL_N->CMF_10, CRASBALMIL->CMF_10, sizeof(CRASBALMIL->CMF_10));
    MEMCPY_AN(CRASBALMIL_N->CREATE_USER_ID, CRASBALMIL->CREATE_USER_ID, sizeof(CRASBALMIL->CREATE_USER_ID));
    MEMCPY_AN(CRASBALMIL_N->CREATE_TIME, CRASBALMIL->CREATE_TIME, sizeof(CRASBALMIL->CREATE_TIME));
    MEMCPY_AN(CRASBALMIL_N->UPDATE_USER_ID, CRASBALMIL->UPDATE_USER_ID, sizeof(CRASBALMIL->UPDATE_USER_ID));
    MEMCPY_AN(CRASBALMIL_N->UPDATE_TIME, CRASBALMIL->UPDATE_TIME, sizeof(CRASBALMIL->UPDATE_TIME));
