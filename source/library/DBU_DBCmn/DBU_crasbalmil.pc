    MEMCPY_DN(CRASBALMIL->CREATE_TIME, CRASBALMIL_N->CREATE_TIME, sizeof(CRASBALMIL->CREATE_TIME));
    MEMCPY_DN(CRASBALMIL->UPDATE_USER_ID, CRASBALMIL_N->UPDATE_USER_ID, sizeof(CRASBALMIL->UPDATE_USER_ID));
    MEMCPY_DN(CRASBALMIL->UPDATE_TIME, CRASBALMIL_N->UPDATE_TIME, sizeof(CRASBALMIL->UPDATE_TIME));
