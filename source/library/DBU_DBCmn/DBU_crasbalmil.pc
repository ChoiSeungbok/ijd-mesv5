/* Del Null Function */
void DBU_del_null_crasbalmil(struct CRASBALMIL_N_TAG *CRASBALMIL_N, struct CRASBALMIL_TAG *CRASBALMIL)
{
    MEMCPY_DN(CRASBALMIL->RES_ID, CRASBALMIL_N->RES_ID, sizeof(CRASBALMIL->RES_ID));
    CRASBALMIL->HIST_SEQ = CRASBALMIL_N->HIST_SEQ;
    MEMCPY_DN(CRASBALMIL->WORK_TIME, CRASBALMIL_N->WORK_TIME, sizeof(CRASBALMIL->WORK_TIME));
