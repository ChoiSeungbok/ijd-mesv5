        case 1:
            EXEC SQL CLOSE DBU_CRASBALMIL_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_crasbalmil", sel_type);
}


/* Initialize Function */
void DBU_init_crasbalmil(struct CRASBALMIL_TAG *CRASBALMIL)
{
    /* memset by Space */
    memset(CRASBALMIL, ' ', sizeof(struct CRASBALMIL_TAG));
    
    CRASBALMIL->HIST_SEQ = 0;
	CRASBALMIL->SV_RPM = 0;
    CRASBALMIL->PV_RPM = 0;
}


/* Add Null Function */
void DBU_add_null_crasbalmil(struct CRASBALMIL_N_TAG *CRASBALMIL_N, struct CRASBALMIL_TAG *CRASBALMIL)
{
    /* memset by NULL */
    memset(CRASBALMIL_N, '\0', sizeof(struct CRASBALMIL_N_TAG));
    
    MEMCPY_AN(CRASBALMIL_N->RES_ID, CRASBALMIL->RES_ID, sizeof(CRASBALMIL->RES_ID));
    CRASBALMIL_N->HIST_SEQ = CRASBALMIL->HIST_SEQ;
    MEMCPY_AN(CRASBALMIL_N->WORK_TIME, CRASBALMIL->WORK_TIME, sizeof(CRASBALMIL->WORK_TIME));
