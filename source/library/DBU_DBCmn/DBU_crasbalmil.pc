    MEMCPY_AN(CRASBALMIL_N->PV_TIME, CRASBALMIL->PV_TIME, sizeof(CRASBALMIL->PV_TIME));
	CRASBALMIL_N->SV_RPM = CRASBALMIL->SV_RPM;
    CRASBALMIL_N->PV_RPM = CRASBALMIL->PV_RPM;
    CRASBALMIL_N->RES_STATUS[0] = CRASBALMIL->RES_STATUS;
    MEMCPY_AN(CRASBALMIL_N->START_TIME, CRASBALMIL->START_TIME, sizeof(CRASBALMIL->START_TIME));
    MEMCPY_AN(CRASBALMIL_N->END_TIME, CRASBALMIL->END_TIME, sizeof(CRASBALMIL->END_TIME));
