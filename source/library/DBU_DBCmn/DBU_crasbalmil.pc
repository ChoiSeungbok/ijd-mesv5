    MEMCPY_AN(CRASBALMIL_N->CMF_1, CRASBALMIL->CMF_1, sizeof(CRASBALMIL->CMF_1));
    MEMCPY_AN(CRASBALMIL_N->CMF_2, CRASBALMIL->CMF_2, sizeof(CRASBALMIL->CMF_2));
