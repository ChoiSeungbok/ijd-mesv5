    DB_error_code = 0;
    d_value = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MINVDLVDTL
                WHERE FACTORY = :MINVDLVDTL_N.FACTORY
                    AND DLV_NO = :MINVDLVDTL_N.DLV_NO
                    AND DLV_SEQ = :MINVDLVDTL_N.DLV_SEQ;
            break;

		case 2:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MINVDLVDTL
                WHERE FACTORY = :MINVDLVDTL_N.FACTORY
                    AND DLV_NO = :MINVDLVDTL_N.DLV_NO
					AND DELETE_FLAG <> 'Y';
            break;

		case 101:
            EXEC SQL SELECT NVL(MAX(DLV_SEQ), 0) + 1
                INTO :d_value
                FROM MINVDLVDTL
                WHERE FACTORY = :MINVDLVDTL_N.FACTORY
                    AND DLV_NO = :MINVDLVDTL_N.DLV_NO;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_select_minvdlvdtl_scalar", sel_type);

    return d_value;
}


