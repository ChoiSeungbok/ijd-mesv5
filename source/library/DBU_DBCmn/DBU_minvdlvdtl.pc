	MINVDLVDTL->PO_LINE_ID = 0;
	MINVDLVDTL->PO_RELEASE_ID = 0;
	MINVDLVDTL->LINE_LOCATION_ID = 0;
	MINVDLVDTL->PO_DISTRIBUTION_ID = 0;
