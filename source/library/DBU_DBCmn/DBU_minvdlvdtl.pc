/* SQL UPDATE Function */
void DBU_update_minvdlvdtl(int sel_type, struct MINVDLVDTL_TAG *MINVDLVDTL)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVDLVDTL_N_TAG MINVDLVDTL_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_minvdlvdtl(&MINVDLVDTL_N, MINVDLVDTL);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL UPDATE MINVDLVDTL SET
                    MAT_ID = :MINVDLVDTL_N.MAT_ID,
                    MAT_VER = :MINVDLVDTL_N.MAT_VER,
                    PO_NO = :MINVDLVDTL_N.PO_NO,
                    PO_SEQ = :MINVDLVDTL_N.PO_SEQ,
                    BL_NO = :MINVDLVDTL_N.BL_NO,
                    BL_SEQ = :MINVDLVDTL_N.BL_SEQ,
                    DLV_QTY = :MINVDLVDTL_N.DLV_QTY,
					DLV_IN_QTY = :MINVDLVDTL_N.DLV_IN_QTY,
                    CONFIRM_QTY = :MINVDLVDTL_N.CONFIRM_QTY,
					LOSS_QTY = :MINVDLVDTL_N.LOSS_QTY,
                    AREA_ID = :MINVDLVDTL_N.AREA_ID,
                    SUB_AREA_ID = :MINVDLVDTL_N.SUB_AREA_ID,
					PO_HEADER_ID = :MINVDLVDTL_N.PO_HEADER_ID,
					PO_LINE_ID = :MINVDLVDTL_N.PO_LINE_ID,
					PO_RELEASE_ID = :MINVDLVDTL_N.PO_RELEASE_ID,
					LINE_LOCATION_ID = :MINVDLVDTL_N.LINE_LOCATION_ID,
					PO_DISTRIBUTION_ID = :MINVDLVDTL_N.PO_DISTRIBUTION_ID,
					PO_TYPE = :MINVDLVDTL_N.PO_TYPE,
					INSPECTION_FLAG = :MINVDLVDTL_N.INSPECTION_FLAG,
					CONSIGNMENT_FLAG = :MINVDLVDTL_N.CONSIGNMENT_FLAG,
                    CMF_1 = :MINVDLVDTL_N.CMF_1,
                    CMF_2 = :MINVDLVDTL_N.CMF_2,
                    CMF_3 = :MINVDLVDTL_N.CMF_3,
                    CMF_4 = :MINVDLVDTL_N.CMF_4,
                    CMF_5 = :MINVDLVDTL_N.CMF_5,
                    CMF_6 = :MINVDLVDTL_N.CMF_6,
                    CMF_7 = :MINVDLVDTL_N.CMF_7,
                    CMF_8 = :MINVDLVDTL_N.CMF_8,
                    CMF_9 = :MINVDLVDTL_N.CMF_9,
                    CMF_10 = :MINVDLVDTL_N.CMF_10,
                    CREATE_USER_ID = :MINVDLVDTL_N.CREATE_USER_ID,
                    CREATE_TIME = :MINVDLVDTL_N.CREATE_TIME,
                    UPDATE_USER_ID = :MINVDLVDTL_N.UPDATE_USER_ID,
                    UPDATE_TIME = :MINVDLVDTL_N.UPDATE_TIME,
					DELETE_FLAG = :MINVDLVDTL_N.DELETE_FLAG,
					ERP_OPEN_YN = :MINVDLVDTL_N.ERP_OPEN_YN
                WHERE FACTORY = :MINVDLVDTL_N.FACTORY
                    AND DLV_NO = :MINVDLVDTL_N.DLV_NO
                    AND DLV_SEQ = :MINVDLVDTL_N.DLV_SEQ;
            break;

		case 2:
            EXEC SQL UPDATE MINVDLVDTL SET
                    CONFIRM_QTY = :MINVDLVDTL_N.CONFIRM_QTY,
                    UPDATE_USER_ID = :MINVDLVDTL_N.UPDATE_USER_ID,
                    UPDATE_TIME = :MINVDLVDTL_N.UPDATE_TIME,
					DELETE_FLAG = :MINVDLVDTL_N.DELETE_FLAG
                WHERE FACTORY = :MINVDLVDTL_N.FACTORY
                    AND DLV_NO = :MINVDLVDTL_N.DLV_NO
                    AND DLV_SEQ = :MINVDLVDTL_N.DLV_SEQ;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_update_minvdlvdtl", sel_type);
}


/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_minvdlvdtl(int sel_type, struct MINVDLVDTL_TAG *MINVDLVDTL)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVDLVDTL_N_TAG MINVDLVDTL_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_minvdlvdtl(&MINVDLVDTL_N, MINVDLVDTL);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_MINVDLVDTL_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    DLV_NO,
                    DLV_SEQ,
                    MAT_ID,
                    MAT_VER,
                    PO_NO,
                    PO_SEQ,
                    BL_NO,
                    BL_SEQ,
                    DLV_QTY,
					DLV_IN_QTY,
                    CONFIRM_QTY,
					LOSS_QTY,
                    AREA_ID,
                    SUB_AREA_ID,
					PO_HEADER_ID,
					PO_LINE_ID,
					PO_RELEASE_ID,
					LINE_LOCATION_ID,
					PO_DISTRIBUTION_ID,
					PO_TYPE,
					INSPECTION_FLAG,
					CONSIGNMENT_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME,
					DELETE_FLAG,
					ERP_OPEN_YN
                FROM MINVDLVDTL
                ORDER BY FACTORY ASC,
                    DLV_NO ASC,
                    DLV_SEQ ASC;
            EXEC SQL OPEN DBU_MINVDLVDTL_CUR_1;
            break;

		case 2:
            EXEC SQL DECLARE DBU_MINVDLVDTL_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    DLV_NO,
                    DLV_SEQ,
                    MAT_ID,
                    MAT_VER,
                    PO_NO,
                    PO_SEQ,
                    BL_NO,
                    BL_SEQ,
                    DLV_QTY,
					DLV_IN_QTY,
                    CONFIRM_QTY,
					LOSS_QTY,
                    AREA_ID,
                    SUB_AREA_ID,
					PO_HEADER_ID,
					PO_LINE_ID,
					PO_RELEASE_ID,
					LINE_LOCATION_ID,
					PO_DISTRIBUTION_ID,
					PO_TYPE,
					INSPECTION_FLAG,
					CONSIGNMENT_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME,
					DELETE_FLAG,
					ERP_OPEN_YN
                FROM MINVDLVDTL
				WHERE FACTORY = :MINVDLVDTL_N.FACTORY
				 AND DLV_NO = :MINVDLVDTL_N.DLV_NO
                ORDER BY FACTORY ASC,
                    DLV_NO ASC,
                    DLV_SEQ ASC;
            EXEC SQL OPEN DBU_MINVDLVDTL_CUR_2;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_minvdlvdtl", sel_type);
}


