    memset(MINVDLVDTL, ' ', sizeof(struct MINVDLVDTL_TAG));
    MINVDLVDTL->DLV_SEQ = 0;
    MINVDLVDTL->MAT_VER = 0;
    MINVDLVDTL->PO_SEQ = 0;
    MINVDLVDTL->BL_SEQ = 0;
    MINVDLVDTL->DLV_QTY = 0;
