/* Add Null Function */
void DBU_add_null_minvdlvdtl(struct MINVDLVDTL_N_TAG *MINVDLVDTL_N, struct MINVDLVDTL_TAG *MINVDLVDTL)
{
    /* memset by NULL */
    memset(MINVDLVDTL_N, '\0', sizeof(struct MINVDLVDTL_N_TAG));
    
    MEMCPY_AN(MINVDLVDTL_N->FACTORY, MINVDLVDTL->FACTORY, sizeof(MINVDLVDTL->FACTORY));
    MEMCPY_AN(MINVDLVDTL_N->DLV_NO, MINVDLVDTL->DLV_NO, sizeof(MINVDLVDTL->DLV_NO));
    MINVDLVDTL_N->DLV_SEQ = MINVDLVDTL->DLV_SEQ;
