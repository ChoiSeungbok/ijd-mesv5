         );

    DB_stop_query_timer("DBU_insert_cqcmispsts", 0);
}


/* SQL UPDATE Function */
void DBU_update_cqcmispsts(int sel_type, struct CQCMISPSTS_TAG *CQCMISPSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CQCMISPSTS_N_TAG CQCMISPSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cqcmispsts(&CQCMISPSTS_N, CQCMISPSTS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL UPDATE CQCMISPSTS SET
                    INSP_TYPE = :CQCMISPSTS_N.INSP_TYPE,
                    INSP_REQ_TIME = :CQCMISPSTS_N.INSP_REQ_TIME,
                    INSP_STATUS = :CQCMISPSTS_N.INSP_STATUS,
                    INSP_JUDGE_FLAG = :CQCMISPSTS_N.INSP_JUDGE_FLAG,
                    INSP_JUDGE_TYPE = :CQCMISPSTS_N.INSP_JUDGE_TYPE,
                    INSP_JUDGE_TIME = :CQCMISPSTS_N.INSP_JUDGE_TIME,
                    INSP_OPER = :CQCMISPSTS_N.INSP_OPER,
                    COL_SET_ID = :CQCMISPSTS_N.COL_SET_ID,
                    COL_SET_VERSION = :CQCMISPSTS_N.COL_SET_VERSION,
                    LOT_ID = :CQCMISPSTS_N.LOT_ID,
                    MAT_ID = :CQCMISPSTS_N.MAT_ID,
                    MAT_VER = :CQCMISPSTS_N.MAT_VER,
                    QTY = :CQCMISPSTS_N.QTY,
                    RWK_FLOW = :CQCMISPSTS_N.RWK_FLOW,
                    RWK_OPER = :CQCMISPSTS_N.RWK_OPER,
                    INSP_COMMENT = :CQCMISPSTS_N.INSP_COMMENT,
                    AREA_ID = :CQCMISPSTS_N.AREA_ID,
                    SUB_AREA_ID = :CQCMISPSTS_N.SUB_AREA_ID,
                    CMF_1 = :CQCMISPSTS_N.CMF_1,
                    CMF_2 = :CQCMISPSTS_N.CMF_2,
                    CMF_3 = :CQCMISPSTS_N.CMF_3,
                    CMF_4 = :CQCMISPSTS_N.CMF_4,
                    CMF_5 = :CQCMISPSTS_N.CMF_5,
                    CMF_6 = :CQCMISPSTS_N.CMF_6,
                    CMF_7 = :CQCMISPSTS_N.CMF_7,
                    CMF_8 = :CQCMISPSTS_N.CMF_8,
                    CMF_9 = :CQCMISPSTS_N.CMF_9,
                    CMF_10 = :CQCMISPSTS_N.CMF_10,
                    CREATE_USER_ID = :CQCMISPSTS_N.CREATE_USER_ID,
                    CREATE_TIME = :CQCMISPSTS_N.CREATE_TIME,
                    UPDATE_USER_ID = :CQCMISPSTS_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CQCMISPSTS_N.UPDATE_TIME
                WHERE FACTORY = :CQCMISPSTS_N.FACTORY
                    AND INSP_ID = :CQCMISPSTS_N.INSP_ID;
            break;

		case 2:
            EXEC SQL UPDATE CQCMISPSTS SET
                    INSP_STATUS = :CQCMISPSTS_N.INSP_STATUS,
                    INSP_JUDGE_FLAG = :CQCMISPSTS_N.INSP_JUDGE_FLAG,
                    INSP_JUDGE_TIME = :CQCMISPSTS_N.INSP_JUDGE_TIME,
					COL_SET_ID = :CQCMISPSTS_N.COL_SET_ID,
					COL_SET_VERSION = :CQCMISPSTS_N.COL_SET_VERSION,
					RWK_FLOW = :CQCMISPSTS_N.RWK_FLOW,
                    RWK_OPER = :CQCMISPSTS_N.RWK_OPER,
                    CMF_4 = :CQCMISPSTS_N.CMF_4,
					CMF_5 = :CQCMISPSTS_N.CMF_5,
					CMF_6 = :CQCMISPSTS_N.CMF_6,
					CMF_7 = :CQCMISPSTS_N.CMF_7,
					CMF_8 = :CQCMISPSTS_N.CMF_8,
					CMF_9 = :CQCMISPSTS_N.CMF_9,
					CMF_10 = :CQCMISPSTS_N.CMF_10,
					INSP_COMMENT = :CQCMISPSTS_N.INSP_COMMENT,
                    UPDATE_USER_ID = :CQCMISPSTS_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CQCMISPSTS_N.UPDATE_TIME
                WHERE FACTORY = :CQCMISPSTS_N.FACTORY
                    AND INSP_ID = :CQCMISPSTS_N.INSP_ID;
            break;

		case 3:
            EXEC SQL UPDATE CQCMISPSTS A
							   SET INSP_STATUS = :CQCMISPSTS_N.INSP_STATUS
							 WHERE A.FACTORY = :CQCMISPSTS_N.FACTORY
							   AND A.LOT_ID = :CQCMISPSTS_N.LOT_ID
							   AND A.INSP_STATUS IN (SELECT KEY_1 FROM MGCMTBLDAT
							                                       WHERE FACTORY = :CQCMISPSTS_N.FACTORY
																      AND TABLE_NAME = 'C_INSP_STATUS'
																	  AND DATA_2 = 'N' );
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_update_cqcmispsts", sel_type);
}


/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cqcmispsts(int sel_type, struct CQCMISPSTS_TAG *CQCMISPSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CQCMISPSTS_N_TAG CQCMISPSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cqcmispsts(&CQCMISPSTS_N, CQCMISPSTS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CQCMISPSTS_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    INSP_ID,
                    INSP_TYPE,
                    INSP_REQ_TIME,
                    INSP_STATUS,
                    INSP_JUDGE_FLAG,
                    INSP_JUDGE_TYPE,
                    INSP_JUDGE_TIME,
                    INSP_OPER,
                    COL_SET_ID,
                    COL_SET_VERSION,
                    LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    RWK_FLOW,
                    RWK_OPER,
                    INSP_COMMENT,
                    AREA_ID,
                    SUB_AREA_ID,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CQCMISPSTS
                ORDER BY FACTORY ASC,
                    INSP_ID ASC;
            EXEC SQL OPEN DBU_CQCMISPSTS_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cqcmispsts", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_cqcmispsts(int sel_type, struct CQCMISPSTS_TAG *CQCMISPSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CQCMISPSTS_N_TAG CQCMISPSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_CQCMISPSTS_CUR_1 INTO
                :CQCMISPSTS_N.FACTORY,
                :CQCMISPSTS_N.INSP_ID,
                :CQCMISPSTS_N.INSP_TYPE,
                :CQCMISPSTS_N.INSP_REQ_TIME,
                :CQCMISPSTS_N.INSP_STATUS,
                :CQCMISPSTS_N.INSP_JUDGE_FLAG,
                :CQCMISPSTS_N.INSP_JUDGE_TYPE,
                :CQCMISPSTS_N.INSP_JUDGE_TIME,
                :CQCMISPSTS_N.INSP_OPER,
                :CQCMISPSTS_N.COL_SET_ID,
                :CQCMISPSTS_N.COL_SET_VERSION,
                :CQCMISPSTS_N.LOT_ID,
                :CQCMISPSTS_N.MAT_ID,
                :CQCMISPSTS_N.MAT_VER,
                :CQCMISPSTS_N.QTY,
                :CQCMISPSTS_N.RWK_FLOW,
                :CQCMISPSTS_N.RWK_OPER,
                :CQCMISPSTS_N.INSP_COMMENT,
                :CQCMISPSTS_N.AREA_ID,
                :CQCMISPSTS_N.SUB_AREA_ID,
                :CQCMISPSTS_N.CMF_1,
                :CQCMISPSTS_N.CMF_2,
                :CQCMISPSTS_N.CMF_3,
                :CQCMISPSTS_N.CMF_4,
                :CQCMISPSTS_N.CMF_5,
                :CQCMISPSTS_N.CMF_6,
                :CQCMISPSTS_N.CMF_7,
                :CQCMISPSTS_N.CMF_8,
                :CQCMISPSTS_N.CMF_9,
                :CQCMISPSTS_N.CMF_10,
                :CQCMISPSTS_N.CREATE_USER_ID,
                :CQCMISPSTS_N.CREATE_TIME,
                :CQCMISPSTS_N.UPDATE_USER_ID,
                :CQCMISPSTS_N.UPDATE_TIME;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_cqcmispsts(&CQCMISPSTS_N, CQCMISPSTS);
    }

    DB_stop_query_timer("DBU_fetch_cqcmispsts", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_cqcmispsts(int sel_type)
{
    DB_start_query_timer();
