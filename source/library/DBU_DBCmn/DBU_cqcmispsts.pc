    DBU_add_null_cqcmispsts(&CQCMISPSTS_N, CQCMISPSTS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DELETE FROM CQCMISPSTS
                WHERE FACTORY = :CQCMISPSTS_N.FACTORY
                    AND INSP_ID = :CQCMISPSTS_N.INSP_ID;
            break;

       case 2:
            EXEC SQL DELETE FROM CQCMISPSTS
                WHERE FACTORY = :CQCMISPSTS_N.FACTORY
                    AND LOT_ID = :CQCMISPSTS_N.LOT_ID;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_delete_cqcmispsts", sel_type);
}


/* SQL INSERT Function */
void DBU_insert_cqcmispsts(struct CQCMISPSTS_TAG *CQCMISPSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CQCMISPSTS_N_TAG CQCMISPSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cqcmispsts(&CQCMISPSTS_N, CQCMISPSTS);
    DB_error_code = 0;


    EXEC SQL INSERT INTO CQCMISPSTS( 
                    FACTORY, 
                    INSP_ID, 
                    INSP_TYPE, 
                    INSP_REQ_TIME, 
                    INSP_STATUS, 
                    INSP_JUDGE_FLAG, 
                    INSP_JUDGE_TYPE, 
