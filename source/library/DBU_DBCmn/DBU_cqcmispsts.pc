/* SQL SELECT_SCALAR Function */
double DBU_select_cqcmispsts_scalar(int sel_type, struct CQCMISPSTS_TAG *CQCMISPSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CQCMISPSTS_N_TAG CQCMISPSTS_N;
        double d_value;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cqcmispsts(&CQCMISPSTS_N, CQCMISPSTS);
    DB_error_code = 0;
    d_value = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CQCMISPSTS
                WHERE FACTORY = :CQCMISPSTS_N.FACTORY
                    AND INSP_ID = :CQCMISPSTS_N.INSP_ID;
            break;

		case 2:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CQCMISPSTS
                WHERE FACTORY = :CQCMISPSTS_N.FACTORY
                    AND LOT_ID = :CQCMISPSTS_N.LOT_ID
					AND INSP_STATUS IN ('Q','R');
            break;

		case 3:
            EXEC SQL SELECT count(*)
				INTO :d_value
				FROM CQCMISPSTS A , MGCMTBLDAT B
				WHERE A.FACTORY = B.FACTORY
					AND B.TABLE_NAME = 'C_INSP_STATUS'
					AND A.INSP_STATUS = B.KEY_1
					AND B.DATA_2 = 'N'
					AND A.FACTORY = :CQCMISPSTS_N.FACTORY
					AND A.LOT_ID = :CQCMISPSTS_N.LOT_ID;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_select_cqcmispsts_scalar", sel_type);

    return d_value;
}


