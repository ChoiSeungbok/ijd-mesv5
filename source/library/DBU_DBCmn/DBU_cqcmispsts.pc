/* Initialize Function */
void DBU_init_cqcmispsts(struct CQCMISPSTS_TAG *CQCMISPSTS)
{
    /* memset by Space */
    memset(CQCMISPSTS, ' ', sizeof(struct CQCMISPSTS_TAG));
    
    CQCMISPSTS->COL_SET_VERSION = 0;
    CQCMISPSTS->MAT_VER = 0;
    CQCMISPSTS->QTY = 0;
}


/* Add Null Function */
void DBU_add_null_cqcmispsts(struct CQCMISPSTS_N_TAG *CQCMISPSTS_N, struct CQCMISPSTS_TAG *CQCMISPSTS)
{
    /* memset by NULL */
    memset(CQCMISPSTS_N, '\0', sizeof(struct CQCMISPSTS_N_TAG));
    
    MEMCPY_AN(CQCMISPSTS_N->FACTORY, CQCMISPSTS->FACTORY, sizeof(CQCMISPSTS->FACTORY));
    MEMCPY_AN(CQCMISPSTS_N->INSP_ID, CQCMISPSTS->INSP_ID, sizeof(CQCMISPSTS->INSP_ID));
