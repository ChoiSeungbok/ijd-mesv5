                FROM MWIPLOTSTS
                 WHERE FACTORY = :MWIPLOTSTSX_N.FACTORY
                 AND ORDER_ID = :MWIPLOTSTSX_N.ORDER_ID
                 AND LOT_DEL_FLAG = ' '
                 AND ROWNUM = 1;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_mwiplotstsx(&MWIPLOTSTSX_N, MWIPLOTSTSX);
    }

    DB_stop_query_timer("DBU_select_mwiplotstsx", sel_type);
}


