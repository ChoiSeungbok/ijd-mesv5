/* SQL UPDATE Function */
void DBU_update_mwiplotstsx(int sel_type, struct MWIPLOTSTSX_TAG *MWIPLOTSTSX)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MWIPLOTSTSX_N_TAG MWIPLOTSTSX_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_mwiplotstsx(&MWIPLOTSTSX_N, MWIPLOTSTSX);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL UPDATE MWIPLOTSTS SET
                    LOT_DESC = :MWIPLOTSTSX_N.LOT_DESC,
                    FACTORY = :MWIPLOTSTSX_N.FACTORY,
