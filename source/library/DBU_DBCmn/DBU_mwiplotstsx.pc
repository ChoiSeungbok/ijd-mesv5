/* SQL CURSOR FETCH Function */
void DBU_fetch_mwiplotstsx(int sel_type, struct MWIPLOTSTSX_TAG *MWIPLOTSTSX)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MWIPLOTSTSX_N_TAG MWIPLOTSTSX_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_MWIPLOTSTSX_CUR_1 INTO
                :MWIPLOTSTSX_N.LOT_ID,
                :MWIPLOTSTSX_N.LOT_DESC,
                :MWIPLOTSTSX_N.FACTORY,
                :MWIPLOTSTSX_N.MAT_ID,
