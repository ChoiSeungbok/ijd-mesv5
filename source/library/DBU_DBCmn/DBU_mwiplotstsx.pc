        case 3:
            EXEC SQL SELECT CASE WHEN MAX(LOT_ID) IS NULL THEN :MWIPLOTSTSX_N.LOT_ID || '-01'
                ELSE SUBSTR(MAX(LOT_ID), 0, LENGTH(MAX(LOT_ID)) - 2) || LPAD(TO_NUMBER(SUBSTR(MAX(LOT_ID), LENGTH(MAX(LOT_ID)) - 1, 2)) + 1, 2, 0)
                END AS LOT_ID
                INTO
                  :MWIPLOTSTSX_N.LOT_ID
                FROM MWIPLOTSTS
                WHERE LOT_ID LIKE :MWIPLOTSTSX_N.LOT_ID || '-%';
            break;

