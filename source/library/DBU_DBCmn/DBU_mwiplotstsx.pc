    MWIPLOTSTSX->BATCH_SEQ = 0;
    MWIPLOTSTSX->BOM_SET_VERSION = 0;
    MWIPLOTSTSX->BOM_ACTIVE_HIST_SEQ = 0;
    MWIPLOTSTSX->BOM_HIST_SEQ = 0;
    MWIPLOTSTSX->LAST_ACTIVE_HIST_SEQ = 0;
    MWIPLOTSTSX->LAST_HIST_SEQ = 0;
    MWIPLOTSTSX->YIELD_1 = 0;
    MWIPLOTSTSX->YIELD_2 = 0;
    MWIPLOTSTSX->YIELD_3 = 0;
    MWIPLOTSTSX->GOOD_QTY = 0;
}


