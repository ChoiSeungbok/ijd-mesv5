                    HM_CMF_20 = :MWIPLOTSTSX_N.HM_CMF_20,
                    GRT_CMF_1 = :MWIPLOTSTSX_N.GRT_CMF_1,
                    GRT_CMF_2 = :MWIPLOTSTSX_N.GRT_CMF_2,
                    GRT_CMF_3 = :MWIPLOTSTSX_N.GRT_CMF_3,
                    GRT_CMF_4 = :MWIPLOTSTSX_N.GRT_CMF_4,
                    GRT_CMF_5 = :MWIPLOTSTSX_N.GRT_CMF_5,
                    GRT_CMF_6 = :MWIPLOTSTSX_N.GRT_CMF_6,
                    GRT_CMF_7 = :MWIPLOTSTSX_N.GRT_CMF_7,
                    GRT_CMF_8 = :MWIPLOTSTSX_N.GRT_CMF_8,
                    GRT_CMF_9 = :MWIPLOTSTSX_N.GRT_CMF_9,
                    GRT_CMF_10 = :MWIPLOTSTSX_N.GRT_CMF_10,
                    GRT_CMF_11 = :MWIPLOTSTSX_N.GRT_CMF_11,
                    GRT_CMF_12 = :MWIPLOTSTSX_N.GRT_CMF_12,
                    GRT_CMF_13 = :MWIPLOTSTSX_N.GRT_CMF_13,
                    GRT_CMF_14 = :MWIPLOTSTSX_N.GRT_CMF_14,
                    GRT_CMF_15 = :MWIPLOTSTSX_N.GRT_CMF_15,
                    GRT_CMF_16 = :MWIPLOTSTSX_N.GRT_CMF_16,
                    GRT_CMF_17 = :MWIPLOTSTSX_N.GRT_CMF_17,
                    GRT_CMF_18 = :MWIPLOTSTSX_N.GRT_CMF_18,
                    GRT_CMF_19 = :MWIPLOTSTSX_N.GRT_CMF_19,
                    GRT_CMF_20 = :MWIPLOTSTSX_N.GRT_CMF_20
                WHERE LOT_ID = :MWIPLOTSTSX_N.LOT_ID;
            break;

		case 2:
            EXEC SQL UPDATE MWIPLOTSTS SET
                    LOT_CMF_10 = :MWIPLOTSTSX_N.LOT_CMF_10,
                    LOT_CMF_11 = :MWIPLOTSTSX_N.LOT_CMF_11
                WHERE LOT_ID = :MWIPLOTSTSX_N.LOT_ID;
            break;

        case 3:
            EXEC SQL UPDATE MWIPLOTSTS SET
                       FLOW = :MWIPLOTSTSX_N.FLOW
                WHERE ORDER_ID = :MWIPLOTSTSX_N.ORDER_ID;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_update_mwiplotstsx", sel_type);
}


