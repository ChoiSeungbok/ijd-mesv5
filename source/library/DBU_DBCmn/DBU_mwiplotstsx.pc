/* SQL CURSOR CLOSE Function */
void DBU_close_mwiplotstsx(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_MWIPLOTSTSX_CUR_1;
            break;

        case 2:
            EXEC SQL CLOSE DBU_MWIPLOTSTSX_CUR_2;
            break;

        case 3:
            EXEC SQL CLOSE DBU_MWIPLOTSTSX_CUR_3;
            break;

        case 4:
            EXEC SQL CLOSE DBU_MWIPLOTSTSX_CUR_4;
            break;

        case 5:
            EXEC SQL CLOSE DBU_MWIPLOTSTSX_CUR_5;
            break;

        case 6:
            EXEC SQL CLOSE DBU_MWIPLOTSTSX_CUR_6;
            break;

		case 7:
            EXEC SQL CLOSE DBU_MWIPLOTSTSX_CUR_7;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_mwiplotstsx", sel_type);
}


/* Initialize Function */
void DBU_init_mwiplotstsx(struct MWIPLOTSTSX_TAG *MWIPLOTSTSX)
{
    /* memset by Space */
    memset(MWIPLOTSTSX, ' ', sizeof(struct MWIPLOTSTSX_TAG));
    
    MWIPLOTSTSX->MAT_VER = 0;
    MWIPLOTSTSX->FLOW_SEQ_NUM = 0;
    MWIPLOTSTSX->QTY_1 = 0;
