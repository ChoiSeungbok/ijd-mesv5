                FROM MWIPLOTSTS
                WHERE LOT_ID = :MWIPLOTSTSX_N.LOT_ID
                FOR UPDATE;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_mwiplotstsx(&MWIPLOTSTSX_N, MWIPLOTSTSX);
    }

    DB_stop_query_timer("DBU_select_mwiplotstsx_for_update", sel_type);
}


/* SQL SELECT_SCALAR Function */
double DBU_select_mwiplotstsx_scalar(int sel_type, struct MWIPLOTSTSX_TAG *MWIPLOTSTSX)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MWIPLOTSTSX_N_TAG MWIPLOTSTSX_N;
        double d_value;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_mwiplotstsx(&MWIPLOTSTSX_N, MWIPLOTSTSX);
    DB_error_code = 0;
    d_value = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MWIPLOTSTS
                WHERE LOT_ID = :MWIPLOTSTSX_N.LOT_ID;
            break;

		case 2:
            EXEC SQL SELECT SUM(LOT.QTY_1) 
                INTO :d_value
                FROM MWIPLOTSTS LOT, MWIPOPRDEF OPR
                WHERE 1=1
                AND LOT.FACTORY = OPR.FACTORY
                AND LOT.OPER = OPR.OPER
                AND LOT.FACTORY = :MWIPLOTSTSX_N.FACTORY
                AND LOT.MAT_ID = :MWIPLOTSTSX_N.MAT_ID
				AND LOT.MAT_VER = :MWIPLOTSTSX_N.MAT_VER
				AND OPR.OPER_GRP_1 = 'PROD';
            break;

        case 3:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MWIPLOTSTS
                WHERE START_RES_ID = :MWIPLOTSTSX_N.START_RES_ID
                  AND LOT_DEL_FLAG  = ' ';

        case 4:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MWIPLOTSTS
                WHERE ORDER_ID = :MWIPLOTSTSX_N.ORDER_ID;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_select_mwiplotstsx_scalar", sel_type);

    return d_value;
}


/* SQL DELETE Function */
void DBU_delete_mwiplotstsx(int sel_type, struct MWIPLOTSTSX_TAG *MWIPLOTSTSX)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MWIPLOTSTSX_N_TAG MWIPLOTSTSX_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_mwiplotstsx(&MWIPLOTSTSX_N, MWIPLOTSTSX);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DELETE FROM MWIPLOTSTS
                WHERE LOT_ID = :MWIPLOTSTSX_N.LOT_ID;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_delete_mwiplotstsx", sel_type);
}


