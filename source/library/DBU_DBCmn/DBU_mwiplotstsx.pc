    MWIPLOTSTSX->CREATE_QTY_3 = 0;
    MWIPLOTSTSX->START_QTY_1 = 0;
    MWIPLOTSTSX->START_QTY_2 = 0;
    MWIPLOTSTSX->START_QTY_3 = 0;
    MWIPLOTSTSX->RWK_COUNT = 0;
    MWIPLOTSTSX->RWK_RET_FLOW_SEQ_NUM = 0;
    MWIPLOTSTSX->RWK_END_FLOW_SEQ_NUM = 0;
