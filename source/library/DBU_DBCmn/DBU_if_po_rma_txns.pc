                :IF_PO_RMA_TXNS_N.LOT_ID,
				:IF_PO_RMA_TXNS_N.MES_ID,
                :IF_PO_RMA_TXNS_N.ERP_AREA_ID,
                :IF_PO_RMA_TXNS_N.AREA_ID,
                :IF_PO_RMA_TXNS_N.SRC_IF_SEQ,
