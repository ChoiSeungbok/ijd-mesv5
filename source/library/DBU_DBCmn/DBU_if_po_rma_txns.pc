                :IF_PO_RMA_TXNS_N.CMF_2,
                :IF_PO_RMA_TXNS_N.CMF_3,
                :IF_PO_RMA_TXNS_N.CMF_4,
                :IF_PO_RMA_TXNS_N.CMF_5,
                :IF_PO_RMA_TXNS_N.CMF_6,
                :IF_PO_RMA_TXNS_N.CMF_7,
                :IF_PO_RMA_TXNS_N.CMF_8,
                :IF_PO_RMA_TXNS_N.CMF_9,
                :IF_PO_RMA_TXNS_N.CMF_10,
                :IF_PO_RMA_TXNS_N.CREATE_USER_ID,
                :IF_PO_RMA_TXNS_N.CREATE_TIME,
                :IF_PO_RMA_TXNS_N.UPDATE_USER_ID,
                :IF_PO_RMA_TXNS_N.UPDATE_TIME;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_if_po_rma_txns(&IF_PO_RMA_TXNS_N, IF_PO_RMA_TXNS);
    }

    DB_stop_query_timer("DBU_fetch_if_po_rma_txns", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_if_po_rma_txns(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_IF_PO_RMA_TXNS_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_if_po_rma_txns", sel_type);
}


