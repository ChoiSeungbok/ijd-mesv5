        struct CWIPWRKGRP_N_TAG CWIPWRKGRP_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cwipwrkgrp(&CWIPWRKGRP_N, CWIPWRKGRP);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CWIPWRKGRP_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    GROUP_ID,
                    WORKER_ID,
					WORK_TYPE,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPWRKGRP
                ORDER BY FACTORY ASC,
                    AREA_ID ASC,
                    SUB_AREA_ID ASC,
                    OPER ASC,
                    GROUP_ID ASC,
                    WORKER_ID ASC;
            EXEC SQL OPEN DBU_CWIPWRKGRP_CUR_1;
            break;

		case 2:
            EXEC SQL DECLARE DBU_CWIPWRKGRP_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    GROUP_ID,
                    WORKER_ID,
					WORK_TYPE,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPWRKGRP
				WHERE FACTORY = :CWIPWRKGRP_N.FACTORY
				 AND AREA_ID = :CWIPWRKGRP_N.AREA_ID
				 AND SUB_AREA_ID = :CWIPWRKGRP_N.SUB_AREA_ID
				 AND OPER = :CWIPWRKGRP_N.OPER
				 AND ((:CWIPWRKGRP_N.GROUP_ID = ' ') OR (GROUP_ID = :CWIPWRKGRP_N.GROUP_ID))
                ORDER BY FACTORY ASC,
                    AREA_ID ASC,
                    SUB_AREA_ID ASC,
                    OPER ASC,
                    GROUP_ID ASC,
                    WORKER_ID ASC;
            EXEC SQL OPEN DBU_CWIPWRKGRP_CUR_2;
            break;

		case 3:
            EXEC SQL DECLARE DBU_CWIPWRKGRP_CUR_3 CURSOR FOR
                SELECT 
                    A.FACTORY,
                    A.WORKER_ID,
					B.WORKER_DESC WORK_TYPE
                FROM CWIPWRKGRP A, CWIPWRKDEF B
				WHERE A.FACTORY = B.FACTORY
				 AND A.WORKER_ID = B.WORKER_ID
				 AND A.FACTORY = :CWIPWRKGRP_N.FACTORY
				 AND ((:CWIPWRKGRP_N.AREA_ID = ' ') OR (A.AREA_ID = :CWIPWRKGRP_N.AREA_ID))
				 AND ((:CWIPWRKGRP_N.SUB_AREA_ID = ' ') OR (A.SUB_AREA_ID = :CWIPWRKGRP_N.SUB_AREA_ID))
				 AND ((:CWIPWRKGRP_N.OPER = ' ') OR (A.OPER = :CWIPWRKGRP_N.OPER))
				 AND ((:CWIPWRKGRP_N.GROUP_ID = ' ') OR (A.GROUP_ID = :CWIPWRKGRP_N.GROUP_ID))
                GROUP BY A.FACTORY, A.WORKER_ID, B.WORKER_DESC
				ORDER BY A.WORKER_ID;
            EXEC SQL OPEN DBU_CWIPWRKGRP_CUR_3;
			break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

