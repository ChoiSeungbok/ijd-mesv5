/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cwippryer(int sel_type, struct CWIPPRYER_TAG *CWIPPRYER)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CWIPPRYER_N_TAG CWIPPRYER_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cwippryer(&CWIPPRYER_N, CWIPPRYER);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CWIPPRYER_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    STD_YEAR,
                    STD_TYPE,
                    STD_TYPE_DESC,
                    AREA_ID,
                    QTR_01,
                    QTR_02,
                    QTR_03,
                    QTR_04,
                    MTH_01,
                    MTH_02,
                    MTH_03,
                    MTH_04,
                    MTH_05,
                    MTH_06,
                    MTH_07,
                    MTH_08,
                    MTH_09,
                    MTH_10,
                    MTH_11,
