                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CMF_11,
                    CMF_12,
                    REMARK,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPPRYER
                ORDER BY FACTORY ASC,
                    STD_YEAR ASC,
                    STD_TYPE ASC,
                    AREA_ID ASC;
            EXEC SQL OPEN DBU_CWIPPRYER_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
