    MEMCPY_DN(CRASMDEXTD->CREATE_TIME, CRASMDEXTD_N->CREATE_TIME, sizeof(CRASMDEXTD->CREATE_TIME));
    MEMCPY_DN(CRASMDEXTD->UPDATE_USER_ID, CRASMDEXTD_N->UPDATE_USER_ID, sizeof(CRASMDEXTD->UPDATE_USER_ID));
    MEMCPY_DN(CRASMDEXTD->UPDATE_TIME, CRASMDEXTD_N->UPDATE_TIME, sizeof(CRASMDEXTD->UPDATE_TIME));
	CRASMDEXTD_N->SV_TEMP = CRASMDEXTD->SV_TEMP;
    CRASMDEXTD_N->PV_TEMP = CRASMDEXTD->PV_TEMP;
