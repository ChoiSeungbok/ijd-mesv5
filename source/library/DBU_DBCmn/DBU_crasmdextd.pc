    MEMCPY_DN(CRASMDEXTD->CMF_6, CRASMDEXTD_N->CMF_6, sizeof(CRASMDEXTD->CMF_6));
    MEMCPY_DN(CRASMDEXTD->CMF_7, CRASMDEXTD_N->CMF_7, sizeof(CRASMDEXTD->CMF_7));
    MEMCPY_DN(CRASMDEXTD->CMF_8, CRASMDEXTD_N->CMF_8, sizeof(CRASMDEXTD->CMF_8));
