    MEMCPY_AN(CRASMDEXTD_N->CREATE_TIME, CRASMDEXTD->CREATE_TIME, sizeof(CRASMDEXTD->CREATE_TIME));
    MEMCPY_AN(CRASMDEXTD_N->UPDATE_USER_ID, CRASMDEXTD->UPDATE_USER_ID, sizeof(CRASMDEXTD->UPDATE_USER_ID));
    MEMCPY_AN(CRASMDEXTD_N->UPDATE_TIME, CRASMDEXTD->UPDATE_TIME, sizeof(CRASMDEXTD->UPDATE_TIME));
	CRASMDEXTD_N->SV_TEMP = CRASMDEXTD->SV_TEMP;
    CRASMDEXTD_N->PV_TEMP = CRASMDEXTD->PV_TEMP;
}


/* Del Null Function */
void DBU_del_null_crasmdextd(struct CRASMDEXTD_N_TAG *CRASMDEXTD_N, struct CRASMDEXTD_TAG *CRASMDEXTD)
{
    MEMCPY_DN(CRASMDEXTD->RES_ID, CRASMDEXTD_N->RES_ID, sizeof(CRASMDEXTD->RES_ID));
