            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_if_p_wo_info(&IF_P_WO_INFO_N, IF_P_WO_INFO);
    }

    DB_stop_query_timer("DBU_fetch_if_p_wo_info", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_if_p_wo_info(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_IF_P_WO_INFO_CUR_1;
            break;

		case 101:
            EXEC SQL CLOSE DBU_IF_P_WO_INFO_CUR_101;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_if_p_wo_info", sel_type);
}


/* Initialize Function */
void DBU_init_if_p_wo_info(struct IF_P_WO_INFO_TAG *IF_P_WO_INFO)
{
    /* memset by Space */
    memset(IF_P_WO_INFO, ' ', sizeof(struct IF_P_WO_INFO_TAG));
    
    IF_P_WO_INFO->IF_SEQ = 0;
    IF_P_WO_INFO->ORG_ID = 0;
    IF_P_WO_INFO->WIP_ENTITY_ID = 0;
    IF_P_WO_INFO->ITEM_ID = 0;
    IF_P_WO_INFO->REMAIN_QTY = 0;
    IF_P_WO_INFO->IF_GROUP_ID = 0;
}


