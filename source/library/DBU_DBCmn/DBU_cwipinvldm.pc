                 AND ORDER_ID = :CWIPINVLDM_N.ORDER_ID
               ORDER BY MAT_ID, TRAN_TIME, INV_LOT_ID;
            EXEC SQL OPEN DBU_CWIPINVLDM_CUR_3;
