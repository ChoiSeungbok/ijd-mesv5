    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cwipinvldm(&CWIPINVLDM_N, CWIPINVLDM);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CWIPINVLDM_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
