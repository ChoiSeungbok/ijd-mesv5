    MEMCPY_AN(CQCMGRTASP_N->SPEC_VAL, CQCMGRTASP->SPEC_VAL, sizeof(CQCMGRTASP->SPEC_VAL));
    CQCMGRTASP_N->VAL_1 = CQCMGRTASP->VAL_1;
    CQCMGRTASP_N->VAL_2 = CQCMGRTASP->VAL_2;
    CQCMGRTASP_N->VAL_3 = CQCMGRTASP->VAL_3;
