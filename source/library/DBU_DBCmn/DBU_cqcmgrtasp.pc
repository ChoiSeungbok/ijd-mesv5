    MEMCPY_DN(CQCMGRTASP->CREATE_USER_ID, CQCMGRTASP_N->CREATE_USER_ID, sizeof(CQCMGRTASP->CREATE_USER_ID));
    MEMCPY_DN(CQCMGRTASP->CREATE_TIME, CQCMGRTASP_N->CREATE_TIME, sizeof(CQCMGRTASP->CREATE_TIME));
    MEMCPY_DN(CQCMGRTASP->UPDATE_USER_ID, CQCMGRTASP_N->UPDATE_USER_ID, sizeof(CQCMGRTASP->UPDATE_USER_ID));
    MEMCPY_DN(CQCMGRTASP->UPDATE_TIME, CQCMGRTASP_N->UPDATE_TIME, sizeof(CQCMGRTASP->UPDATE_TIME));
}


