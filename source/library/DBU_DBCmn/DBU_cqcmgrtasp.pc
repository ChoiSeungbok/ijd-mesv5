    MEMCPY_AN(CQCMGRTASP_N->CREATE_TIME, CQCMGRTASP->CREATE_TIME, sizeof(CQCMGRTASP->CREATE_TIME));
    MEMCPY_AN(CQCMGRTASP_N->UPDATE_USER_ID, CQCMGRTASP->UPDATE_USER_ID, sizeof(CQCMGRTASP->UPDATE_USER_ID));
    MEMCPY_AN(CQCMGRTASP_N->UPDATE_TIME, CQCMGRTASP->UPDATE_TIME, sizeof(CQCMGRTASP->UPDATE_TIME));
}


