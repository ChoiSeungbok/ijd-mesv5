    MEMCPY_DN(CRASRPRSTS->ACTION_START_TIME, CRASRPRSTS_N->ACTION_START_TIME, sizeof(CRASRPRSTS->ACTION_START_TIME));
    MEMCPY_DN(CRASRPRSTS->ACTION_END_TIME, CRASRPRSTS_N->ACTION_END_TIME, sizeof(CRASRPRSTS->ACTION_END_TIME));
    CRASRPRSTS->ACTION_USE_TIME = CRASRPRSTS_N->ACTION_USE_TIME;
    CRASRPRSTS->TOTAL_USE_TIME = CRASRPRSTS_N->TOTAL_USE_TIME;
    CRASRPRSTS->WORST_BM_TIME = CRASRPRSTS_N->WORST_BM_TIME;
    MEMCPY_DN(CRASRPRSTS->RECEPTION_DATA, CRASRPRSTS_N->RECEPTION_DATA, sizeof(CRASRPRSTS->RECEPTION_DATA));
    MEMCPY_DN(CRASRPRSTS->BREAK_CLASS, CRASRPRSTS_N->BREAK_CLASS, sizeof(CRASRPRSTS->BREAK_CLASS));
    MEMCPY_DN(CRASRPRSTS->BREAK_PART, CRASRPRSTS_N->BREAK_PART, sizeof(CRASRPRSTS->BREAK_PART));
    MEMCPY_DN(CRASRPRSTS->BREAK_TYPE, CRASRPRSTS_N->BREAK_TYPE, sizeof(CRASRPRSTS->BREAK_TYPE));
    MEMCPY_DN(CRASRPRSTS->CAUSE_DATA, CRASRPRSTS_N->CAUSE_DATA, sizeof(CRASRPRSTS->CAUSE_DATA));
    MEMCPY_DN(CRASRPRSTS->ACTION_DATA, CRASRPRSTS_N->ACTION_DATA, sizeof(CRASRPRSTS->ACTION_DATA));
    MEMCPY_DN(CRASRPRSTS->REMARK, CRASRPRSTS_N->REMARK, sizeof(CRASRPRSTS->REMARK));
    CRASRPRSTS->MAN_HOUR = CRASRPRSTS_N->MAN_HOUR;
    CRASRPRSTS->WORKER_COUNT = CRASRPRSTS_N->WORKER_COUNT;
    MEMCPY_DN(CRASRPRSTS->CMF_1, CRASRPRSTS_N->CMF_1, sizeof(CRASRPRSTS->CMF_1));
    MEMCPY_DN(CRASRPRSTS->CMF_2, CRASRPRSTS_N->CMF_2, sizeof(CRASRPRSTS->CMF_2));
    MEMCPY_DN(CRASRPRSTS->CMF_3, CRASRPRSTS_N->CMF_3, sizeof(CRASRPRSTS->CMF_3));
