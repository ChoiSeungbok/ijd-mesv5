    MEMCPY_DN(CRASRPRSTS->CMF_5, CRASRPRSTS_N->CMF_5, sizeof(CRASRPRSTS->CMF_5));
    MEMCPY_DN(CRASRPRSTS->CMF_6, CRASRPRSTS_N->CMF_6, sizeof(CRASRPRSTS->CMF_6));
    MEMCPY_DN(CRASRPRSTS->CMF_7, CRASRPRSTS_N->CMF_7, sizeof(CRASRPRSTS->CMF_7));
    MEMCPY_DN(CRASRPRSTS->CMF_8, CRASRPRSTS_N->CMF_8, sizeof(CRASRPRSTS->CMF_8));
    MEMCPY_DN(CRASRPRSTS->CMF_9, CRASRPRSTS_N->CMF_9, sizeof(CRASRPRSTS->CMF_9));
