void DBU_close_crasrprsts(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CRASRPRSTS_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_crasrprsts", sel_type);
}


/* Initialize Function */
void DBU_init_crasrprsts(struct CRASRPRSTS_TAG *CRASRPRSTS)
{
    /* memset by Space */
    memset(CRASRPRSTS, ' ', sizeof(struct CRASRPRSTS_TAG));
    
    CRASRPRSTS->WEEK = 0;
    CRASRPRSTS->MONTH = 0;
    CRASRPRSTS->ACTION_USE_TIME = 0;
    CRASRPRSTS->TOTAL_USE_TIME = 0;
    CRASRPRSTS->WORST_BM_TIME = 0;
    CRASRPRSTS->MAN_HOUR = 0;
    CRASRPRSTS->WORKER_COUNT = 0;
}


/* Add Null Function */
void DBU_add_null_crasrprsts(struct CRASRPRSTS_N_TAG *CRASRPRSTS_N, struct CRASRPRSTS_TAG *CRASRPRSTS)
{
    /* memset by NULL */
    memset(CRASRPRSTS_N, '\0', sizeof(struct CRASRPRSTS_N_TAG));
    
    MEMCPY_AN(CRASRPRSTS_N->FACTORY, CRASRPRSTS->FACTORY, sizeof(CRASRPRSTS->FACTORY));
    MEMCPY_AN(CRASRPRSTS_N->REPAIR_ID, CRASRPRSTS->REPAIR_ID, sizeof(CRASRPRSTS->REPAIR_ID));
    MEMCPY_AN(CRASRPRSTS_N->WORK_DATE, CRASRPRSTS->WORK_DATE, sizeof(CRASRPRSTS->WORK_DATE));
    CRASRPRSTS_N->WEEKEND_FLAG[0] = CRASRPRSTS->WEEKEND_FLAG;
    CRASRPRSTS_N->WEEK = CRASRPRSTS->WEEK;
    CRASRPRSTS_N->MONTH = CRASRPRSTS->MONTH;
    MEMCPY_AN(CRASRPRSTS_N->REPAIR_STATUS, CRASRPRSTS->REPAIR_STATUS, sizeof(CRASRPRSTS->REPAIR_STATUS));
    MEMCPY_AN(CRASRPRSTS_N->AREA_ID, CRASRPRSTS->AREA_ID, sizeof(CRASRPRSTS->AREA_ID));
    MEMCPY_AN(CRASRPRSTS_N->SUB_AREA_ID, CRASRPRSTS->SUB_AREA_ID, sizeof(CRASRPRSTS->SUB_AREA_ID));
    MEMCPY_AN(CRASRPRSTS_N->OPER, CRASRPRSTS->OPER, sizeof(CRASRPRSTS->OPER));
    MEMCPY_AN(CRASRPRSTS_N->RES_ID, CRASRPRSTS->RES_ID, sizeof(CRASRPRSTS->RES_ID));
    MEMCPY_AN(CRASRPRSTS_N->GRADE, CRASRPRSTS->GRADE, sizeof(CRASRPRSTS->GRADE));
    MEMCPY_AN(CRASRPRSTS_N->WORK_USER_ID, CRASRPRSTS->WORK_USER_ID, sizeof(CRASRPRSTS->WORK_USER_ID));
    MEMCPY_AN(CRASRPRSTS_N->REPAIR_TYPE, CRASRPRSTS->REPAIR_TYPE, sizeof(CRASRPRSTS->REPAIR_TYPE));
    MEMCPY_AN(CRASRPRSTS_N->ALRAM_TIME, CRASRPRSTS->ALRAM_TIME, sizeof(CRASRPRSTS->ALRAM_TIME));
    MEMCPY_AN(CRASRPRSTS_N->ACTION_START_TIME, CRASRPRSTS->ACTION_START_TIME, sizeof(CRASRPRSTS->ACTION_START_TIME));
    MEMCPY_AN(CRASRPRSTS_N->ACTION_END_TIME, CRASRPRSTS->ACTION_END_TIME, sizeof(CRASRPRSTS->ACTION_END_TIME));
    CRASRPRSTS_N->ACTION_USE_TIME = CRASRPRSTS->ACTION_USE_TIME;
    CRASRPRSTS_N->TOTAL_USE_TIME = CRASRPRSTS->TOTAL_USE_TIME;
    CRASRPRSTS_N->WORST_BM_TIME = CRASRPRSTS->WORST_BM_TIME;
    MEMCPY_AN(CRASRPRSTS_N->RECEPTION_DATA, CRASRPRSTS->RECEPTION_DATA, sizeof(CRASRPRSTS->RECEPTION_DATA));
    MEMCPY_AN(CRASRPRSTS_N->BREAK_CLASS, CRASRPRSTS->BREAK_CLASS, sizeof(CRASRPRSTS->BREAK_CLASS));
    MEMCPY_AN(CRASRPRSTS_N->BREAK_PART, CRASRPRSTS->BREAK_PART, sizeof(CRASRPRSTS->BREAK_PART));
    MEMCPY_AN(CRASRPRSTS_N->BREAK_TYPE, CRASRPRSTS->BREAK_TYPE, sizeof(CRASRPRSTS->BREAK_TYPE));
    MEMCPY_AN(CRASRPRSTS_N->CAUSE_DATA, CRASRPRSTS->CAUSE_DATA, sizeof(CRASRPRSTS->CAUSE_DATA));
    MEMCPY_AN(CRASRPRSTS_N->ACTION_DATA, CRASRPRSTS->ACTION_DATA, sizeof(CRASRPRSTS->ACTION_DATA));
    MEMCPY_AN(CRASRPRSTS_N->REMARK, CRASRPRSTS->REMARK, sizeof(CRASRPRSTS->REMARK));
    CRASRPRSTS_N->MAN_HOUR = CRASRPRSTS->MAN_HOUR;
    CRASRPRSTS_N->WORKER_COUNT = CRASRPRSTS->WORKER_COUNT;
    MEMCPY_AN(CRASRPRSTS_N->CMF_1, CRASRPRSTS->CMF_1, sizeof(CRASRPRSTS->CMF_1));
    MEMCPY_AN(CRASRPRSTS_N->CMF_2, CRASRPRSTS->CMF_2, sizeof(CRASRPRSTS->CMF_2));
    MEMCPY_AN(CRASRPRSTS_N->CMF_3, CRASRPRSTS->CMF_3, sizeof(CRASRPRSTS->CMF_3));
    MEMCPY_AN(CRASRPRSTS_N->CMF_4, CRASRPRSTS->CMF_4, sizeof(CRASRPRSTS->CMF_4));
    MEMCPY_AN(CRASRPRSTS_N->CMF_5, CRASRPRSTS->CMF_5, sizeof(CRASRPRSTS->CMF_5));
    MEMCPY_AN(CRASRPRSTS_N->CMF_6, CRASRPRSTS->CMF_6, sizeof(CRASRPRSTS->CMF_6));
    MEMCPY_AN(CRASRPRSTS_N->CMF_7, CRASRPRSTS->CMF_7, sizeof(CRASRPRSTS->CMF_7));
    MEMCPY_AN(CRASRPRSTS_N->CMF_8, CRASRPRSTS->CMF_8, sizeof(CRASRPRSTS->CMF_8));
    MEMCPY_AN(CRASRPRSTS_N->CMF_9, CRASRPRSTS->CMF_9, sizeof(CRASRPRSTS->CMF_9));
    MEMCPY_AN(CRASRPRSTS_N->CMF_10, CRASRPRSTS->CMF_10, sizeof(CRASRPRSTS->CMF_10));
    MEMCPY_AN(CRASRPRSTS_N->CREATE_USER_ID, CRASRPRSTS->CREATE_USER_ID, sizeof(CRASRPRSTS->CREATE_USER_ID));
    MEMCPY_AN(CRASRPRSTS_N->CREATE_TIME, CRASRPRSTS->CREATE_TIME, sizeof(CRASRPRSTS->CREATE_TIME));
    MEMCPY_AN(CRASRPRSTS_N->UPDATE_USER_ID, CRASRPRSTS->UPDATE_USER_ID, sizeof(CRASRPRSTS->UPDATE_USER_ID));
    MEMCPY_AN(CRASRPRSTS_N->UPDATE_TIME, CRASRPRSTS->UPDATE_TIME, sizeof(CRASRPRSTS->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_crasrprsts(struct CRASRPRSTS_N_TAG *CRASRPRSTS_N, struct CRASRPRSTS_TAG *CRASRPRSTS)
{
    MEMCPY_DN(CRASRPRSTS->FACTORY, CRASRPRSTS_N->FACTORY, sizeof(CRASRPRSTS->FACTORY));
    MEMCPY_DN(CRASRPRSTS->REPAIR_ID, CRASRPRSTS_N->REPAIR_ID, sizeof(CRASRPRSTS->REPAIR_ID));
    MEMCPY_DN(CRASRPRSTS->WORK_DATE, CRASRPRSTS_N->WORK_DATE, sizeof(CRASRPRSTS->WORK_DATE));
    CRASRPRSTS->WEEKEND_FLAG = CRASRPRSTS_N->WEEKEND_FLAG[0];
    CRASRPRSTS->WEEK = CRASRPRSTS_N->WEEK;
    CRASRPRSTS->MONTH = CRASRPRSTS_N->MONTH;
    MEMCPY_DN(CRASRPRSTS->REPAIR_STATUS, CRASRPRSTS_N->REPAIR_STATUS, sizeof(CRASRPRSTS->REPAIR_STATUS));
    MEMCPY_DN(CRASRPRSTS->AREA_ID, CRASRPRSTS_N->AREA_ID, sizeof(CRASRPRSTS->AREA_ID));
    MEMCPY_DN(CRASRPRSTS->SUB_AREA_ID, CRASRPRSTS_N->SUB_AREA_ID, sizeof(CRASRPRSTS->SUB_AREA_ID));
    MEMCPY_DN(CRASRPRSTS->OPER, CRASRPRSTS_N->OPER, sizeof(CRASRPRSTS->OPER));
