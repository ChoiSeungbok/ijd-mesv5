/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cbaslbldat(int sel_type, struct CBASLBLDAT_TAG *CBASLBLDAT)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CBASLBLDAT_N_TAG CBASLBLDAT_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cbaslbldat(&CBASLBLDAT_N, CBASLBLDAT);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CBASLBLDAT_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    AREA_ID,
                    FILE_NAME,
                    SEQ,
                    LABEL_SIZE,
                    PRINT_DATE,
                    LOT_ID,
                    ITEM_CODE,
                    ITEM_NAME,
                    INPUT_DATE,
                    LOT_QTY,
                    UOM,
                    VENDOR_NAME,
                    SUPPLIER_LOT_ID,
                    CELL_NO,
                    WO_NO,
                    PC0201,
                    PC0202,
                    PC0203,
                    PC0204,
                    MAIN_LOT_ID,
                    GRADE,
                    ITEM_UOM,
                    REMARKS,
                    GROUP_ID,
                    ITEM_NAME2,
                    TYPE,
                    SPEC,
                    BOX_COUNT,
                    ITEM_NAME1,
                    ITEM,
                    PO_NUMBER,
                    MN_NO,
                    DRAWING_FLAG,
                    COAT,
                    GROSS,
                    QR_DATA,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CBASLBLDAT
                ORDER BY FACTORY ASC,
                    AREA_ID ASC,
                    FILE_NAME ASC,
                    SEQ ASC;
            EXEC SQL OPEN DBU_CBASLBLDAT_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cbaslbldat", sel_type);
}


