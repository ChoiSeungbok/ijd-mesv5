/* Del Null Function */
void DBU_del_null_crasdsptol(struct CRASDSPTOL_N_TAG *CRASDSPTOL_N, struct CRASDSPTOL_TAG *CRASDSPTOL)
{
    MEMCPY_DN(CRASDSPTOL->FACTORY, CRASDSPTOL_N->FACTORY, sizeof(CRASDSPTOL->FACTORY));
    MEMCPY_DN(CRASDSPTOL->REQ_NO, CRASDSPTOL_N->REQ_NO, sizeof(CRASDSPTOL->REQ_NO));
    MEMCPY_DN(CRASDSPTOL->TOOL_ID, CRASDSPTOL_N->TOOL_ID, sizeof(CRASDSPTOL->TOOL_ID));
    CRASDSPTOL->CONFIRM_FLAG = CRASDSPTOL_N->CONFIRM_FLAG[0];
    MEMCPY_DN(CRASDSPTOL->FROM_OPER, CRASDSPTOL_N->FROM_OPER, sizeof(CRASDSPTOL->FROM_OPER));
    MEMCPY_DN(CRASDSPTOL->TO_OPER, CRASDSPTOL_N->TO_OPER, sizeof(CRASDSPTOL->TO_OPER));
    MEMCPY_DN(CRASDSPTOL->CMF_1, CRASDSPTOL_N->CMF_1, sizeof(CRASDSPTOL->CMF_1));
    MEMCPY_DN(CRASDSPTOL->CMF_2, CRASDSPTOL_N->CMF_2, sizeof(CRASDSPTOL->CMF_2));
    MEMCPY_DN(CRASDSPTOL->CMF_3, CRASDSPTOL_N->CMF_3, sizeof(CRASDSPTOL->CMF_3));
    MEMCPY_DN(CRASDSPTOL->CMF_4, CRASDSPTOL_N->CMF_4, sizeof(CRASDSPTOL->CMF_4));
    MEMCPY_DN(CRASDSPTOL->CMF_5, CRASDSPTOL_N->CMF_5, sizeof(CRASDSPTOL->CMF_5));
    MEMCPY_DN(CRASDSPTOL->CREATE_USER_ID, CRASDSPTOL_N->CREATE_USER_ID, sizeof(CRASDSPTOL->CREATE_USER_ID));
    MEMCPY_DN(CRASDSPTOL->CREATE_TIME, CRASDSPTOL_N->CREATE_TIME, sizeof(CRASDSPTOL->CREATE_TIME));
    MEMCPY_DN(CRASDSPTOL->UPDATE_USER_ID, CRASDSPTOL_N->UPDATE_USER_ID, sizeof(CRASDSPTOL->UPDATE_USER_ID));
    MEMCPY_DN(CRASDSPTOL->UPDATE_TIME, CRASDSPTOL_N->UPDATE_TIME, sizeof(CRASDSPTOL->UPDATE_TIME));
}


