    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CRASDSPTOL_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    REQ_NO,
                    TOOL_ID,
                    CONFIRM_FLAG,
                    FROM_OPER,
                    TO_OPER,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CRASDSPTOL
                ORDER BY FACTORY ASC,
                    REQ_NO ASC,
                    TOOL_ID ASC;
            EXEC SQL OPEN DBU_CRASDSPTOL_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
