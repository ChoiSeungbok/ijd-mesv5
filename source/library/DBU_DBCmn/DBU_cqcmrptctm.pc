/* Add Null Function */
void DBU_add_null_cqcmrptctm(struct CQCMRPTCTM_N_TAG *CQCMRPTCTM_N, struct CQCMRPTCTM_TAG *CQCMRPTCTM)
{
    /* memset by NULL */
