    MEMCPY_AN(CQCMRPTCTM_N->FACTORY, CQCMRPTCTM->FACTORY, sizeof(CQCMRPTCTM->FACTORY));
    MEMCPY_AN(CQCMRPTCTM_N->REPORT_NO, CQCMRPTCTM->REPORT_NO, sizeof(CQCMRPTCTM->REPORT_NO));
