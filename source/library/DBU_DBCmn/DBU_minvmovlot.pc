    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_minvmovlot(&MINVMOVLOT_N, MINVMOVLOT);
    DB_error_code = 0;
    d_value = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MINVMOVLOT
                WHERE FACTORY = :MINVMOVLOT_N.FACTORY
                    AND MOVE_ID = :MINVMOVLOT_N.MOVE_ID
                    AND INV_LOT_ID = :MINVMOVLOT_N.INV_LOT_ID;
            break;

		case 2:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM 
				(SELECT DISTINCT MOV.MOVE_ID
				FROM MINVMOVLOT LOT, MINVMOVSTS MOV
                WHERE LOT.FACTORY = :MINVMOVLOT_N.FACTORY
                    AND LOT.INV_LOT_ID = :MINVMOVLOT_N.INV_LOT_ID
					AND LOT.FACTORY = MOV.FACTORY
					AND LOT.MOVE_ID = MOV.MOVE_ID
					AND MOV.MOVE_STATUS = 'O');
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_select_minvmovlot_scalar", sel_type);

    return d_value;
}


