/* Initialize Function */
void DBU_init_minvmovlot(struct MINVMOVLOT_TAG *MINVMOVLOT)
{
    /* memset by Space */
    memset(MINVMOVLOT, ' ', sizeof(struct MINVMOVLOT_TAG));
    
    MINVMOVLOT->QTY = 0;
}


/* Add Null Function */
void DBU_add_null_minvmovlot(struct MINVMOVLOT_N_TAG *MINVMOVLOT_N, struct MINVMOVLOT_TAG *MINVMOVLOT)
{
    /* memset by NULL */
    memset(MINVMOVLOT_N, '\0', sizeof(struct MINVMOVLOT_N_TAG));
    
    MEMCPY_AN(MINVMOVLOT_N->FACTORY, MINVMOVLOT->FACTORY, sizeof(MINVMOVLOT->FACTORY));
    MEMCPY_AN(MINVMOVLOT_N->MOVE_ID, MINVMOVLOT->MOVE_ID, sizeof(MINVMOVLOT->MOVE_ID));
    MEMCPY_AN(MINVMOVLOT_N->INV_LOT_ID, MINVMOVLOT->INV_LOT_ID, sizeof(MINVMOVLOT->INV_LOT_ID));
    MINVMOVLOT_N->QTY = MINVMOVLOT->QTY;
    MEMCPY_AN(MINVMOVLOT_N->CREATE_USER_ID, MINVMOVLOT->CREATE_USER_ID, sizeof(MINVMOVLOT->CREATE_USER_ID));
    MEMCPY_AN(MINVMOVLOT_N->CREATE_TIME, MINVMOVLOT->CREATE_TIME, sizeof(MINVMOVLOT->CREATE_TIME));
    MEMCPY_AN(MINVMOVLOT_N->UPDATE_USER_ID, MINVMOVLOT->UPDATE_USER_ID, sizeof(MINVMOVLOT->UPDATE_USER_ID));
    MEMCPY_AN(MINVMOVLOT_N->UPDATE_TIME, MINVMOVLOT->UPDATE_TIME, sizeof(MINVMOVLOT->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_minvmovlot(struct MINVMOVLOT_N_TAG *MINVMOVLOT_N, struct MINVMOVLOT_TAG *MINVMOVLOT)
{
    MEMCPY_DN(MINVMOVLOT->FACTORY, MINVMOVLOT_N->FACTORY, sizeof(MINVMOVLOT->FACTORY));
    MEMCPY_DN(MINVMOVLOT->MOVE_ID, MINVMOVLOT_N->MOVE_ID, sizeof(MINVMOVLOT->MOVE_ID));
    MEMCPY_DN(MINVMOVLOT->INV_LOT_ID, MINVMOVLOT_N->INV_LOT_ID, sizeof(MINVMOVLOT->INV_LOT_ID));
    MINVMOVLOT->QTY = MINVMOVLOT_N->QTY;
    MEMCPY_DN(MINVMOVLOT->CREATE_USER_ID, MINVMOVLOT_N->CREATE_USER_ID, sizeof(MINVMOVLOT->CREATE_USER_ID));
    MEMCPY_DN(MINVMOVLOT->CREATE_TIME, MINVMOVLOT_N->CREATE_TIME, sizeof(MINVMOVLOT->CREATE_TIME));
    MEMCPY_DN(MINVMOVLOT->UPDATE_USER_ID, MINVMOVLOT_N->UPDATE_USER_ID, sizeof(MINVMOVLOT->UPDATE_USER_ID));
    MEMCPY_DN(MINVMOVLOT->UPDATE_TIME, MINVMOVLOT_N->UPDATE_TIME, sizeof(MINVMOVLOT->UPDATE_TIME));
}


