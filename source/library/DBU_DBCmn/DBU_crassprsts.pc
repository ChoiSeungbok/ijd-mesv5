    MEMCPY_DN(CRASSPRSTS->CMF_10, CRASSPRSTS_N->CMF_10, sizeof(CRASSPRSTS->CMF_10));
    MEMCPY_DN(CRASSPRSTS->CREATE_USER_ID, CRASSPRSTS_N->CREATE_USER_ID, sizeof(CRASSPRSTS->CREATE_USER_ID));
    MEMCPY_DN(CRASSPRSTS->CREATE_TIME, CRASSPRSTS_N->CREATE_TIME, sizeof(CRASSPRSTS->CREATE_TIME));
    MEMCPY_DN(CRASSPRSTS->UPDATE_USER_ID, CRASSPRSTS_N->UPDATE_USER_ID, sizeof(CRASSPRSTS->UPDATE_USER_ID));
    MEMCPY_DN(CRASSPRSTS->UPDATE_TIME, CRASSPRSTS_N->UPDATE_TIME, sizeof(CRASSPRSTS->UPDATE_TIME));
}


