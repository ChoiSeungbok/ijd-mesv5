    memset(CBOMSTDDEF, ' ', sizeof(struct CBOMSTDDEF_TAG));
    
    CBOMSTDDEF->ERP_AREA_ID = 0;
    CBOMSTDDEF->ERP_MAT_ID = 0;
    CBOMSTDDEF->MAT_VER = 0;
    CBOMSTDDEF->OPER_SEQ = 0;
    CBOMSTDDEF->STD_OPER_ID = 0;
    CBOMSTDDEF->COMP_ERP_MAT_ID = 0;
    CBOMSTDDEF->COMP_SEQ = 0;
    CBOMSTDDEF->COMP_QTY = 0;
    CBOMSTDDEF->COMP_YIELD_FACTOR = 0;
    CBOMSTDDEF->WIP_SUPPLY_TYPE = 0;
}


/* Add Null Function */
void DBU_add_null_cbomstddef(struct CBOMSTDDEF_N_TAG *CBOMSTDDEF_N, struct CBOMSTDDEF_TAG *CBOMSTDDEF)
{
    /* memset by NULL */
    memset(CBOMSTDDEF_N, '\0', sizeof(struct CBOMSTDDEF_N_TAG));
    
    MEMCPY_AN(CBOMSTDDEF_N->FACTORY, CBOMSTDDEF->FACTORY, sizeof(CBOMSTDDEF->FACTORY));
    CBOMSTDDEF_N->ERP_AREA_ID = CBOMSTDDEF->ERP_AREA_ID;
    MEMCPY_AN(CBOMSTDDEF_N->AREA_ID, CBOMSTDDEF->AREA_ID, sizeof(CBOMSTDDEF->AREA_ID));
    CBOMSTDDEF_N->ERP_MAT_ID = CBOMSTDDEF->ERP_MAT_ID;
