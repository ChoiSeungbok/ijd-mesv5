/* Del Null Function */
void DBU_del_null_cbomstddef(struct CBOMSTDDEF_N_TAG *CBOMSTDDEF_N, struct CBOMSTDDEF_TAG *CBOMSTDDEF)
{
    MEMCPY_DN(CBOMSTDDEF->FACTORY, CBOMSTDDEF_N->FACTORY, sizeof(CBOMSTDDEF->FACTORY));
    CBOMSTDDEF->ERP_AREA_ID = CBOMSTDDEF_N->ERP_AREA_ID;
