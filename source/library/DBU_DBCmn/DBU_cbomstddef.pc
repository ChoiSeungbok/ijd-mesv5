    CBOMSTDDEF_N->MAT_VER = CBOMSTDDEF->MAT_VER;
    MEMCPY_AN(CBOMSTDDEF_N->MAT_DESC, CBOMSTDDEF->MAT_DESC, sizeof(CBOMSTDDEF->MAT_DESC));
    MEMCPY_AN(CBOMSTDDEF_N->UNIT, CBOMSTDDEF->UNIT, sizeof(CBOMSTDDEF->UNIT));
    MEMCPY_AN(CBOMSTDDEF_N->ALTERNATE_CODE, CBOMSTDDEF->ALTERNATE_CODE, sizeof(CBOMSTDDEF->ALTERNATE_CODE));
    CBOMSTDDEF_N->OPER_SEQ = CBOMSTDDEF->OPER_SEQ;
    CBOMSTDDEF_N->STD_OPER_ID = CBOMSTDDEF->STD_OPER_ID;
    MEMCPY_AN(CBOMSTDDEF_N->OPER, CBOMSTDDEF->OPER, sizeof(CBOMSTDDEF->OPER));
    MEMCPY_AN(CBOMSTDDEF_N->OPER_DESC, CBOMSTDDEF->OPER_DESC, sizeof(CBOMSTDDEF->OPER_DESC));
    CBOMSTDDEF_N->COMP_ERP_MAT_ID = CBOMSTDDEF->COMP_ERP_MAT_ID;
    MEMCPY_AN(CBOMSTDDEF_N->COMP_MAT_ID, CBOMSTDDEF->COMP_MAT_ID, sizeof(CBOMSTDDEF->COMP_MAT_ID));
    MEMCPY_AN(CBOMSTDDEF_N->COMP_MAT_DESC, CBOMSTDDEF->COMP_MAT_DESC, sizeof(CBOMSTDDEF->COMP_MAT_DESC));
    MEMCPY_AN(CBOMSTDDEF_N->COMP_MAT_UNIT, CBOMSTDDEF->COMP_MAT_UNIT, sizeof(CBOMSTDDEF->COMP_MAT_UNIT));
    CBOMSTDDEF_N->COMP_SEQ = CBOMSTDDEF->COMP_SEQ;
    CBOMSTDDEF_N->COMP_QTY = CBOMSTDDEF->COMP_QTY;
    CBOMSTDDEF_N->COMP_YIELD_FACTOR = CBOMSTDDEF->COMP_YIELD_FACTOR;
    MEMCPY_AN(CBOMSTDDEF_N->EFFECTIVITY_DATE, CBOMSTDDEF->EFFECTIVITY_DATE, sizeof(CBOMSTDDEF->EFFECTIVITY_DATE));
    CBOMSTDDEF_N->WIP_SUPPLY_TYPE = CBOMSTDDEF->WIP_SUPPLY_TYPE;
    MEMCPY_AN(CBOMSTDDEF_N->WIP_SUPPLY_TYPE_NAME, CBOMSTDDEF->WIP_SUPPLY_TYPE_NAME, sizeof(CBOMSTDDEF->WIP_SUPPLY_TYPE_NAME));
    MEMCPY_AN(CBOMSTDDEF_N->SUPPLY_INV_OPER, CBOMSTDDEF->SUPPLY_INV_OPER, sizeof(CBOMSTDDEF->SUPPLY_INV_OPER));
    MEMCPY_AN(CBOMSTDDEF_N->CMF_1, CBOMSTDDEF->CMF_1, sizeof(CBOMSTDDEF->CMF_1));
    MEMCPY_AN(CBOMSTDDEF_N->CMF_2, CBOMSTDDEF->CMF_2, sizeof(CBOMSTDDEF->CMF_2));
    MEMCPY_AN(CBOMSTDDEF_N->CMF_3, CBOMSTDDEF->CMF_3, sizeof(CBOMSTDDEF->CMF_3));
    MEMCPY_AN(CBOMSTDDEF_N->CMF_4, CBOMSTDDEF->CMF_4, sizeof(CBOMSTDDEF->CMF_4));
    MEMCPY_AN(CBOMSTDDEF_N->CMF_5, CBOMSTDDEF->CMF_5, sizeof(CBOMSTDDEF->CMF_5));
    MEMCPY_AN(CBOMSTDDEF_N->CMF_6, CBOMSTDDEF->CMF_6, sizeof(CBOMSTDDEF->CMF_6));
