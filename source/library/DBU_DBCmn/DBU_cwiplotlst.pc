/* Add Null Function */
void DBU_add_null_cwiplotlst(struct CWIPLOTLST_N_TAG *CWIPLOTLST_N, struct CWIPLOTLST_TAG *CWIPLOTLST)
{
    /* memset by NULL */
    memset(CWIPLOTLST_N, '\0', sizeof(struct CWIPLOTLST_N_TAG));
    
    MEMCPY_AN(CWIPLOTLST_N->LOT_ID, CWIPLOTLST->LOT_ID, sizeof(CWIPLOTLST->LOT_ID));
    CWIPLOTLST_N->HIST_SEQ = CWIPLOTLST->HIST_SEQ;
    CWIPLOTLST_N->QTY_FLAG[0] = CWIPLOTLST->QTY_FLAG;
    MEMCPY_AN(CWIPLOTLST_N->TRAN_TIME, CWIPLOTLST->TRAN_TIME, sizeof(CWIPLOTLST->TRAN_TIME));
    MEMCPY_AN(CWIPLOTLST_N->FACTORY, CWIPLOTLST->FACTORY, sizeof(CWIPLOTLST->FACTORY));
    MEMCPY_AN(CWIPLOTLST_N->MAT_ID, CWIPLOTLST->MAT_ID, sizeof(CWIPLOTLST->MAT_ID));
    CWIPLOTLST_N->MAT_VER = CWIPLOTLST->MAT_VER;
    MEMCPY_AN(CWIPLOTLST_N->FLOW, CWIPLOTLST->FLOW, sizeof(CWIPLOTLST->FLOW));
    MEMCPY_AN(CWIPLOTLST_N->OPER, CWIPLOTLST->OPER, sizeof(CWIPLOTLST->OPER));
    MEMCPY_AN(CWIPLOTLST_N->RES_ID, CWIPLOTLST->RES_ID, sizeof(CWIPLOTLST->RES_ID));
    CWIPLOTLST_N->SEQ_NUM = CWIPLOTLST->SEQ_NUM;
    MEMCPY_AN(CWIPLOTLST_N->LOSS_CODE, CWIPLOTLST->LOSS_CODE, sizeof(CWIPLOTLST->LOSS_CODE));
    CWIPLOTLST_N->LOSS_QTY = CWIPLOTLST->LOSS_QTY;
    MEMCPY_AN(CWIPLOTLST_N->CUASE_OPER, CWIPLOTLST->CUASE_OPER, sizeof(CWIPLOTLST->CUASE_OPER));
}


