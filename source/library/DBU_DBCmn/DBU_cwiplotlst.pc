/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cwiplotlst(int sel_type, struct CWIPLOTLST_TAG *CWIPLOTLST)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CWIPLOTLST_N_TAG CWIPLOTLST_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cwiplotlst(&CWIPLOTLST_N, CWIPLOTLST);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CWIPLOTLST_CUR_1 CURSOR FOR
                SELECT 
                    LOT_ID,
                    HIST_SEQ,
                    QTY_FLAG,
                    TRAN_TIME,
                    FACTORY,
                    MAT_ID,
                    MAT_VER,
                    FLOW,
                    OPER,
                    RES_ID,
                    SEQ_NUM,
                    LOSS_CODE,
                    LOSS_QTY,
                    CUASE_OPER
                FROM CWIPLOTLST
                ORDER BY LOT_ID ASC,
                    HIST_SEQ ASC,
                    QTY_FLAG ASC,
                    SEQ_NUM ASC;
            EXEC SQL OPEN DBU_CWIPLOTLST_CUR_1;
            break;

        case 2:
            EXEC SQL DECLARE DBU_CWIPLOTLST_CUR_2 CURSOR FOR
                SELECT 
                    LOT_ID,
                    HIST_SEQ,
                    QTY_FLAG,
                    TRAN_TIME,
                    FACTORY,
                    MAT_ID,
                    MAT_VER,
                    FLOW,
                    OPER,
                    RES_ID,
                    SEQ_NUM,
                    LOSS_CODE,
                    LOSS_QTY,
                    CUASE_OPER
                FROM CWIPLOTLST
               WHERE FACTORY = :CWIPLOTLST_N.FACTORY
                 AND LOT_ID = :CWIPLOTLST_N.LOT_ID
                 AND OPER = :CWIPLOTLST_N.OPER
                ORDER BY SEQ_NUM ASC;
            EXEC SQL OPEN DBU_CWIPLOTLST_CUR_2;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cwiplotlst", sel_type);
}


