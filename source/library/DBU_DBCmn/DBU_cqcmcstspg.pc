    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CQCMCSTSPG_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    INSP_TYPE,
                    GRADE,
                    DELIVERY_ID,
                    DELIVERY_NAME,
                    CHAR_ID,
                    SPEC_TYPE,
                    TARGET_VALUE,
                    LOW_SPEC_LIMIT,
