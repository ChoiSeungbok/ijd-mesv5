                    UPDATE_TIME
                FROM CQCMCSTSPG
                ORDER BY FACTORY ASC,
                    INSP_TYPE ASC,
                    GRADE ASC,
                    DELIVERY_ID ASC,
                    CHAR_ID ASC;
            EXEC SQL OPEN DBU_CQCMCSTSPG_CUR_1;
            break;


        default:
