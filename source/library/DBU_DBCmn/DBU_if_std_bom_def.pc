                FROM IF_STD_BOM_DEF
                ORDER BY IF_SEQ ASC;
            EXEC SQL OPEN DBU_IF_STD_BOM_DEF_CUR_101;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_if_std_bom_def", sel_type);
}


