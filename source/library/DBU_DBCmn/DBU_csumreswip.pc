    MEMCPY_DN(CSUMRESWIP->START_TIME, CSUMRESWIP_N->START_TIME, sizeof(CSUMRESWIP->START_TIME));
    MEMCPY_DN(CSUMRESWIP->START_DAY_NIGHT, CSUMRESWIP_N->START_DAY_NIGHT, sizeof(CSUMRESWIP->START_DAY_NIGHT));
    CSUMRESWIP->END_HIST_SEQ = CSUMRESWIP_N->END_HIST_SEQ;
    MEMCPY_DN(CSUMRESWIP->END_DATE, CSUMRESWIP_N->END_DATE, sizeof(CSUMRESWIP->END_DATE));
