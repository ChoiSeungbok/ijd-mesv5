    MEMCPY_AN(CSUMRESWIP_N->START_DAY_NIGHT, CSUMRESWIP->START_DAY_NIGHT, sizeof(CSUMRESWIP->START_DAY_NIGHT));
    CSUMRESWIP_N->END_HIST_SEQ = CSUMRESWIP->END_HIST_SEQ;
    MEMCPY_AN(CSUMRESWIP_N->END_DATE, CSUMRESWIP->END_DATE, sizeof(CSUMRESWIP->END_DATE));
    MEMCPY_AN(CSUMRESWIP_N->END_TIME, CSUMRESWIP->END_TIME, sizeof(CSUMRESWIP->END_TIME));
    MEMCPY_AN(CSUMRESWIP_N->END_DAY_NIGHT, CSUMRESWIP->END_DAY_NIGHT, sizeof(CSUMRESWIP->END_DAY_NIGHT));
    MEMCPY_AN(CSUMRESWIP_N->CREATE_USER_ID, CSUMRESWIP->CREATE_USER_ID, sizeof(CSUMRESWIP->CREATE_USER_ID));
    MEMCPY_AN(CSUMRESWIP_N->CREATE_TIME, CSUMRESWIP->CREATE_TIME, sizeof(CSUMRESWIP->CREATE_TIME));
    MEMCPY_AN(CSUMRESWIP_N->UPDATE_USER_ID, CSUMRESWIP->UPDATE_USER_ID, sizeof(CSUMRESWIP->UPDATE_USER_ID));
    MEMCPY_AN(CSUMRESWIP_N->UPDATE_TIME, CSUMRESWIP->UPDATE_TIME, sizeof(CSUMRESWIP->UPDATE_TIME));
}


