    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_MEDCCOLVER_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    COL_SET_ID,
                    COL_SET_VERSION,
                    APPLY_START_TIME,
                    APPLY_END_TIME,
                    APPROVAL_FLAG,
                    APPROVAL_USER_ID,
