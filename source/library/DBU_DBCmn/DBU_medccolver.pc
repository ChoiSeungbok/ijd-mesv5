                    RELEASE_FLAG,
                    RELEASE_USER_ID,
                    RELEASE_TIME,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM MEDCCOLVER
                ORDER BY FACTORY ASC,
                    COL_SET_ID ASC,
                    COL_SET_VERSION ASC;
            EXEC SQL OPEN DBU_MEDCCOLVER_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
