    DBU_add_null_minvlothld(&MINVLOTHLD_N, MINVLOTHLD);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_MINVLOTHLD_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    INV_LOT_ID,
                    HIST_SEQ,
					RELEASE_HIST_SEQ,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    QTY_2,
                    QTY_3,
                    UNIT,
                    UNIT_2,
                    UNIT_3,
                    OPER,
                    HOLD_CODE,
                    HOLD_FLAG,
                    HOLD_USER_ID,
                    HOLD_TIME,
                    HOLD_COMMENT,
                    RELEASE_CODE,
                    RELEASE_USER_ID,
                    RELEASE_TIME,
                    RELEASE_COMMENT,
                    HIST_DEL_FLAG
                FROM MINVLOTHLD
                ORDER BY FACTORY ASC,
                    INV_LOT_ID ASC,
                    HIST_SEQ ASC;
            EXEC SQL OPEN DBU_MINVLOTHLD_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
