    MEMCPY_DN(CWIPGRTCLS->CREATE_USER_ID, CWIPGRTCLS_N->CREATE_USER_ID, sizeof(CWIPGRTCLS->CREATE_USER_ID));
    MEMCPY_DN(CWIPGRTCLS->CREATE_TIME, CWIPGRTCLS_N->CREATE_TIME, sizeof(CWIPGRTCLS->CREATE_TIME));
    MEMCPY_DN(CWIPGRTCLS->UPDATE_USER_ID, CWIPGRTCLS_N->UPDATE_USER_ID, sizeof(CWIPGRTCLS->UPDATE_USER_ID));
    MEMCPY_DN(CWIPGRTCLS->UPDATE_TIME, CWIPGRTCLS_N->UPDATE_TIME, sizeof(CWIPGRTCLS->UPDATE_TIME));
}


