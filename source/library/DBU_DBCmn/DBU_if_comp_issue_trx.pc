/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_if_comp_issue_trx(int sel_type, struct IF_COMP_ISSUE_TRX_TAG *IF_COMP_ISSUE_TRX)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct IF_COMP_ISSUE_TRX_N_TAG IF_COMP_ISSUE_TRX_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_if_comp_issue_trx(&IF_COMP_ISSUE_TRX_N, IF_COMP_ISSUE_TRX);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_IF_COMP_ISSUE_TRX_CUR_1 CURSOR FOR
                SELECT 
                    IF_SEQ,
                    IF_TIME,
                    IF_CODE,
                    IF_MSG,
                    FACTORY,
                    TRAN_TYPE_ID,
                    TRAN_TYPE,
                    TRAN_TIME,
                    TRAN_FLAG,
                    ERP_ORDER_NUM,
                    ERP_AREA_ID,
                    AREA_ID,
                    ERP_SUB_AREA_ID,
                    SUB_AREA_ID,
                    ERP_WO_ID,
                    WO_ID,
                    OPER_SEQ,
                    OPER,
                    INV_OPER,
                    ERP_MAT_ID,
                    MAT_ID,
                    UNIT,
                    QTY,
                    TRAN_HEADER_ID,
                    SRC_TRAN_ID,
                    MMT_TRAN_ID,
                    MMT_TRAN_HEADER_ID,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM IF_COMP_ISSUE_TRX
                ORDER BY IF_SEQ ASC;
            EXEC SQL OPEN DBU_IF_COMP_ISSUE_TRX_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_if_comp_issue_trx", sel_type);
}


