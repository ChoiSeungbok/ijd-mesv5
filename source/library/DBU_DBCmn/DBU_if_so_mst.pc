                    FACTORY,
                    SHIPPING_HEADER_ID,
                    SHIPPING_HEADER_NUM,
                    SHIP_TRX_ID,
                    CUSTOMER_ID,
                    CUSTOMER_NUMBER,
                    CUSTOMER_NAME,
                    SHIPPING_DATE,
                    SHIPPING_STATUS,
                    SHIP_FROM_ORG_ID,
                    SHIP_FROM_ORG_NAME,
                    SHIP_TO_ORG_ID,
                    SHIP_TO_ORG_NAME,
                    SHIP_TO_ADDRESS,
                    INVOICE_TO_ORG_ID,
                    INVOICE_TO_ORG_NAME,
                    ATTRIBUTE1,
                    ATTRIBUTE2,
                    ATTRIBUTE3,
                    ATTRIBUTE4,
                    ATTRIBUTE5,
                    MES_SHIPPING_YN,
                    MES_SHIPPING_DATE,
                    ORDER_NUMBER,
                    PARTY_SITE_ID,
                    CUST_ACCT_SITE_ID,
                    CUST_PHONE_NUMBER,
                    CUST_CONTACT_NAME,
                    CREATED_BY,
                    LAST_UPDATED_BY,
                    LAST_UPDATE_LOGIN,
                    TRAN_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM IF_SO_MST
                ORDER BY IF_SEQ ASC;
            EXEC SQL OPEN DBU_IF_SO_MST_CUR_1;
            break;

		case 101:
            EXEC SQL DECLARE DBU_IF_SO_MST_CUR_101 CURSOR FOR
                SELECT 
                    IF_SEQ,
                    IF_TIME,
                    IF_CODE,
                    IF_MSG,
                    FACTORY,
                    SHIPPING_HEADER_ID,
                    SHIPPING_HEADER_NUM,
                    SHIP_TRX_ID,
                    CUSTOMER_ID,
                    CUSTOMER_NUMBER,
                    CUSTOMER_NAME,
                    SHIPPING_DATE,
                    SHIPPING_STATUS,
                    SHIP_FROM_ORG_ID,
                    SHIP_FROM_ORG_NAME,
                    SHIP_TO_ORG_ID,
                    SHIP_TO_ORG_NAME,
                    SHIP_TO_ADDRESS,
                    INVOICE_TO_ORG_ID,
                    INVOICE_TO_ORG_NAME,
                    ATTRIBUTE1,
                    ATTRIBUTE2,
                    ATTRIBUTE3,
                    ATTRIBUTE4,
                    ATTRIBUTE5,
                    MES_SHIPPING_YN,
                    MES_SHIPPING_DATE,
                    ORDER_NUMBER,
                    PARTY_SITE_ID,
                    CUST_ACCT_SITE_ID,
                    CUST_PHONE_NUMBER,
                    CUST_CONTACT_NAME,
                    CREATED_BY,
                    LAST_UPDATED_BY,
                    LAST_UPDATE_LOGIN,
                    TRAN_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM IF_SO_MST
				WHERE IF_CODE = 'N'
				AND ROWNUM <= 2000
                ORDER BY IF_SEQ ASC;
            EXEC SQL OPEN DBU_IF_SO_MST_CUR_101;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_if_so_mst", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_if_so_mst(int sel_type, struct IF_SO_MST_TAG *IF_SO_MST)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct IF_SO_MST_N_TAG IF_SO_MST_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_IF_SO_MST_CUR_1 INTO
                :IF_SO_MST_N.IF_SEQ,
                :IF_SO_MST_N.IF_TIME,
