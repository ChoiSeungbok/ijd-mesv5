                :IF_SO_MST_N.CREATED_BY,
                :IF_SO_MST_N.LAST_UPDATED_BY,
                :IF_SO_MST_N.LAST_UPDATE_LOGIN,
                :IF_SO_MST_N.TRAN_FLAG,
