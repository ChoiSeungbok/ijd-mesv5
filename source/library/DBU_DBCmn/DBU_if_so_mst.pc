/* SQL CURSOR CLOSE Function */
void DBU_close_if_so_mst(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_IF_SO_MST_CUR_1;
            break;

		case 101:
            EXEC SQL CLOSE DBU_IF_SO_MST_CUR_101;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_if_so_mst", sel_type);
}


/* Initialize Function */
void DBU_init_if_so_mst(struct IF_SO_MST_TAG *IF_SO_MST)
{
    /* memset by Space */
    memset(IF_SO_MST, ' ', sizeof(struct IF_SO_MST_TAG));
    
    IF_SO_MST->IF_SEQ = 0;
    IF_SO_MST->SHIPPING_HEADER_ID = 0;
    IF_SO_MST->SHIP_TRX_ID = 0;
    IF_SO_MST->CUSTOMER_ID = 0;
    IF_SO_MST->SHIP_FROM_ORG_ID = 0;
    IF_SO_MST->SHIP_TO_ORG_ID = 0;
    IF_SO_MST->INVOICE_TO_ORG_ID = 0;
    IF_SO_MST->ORDER_NUMBER = 0;
    IF_SO_MST->PARTY_SITE_ID = 0;
    IF_SO_MST->CUST_ACCT_SITE_ID = 0;
    IF_SO_MST->CREATED_BY = 0;
    IF_SO_MST->LAST_UPDATED_BY = 0;
    IF_SO_MST->LAST_UPDATE_LOGIN = 0;
}


