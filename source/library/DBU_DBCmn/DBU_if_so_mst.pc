                :IF_SO_MST_N.CMF_10,
                :IF_SO_MST_N.CREATE_USER_ID,
                :IF_SO_MST_N.CREATE_TIME,
                :IF_SO_MST_N.UPDATE_USER_ID,
                :IF_SO_MST_N.UPDATE_TIME;
            break;

		case 101:
            EXEC SQL FETCH DBU_IF_SO_MST_CUR_101 INTO
                :IF_SO_MST_N.IF_SEQ,
                :IF_SO_MST_N.IF_TIME,
                :IF_SO_MST_N.IF_CODE,
                :IF_SO_MST_N.IF_MSG,
