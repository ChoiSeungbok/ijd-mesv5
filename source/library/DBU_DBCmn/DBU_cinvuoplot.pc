    MEMCPY_DN(CINVUOPLOT->MAT_ID, CINVUOPLOT_N->MAT_ID, sizeof(CINVUOPLOT->MAT_ID));
    CINVUOPLOT->QTY = CINVUOPLOT_N->QTY;
    MEMCPY_DN(CINVUOPLOT->VENDOR_ID, CINVUOPLOT_N->VENDOR_ID, sizeof(CINVUOPLOT->VENDOR_ID));
    CINVUOPLOT->VENDOR_SITE_ID = CINVUOPLOT_N->VENDOR_SITE_ID;
    MEMCPY_DN(CINVUOPLOT->VENDOR_LOT_ID, CINVUOPLOT_N->VENDOR_LOT_ID, sizeof(CINVUOPLOT->VENDOR_LOT_ID));
    MEMCPY_DN(CINVUOPLOT->MOLD_TYPE, CINVUOPLOT_N->MOLD_TYPE, sizeof(CINVUOPLOT->MOLD_TYPE));
    MEMCPY_DN(CINVUOPLOT->MOLD_MODEL, CINVUOPLOT_N->MOLD_MODEL, sizeof(CINVUOPLOT->MOLD_MODEL));
    MEMCPY_DN(CINVUOPLOT->CREATE_USER_ID, CINVUOPLOT_N->CREATE_USER_ID, sizeof(CINVUOPLOT->CREATE_USER_ID));
    MEMCPY_DN(CINVUOPLOT->CREATE_TIME, CINVUOPLOT_N->CREATE_TIME, sizeof(CINVUOPLOT->CREATE_TIME));
    MEMCPY_DN(CINVUOPLOT->UPDATE_USER_ID, CINVUOPLOT_N->UPDATE_USER_ID, sizeof(CINVUOPLOT->UPDATE_USER_ID));
    MEMCPY_DN(CINVUOPLOT->UPDATE_TIME, CINVUOPLOT_N->UPDATE_TIME, sizeof(CINVUOPLOT->UPDATE_TIME));
}


