/* Del Null Function */
void DBU_del_null_cinvuoplot(struct CINVUOPLOT_N_TAG *CINVUOPLOT_N, struct CINVUOPLOT_TAG *CINVUOPLOT)
{
    MEMCPY_DN(CINVUOPLOT->LOT_ID, CINVUOPLOT_N->LOT_ID, sizeof(CINVUOPLOT->LOT_ID));
    CINVUOPLOT->SEQ = CINVUOPLOT_N->SEQ;
