                :IF_TXN_TYPE_DEF_N.CMF_6,
                :IF_TXN_TYPE_DEF_N.CMF_7,
                :IF_TXN_TYPE_DEF_N.CMF_8,
                :IF_TXN_TYPE_DEF_N.CMF_9,
                :IF_TXN_TYPE_DEF_N.CMF_10,
                :IF_TXN_TYPE_DEF_N.CREATE_USER_ID,
                :IF_TXN_TYPE_DEF_N.CREATE_TIME,
                :IF_TXN_TYPE_DEF_N.UPDATE_USER_ID,
                :IF_TXN_TYPE_DEF_N.UPDATE_TIME;
            break;

		case 101:
            EXEC SQL FETCH DBU_IF_TXN_TYPE_DEF_CUR_101 INTO
                :IF_TXN_TYPE_DEF_N.IF_SEQ,
                :IF_TXN_TYPE_DEF_N.IF_TIME,
                :IF_TXN_TYPE_DEF_N.IF_CODE,
                :IF_TXN_TYPE_DEF_N.IF_MSG,
                :IF_TXN_TYPE_DEF_N.FACTORY,
                :IF_TXN_TYPE_DEF_N.ORG_ID,
                :IF_TXN_TYPE_DEF_N.ORG_CODE,
                :IF_TXN_TYPE_DEF_N.TRANSACTION_TYPE_ID,
                :IF_TXN_TYPE_DEF_N.TRANSACTION_TYPE_NAME,
                :IF_TXN_TYPE_DEF_N.TRANSACTION_SOURCE_ID,
                :IF_TXN_TYPE_DEF_N.TRANSACTION_SOURCE_DESC,
                :IF_TXN_TYPE_DEF_N.USER_DEFINED_FLAG,
                :IF_TXN_TYPE_DEF_N.ISSUE_RECEIPT_FLAG,
                :IF_TXN_TYPE_DEF_N.TRANSACTION_ACTION_ID,
                :IF_TXN_TYPE_DEF_N.TRANSACTION_SOURCE_TYPE_ID,
                :IF_TXN_TYPE_DEF_N.TRANSACTION_SOURCE_TYPE_NAME,
                :IF_TXN_TYPE_DEF_N.MRO_FLAG,
                :IF_TXN_TYPE_DEF_N.ENABLED_FLAG,
                :IF_TXN_TYPE_DEF_N.DISABLE_DATE,
                :IF_TXN_TYPE_DEF_N.TRAN_FLAG,
                :IF_TXN_TYPE_DEF_N.CMF_1,
                :IF_TXN_TYPE_DEF_N.CMF_2,
                :IF_TXN_TYPE_DEF_N.CMF_3,
                :IF_TXN_TYPE_DEF_N.CMF_4,
                :IF_TXN_TYPE_DEF_N.CMF_5,
                :IF_TXN_TYPE_DEF_N.CMF_6,
                :IF_TXN_TYPE_DEF_N.CMF_7,
                :IF_TXN_TYPE_DEF_N.CMF_8,
                :IF_TXN_TYPE_DEF_N.CMF_9,
                :IF_TXN_TYPE_DEF_N.CMF_10,
                :IF_TXN_TYPE_DEF_N.CREATE_USER_ID,
                :IF_TXN_TYPE_DEF_N.CREATE_TIME,
                :IF_TXN_TYPE_DEF_N.UPDATE_USER_ID,
                :IF_TXN_TYPE_DEF_N.UPDATE_TIME;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_if_txn_type_def(&IF_TXN_TYPE_DEF_N, IF_TXN_TYPE_DEF);
    }

    DB_stop_query_timer("DBU_fetch_if_txn_type_def", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_if_txn_type_def(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_IF_TXN_TYPE_DEF_CUR_1;
            break;

		case 101:
            EXEC SQL CLOSE DBU_IF_TXN_TYPE_DEF_CUR_101;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_if_txn_type_def", sel_type);
}


/* Initialize Function */
void DBU_init_if_txn_type_def(struct IF_TXN_TYPE_DEF_TAG *IF_TXN_TYPE_DEF)
{
    /* memset by Space */
    memset(IF_TXN_TYPE_DEF, ' ', sizeof(struct IF_TXN_TYPE_DEF_TAG));
    
    IF_TXN_TYPE_DEF->IF_SEQ = 0;
    IF_TXN_TYPE_DEF->ORG_ID = 0;
    IF_TXN_TYPE_DEF->TRANSACTION_TYPE_ID = 0;
    IF_TXN_TYPE_DEF->TRANSACTION_SOURCE_ID = 0;
    IF_TXN_TYPE_DEF->TRANSACTION_ACTION_ID = 0;
    IF_TXN_TYPE_DEF->TRANSACTION_SOURCE_TYPE_ID = 0;
}


