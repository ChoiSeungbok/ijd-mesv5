                :CRETLOTSTS_N.CMF_5,
                :CRETLOTSTS_N.CMF_6,
                :CRETLOTSTS_N.CMF_7,
                :CRETLOTSTS_N.CMF_8,
                :CRETLOTSTS_N.CMF_9,
                :CRETLOTSTS_N.CMF_10,
                :CRETLOTSTS_N.CREATE_USER_ID,
                :CRETLOTSTS_N.CREATE_TIME,
                :CRETLOTSTS_N.UPDATE_USER_ID,
                :CRETLOTSTS_N.UPDATE_TIME;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_cretlotsts(&CRETLOTSTS_N, CRETLOTSTS);
    }

    DB_stop_query_timer("DBU_fetch_cretlotsts", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_cretlotsts(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CRETLOTSTS_CUR_1;
            break;

		case 2:
            EXEC SQL CLOSE DBU_CRETLOTSTS_CUR_2;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_cretlotsts", sel_type);
}


/* Initialize Function */
void DBU_init_cretlotsts(struct CRETLOTSTS_TAG *CRETLOTSTS)
{
    /* memset by Space */
    memset(CRETLOTSTS, ' ', sizeof(struct CRETLOTSTS_TAG));
    
    CRETLOTSTS->MAT_VER = 0;
    CRETLOTSTS->QTY = 0;
    CRETLOTSTS->RET_LINE_NO = 0;
    CRETLOTSTS->PACK_LINE_NO = 0;
    CRETLOTSTS->SHIP_ORDER_SEQ = 0;
}


/* Add Null Function */
void DBU_add_null_cretlotsts(struct CRETLOTSTS_N_TAG *CRETLOTSTS_N, struct CRETLOTSTS_TAG *CRETLOTSTS)
{
    /* memset by NULL */
    memset(CRETLOTSTS_N, '\0', sizeof(struct CRETLOTSTS_N_TAG));
    
    MEMCPY_AN(CRETLOTSTS_N->FACTORY, CRETLOTSTS->FACTORY, sizeof(CRETLOTSTS->FACTORY));
    MEMCPY_AN(CRETLOTSTS_N->RET_ORDER_ID, CRETLOTSTS->RET_ORDER_ID, sizeof(CRETLOTSTS->RET_ORDER_ID));
    MEMCPY_AN(CRETLOTSTS_N->LOT_ID, CRETLOTSTS->LOT_ID, sizeof(CRETLOTSTS->LOT_ID));
    MEMCPY_AN(CRETLOTSTS_N->RET_LOT_ID, CRETLOTSTS->RET_LOT_ID, sizeof(CRETLOTSTS->RET_LOT_ID));
    MEMCPY_AN(CRETLOTSTS_N->MAT_ID, CRETLOTSTS->MAT_ID, sizeof(CRETLOTSTS->MAT_ID));
    CRETLOTSTS_N->MAT_VER = CRETLOTSTS->MAT_VER;
    CRETLOTSTS_N->QTY = CRETLOTSTS->QTY;
    MEMCPY_AN(CRETLOTSTS_N->UNIT, CRETLOTSTS->UNIT, sizeof(CRETLOTSTS->UNIT));
    MEMCPY_AN(CRETLOTSTS_N->RET_DATE, CRETLOTSTS->RET_DATE, sizeof(CRETLOTSTS->RET_DATE));
    CRETLOTSTS_N->RET_LINE_NO = CRETLOTSTS->RET_LINE_NO;
    MEMCPY_AN(CRETLOTSTS_N->PACK_DATE, CRETLOTSTS->PACK_DATE, sizeof(CRETLOTSTS->PACK_DATE));
    MEMCPY_AN(CRETLOTSTS_N->PACK_ORDER_ID, CRETLOTSTS->PACK_ORDER_ID, sizeof(CRETLOTSTS->PACK_ORDER_ID));
    CRETLOTSTS_N->PACK_LINE_NO = CRETLOTSTS->PACK_LINE_NO;
    MEMCPY_AN(CRETLOTSTS_N->SHIP_DATE, CRETLOTSTS->SHIP_DATE, sizeof(CRETLOTSTS->SHIP_DATE));
    MEMCPY_AN(CRETLOTSTS_N->SHIP_ORDER_ID, CRETLOTSTS->SHIP_ORDER_ID, sizeof(CRETLOTSTS->SHIP_ORDER_ID));
    CRETLOTSTS_N->SHIP_ORDER_SEQ = CRETLOTSTS->SHIP_ORDER_SEQ;
    MEMCPY_AN(CRETLOTSTS_N->CMF_1, CRETLOTSTS->CMF_1, sizeof(CRETLOTSTS->CMF_1));
    MEMCPY_AN(CRETLOTSTS_N->CMF_2, CRETLOTSTS->CMF_2, sizeof(CRETLOTSTS->CMF_2));
    MEMCPY_AN(CRETLOTSTS_N->CMF_3, CRETLOTSTS->CMF_3, sizeof(CRETLOTSTS->CMF_3));
    MEMCPY_AN(CRETLOTSTS_N->CMF_4, CRETLOTSTS->CMF_4, sizeof(CRETLOTSTS->CMF_4));
    MEMCPY_AN(CRETLOTSTS_N->CMF_5, CRETLOTSTS->CMF_5, sizeof(CRETLOTSTS->CMF_5));
    MEMCPY_AN(CRETLOTSTS_N->CMF_6, CRETLOTSTS->CMF_6, sizeof(CRETLOTSTS->CMF_6));
    MEMCPY_AN(CRETLOTSTS_N->CMF_7, CRETLOTSTS->CMF_7, sizeof(CRETLOTSTS->CMF_7));
    MEMCPY_AN(CRETLOTSTS_N->CMF_8, CRETLOTSTS->CMF_8, sizeof(CRETLOTSTS->CMF_8));
    MEMCPY_AN(CRETLOTSTS_N->CMF_9, CRETLOTSTS->CMF_9, sizeof(CRETLOTSTS->CMF_9));
    MEMCPY_AN(CRETLOTSTS_N->CMF_10, CRETLOTSTS->CMF_10, sizeof(CRETLOTSTS->CMF_10));
    MEMCPY_AN(CRETLOTSTS_N->CREATE_USER_ID, CRETLOTSTS->CREATE_USER_ID, sizeof(CRETLOTSTS->CREATE_USER_ID));
    MEMCPY_AN(CRETLOTSTS_N->CREATE_TIME, CRETLOTSTS->CREATE_TIME, sizeof(CRETLOTSTS->CREATE_TIME));
    MEMCPY_AN(CRETLOTSTS_N->UPDATE_USER_ID, CRETLOTSTS->UPDATE_USER_ID, sizeof(CRETLOTSTS->UPDATE_USER_ID));
    MEMCPY_AN(CRETLOTSTS_N->UPDATE_TIME, CRETLOTSTS->UPDATE_TIME, sizeof(CRETLOTSTS->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_cretlotsts(struct CRETLOTSTS_N_TAG *CRETLOTSTS_N, struct CRETLOTSTS_TAG *CRETLOTSTS)
{
    MEMCPY_DN(CRETLOTSTS->FACTORY, CRETLOTSTS_N->FACTORY, sizeof(CRETLOTSTS->FACTORY));
    MEMCPY_DN(CRETLOTSTS->RET_ORDER_ID, CRETLOTSTS_N->RET_ORDER_ID, sizeof(CRETLOTSTS->RET_ORDER_ID));
    MEMCPY_DN(CRETLOTSTS->LOT_ID, CRETLOTSTS_N->LOT_ID, sizeof(CRETLOTSTS->LOT_ID));
    MEMCPY_DN(CRETLOTSTS->RET_LOT_ID, CRETLOTSTS_N->RET_LOT_ID, sizeof(CRETLOTSTS->RET_LOT_ID));
    MEMCPY_DN(CRETLOTSTS->MAT_ID, CRETLOTSTS_N->MAT_ID, sizeof(CRETLOTSTS->MAT_ID));
    CRETLOTSTS->MAT_VER = CRETLOTSTS_N->MAT_VER;
    CRETLOTSTS->QTY = CRETLOTSTS_N->QTY;
    MEMCPY_DN(CRETLOTSTS->UNIT, CRETLOTSTS_N->UNIT, sizeof(CRETLOTSTS->UNIT));
    MEMCPY_DN(CRETLOTSTS->RET_DATE, CRETLOTSTS_N->RET_DATE, sizeof(CRETLOTSTS->RET_DATE));
    CRETLOTSTS->RET_LINE_NO = CRETLOTSTS_N->RET_LINE_NO;
    MEMCPY_DN(CRETLOTSTS->PACK_DATE, CRETLOTSTS_N->PACK_DATE, sizeof(CRETLOTSTS->PACK_DATE));
    MEMCPY_DN(CRETLOTSTS->PACK_ORDER_ID, CRETLOTSTS_N->PACK_ORDER_ID, sizeof(CRETLOTSTS->PACK_ORDER_ID));
    CRETLOTSTS->PACK_LINE_NO = CRETLOTSTS_N->PACK_LINE_NO;
    MEMCPY_DN(CRETLOTSTS->SHIP_DATE, CRETLOTSTS_N->SHIP_DATE, sizeof(CRETLOTSTS->SHIP_DATE));
    MEMCPY_DN(CRETLOTSTS->SHIP_ORDER_ID, CRETLOTSTS_N->SHIP_ORDER_ID, sizeof(CRETLOTSTS->SHIP_ORDER_ID));
    CRETLOTSTS->SHIP_ORDER_SEQ = CRETLOTSTS_N->SHIP_ORDER_SEQ;
    MEMCPY_DN(CRETLOTSTS->CMF_1, CRETLOTSTS_N->CMF_1, sizeof(CRETLOTSTS->CMF_1));
    MEMCPY_DN(CRETLOTSTS->CMF_2, CRETLOTSTS_N->CMF_2, sizeof(CRETLOTSTS->CMF_2));
    MEMCPY_DN(CRETLOTSTS->CMF_3, CRETLOTSTS_N->CMF_3, sizeof(CRETLOTSTS->CMF_3));
    MEMCPY_DN(CRETLOTSTS->CMF_4, CRETLOTSTS_N->CMF_4, sizeof(CRETLOTSTS->CMF_4));
    MEMCPY_DN(CRETLOTSTS->CMF_5, CRETLOTSTS_N->CMF_5, sizeof(CRETLOTSTS->CMF_5));
    MEMCPY_DN(CRETLOTSTS->CMF_6, CRETLOTSTS_N->CMF_6, sizeof(CRETLOTSTS->CMF_6));
    MEMCPY_DN(CRETLOTSTS->CMF_7, CRETLOTSTS_N->CMF_7, sizeof(CRETLOTSTS->CMF_7));
    MEMCPY_DN(CRETLOTSTS->CMF_8, CRETLOTSTS_N->CMF_8, sizeof(CRETLOTSTS->CMF_8));
    MEMCPY_DN(CRETLOTSTS->CMF_9, CRETLOTSTS_N->CMF_9, sizeof(CRETLOTSTS->CMF_9));
    MEMCPY_DN(CRETLOTSTS->CMF_10, CRETLOTSTS_N->CMF_10, sizeof(CRETLOTSTS->CMF_10));
    MEMCPY_DN(CRETLOTSTS->CREATE_USER_ID, CRETLOTSTS_N->CREATE_USER_ID, sizeof(CRETLOTSTS->CREATE_USER_ID));
    MEMCPY_DN(CRETLOTSTS->CREATE_TIME, CRETLOTSTS_N->CREATE_TIME, sizeof(CRETLOTSTS->CREATE_TIME));
    MEMCPY_DN(CRETLOTSTS->UPDATE_USER_ID, CRETLOTSTS_N->UPDATE_USER_ID, sizeof(CRETLOTSTS->UPDATE_USER_ID));
    MEMCPY_DN(CRETLOTSTS->UPDATE_TIME, CRETLOTSTS_N->UPDATE_TIME, sizeof(CRETLOTSTS->UPDATE_TIME));
}


