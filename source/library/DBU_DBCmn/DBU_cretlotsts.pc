        struct CRETLOTSTS_N_TAG CRETLOTSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cretlotsts(&CRETLOTSTS_N, CRETLOTSTS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CRETLOTSTS_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    RET_ORDER_ID,
                    LOT_ID,
                    RET_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    RET_DATE,
                    RET_LINE_NO,
                    PACK_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CRETLOTSTS
                ORDER BY FACTORY ASC,
                    RET_ORDER_ID ASC,
                    LOT_ID ASC,
                    RET_LOT_ID ASC;
            EXEC SQL OPEN DBU_CRETLOTSTS_CUR_1;
            break;

		case 2:
            EXEC SQL DECLARE DBU_CRETLOTSTS_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    RET_ORDER_ID,
                    LOT_ID,
                    RET_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    RET_DATE,
                    RET_LINE_NO,
                    PACK_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CRETLOTSTS
				WHERE FACTORY = :CRETLOTSTS_N.FACTORY
				 AND RET_ORDER_ID = :CRETLOTSTS_N.RET_ORDER_ID
				 AND (RET_DATE || '00000000') BETWEEN :DBC_Q_COND_N.FROM_TIME  AND :DBC_Q_COND_N.TO_TIME
                ORDER BY FACTORY ASC,
                    RET_ORDER_ID ASC,
                    LOT_ID ASC,
                    RET_LOT_ID ASC;
            EXEC SQL OPEN DBU_CRETLOTSTS_CUR_2;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cretlotsts", sel_type);
}


