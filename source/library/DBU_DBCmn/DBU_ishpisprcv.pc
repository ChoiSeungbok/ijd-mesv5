    MEMCPY_AN(ISHPISPRCV_N->CHAR_ID, ISHPISPRCV->CHAR_ID, sizeof(ISHPISPRCV->CHAR_ID));
    ISHPISPRCV_N->CHAR_SEQ = ISHPISPRCV->CHAR_SEQ;
    ISHPISPRCV_N->UNIT_SEQ = ISHPISPRCV->UNIT_SEQ;
