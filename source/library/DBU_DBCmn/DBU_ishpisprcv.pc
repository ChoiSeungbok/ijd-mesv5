                    AND VALUE_SEQ = :ISHPISPRCV_N.VALUE_SEQ;
            break;

        case 2:
            EXEC SQL UPDATE ISHPISPRCV SET                
                    RECEIVE_FLAG = :ISHPISPRCV_N.RECEIVE_FLAG,
                    UPDATE_USER_ID = :ISHPISPRCV_N.UPDATE_USER_ID,
                    UPDATE_TIME = :ISHPISPRCV_N.UPDATE_TIME
                WHERE FACTORY = :ISHPISPRCV_N.FACTORY
                    AND PACK_LOT_ID = :ISHPISPRCV_N.PACK_LOT_ID
                    AND ORG_LOT_ID = :ISHPISPRCV_N.ORG_LOT_ID;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_update_ishpisprcv", sel_type);
}


/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_ishpisprcv(int sel_type, struct ISHPISPRCV_TAG *ISHPISPRCV)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct ISHPISPRCV_N_TAG ISHPISPRCV_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_ishpisprcv(&ISHPISPRCV_N, ISHPISPRCV);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_ISHPISPRCV_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    PACK_LOT_ID,
                    ORG_LOT_ID,
                    FROM_FACTORY,
                    INSP_ID,
                    COL_SET_ID,
                    COL_SET_VER,
                    CHAR_ID,
                    CHAR_SEQ,
                    UNIT_SEQ,
                    VALUE_SEQ,
                    UNIT_ID,
                    VALUE_TYPE,
                    VALUE_COUNT,
                    VALUE_1,
                    VALUE_2,
                    VALUE_3,
                    VALUE_4,
                    VALUE_5,
                    VALUE_6,
                    VALUE_7,
                    VALUE_8,
                    VALUE_9,
                    VALUE_10,
                    VALUE_11,
                    VALUE_12,
                    VALUE_13,
                    VALUE_14,
                    VALUE_15,
                    VALUE_16,
                    VALUE_17,
                    VALUE_18,
                    VALUE_19,
                    VALUE_20,
                    VALUE_21,
                    VALUE_22,
                    VALUE_23,
                    VALUE_24,
                    VALUE_25,
                    SAMPLE_COUNT,
                    SPEC_OUT_MASK,
                    INSP_JUDGE_FLAG,
                    INSP_JUDGE_TYPE,
                    INSP_JUDGE_TIME,
                    RECEIVE_FLAG,
                    DELETE_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM ISHPISPRCV
                ORDER BY FACTORY ASC,
                    PACK_LOT_ID ASC,
                    ORG_LOT_ID ASC,
                    INSP_ID ASC,
                    COL_SET_ID ASC,
                    CHAR_SEQ ASC,
                    UNIT_SEQ ASC,
                    VALUE_SEQ ASC;
            EXEC SQL OPEN DBU_ISHPISPRCV_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_ishpisprcv", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_ishpisprcv(int sel_type, struct ISHPISPRCV_TAG *ISHPISPRCV)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct ISHPISPRCV_N_TAG ISHPISPRCV_N;
    EXEC SQL END DECLARE SECTION;

