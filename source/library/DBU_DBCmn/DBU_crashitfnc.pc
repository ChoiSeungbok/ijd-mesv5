/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_crashitfnc(int sel_type, struct CRASHITFNC_TAG *CRASHITFNC)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CRASHITFNC_N_TAG CRASHITFNC_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_crashitfnc(&CRASHITFNC_N, CRASHITFNC);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CRASHITFNC_CUR_1 CURSOR FOR
                SELECT 
                    RES_ID,
                    HIST_SEQ,
                    WORK_TIME,
                    FACTORY,
                    WORK_DATE,
                    DAY_NIGHT,
                    SV_TEMP,
                    PV_TEMP,
                    TIME_RM,
                    VACCUM_PV1,
                    VACCUM_PV2,
                    THROTTLE_SV,
                    THROTTLE_PV,
                    THROTTLE_OUT,
                    RES_STATUS,
                    START_TIME,
                    END_TIME,
                    EVENT_ID,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CRASHITFNC
                ORDER BY RES_ID ASC,
                    HIST_SEQ ASC,
                    WORK_TIME ASC;
            EXEC SQL OPEN DBU_CRASHITFNC_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_crashitfnc", sel_type);
}


