    MEMCPY_AN(CRASHITFNC_N->TIME_RM, CRASHITFNC->TIME_RM, sizeof(CRASHITFNC->TIME_RM));
    CRASHITFNC_N->VACCUM_PV1 = CRASHITFNC->VACCUM_PV1;
    CRASHITFNC_N->VACCUM_PV2 = CRASHITFNC->VACCUM_PV2;
    CRASHITFNC_N->THROTTLE_SV = CRASHITFNC->THROTTLE_SV;
    CRASHITFNC_N->THROTTLE_PV = CRASHITFNC->THROTTLE_PV;
    CRASHITFNC_N->THROTTLE_OUT = CRASHITFNC->THROTTLE_OUT;
    CRASHITFNC_N->RES_STATUS[0] = CRASHITFNC->RES_STATUS;
    MEMCPY_AN(CRASHITFNC_N->START_TIME, CRASHITFNC->START_TIME, sizeof(CRASHITFNC->START_TIME));
    MEMCPY_AN(CRASHITFNC_N->END_TIME, CRASHITFNC->END_TIME, sizeof(CRASHITFNC->END_TIME));
