    MEMCPY_AN(CRASHITFNC_N->CMF_8, CRASHITFNC->CMF_8, sizeof(CRASHITFNC->CMF_8));
    MEMCPY_AN(CRASHITFNC_N->CMF_9, CRASHITFNC->CMF_9, sizeof(CRASHITFNC->CMF_9));
    MEMCPY_AN(CRASHITFNC_N->CMF_10, CRASHITFNC->CMF_10, sizeof(CRASHITFNC->CMF_10));
    MEMCPY_AN(CRASHITFNC_N->CREATE_USER_ID, CRASHITFNC->CREATE_USER_ID, sizeof(CRASHITFNC->CREATE_USER_ID));
    MEMCPY_AN(CRASHITFNC_N->CREATE_TIME, CRASHITFNC->CREATE_TIME, sizeof(CRASHITFNC->CREATE_TIME));
    MEMCPY_AN(CRASHITFNC_N->UPDATE_USER_ID, CRASHITFNC->UPDATE_USER_ID, sizeof(CRASHITFNC->UPDATE_USER_ID));
    MEMCPY_AN(CRASHITFNC_N->UPDATE_TIME, CRASHITFNC->UPDATE_TIME, sizeof(CRASHITFNC->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_crashitfnc(struct CRASHITFNC_N_TAG *CRASHITFNC_N, struct CRASHITFNC_TAG *CRASHITFNC)
{
    MEMCPY_DN(CRASHITFNC->RES_ID, CRASHITFNC_N->RES_ID, sizeof(CRASHITFNC->RES_ID));
    CRASHITFNC->HIST_SEQ = CRASHITFNC_N->HIST_SEQ;
