    memset(CRASHITFNC, ' ', sizeof(struct CRASHITFNC_TAG));
    
    CRASHITFNC->HIST_SEQ = 0;
    CRASHITFNC->SV_TEMP = 0;
    CRASHITFNC->PV_TEMP = 0;
    CRASHITFNC->VACCUM_PV1 = 0;
    CRASHITFNC->VACCUM_PV2 = 0;
    CRASHITFNC->THROTTLE_SV = 0;
    CRASHITFNC->THROTTLE_PV = 0;
    CRASHITFNC->THROTTLE_OUT = 0;
}


/* Add Null Function */
void DBU_add_null_crashitfnc(struct CRASHITFNC_N_TAG *CRASHITFNC_N, struct CRASHITFNC_TAG *CRASHITFNC)
{
    /* memset by NULL */
    memset(CRASHITFNC_N, '\0', sizeof(struct CRASHITFNC_N_TAG));
    
    MEMCPY_AN(CRASHITFNC_N->RES_ID, CRASHITFNC->RES_ID, sizeof(CRASHITFNC->RES_ID));
    CRASHITFNC_N->HIST_SEQ = CRASHITFNC->HIST_SEQ;
    MEMCPY_AN(CRASHITFNC_N->WORK_TIME, CRASHITFNC->WORK_TIME, sizeof(CRASHITFNC->WORK_TIME));
