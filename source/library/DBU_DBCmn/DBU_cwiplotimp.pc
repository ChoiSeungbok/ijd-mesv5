    CWIPLOTIMP->FLOW_SEQ_NUM = 0;
    CWIPLOTIMP->EDC_HIST_SEQ = 0;
    CWIPLOTIMP->FLATNESS_1 = 0;
    CWIPLOTIMP->FLATNESS_2 = 0;
    CWIPLOTIMP->FLATNESS_3 = 0;
    CWIPLOTIMP->FLATNESS_4 = 0;
    CWIPLOTIMP->FLATNESS_5 = 0;
    CWIPLOTIMP->WEIGHT = 0;
    CWIPLOTIMP->AIR_POCKET = 0;
    CWIPLOTIMP->IMPACT_TIME = 0;
}


