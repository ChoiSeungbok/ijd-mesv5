/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cwiplotimp(int sel_type, struct CWIPLOTIMP_TAG *CWIPLOTIMP)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CWIPLOTIMP_N_TAG CWIPLOTIMP_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cwiplotimp(&CWIPLOTIMP_N, CWIPLOTIMP);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CWIPLOTIMP_CUR_1 CURSOR FOR
                SELECT 
                    LOT_ID,
                    HIST_SEQ,
                    OPER,
                    MAT_ID,
                    FLOW,
                    FLOW_SEQ_NUM,
                    GRADE,
                    RES_ID,
                    FACTORY,
                    WORK_DATE,
                    WORK_TIME,
                    DAY_NIGHT,
                    EDC_HIST_SEQ,
                    RECIPE_ID,
                    START_TIME,
                    END_TIME,
                    JUDGMENT,
                    FLATNESS_1,
                    FLATNESS_2,
                    FLATNESS_3,
                    FLATNESS_4,
                    FLATNESS_5,
                    WEIGHT,
                    AIR_POCKET,
                    IMPACT_NO,
                    IMPACT_TIME,
                    AUTO_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPLOTIMP
                ORDER BY LOT_ID ASC,
                    HIST_SEQ ASC;
            EXEC SQL OPEN DBU_CWIPLOTIMP_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cwiplotimp", sel_type);
}


