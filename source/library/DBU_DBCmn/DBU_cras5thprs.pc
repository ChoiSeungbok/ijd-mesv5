                :CRAS5THPRS_N.PV_STROKE,
                :CRAS5THPRS_N.PV_CLW_IN_TEMP,
                :CRAS5THPRS_N.PV_CLW_OUT_TEMP,
                :CRAS5THPRS_N.PV_HDL_TEMP,
                :CRAS5THPRS_N.RES_STATUS,
                :CRAS5THPRS_N.START_TIME,
                :CRAS5THPRS_N.END_TIME,
                :CRAS5THPRS_N.EVENT_ID,
                :CRAS5THPRS_N.CMF_1,
                :CRAS5THPRS_N.CMF_2,
                :CRAS5THPRS_N.CMF_3,
                :CRAS5THPRS_N.CMF_4,
                :CRAS5THPRS_N.CMF_5,
                :CRAS5THPRS_N.CMF_6,
                :CRAS5THPRS_N.CMF_7,
                :CRAS5THPRS_N.CMF_8,
                :CRAS5THPRS_N.CMF_9,
                :CRAS5THPRS_N.CMF_10,
                :CRAS5THPRS_N.CREATE_USER_ID,
                :CRAS5THPRS_N.CREATE_TIME,
                :CRAS5THPRS_N.UPDATE_USER_ID,
                :CRAS5THPRS_N.UPDATE_TIME;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_cras5thprs(&CRAS5THPRS_N, CRAS5THPRS);
    }

    DB_stop_query_timer("DBU_fetch_cras5thprs", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_cras5thprs(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CRAS5THPRS_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_cras5thprs", sel_type);
}


/* Initialize Function */
void DBU_init_cras5thprs(struct CRAS5THPRS_TAG *CRAS5THPRS)
{
    /* memset by Space */
    memset(CRAS5THPRS, ' ', sizeof(struct CRAS5THPRS_TAG));
    
    CRAS5THPRS->HIST_SEQ = 0;
    CRAS5THPRS->SV_PRESSURE = 0;
    CRAS5THPRS->PV_PRESSURE = 0;
    CRAS5THPRS->SV_POWER = 0;
    CRAS5THPRS->PV_POWER = 0;
    CRAS5THPRS->PV_VOLT = 0;
    CRAS5THPRS->PV_ELECTRIC = 0;
    CRAS5THPRS->PV_RESISTANCE = 0;
    CRAS5THPRS->PV_STROKE = 0;
    CRAS5THPRS->PV_CLW_IN_TEMP = 0;
    CRAS5THPRS->PV_CLW_OUT_TEMP = 0;
    CRAS5THPRS->PV_HDL_TEMP = 0;
}


