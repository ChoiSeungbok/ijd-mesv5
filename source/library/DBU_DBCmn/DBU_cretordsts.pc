					LABEL_NAME = :CRETORDSTS_N.LABEL_NAME,
                    CMF_1 = :CRETORDSTS_N.CMF_1,
                    CMF_2 = :CRETORDSTS_N.CMF_2,
                    CMF_3 = :CRETORDSTS_N.CMF_3,
                    CMF_4 = :CRETORDSTS_N.CMF_4,
                    CMF_5 = :CRETORDSTS_N.CMF_5,
                    CMF_6 = :CRETORDSTS_N.CMF_6,
                    CMF_7 = :CRETORDSTS_N.CMF_7,
                    CMF_8 = :CRETORDSTS_N.CMF_8,
                    CMF_9 = :CRETORDSTS_N.CMF_9,
                    CMF_10 = :CRETORDSTS_N.CMF_10,
                    CREATE_USER_ID = :CRETORDSTS_N.CREATE_USER_ID,
                    CREATE_TIME = :CRETORDSTS_N.CREATE_TIME,
                    UPDATE_USER_ID = :CRETORDSTS_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CRETORDSTS_N.UPDATE_TIME
                WHERE FACTORY = :CRETORDSTS_N.FACTORY
                    AND RET_ORDER_ID = :CRETORDSTS_N.RET_ORDER_ID
                    AND RET_LOT_ID = :CRETORDSTS_N.RET_LOT_ID;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_update_cretordsts", sel_type);
}


/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cretordsts(int sel_type, struct CRETORDSTS_TAG *CRETORDSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CRETORDSTS_N_TAG CRETORDSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cretordsts(&CRETORDSTS_N, CRETORDSTS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CRETORDSTS_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    RET_ORDER_ID,
                    RET_LOT_ID,
                    LINE_NO,
                    RET_ORD_DATE,
                    MAT_ID,
                    MAT_VER,
                    CUSTOMER_ID,
					CUSTOMER_NUMBER,
					CUSTOMER_NAME,
					CUSTOMER_SITE_ID,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    QTY,
					RETURNED_QTY,
                    UNIT,
                    RET_ORD_STATUS,
                    RET_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
					SHIP_LINE_IF_ID,
					SHIP_LINE_LOT_IF_ID,
					REFERENCE_LINE_ID,
					OE_ORDER_HEADER_ID,
					OE_ORDER_LINE_ID,
					LABEL_NAME,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CRETORDSTS
                ORDER BY FACTORY ASC,
                    RET_ORDER_ID ASC,
                    RET_LOT_ID ASC;
            EXEC SQL OPEN DBU_CRETORDSTS_CUR_1;
            break;

		case 2:
            EXEC SQL DECLARE DBU_CRETORDSTS_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    RET_ORDER_ID,
                    RET_LOT_ID,
                    LINE_NO,
                    RET_ORD_DATE,
                    MAT_ID,
                    MAT_VER,
                    CUSTOMER_ID,
					CUSTOMER_NUMBER,
					CUSTOMER_NAME,
					CUSTOMER_SITE_ID,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    QTY,
					RETURNED_QTY,
                    UNIT,
                    RET_ORD_STATUS,
                    RET_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
					SHIP_LINE_IF_ID,
					SHIP_LINE_LOT_IF_ID,
					REFERENCE_LINE_ID,
					OE_ORDER_HEADER_ID,
					OE_ORDER_LINE_ID,
					LABEL_NAME,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CRETORDSTS
				WHERE FACTORY = :CRETORDSTS_N.FACTORY
				 AND ((:CRETORDSTS_N.CMF_1 = ' ') OR (CMF_1 = :CRETORDSTS_N.CMF_1))
				 AND ((:CRETORDSTS_N.MAT_ID = ' ') OR (MAT_ID = :CRETORDSTS_N.MAT_ID))
				 AND ((:CRETORDSTS_N.CUSTOMER_ID = ' ') OR (CUSTOMER_ID = :CRETORDSTS_N.CUSTOMER_ID))
				 AND AREA_ID = :CRETORDSTS_N.AREA_ID
				 AND RET_ORD_DATE BETWEEN :DBC_Q_COND_N.FROM_TIME  AND :DBC_Q_COND_N.TO_TIME
                ORDER BY FACTORY ASC,
                    RET_ORDER_ID ASC,
                    RET_LOT_ID ASC;
            EXEC SQL OPEN DBU_CRETORDSTS_CUR_2;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cretordsts", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_cretordsts(int sel_type, struct CRETORDSTS_TAG *CRETORDSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CRETORDSTS_N_TAG CRETORDSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_CRETORDSTS_CUR_1 INTO
                :CRETORDSTS_N.FACTORY,
                :CRETORDSTS_N.RET_ORDER_ID,
                :CRETORDSTS_N.RET_LOT_ID,
                :CRETORDSTS_N.LINE_NO,
                :CRETORDSTS_N.RET_ORD_DATE,
                :CRETORDSTS_N.MAT_ID,
                :CRETORDSTS_N.MAT_VER,
                :CRETORDSTS_N.CUSTOMER_ID,
				:CRETORDSTS_N.CUSTOMER_NUMBER,
				:CRETORDSTS_N.CUSTOMER_NAME,
				:CRETORDSTS_N.CUSTOMER_SITE_ID,
                :CRETORDSTS_N.AREA_ID,
                :CRETORDSTS_N.SUB_AREA_ID,
                :CRETORDSTS_N.OPER,
                :CRETORDSTS_N.QTY,
				:CRETORDSTS_N.RETURNED_QTY,
                :CRETORDSTS_N.UNIT,
                :CRETORDSTS_N.RET_ORD_STATUS,
                :CRETORDSTS_N.RET_DATE,
                :CRETORDSTS_N.SHIP_ORDER_ID,
                :CRETORDSTS_N.SHIP_ORDER_SEQ,
				:CRETORDSTS_N.SHIP_LINE_IF_ID,
				:CRETORDSTS_N.SHIP_LINE_LOT_IF_ID,
				:CRETORDSTS_N.REFERENCE_LINE_ID,
				:CRETORDSTS_N.OE_ORDER_HEADER_ID,
				:CRETORDSTS_N.OE_ORDER_LINE_ID,
				:CRETORDSTS_N.LABEL_NAME,
                :CRETORDSTS_N.CMF_1,
                :CRETORDSTS_N.CMF_2,
                :CRETORDSTS_N.CMF_3,
                :CRETORDSTS_N.CMF_4,
                :CRETORDSTS_N.CMF_5,
                :CRETORDSTS_N.CMF_6,
                :CRETORDSTS_N.CMF_7,
                :CRETORDSTS_N.CMF_8,
                :CRETORDSTS_N.CMF_9,
                :CRETORDSTS_N.CMF_10,
                :CRETORDSTS_N.CREATE_USER_ID,
                :CRETORDSTS_N.CREATE_TIME,
                :CRETORDSTS_N.UPDATE_USER_ID,
                :CRETORDSTS_N.UPDATE_TIME;
            break;

		case 2:
            EXEC SQL FETCH DBU_CRETORDSTS_CUR_2 INTO
                :CRETORDSTS_N.FACTORY,
                :CRETORDSTS_N.RET_ORDER_ID,
                :CRETORDSTS_N.RET_LOT_ID,
                :CRETORDSTS_N.LINE_NO,
                :CRETORDSTS_N.RET_ORD_DATE,
                :CRETORDSTS_N.MAT_ID,
                :CRETORDSTS_N.MAT_VER,
                :CRETORDSTS_N.CUSTOMER_ID,
				:CRETORDSTS_N.CUSTOMER_NUMBER,
				:CRETORDSTS_N.CUSTOMER_NAME,
				:CRETORDSTS_N.CUSTOMER_SITE_ID,
                :CRETORDSTS_N.AREA_ID,
                :CRETORDSTS_N.SUB_AREA_ID,
                :CRETORDSTS_N.OPER,
                :CRETORDSTS_N.QTY,
				:CRETORDSTS_N.RETURNED_QTY,
                :CRETORDSTS_N.UNIT,
                :CRETORDSTS_N.RET_ORD_STATUS,
                :CRETORDSTS_N.RET_DATE,
                :CRETORDSTS_N.SHIP_ORDER_ID,
                :CRETORDSTS_N.SHIP_ORDER_SEQ,
				:CRETORDSTS_N.SHIP_LINE_IF_ID,
				:CRETORDSTS_N.SHIP_LINE_LOT_IF_ID,
				:CRETORDSTS_N.REFERENCE_LINE_ID,
				:CRETORDSTS_N.OE_ORDER_HEADER_ID,
				:CRETORDSTS_N.OE_ORDER_LINE_ID,
				:CRETORDSTS_N.LABEL_NAME,
                :CRETORDSTS_N.CMF_1,
                :CRETORDSTS_N.CMF_2,
                :CRETORDSTS_N.CMF_3,
                :CRETORDSTS_N.CMF_4,
                :CRETORDSTS_N.CMF_5,
                :CRETORDSTS_N.CMF_6,
                :CRETORDSTS_N.CMF_7,
                :CRETORDSTS_N.CMF_8,
                :CRETORDSTS_N.CMF_9,
                :CRETORDSTS_N.CMF_10,
                :CRETORDSTS_N.CREATE_USER_ID,
                :CRETORDSTS_N.CREATE_TIME,
                :CRETORDSTS_N.UPDATE_USER_ID,
                :CRETORDSTS_N.UPDATE_TIME;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_cretordsts(&CRETORDSTS_N, CRETORDSTS);
    }

    DB_stop_query_timer("DBU_fetch_cretordsts", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_cretordsts(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CRETORDSTS_CUR_1;
            break;

		case 2:
            EXEC SQL CLOSE DBU_CRETORDSTS_CUR_2;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_cretordsts", sel_type);
}


/* Initialize Function */
void DBU_init_cretordsts(struct CRETORDSTS_TAG *CRETORDSTS)
{
    /* memset by Space */
    memset(CRETORDSTS, ' ', sizeof(struct CRETORDSTS_TAG));
    
    CRETORDSTS->LINE_NO = 0;
    CRETORDSTS->MAT_VER = 0;
    CRETORDSTS->QTY = 0;
	CRETORDSTS->RETURNED_QTY = 0;
    CRETORDSTS->SHIP_ORDER_SEQ = 0;
	CRETORDSTS->SHIP_LINE_IF_ID = 0;
	CRETORDSTS->SHIP_LINE_LOT_IF_ID = 0;
	CRETORDSTS->REFERENCE_LINE_ID = 0;
	CRETORDSTS->OE_ORDER_HEADER_ID = 0;
	CRETORDSTS->OE_ORDER_LINE_ID = 0;
}


/* Add Null Function */
void DBU_add_null_cretordsts(struct CRETORDSTS_N_TAG *CRETORDSTS_N, struct CRETORDSTS_TAG *CRETORDSTS)
{
    /* memset by NULL */
    memset(CRETORDSTS_N, '\0', sizeof(struct CRETORDSTS_N_TAG));
    
    MEMCPY_AN(CRETORDSTS_N->FACTORY, CRETORDSTS->FACTORY, sizeof(CRETORDSTS->FACTORY));
    MEMCPY_AN(CRETORDSTS_N->RET_ORDER_ID, CRETORDSTS->RET_ORDER_ID, sizeof(CRETORDSTS->RET_ORDER_ID));
    MEMCPY_AN(CRETORDSTS_N->RET_LOT_ID, CRETORDSTS->RET_LOT_ID, sizeof(CRETORDSTS->RET_LOT_ID));
    CRETORDSTS_N->LINE_NO = CRETORDSTS->LINE_NO;
    MEMCPY_AN(CRETORDSTS_N->RET_ORD_DATE, CRETORDSTS->RET_ORD_DATE, sizeof(CRETORDSTS->RET_ORD_DATE));
    MEMCPY_AN(CRETORDSTS_N->MAT_ID, CRETORDSTS->MAT_ID, sizeof(CRETORDSTS->MAT_ID));
    CRETORDSTS_N->MAT_VER = CRETORDSTS->MAT_VER;
    MEMCPY_AN(CRETORDSTS_N->CUSTOMER_ID, CRETORDSTS->CUSTOMER_ID, sizeof(CRETORDSTS->CUSTOMER_ID));
	MEMCPY_AN(CRETORDSTS_N->CUSTOMER_NUMBER, CRETORDSTS->CUSTOMER_NUMBER, sizeof(CRETORDSTS->CUSTOMER_NUMBER));
	MEMCPY_AN(CRETORDSTS_N->CUSTOMER_NAME, CRETORDSTS->CUSTOMER_NAME, sizeof(CRETORDSTS->CUSTOMER_NAME));
	CRETORDSTS_N->CUSTOMER_SITE_ID = CRETORDSTS->CUSTOMER_SITE_ID;
    MEMCPY_AN(CRETORDSTS_N->AREA_ID, CRETORDSTS->AREA_ID, sizeof(CRETORDSTS->AREA_ID));
    MEMCPY_AN(CRETORDSTS_N->SUB_AREA_ID, CRETORDSTS->SUB_AREA_ID, sizeof(CRETORDSTS->SUB_AREA_ID));
    MEMCPY_AN(CRETORDSTS_N->OPER, CRETORDSTS->OPER, sizeof(CRETORDSTS->OPER));
    CRETORDSTS_N->QTY = CRETORDSTS->QTY;
	CRETORDSTS_N->RETURNED_QTY = CRETORDSTS->RETURNED_QTY;
    MEMCPY_AN(CRETORDSTS_N->UNIT, CRETORDSTS->UNIT, sizeof(CRETORDSTS->UNIT));
    MEMCPY_AN(CRETORDSTS_N->RET_ORD_STATUS, CRETORDSTS->RET_ORD_STATUS, sizeof(CRETORDSTS->RET_ORD_STATUS));
    MEMCPY_AN(CRETORDSTS_N->RET_DATE, CRETORDSTS->RET_DATE, sizeof(CRETORDSTS->RET_DATE));
    MEMCPY_AN(CRETORDSTS_N->SHIP_ORDER_ID, CRETORDSTS->SHIP_ORDER_ID, sizeof(CRETORDSTS->SHIP_ORDER_ID));
    CRETORDSTS_N->SHIP_ORDER_SEQ = CRETORDSTS->SHIP_ORDER_SEQ;
	CRETORDSTS_N->SHIP_LINE_IF_ID = CRETORDSTS->SHIP_LINE_IF_ID;
	CRETORDSTS_N->SHIP_LINE_LOT_IF_ID = CRETORDSTS->SHIP_LINE_LOT_IF_ID;
	CRETORDSTS_N->REFERENCE_LINE_ID = CRETORDSTS->REFERENCE_LINE_ID;
	CRETORDSTS_N->OE_ORDER_HEADER_ID = CRETORDSTS->OE_ORDER_HEADER_ID;
	CRETORDSTS_N->OE_ORDER_LINE_ID = CRETORDSTS->OE_ORDER_LINE_ID;
	MEMCPY_AN(CRETORDSTS_N->LABEL_NAME, CRETORDSTS->LABEL_NAME, sizeof(CRETORDSTS->LABEL_NAME));
    MEMCPY_AN(CRETORDSTS_N->CMF_1, CRETORDSTS->CMF_1, sizeof(CRETORDSTS->CMF_1));
    MEMCPY_AN(CRETORDSTS_N->CMF_2, CRETORDSTS->CMF_2, sizeof(CRETORDSTS->CMF_2));
    MEMCPY_AN(CRETORDSTS_N->CMF_3, CRETORDSTS->CMF_3, sizeof(CRETORDSTS->CMF_3));
    MEMCPY_AN(CRETORDSTS_N->CMF_4, CRETORDSTS->CMF_4, sizeof(CRETORDSTS->CMF_4));
    MEMCPY_AN(CRETORDSTS_N->CMF_5, CRETORDSTS->CMF_5, sizeof(CRETORDSTS->CMF_5));
    MEMCPY_AN(CRETORDSTS_N->CMF_6, CRETORDSTS->CMF_6, sizeof(CRETORDSTS->CMF_6));
    MEMCPY_AN(CRETORDSTS_N->CMF_7, CRETORDSTS->CMF_7, sizeof(CRETORDSTS->CMF_7));
    MEMCPY_AN(CRETORDSTS_N->CMF_8, CRETORDSTS->CMF_8, sizeof(CRETORDSTS->CMF_8));
    MEMCPY_AN(CRETORDSTS_N->CMF_9, CRETORDSTS->CMF_9, sizeof(CRETORDSTS->CMF_9));
    MEMCPY_AN(CRETORDSTS_N->CMF_10, CRETORDSTS->CMF_10, sizeof(CRETORDSTS->CMF_10));
    MEMCPY_AN(CRETORDSTS_N->CREATE_USER_ID, CRETORDSTS->CREATE_USER_ID, sizeof(CRETORDSTS->CREATE_USER_ID));
    MEMCPY_AN(CRETORDSTS_N->CREATE_TIME, CRETORDSTS->CREATE_TIME, sizeof(CRETORDSTS->CREATE_TIME));
    MEMCPY_AN(CRETORDSTS_N->UPDATE_USER_ID, CRETORDSTS->UPDATE_USER_ID, sizeof(CRETORDSTS->UPDATE_USER_ID));
    MEMCPY_AN(CRETORDSTS_N->UPDATE_TIME, CRETORDSTS->UPDATE_TIME, sizeof(CRETORDSTS->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_cretordsts(struct CRETORDSTS_N_TAG *CRETORDSTS_N, struct CRETORDSTS_TAG *CRETORDSTS)
{
    MEMCPY_DN(CRETORDSTS->FACTORY, CRETORDSTS_N->FACTORY, sizeof(CRETORDSTS->FACTORY));
    MEMCPY_DN(CRETORDSTS->RET_ORDER_ID, CRETORDSTS_N->RET_ORDER_ID, sizeof(CRETORDSTS->RET_ORDER_ID));
    MEMCPY_DN(CRETORDSTS->RET_LOT_ID, CRETORDSTS_N->RET_LOT_ID, sizeof(CRETORDSTS->RET_LOT_ID));
