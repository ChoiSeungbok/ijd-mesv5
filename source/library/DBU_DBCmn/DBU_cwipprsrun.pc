    MEMCPY_AN(CWIPPRSRUN_N->CREATE_TIME, CWIPPRSRUN->CREATE_TIME, sizeof(CWIPPRSRUN->CREATE_TIME));
    MEMCPY_AN(CWIPPRSRUN_N->UPDATE_USER_ID, CWIPPRSRUN->UPDATE_USER_ID, sizeof(CWIPPRSRUN->UPDATE_USER_ID));
    MEMCPY_AN(CWIPPRSRUN_N->UPDATE_TIME, CWIPPRSRUN->UPDATE_TIME, sizeof(CWIPPRSRUN->UPDATE_TIME));
}


