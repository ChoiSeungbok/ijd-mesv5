/* SQL CURSOR CLOSE Function */
void DBU_close_cwipprsrun(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CWIPPRSRUN_CUR_1;
            break;

        case 2:
            EXEC SQL CLOSE DBU_CWIPPRSRUN_CUR_2;
            break;

        case 3:
            EXEC SQL CLOSE DBU_CWIPPRSRUN_CUR_3;
            break;

        case 4:
            EXEC SQL CLOSE DBU_CWIPPRSRUN_CUR_4;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_cwipprsrun", sel_type);
}


/* Initialize Function */
void DBU_init_cwipprsrun(struct CWIPPRSRUN_TAG *CWIPPRSRUN)
{
    /* memset by Space */
    memset(CWIPPRSRUN, ' ', sizeof(struct CWIPPRSRUN_TAG));
    
    CWIPPRSRUN->RUN_COUNT = 0;
    CWIPPRSRUN->MAPPING_SEQ = 0;
    CWIPPRSRUN->ORG_LOT_HIST_SEQ = 0;
    CWIPPRSRUN->CELL_WEIGHT = 0;
    CWIPPRSRUN->CELL_HEIGHT = 0;
    CWIPPRSRUN->SET_VOLTAGE = 0;
    CWIPPRSRUN->SET_POWER_1 = 0;
    CWIPPRSRUN->SET_POWER_2 = 0;
    CWIPPRSRUN->SET_POWER_3 = 0;
}


/* Add Null Function */
void DBU_add_null_cwipprsrun(struct CWIPPRSRUN_N_TAG *CWIPPRSRUN_N, struct CWIPPRSRUN_TAG *CWIPPRSRUN)
{
    /* memset by NULL */
    memset(CWIPPRSRUN_N, '\0', sizeof(struct CWIPPRSRUN_N_TAG));
    
    MEMCPY_AN(CWIPPRSRUN_N->FACTORY, CWIPPRSRUN->FACTORY, sizeof(CWIPPRSRUN->FACTORY));
    MEMCPY_AN(CWIPPRSRUN_N->WORK_DATE, CWIPPRSRUN->WORK_DATE, sizeof(CWIPPRSRUN->WORK_DATE));
    MEMCPY_AN(CWIPPRSRUN_N->RES_ID, CWIPPRSRUN->RES_ID, sizeof(CWIPPRSRUN->RES_ID));
    CWIPPRSRUN_N->RUN_COUNT = CWIPPRSRUN->RUN_COUNT;
    MEMCPY_AN(CWIPPRSRUN_N->CELL_ID, CWIPPRSRUN->CELL_ID, sizeof(CWIPPRSRUN->CELL_ID));
    MEMCPY_AN(CWIPPRSRUN_N->LOT_ID, CWIPPRSRUN->LOT_ID, sizeof(CWIPPRSRUN->LOT_ID));
    CWIPPRSRUN_N->MAPPING_SEQ = CWIPPRSRUN->MAPPING_SEQ;
    CWIPPRSRUN_N->LOSS_YN[0] = CWIPPRSRUN->LOSS_YN;
    MEMCPY_AN(CWIPPRSRUN_N->CAR, CWIPPRSRUN->CAR, sizeof(CWIPPRSRUN->CAR));
    CWIPPRSRUN_N->DAY_NIGHT[0] = CWIPPRSRUN->DAY_NIGHT;
    MEMCPY_AN(CWIPPRSRUN_N->MAT_ID, CWIPPRSRUN->MAT_ID, sizeof(CWIPPRSRUN->MAT_ID));
    MEMCPY_AN(CWIPPRSRUN_N->AREA_ID, CWIPPRSRUN->AREA_ID, sizeof(CWIPPRSRUN->AREA_ID));
    MEMCPY_AN(CWIPPRSRUN_N->SUB_AREA_ID, CWIPPRSRUN->SUB_AREA_ID, sizeof(CWIPPRSRUN->SUB_AREA_ID));
    MEMCPY_AN(CWIPPRSRUN_N->OPER, CWIPPRSRUN->OPER, sizeof(CWIPPRSRUN->OPER));
    MEMCPY_AN(CWIPPRSRUN_N->TRAN_TIME, CWIPPRSRUN->TRAN_TIME, sizeof(CWIPPRSRUN->TRAN_TIME));
    MEMCPY_AN(CWIPPRSRUN_N->ORG_LOT_ID, CWIPPRSRUN->ORG_LOT_ID, sizeof(CWIPPRSRUN->ORG_LOT_ID));
    CWIPPRSRUN_N->ORG_LOT_HIST_SEQ = CWIPPRSRUN->ORG_LOT_HIST_SEQ;
    CWIPPRSRUN_N->CELL_WEIGHT = CWIPPRSRUN->CELL_WEIGHT;
    CWIPPRSRUN_N->CELL_HEIGHT = CWIPPRSRUN->CELL_HEIGHT;
    MEMCPY_AN(CWIPPRSRUN_N->PROFILE_ID, CWIPPRSRUN->PROFILE_ID, sizeof(CWIPPRSRUN->PROFILE_ID));
    CWIPPRSRUN_N->SET_VOLTAGE = CWIPPRSRUN->SET_VOLTAGE;
    CWIPPRSRUN_N->SET_POWER_1 = CWIPPRSRUN->SET_POWER_1;
    CWIPPRSRUN_N->SET_POWER_2 = CWIPPRSRUN->SET_POWER_2;
    CWIPPRSRUN_N->SET_POWER_3 = CWIPPRSRUN->SET_POWER_3;
    MEMCPY_AN(CWIPPRSRUN_N->CMF_1, CWIPPRSRUN->CMF_1, sizeof(CWIPPRSRUN->CMF_1));
    MEMCPY_AN(CWIPPRSRUN_N->CMF_2, CWIPPRSRUN->CMF_2, sizeof(CWIPPRSRUN->CMF_2));
    MEMCPY_AN(CWIPPRSRUN_N->CMF_3, CWIPPRSRUN->CMF_3, sizeof(CWIPPRSRUN->CMF_3));
    MEMCPY_AN(CWIPPRSRUN_N->CMF_4, CWIPPRSRUN->CMF_4, sizeof(CWIPPRSRUN->CMF_4));
    MEMCPY_AN(CWIPPRSRUN_N->CMF_5, CWIPPRSRUN->CMF_5, sizeof(CWIPPRSRUN->CMF_5));
