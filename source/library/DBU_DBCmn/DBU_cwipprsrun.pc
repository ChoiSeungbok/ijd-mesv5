                    SUB_AREA_ID,
                    OPER,
                    TRAN_TIME,
                    ORG_LOT_ID,
                    ORG_LOT_HIST_SEQ,
                    CELL_WEIGHT,
                    CELL_HEIGHT,
                    PROFILE_ID,
                    SET_VOLTAGE,
                    SET_POWER_1,
                    SET_POWER_2,
                    SET_POWER_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPPRSRUN
                ORDER BY FACTORY ASC,
                    WORK_DATE ASC,
                    RES_ID ASC,
                    RUN_COUNT ASC,
                    CELL_ID ASC,
                    LOT_ID ASC;
            EXEC SQL OPEN DBU_CWIPPRSRUN_CUR_1;
            break;

              case 2:
            EXEC SQL DECLARE DBU_CWIPPRSRUN_CUR_2 CURSOR FOR
               SELECT 
                    FACTORY,
                    WORK_DATE,
                    RES_ID,
                    RUN_COUNT,
                    CELL_ID,
                    LOT_ID,
                    MAPPING_SEQ,
                    LOSS_YN,
                    CAR,
                    DAY_NIGHT,
                    MAT_ID,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    TRAN_TIME,
                    ORG_LOT_ID,
                    ORG_LOT_HIST_SEQ,
                    CELL_WEIGHT,
                    CELL_HEIGHT,
                    PROFILE_ID,
                    SET_VOLTAGE,
                    SET_POWER_1,
                    SET_POWER_2,
                    SET_POWER_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPPRSRUN
                WHERE FACTORY = :CWIPPRSRUN_N.FACTORY
                    AND CELL_ID = :CWIPPRSRUN_N.CELL_ID
                ORDER BY CELL_ID ASC,
                    MAPPING_SEQ ASC;
            EXEC SQL OPEN DBU_CWIPPRSRUN_CUR_2;
            break;

        case 3:
            EXEC SQL DECLARE DBU_CWIPPRSRUN_CUR_3 CURSOR FOR
               SELECT 
                    FACTORY,
                    WORK_DATE,
                    RES_ID,
                    RUN_COUNT,
                    CELL_ID,
                    LOT_ID,
                    MAPPING_SEQ,
                    LOSS_YN,
                    CAR,
                    DAY_NIGHT,
                    MAT_ID,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    TRAN_TIME,
                    ORG_LOT_ID,
                    ORG_LOT_HIST_SEQ,
                    CELL_WEIGHT,
                    CELL_HEIGHT,
                    PROFILE_ID,
                    SET_VOLTAGE,
                    SET_POWER_1,
                    SET_POWER_2,
                    SET_POWER_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPPRSRUN
                WHERE FACTORY = :CWIPPRSRUN_N.FACTORY
                  AND WORK_DATE = :CWIPPRSRUN_N.WORK_DATE
                  AND RES_ID = :CWIPPRSRUN_N.RES_ID
                  AND MAT_ID = :CWIPPRSRUN_N.MAT_ID
                 ORDER BY LOT_ID;
            EXEC SQL OPEN DBU_CWIPPRSRUN_CUR_3;
            break;

      case 4:
            EXEC SQL DECLARE DBU_CWIPPRSRUN_CUR_4 CURSOR FOR
               SELECT 
                    A.FACTORY,
                    A.WORK_DATE,
                    A.RES_ID,
                    A.RUN_COUNT,
                    A.CELL_ID,
                    A.LOT_ID,
                    A.MAPPING_SEQ,
                    A.LOSS_YN,
                    A.CAR,
                    A.DAY_NIGHT,
                    A.MAT_ID,
                    A.AREA_ID,
                    A.SUB_AREA_ID,
                    A.OPER,
                    A.TRAN_TIME,
                    A.ORG_LOT_ID,
                    A.ORG_LOT_HIST_SEQ,
                    A.CELL_WEIGHT,
                    A.CELL_HEIGHT,
                    A.PROFILE_ID,
                    A.SET_VOLTAGE,
                    A.SET_POWER_1,
                    A.SET_POWER_2,
                    A.SET_POWER_3,
                    A.CMF_1,
                    A.CMF_2,
                    A.CMF_3,
                    A.CMF_4,
                    A.CMF_5,
                    A.CMF_6,
                    A.CMF_7,
                    A.CMF_8,
                    A.CMF_9,
                    A.CMF_10,
                    A.CREATE_USER_ID,
                    A.CREATE_TIME,
                    A.UPDATE_USER_ID,
                    A.UPDATE_TIME
                FROM CWIPPRSRUN A, CWIPLOTMVR B
                WHERE A.FACTORY = B.FACTORY 
                  AND A.LOT_ID = B.LOT_ID
                  AND A.FACTORY = :CWIPPRSRUN_N.FACTORY
                  AND A.WORK_DATE = :CWIPPRSRUN_N.WORK_DATE
                  AND A.RES_ID = :CWIPPRSRUN_N.RES_ID
                  AND A.MAT_ID = :CWIPPRSRUN_N.MAT_ID
                  AND B.MOVE_ID = :CWIPPRSRUN_N.CMF_10
                 ORDER BY A.LOT_ID;
            EXEC SQL OPEN DBU_CWIPPRSRUN_CUR_4;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cwipprsrun", sel_type);
}


