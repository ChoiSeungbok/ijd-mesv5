                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM IF_WO_BOM_INFO
                ORDER BY IF_SEQ ASC;
            EXEC SQL OPEN DBU_IF_WO_BOM_INFO_CUR_1;
            break;

		case 101:
            EXEC SQL DECLARE DBU_IF_WO_BOM_INFO_CUR_101 CURSOR FOR
                SELECT * FROM (
					SELECT 
						IF_SEQ,
						IF_TIME,
						IF_CODE,
						IF_MSG,
						FACTORY,
						ORG_ID,
						ORG_CODE,
						WIP_ENTITY_ID,
						WIP_ENTITY_NAME,
						ITEM_ID,
						ITEM_CODE,
						COMP_ITEM_ID,
						COMP_ITEM_CODE,
						COMP_ITEM_DESC,
						COMP_ITEM_TYPE,
						COMP_ITEM_UNIT,
						ALTERNATE_BOM_DESIGNATOR,
						ALTER_RTG_NAME,
						OPER_SEQ,
						OPER_ID,
						OPER,
						OPER_DESC,
						DEPT_ID,
						DEPT_CODE,
						DEPT_DESC,
						TOTAL_QTY,
						ISSUED_QTY,
						UNIT_QTY,
						SUPPLY_TYPE,
						SUPPLY_TYPE_NAME,
						SUPPLY_INV_OPER,
						TRAN_FLAG,
						CMF_1,
						CMF_2,
						CMF_3,
						CMF_4,
						CMF_5,
						CMF_6,
						CMF_7,
						CMF_8,
						CMF_9,
						CMF_10,
						CREATE_USER_ID,
						CREATE_TIME,
						UPDATE_USER_ID,
						UPDATE_TIME
					FROM IF_WO_BOM_INFO
					WHERE IF_CODE in ( 'N', 'R')
					ORDER BY IF_SEQ ASC)
				WHERE ROWNUM <= 10000
				;
            EXEC SQL OPEN DBU_IF_WO_BOM_INFO_CUR_101;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_if_wo_bom_info", sel_type);
}


