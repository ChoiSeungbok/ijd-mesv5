    memset(IF_WO_BOM_INFO, ' ', sizeof(struct IF_WO_BOM_INFO_TAG));
    
    IF_WO_BOM_INFO->IF_SEQ = 0;
    IF_WO_BOM_INFO->ORG_ID = 0;
