/* Add Null Function */
void DBU_add_null_cbasshpbom(struct CBASSHPBOM_N_TAG *CBASSHPBOM_N, struct CBASSHPBOM_TAG *CBASSHPBOM)
{
    /* memset by NULL */
    memset(CBASSHPBOM_N, '\0', sizeof(struct CBASSHPBOM_N_TAG));
    
    MEMCPY_AN(CBASSHPBOM_N->FACTORY, CBASSHPBOM->FACTORY, sizeof(CBASSHPBOM->FACTORY));
    MEMCPY_AN(CBASSHPBOM_N->MAT_ID, CBASSHPBOM->MAT_ID, sizeof(CBASSHPBOM->MAT_ID));
    MEMCPY_AN(CBASSHPBOM_N->BOM_MAT_ID, CBASSHPBOM->BOM_MAT_ID, sizeof(CBASSHPBOM->BOM_MAT_ID));
    CBASSHPBOM_N->QTY = CBASSHPBOM->QTY;
    MEMCPY_AN(CBASSHPBOM_N->REMARKS, CBASSHPBOM->REMARKS, sizeof(CBASSHPBOM->REMARKS));
    MEMCPY_AN(CBASSHPBOM_N->CREATE_USER_ID, CBASSHPBOM->CREATE_USER_ID, sizeof(CBASSHPBOM->CREATE_USER_ID));
    MEMCPY_AN(CBASSHPBOM_N->CREATE_TIME, CBASSHPBOM->CREATE_TIME, sizeof(CBASSHPBOM->CREATE_TIME));
    MEMCPY_AN(CBASSHPBOM_N->UPDATE_USER_ID, CBASSHPBOM->UPDATE_USER_ID, sizeof(CBASSHPBOM->UPDATE_USER_ID));
    MEMCPY_AN(CBASSHPBOM_N->UPDATE_TIME, CBASSHPBOM->UPDATE_TIME, sizeof(CBASSHPBOM->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_cbasshpbom(struct CBASSHPBOM_N_TAG *CBASSHPBOM_N, struct CBASSHPBOM_TAG *CBASSHPBOM)
{
    MEMCPY_DN(CBASSHPBOM->FACTORY, CBASSHPBOM_N->FACTORY, sizeof(CBASSHPBOM->FACTORY));
    MEMCPY_DN(CBASSHPBOM->MAT_ID, CBASSHPBOM_N->MAT_ID, sizeof(CBASSHPBOM->MAT_ID));
    MEMCPY_DN(CBASSHPBOM->BOM_MAT_ID, CBASSHPBOM_N->BOM_MAT_ID, sizeof(CBASSHPBOM->BOM_MAT_ID));
    CBASSHPBOM->QTY = CBASSHPBOM_N->QTY;
    MEMCPY_DN(CBASSHPBOM->REMARKS, CBASSHPBOM_N->REMARKS, sizeof(CBASSHPBOM->REMARKS));
    MEMCPY_DN(CBASSHPBOM->CREATE_USER_ID, CBASSHPBOM_N->CREATE_USER_ID, sizeof(CBASSHPBOM->CREATE_USER_ID));
    MEMCPY_DN(CBASSHPBOM->CREATE_TIME, CBASSHPBOM_N->CREATE_TIME, sizeof(CBASSHPBOM->CREATE_TIME));
    MEMCPY_DN(CBASSHPBOM->UPDATE_USER_ID, CBASSHPBOM_N->UPDATE_USER_ID, sizeof(CBASSHPBOM->UPDATE_USER_ID));
    MEMCPY_DN(CBASSHPBOM->UPDATE_TIME, CBASSHPBOM_N->UPDATE_TIME, sizeof(CBASSHPBOM->UPDATE_TIME));
}


