                    MAT_ID,
                    MAT_VER,
                    QTY,
					SHIPPED_QTY,
                    UNIT,
                    SHIP_ORD_STATUS,
                    SHIP_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
					SHIPPING_LINE_ID,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME,
					DELETE_FLAG
                FROM CSHPORDDTL
                WHERE FACTORY = :CSHPORDDTL_N.FACTORY
                    AND SHIP_ORDER_ID = :CSHPORDDTL_N.SHIP_ORDER_ID
                ORDER BY MAT_ID, QTY DESC;
            EXEC SQL OPEN DBU_CSHPORDDTL_CUR_3;
            break;

		case 4:
            EXEC SQL DECLARE DBU_CSHPORDDTL_CUR_4 CURSOR FOR
                SELECT 
                    FACTORY,
                    SHIP_ORDER_ID,
                    SEQ,
                    MAT_ID,
                    MAT_VER,
                    QTY,
					SHIPPED_QTY,
                    UNIT,
                    SHIP_ORD_STATUS,
                    SHIP_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
					SHIPPING_LINE_ID,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME,
					DELETE_FLAG
                FROM CSHPORDDTL
                WHERE FACTORY = :CSHPORDDTL_N.FACTORY
                    AND SHIP_ORDER_ID = :CSHPORDDTL_N.SHIP_ORDER_ID
					AND PACK_ORDER_ID = :CSHPORDDTL_N.PACK_ORDER_ID
					AND PACK_LINE_NO = :CSHPORDDTL_N.PACK_LINE_NO
                ORDER BY MAT_ID, QTY DESC;
            EXEC SQL OPEN DBU_CSHPORDDTL_CUR_4;
            break;
        
        
        case 5:
            EXEC SQL DECLARE DBU_CSHPORDDTL_CUR_5 CURSOR FOR
                SELECT 
                    FACTORY,
                    SHIP_ORDER_ID,
                    SEQ,
                    MAT_ID,
                    MAT_VER,
                    QTY,
					SHIPPED_QTY,
                    UNIT,
                    SHIP_ORD_STATUS,
                    SHIP_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
					SHIPPING_LINE_ID,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME,
					DELETE_FLAG
                FROM CSHPORDDTL
                WHERE FACTORY = :CSHPORDDTL_N.FACTORY
                    AND SHIP_ORDER_ID = :CSHPORDDTL_N.SHIP_ORDER_ID
					AND PACK_ORDER_ID = :CSHPORDDTL_N.PACK_ORDER_ID
					AND PACK_LINE_NO = :CSHPORDDTL_N.PACK_LINE_NO
                    AND SEQ = :CSHPORDDTL_N.SEQ
                ORDER BY MAT_ID, QTY DESC;
            EXEC SQL OPEN DBU_CSHPORDDTL_CUR_5;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cshporddtl", sel_type);
}


