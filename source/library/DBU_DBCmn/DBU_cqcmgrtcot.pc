/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cqcmgrtcot(int sel_type, struct CQCMGRTCOT_TAG *CQCMGRTCOT)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CQCMGRTCOT_N_TAG CQCMGRTCOT_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cqcmgrtcot(&CQCMGRTCOT_N, CQCMGRTCOT);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CQCMGRTCOT_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    INSP_ID,
                    INSP_DTL_TYPE,
                    INSP_COUNT,
                    SIZES,
                    MA_VALUE_1,
                    MA_RESULT,
                    WT_VALUE_1,
                    WT_VALUE_2,
                    WT_VALUE_3,
                    WT_RESULT,
                    BD_VALUE_1,
                    BD_RESULT,
                    TD_VALUE_1,
                    TD_RESULT,
                    PCS_VALUE_1,
                    PCS_RESULT,
                    PS_VALUE_1,
                    PS_VALUE_2,
                    PS_RESULT,
                    CM_L,
                    CM_A,
                    CM_B,
                    CM_YI,
                    REMARKS,
                    COMPAC_VALUE,
                    ELIP_VALUE,
                    ROUG_VALUE,
                    SURFACE_NI,
                    SURFACE_FE,
                    SURFACE_CU,
                    SURFACE_CR,
                    SURFACE_TI,
                    SURFACE_MN,
                    SURFACE_CO,
                    SURFACE_CA,
                    SURFACE_MG,
                    SURFACE_ZN,
                    SURFACE_MO,
                    SURFACE_PB,
                    SURFACE_AL,
                    SURFACE_SI,
                    SURFACE_B,
                    SURFACE_NA,
                    CON_O_VALUE,
                    ELIP_VALUE2,
                    SHAPE_FACTOR,
                    GRAIN_SIZE,
                    CIRCULRARITY,
                    CONVEXITY,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CQCMGRTCOT
                ORDER BY FACTORY ASC,
                    INSP_ID ASC,
                    INSP_DTL_TYPE ASC,
                    INSP_COUNT ASC;
            EXEC SQL OPEN DBU_CQCMGRTCOT_CUR_1;
            break;

		case 2:
            EXEC SQL DECLARE DBU_CQCMGRTCOT_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    INSP_ID,
                    INSP_DTL_TYPE,
                    INSP_COUNT,
                    SIZES,
                    MA_VALUE_1,
                    MA_RESULT,
                    WT_VALUE_1,
                    WT_VALUE_2,
                    WT_VALUE_3,
                    WT_RESULT,
                    BD_VALUE_1,
                    BD_RESULT,
                    TD_VALUE_1,
                    TD_RESULT,
                    PCS_VALUE_1,
                    PCS_RESULT,
                    PS_VALUE_1,
                    PS_VALUE_2,
                    PS_RESULT,
                    CM_L,
                    CM_A,
                    CM_B,
                    CM_YI,
                    REMARKS,
                    COMPAC_VALUE,
                    ELIP_VALUE,
                    ROUG_VALUE,
                    SURFACE_NI,
                    SURFACE_FE,
                    SURFACE_CU,
                    SURFACE_CR,
                    SURFACE_TI,
                    SURFACE_MN,
                    SURFACE_CO,
                    SURFACE_CA,
                    SURFACE_MG,
                    SURFACE_ZN,
                    SURFACE_MO,
                    SURFACE_PB,
                    SURFACE_AL,
                    SURFACE_SI,
                    SURFACE_B,
                    SURFACE_NA,
                    CON_O_VALUE,
                    ELIP_VALUE2,
                    SHAPE_FACTOR,
                    GRAIN_SIZE,
                    CIRCULRARITY,
                    CONVEXITY,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CQCMGRTCOT
			  WHERE FACTORY = :CQCMGRTCOT_N.FACTORY
			     AND INSP_ID = :CQCMGRTCOT_N.INSP_ID;
            EXEC SQL OPEN DBU_CQCMGRTCOT_CUR_2;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cqcmgrtcot", sel_type);
}


