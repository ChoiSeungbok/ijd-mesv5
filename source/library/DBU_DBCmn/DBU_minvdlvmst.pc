                    PO_NO,
                    PO_SEQ,
                    BL_NO,
                    BL_SEQ,
                    DLV_EXP_DATE,
                    VENDOR_ID,
					VENDOR_SITE_ID,
                    AREA_ID,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME,
					DELETE_FLAG
                FROM MINVDLVMST
				WHERE FACTORY = :MINVDLVMST_N.FACTORY
				 AND AREA_ID = :MINVDLVMST_N.AREA_ID
				 AND ((:MINVDLVMST_N.VENDOR_ID = ' ') OR (VENDOR_ID = :MINVDLVMST_N.VENDOR_ID))
				 AND CREATE_TIME BETWEEN :DBC_Q_COND_N.FROM_TIME  AND :DBC_Q_COND_N.TO_TIME
                ORDER BY FACTORY ASC,
                    DLV_NO ASC;
            EXEC SQL OPEN DBU_MINVDLVMST_CUR_2;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_minvdlvmst", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_minvdlvmst(int sel_type, struct MINVDLVMST_TAG *MINVDLVMST)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVDLVMST_N_TAG MINVDLVMST_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_MINVDLVMST_CUR_1 INTO
                :MINVDLVMST_N.FACTORY,
                :MINVDLVMST_N.DLV_NO,
                :MINVDLVMST_N.PO_NO,
                :MINVDLVMST_N.PO_SEQ,
                :MINVDLVMST_N.BL_NO,
                :MINVDLVMST_N.BL_SEQ,
                :MINVDLVMST_N.DLV_EXP_DATE,
                :MINVDLVMST_N.VENDOR_ID,
				:MINVDLVMST_N.VENDOR_SITE_ID,
                :MINVDLVMST_N.AREA_ID,
                :MINVDLVMST_N.CMF_1,
                :MINVDLVMST_N.CMF_2,
                :MINVDLVMST_N.CMF_3,
                :MINVDLVMST_N.CMF_4,
                :MINVDLVMST_N.CMF_5,
                :MINVDLVMST_N.CMF_6,
                :MINVDLVMST_N.CMF_7,
                :MINVDLVMST_N.CMF_8,
                :MINVDLVMST_N.CMF_9,
                :MINVDLVMST_N.CMF_10,
                :MINVDLVMST_N.CREATE_USER_ID,
                :MINVDLVMST_N.CREATE_TIME,
                :MINVDLVMST_N.UPDATE_USER_ID,
                :MINVDLVMST_N.UPDATE_TIME,
				:MINVDLVMST_N.DELETE_FLAG;
            break;

		case 2:
            EXEC SQL FETCH DBU_MINVDLVMST_CUR_2 INTO
                :MINVDLVMST_N.FACTORY,
                :MINVDLVMST_N.DLV_NO,
                :MINVDLVMST_N.PO_NO,
                :MINVDLVMST_N.PO_SEQ,
                :MINVDLVMST_N.BL_NO,
                :MINVDLVMST_N.BL_SEQ,
                :MINVDLVMST_N.DLV_EXP_DATE,
                :MINVDLVMST_N.VENDOR_ID,
				:MINVDLVMST_N.VENDOR_SITE_ID,
                :MINVDLVMST_N.AREA_ID,
                :MINVDLVMST_N.CMF_1,
                :MINVDLVMST_N.CMF_2,
                :MINVDLVMST_N.CMF_3,
                :MINVDLVMST_N.CMF_4,
                :MINVDLVMST_N.CMF_5,
                :MINVDLVMST_N.CMF_6,
                :MINVDLVMST_N.CMF_7,
                :MINVDLVMST_N.CMF_8,
                :MINVDLVMST_N.CMF_9,
                :MINVDLVMST_N.CMF_10,
                :MINVDLVMST_N.CREATE_USER_ID,
                :MINVDLVMST_N.CREATE_TIME,
                :MINVDLVMST_N.UPDATE_USER_ID,
                :MINVDLVMST_N.UPDATE_TIME,
				:MINVDLVMST_N.DELETE_FLAG;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_minvdlvmst(&MINVDLVMST_N, MINVDLVMST);
    }

    DB_stop_query_timer("DBU_fetch_minvdlvmst", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_minvdlvmst(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_MINVDLVMST_CUR_1;
            break;

		case 2:
            EXEC SQL CLOSE DBU_MINVDLVMST_CUR_2;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_minvdlvmst", sel_type);
}


/* Initialize Function */
void DBU_init_minvdlvmst(struct MINVDLVMST_TAG *MINVDLVMST)
{
    /* memset by Space */
    memset(MINVDLVMST, ' ', sizeof(struct MINVDLVMST_TAG));
    
    MINVDLVMST->PO_SEQ = 0;
    MINVDLVMST->BL_SEQ = 0;
	MINVDLVMST->VENDOR_SITE_ID = 0;
}


/* Add Null Function */
void DBU_add_null_minvdlvmst(struct MINVDLVMST_N_TAG *MINVDLVMST_N, struct MINVDLVMST_TAG *MINVDLVMST)
{
    /* memset by NULL */
    memset(MINVDLVMST_N, '\0', sizeof(struct MINVDLVMST_N_TAG));
    
    MEMCPY_AN(MINVDLVMST_N->FACTORY, MINVDLVMST->FACTORY, sizeof(MINVDLVMST->FACTORY));
    MEMCPY_AN(MINVDLVMST_N->DLV_NO, MINVDLVMST->DLV_NO, sizeof(MINVDLVMST->DLV_NO));
    MEMCPY_AN(MINVDLVMST_N->PO_NO, MINVDLVMST->PO_NO, sizeof(MINVDLVMST->PO_NO));
    MINVDLVMST_N->PO_SEQ = MINVDLVMST->PO_SEQ;
    MEMCPY_AN(MINVDLVMST_N->BL_NO, MINVDLVMST->BL_NO, sizeof(MINVDLVMST->BL_NO));
    MINVDLVMST_N->BL_SEQ = MINVDLVMST->BL_SEQ;
    MEMCPY_AN(MINVDLVMST_N->DLV_EXP_DATE, MINVDLVMST->DLV_EXP_DATE, sizeof(MINVDLVMST->DLV_EXP_DATE));
    MEMCPY_AN(MINVDLVMST_N->VENDOR_ID, MINVDLVMST->VENDOR_ID, sizeof(MINVDLVMST->VENDOR_ID));
	MINVDLVMST_N->VENDOR_SITE_ID = MINVDLVMST->VENDOR_SITE_ID;
    MEMCPY_AN(MINVDLVMST_N->AREA_ID, MINVDLVMST->AREA_ID, sizeof(MINVDLVMST->AREA_ID));
    MEMCPY_AN(MINVDLVMST_N->CMF_1, MINVDLVMST->CMF_1, sizeof(MINVDLVMST->CMF_1));
    MEMCPY_AN(MINVDLVMST_N->CMF_2, MINVDLVMST->CMF_2, sizeof(MINVDLVMST->CMF_2));
    MEMCPY_AN(MINVDLVMST_N->CMF_3, MINVDLVMST->CMF_3, sizeof(MINVDLVMST->CMF_3));
    MEMCPY_AN(MINVDLVMST_N->CMF_4, MINVDLVMST->CMF_4, sizeof(MINVDLVMST->CMF_4));
    MEMCPY_AN(MINVDLVMST_N->CMF_5, MINVDLVMST->CMF_5, sizeof(MINVDLVMST->CMF_5));
    MEMCPY_AN(MINVDLVMST_N->CMF_6, MINVDLVMST->CMF_6, sizeof(MINVDLVMST->CMF_6));
    MEMCPY_AN(MINVDLVMST_N->CMF_7, MINVDLVMST->CMF_7, sizeof(MINVDLVMST->CMF_7));
    MEMCPY_AN(MINVDLVMST_N->CMF_8, MINVDLVMST->CMF_8, sizeof(MINVDLVMST->CMF_8));
    MEMCPY_AN(MINVDLVMST_N->CMF_9, MINVDLVMST->CMF_9, sizeof(MINVDLVMST->CMF_9));
    MEMCPY_AN(MINVDLVMST_N->CMF_10, MINVDLVMST->CMF_10, sizeof(MINVDLVMST->CMF_10));
    MEMCPY_AN(MINVDLVMST_N->CREATE_USER_ID, MINVDLVMST->CREATE_USER_ID, sizeof(MINVDLVMST->CREATE_USER_ID));
    MEMCPY_AN(MINVDLVMST_N->CREATE_TIME, MINVDLVMST->CREATE_TIME, sizeof(MINVDLVMST->CREATE_TIME));
    MEMCPY_AN(MINVDLVMST_N->UPDATE_USER_ID, MINVDLVMST->UPDATE_USER_ID, sizeof(MINVDLVMST->UPDATE_USER_ID));
    MEMCPY_AN(MINVDLVMST_N->UPDATE_TIME, MINVDLVMST->UPDATE_TIME, sizeof(MINVDLVMST->UPDATE_TIME));
	MINVDLVMST_N->DELETE_FLAG[0] = MINVDLVMST->DELETE_FLAG;
}


/* Del Null Function */
void DBU_del_null_minvdlvmst(struct MINVDLVMST_N_TAG *MINVDLVMST_N, struct MINVDLVMST_TAG *MINVDLVMST)
{
    MEMCPY_DN(MINVDLVMST->FACTORY, MINVDLVMST_N->FACTORY, sizeof(MINVDLVMST->FACTORY));
    MEMCPY_DN(MINVDLVMST->DLV_NO, MINVDLVMST_N->DLV_NO, sizeof(MINVDLVMST->DLV_NO));
    MEMCPY_DN(MINVDLVMST->PO_NO, MINVDLVMST_N->PO_NO, sizeof(MINVDLVMST->PO_NO));
    MINVDLVMST->PO_SEQ = MINVDLVMST_N->PO_SEQ;
    MEMCPY_DN(MINVDLVMST->BL_NO, MINVDLVMST_N->BL_NO, sizeof(MINVDLVMST->BL_NO));
    MINVDLVMST->BL_SEQ = MINVDLVMST_N->BL_SEQ;
    MEMCPY_DN(MINVDLVMST->DLV_EXP_DATE, MINVDLVMST_N->DLV_EXP_DATE, sizeof(MINVDLVMST->DLV_EXP_DATE));
    MEMCPY_DN(MINVDLVMST->VENDOR_ID, MINVDLVMST_N->VENDOR_ID, sizeof(MINVDLVMST->VENDOR_ID));
	MINVDLVMST->VENDOR_SITE_ID = MINVDLVMST_N->VENDOR_SITE_ID;
    MEMCPY_DN(MINVDLVMST->AREA_ID, MINVDLVMST_N->AREA_ID, sizeof(MINVDLVMST->AREA_ID));
    MEMCPY_DN(MINVDLVMST->CMF_1, MINVDLVMST_N->CMF_1, sizeof(MINVDLVMST->CMF_1));
    MEMCPY_DN(MINVDLVMST->CMF_2, MINVDLVMST_N->CMF_2, sizeof(MINVDLVMST->CMF_2));
    MEMCPY_DN(MINVDLVMST->CMF_3, MINVDLVMST_N->CMF_3, sizeof(MINVDLVMST->CMF_3));
    MEMCPY_DN(MINVDLVMST->CMF_4, MINVDLVMST_N->CMF_4, sizeof(MINVDLVMST->CMF_4));
    MEMCPY_DN(MINVDLVMST->CMF_5, MINVDLVMST_N->CMF_5, sizeof(MINVDLVMST->CMF_5));
    MEMCPY_DN(MINVDLVMST->CMF_6, MINVDLVMST_N->CMF_6, sizeof(MINVDLVMST->CMF_6));
    MEMCPY_DN(MINVDLVMST->CMF_7, MINVDLVMST_N->CMF_7, sizeof(MINVDLVMST->CMF_7));
    MEMCPY_DN(MINVDLVMST->CMF_8, MINVDLVMST_N->CMF_8, sizeof(MINVDLVMST->CMF_8));
    MEMCPY_DN(MINVDLVMST->CMF_9, MINVDLVMST_N->CMF_9, sizeof(MINVDLVMST->CMF_9));
    MEMCPY_DN(MINVDLVMST->CMF_10, MINVDLVMST_N->CMF_10, sizeof(MINVDLVMST->CMF_10));
    MEMCPY_DN(MINVDLVMST->CREATE_USER_ID, MINVDLVMST_N->CREATE_USER_ID, sizeof(MINVDLVMST->CREATE_USER_ID));
    MEMCPY_DN(MINVDLVMST->CREATE_TIME, MINVDLVMST_N->CREATE_TIME, sizeof(MINVDLVMST->CREATE_TIME));
    MEMCPY_DN(MINVDLVMST->UPDATE_USER_ID, MINVDLVMST_N->UPDATE_USER_ID, sizeof(MINVDLVMST->UPDATE_USER_ID));
    MEMCPY_DN(MINVDLVMST->UPDATE_TIME, MINVDLVMST_N->UPDATE_TIME, sizeof(MINVDLVMST->UPDATE_TIME));
	MINVDLVMST->DELETE_FLAG = MINVDLVMST_N->DELETE_FLAG[0];
}


