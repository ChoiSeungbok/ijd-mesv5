                :CWIPERPOPR_N.PREV_OPER,
                :CWIPERPOPR_N.NEXT_OPER_SEQ,
                :CWIPERPOPR_N.NEXT_OPER,
                :CWIPERPOPR_N.FIRST_FLAG,
                :CWIPERPOPR_N.LAST_FLAG,
                :CWIPERPOPR_N.CMF_1,
                :CWIPERPOPR_N.CMF_2,
                :CWIPERPOPR_N.CMF_3,
                :CWIPERPOPR_N.CMF_4,
                :CWIPERPOPR_N.CMF_5,
                :CWIPERPOPR_N.CMF_6,
                :CWIPERPOPR_N.CMF_7,
                :CWIPERPOPR_N.CMF_8,
                :CWIPERPOPR_N.CMF_9,
                :CWIPERPOPR_N.CMF_10,
                :CWIPERPOPR_N.CREATE_USER_ID,
                :CWIPERPOPR_N.CREATE_TIME,
                :CWIPERPOPR_N.UPDATE_USER_ID,
                :CWIPERPOPR_N.UPDATE_TIME;
            break;

		case 2:
            EXEC SQL FETCH DBU_CWIPERPOPR_CUR_2 INTO
                :CWIPERPOPR_N.FACTORY,
                :CWIPERPOPR_N.AREA_ID,
                :CWIPERPOPR_N.SUB_AREA_ID,
                :CWIPERPOPR_N.ORDER_ID,
                :CWIPERPOPR_N.OPER_SEQ,
                :CWIPERPOPR_N.OPER,
                :CWIPERPOPR_N.OPER_DESC,
                :CWIPERPOPR_N.INV_OPER,
                :CWIPERPOPR_N.PREV_OPER_SEQ,
                :CWIPERPOPR_N.PREV_OPER,
                :CWIPERPOPR_N.NEXT_OPER_SEQ,
                :CWIPERPOPR_N.NEXT_OPER,
                :CWIPERPOPR_N.FIRST_FLAG,
                :CWIPERPOPR_N.LAST_FLAG,
                :CWIPERPOPR_N.CMF_1,
                :CWIPERPOPR_N.CMF_2,
                :CWIPERPOPR_N.CMF_3,
                :CWIPERPOPR_N.CMF_4,
                :CWIPERPOPR_N.CMF_5,
                :CWIPERPOPR_N.CMF_6,
                :CWIPERPOPR_N.CMF_7,
                :CWIPERPOPR_N.CMF_8,
                :CWIPERPOPR_N.CMF_9,
                :CWIPERPOPR_N.CMF_10,
                :CWIPERPOPR_N.CREATE_USER_ID,
                :CWIPERPOPR_N.CREATE_TIME,
                :CWIPERPOPR_N.UPDATE_USER_ID,
                :CWIPERPOPR_N.UPDATE_TIME;
            break;

	    case 3:
            EXEC SQL FETCH DBU_CWIPERPOPR_CUR_3 INTO
                :CWIPERPOPR_N.FACTORY,
                :CWIPERPOPR_N.AREA_ID,
                :CWIPERPOPR_N.SUB_AREA_ID,
                :CWIPERPOPR_N.ORDER_ID,
                :CWIPERPOPR_N.OPER_SEQ,
                :CWIPERPOPR_N.OPER,
                :CWIPERPOPR_N.OPER_DESC,
                :CWIPERPOPR_N.INV_OPER,
                :CWIPERPOPR_N.PREV_OPER_SEQ,
                :CWIPERPOPR_N.PREV_OPER,
                :CWIPERPOPR_N.NEXT_OPER_SEQ,
                :CWIPERPOPR_N.NEXT_OPER,
                :CWIPERPOPR_N.FIRST_FLAG,
                :CWIPERPOPR_N.LAST_FLAG,
                :CWIPERPOPR_N.CMF_1,
                :CWIPERPOPR_N.CMF_2,
                :CWIPERPOPR_N.CMF_3,
                :CWIPERPOPR_N.CMF_4,
                :CWIPERPOPR_N.CMF_5,
                :CWIPERPOPR_N.CMF_6,
                :CWIPERPOPR_N.CMF_7,
                :CWIPERPOPR_N.CMF_8,
                :CWIPERPOPR_N.CMF_9,
                :CWIPERPOPR_N.CMF_10,
                :CWIPERPOPR_N.CREATE_USER_ID,
                :CWIPERPOPR_N.CREATE_TIME,
                :CWIPERPOPR_N.UPDATE_USER_ID,
                :CWIPERPOPR_N.UPDATE_TIME;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_cwiperpopr(&CWIPERPOPR_N, CWIPERPOPR);
    }

    DB_stop_query_timer("DBU_fetch_cwiperpopr", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_cwiperpopr(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CWIPERPOPR_CUR_1;
            break;

		case 2:
            EXEC SQL CLOSE DBU_CWIPERPOPR_CUR_2;
            break;

        case 3:
            EXEC SQL CLOSE DBU_CWIPERPOPR_CUR_3;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_cwiperpopr", sel_type);
}


/* Initialize Function */
void DBU_init_cwiperpopr(struct CWIPERPOPR_TAG *CWIPERPOPR)
{
    /* memset by Space */
    memset(CWIPERPOPR, ' ', sizeof(struct CWIPERPOPR_TAG));
    
    CWIPERPOPR->OPER_SEQ = 0;
    CWIPERPOPR->PREV_OPER_SEQ = 0;
    CWIPERPOPR->NEXT_OPER_SEQ = 0;
}


/* Add Null Function */
void DBU_add_null_cwiperpopr(struct CWIPERPOPR_N_TAG *CWIPERPOPR_N, struct CWIPERPOPR_TAG *CWIPERPOPR)
{
    /* memset by NULL */
    memset(CWIPERPOPR_N, '\0', sizeof(struct CWIPERPOPR_N_TAG));
    
    MEMCPY_AN(CWIPERPOPR_N->FACTORY, CWIPERPOPR->FACTORY, sizeof(CWIPERPOPR->FACTORY));
    MEMCPY_AN(CWIPERPOPR_N->AREA_ID, CWIPERPOPR->AREA_ID, sizeof(CWIPERPOPR->AREA_ID));
    MEMCPY_AN(CWIPERPOPR_N->SUB_AREA_ID, CWIPERPOPR->SUB_AREA_ID, sizeof(CWIPERPOPR->SUB_AREA_ID));
    MEMCPY_AN(CWIPERPOPR_N->ORDER_ID, CWIPERPOPR->ORDER_ID, sizeof(CWIPERPOPR->ORDER_ID));
    CWIPERPOPR_N->OPER_SEQ = CWIPERPOPR->OPER_SEQ;
    MEMCPY_AN(CWIPERPOPR_N->OPER, CWIPERPOPR->OPER, sizeof(CWIPERPOPR->OPER));
    MEMCPY_AN(CWIPERPOPR_N->OPER_DESC, CWIPERPOPR->OPER_DESC, sizeof(CWIPERPOPR->OPER_DESC));
    MEMCPY_AN(CWIPERPOPR_N->INV_OPER, CWIPERPOPR->INV_OPER, sizeof(CWIPERPOPR->INV_OPER));
    CWIPERPOPR_N->PREV_OPER_SEQ = CWIPERPOPR->PREV_OPER_SEQ;
    MEMCPY_AN(CWIPERPOPR_N->PREV_OPER, CWIPERPOPR->PREV_OPER, sizeof(CWIPERPOPR->PREV_OPER));
    CWIPERPOPR_N->NEXT_OPER_SEQ = CWIPERPOPR->NEXT_OPER_SEQ;
    MEMCPY_AN(CWIPERPOPR_N->NEXT_OPER, CWIPERPOPR->NEXT_OPER, sizeof(CWIPERPOPR->NEXT_OPER));
    CWIPERPOPR_N->FIRST_FLAG[0] = CWIPERPOPR->FIRST_FLAG;
    CWIPERPOPR_N->LAST_FLAG[0] = CWIPERPOPR->LAST_FLAG;
    MEMCPY_AN(CWIPERPOPR_N->CMF_1, CWIPERPOPR->CMF_1, sizeof(CWIPERPOPR->CMF_1));
    MEMCPY_AN(CWIPERPOPR_N->CMF_2, CWIPERPOPR->CMF_2, sizeof(CWIPERPOPR->CMF_2));
    MEMCPY_AN(CWIPERPOPR_N->CMF_3, CWIPERPOPR->CMF_3, sizeof(CWIPERPOPR->CMF_3));
    MEMCPY_AN(CWIPERPOPR_N->CMF_4, CWIPERPOPR->CMF_4, sizeof(CWIPERPOPR->CMF_4));
    MEMCPY_AN(CWIPERPOPR_N->CMF_5, CWIPERPOPR->CMF_5, sizeof(CWIPERPOPR->CMF_5));
    MEMCPY_AN(CWIPERPOPR_N->CMF_6, CWIPERPOPR->CMF_6, sizeof(CWIPERPOPR->CMF_6));
    MEMCPY_AN(CWIPERPOPR_N->CMF_7, CWIPERPOPR->CMF_7, sizeof(CWIPERPOPR->CMF_7));
    MEMCPY_AN(CWIPERPOPR_N->CMF_8, CWIPERPOPR->CMF_8, sizeof(CWIPERPOPR->CMF_8));
    MEMCPY_AN(CWIPERPOPR_N->CMF_9, CWIPERPOPR->CMF_9, sizeof(CWIPERPOPR->CMF_9));
    MEMCPY_AN(CWIPERPOPR_N->CMF_10, CWIPERPOPR->CMF_10, sizeof(CWIPERPOPR->CMF_10));
    MEMCPY_AN(CWIPERPOPR_N->CREATE_USER_ID, CWIPERPOPR->CREATE_USER_ID, sizeof(CWIPERPOPR->CREATE_USER_ID));
    MEMCPY_AN(CWIPERPOPR_N->CREATE_TIME, CWIPERPOPR->CREATE_TIME, sizeof(CWIPERPOPR->CREATE_TIME));
    MEMCPY_AN(CWIPERPOPR_N->UPDATE_USER_ID, CWIPERPOPR->UPDATE_USER_ID, sizeof(CWIPERPOPR->UPDATE_USER_ID));
    MEMCPY_AN(CWIPERPOPR_N->UPDATE_TIME, CWIPERPOPR->UPDATE_TIME, sizeof(CWIPERPOPR->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_cwiperpopr(struct CWIPERPOPR_N_TAG *CWIPERPOPR_N, struct CWIPERPOPR_TAG *CWIPERPOPR)
{
    MEMCPY_DN(CWIPERPOPR->FACTORY, CWIPERPOPR_N->FACTORY, sizeof(CWIPERPOPR->FACTORY));
    MEMCPY_DN(CWIPERPOPR->AREA_ID, CWIPERPOPR_N->AREA_ID, sizeof(CWIPERPOPR->AREA_ID));
    MEMCPY_DN(CWIPERPOPR->SUB_AREA_ID, CWIPERPOPR_N->SUB_AREA_ID, sizeof(CWIPERPOPR->SUB_AREA_ID));
    MEMCPY_DN(CWIPERPOPR->ORDER_ID, CWIPERPOPR_N->ORDER_ID, sizeof(CWIPERPOPR->ORDER_ID));
    CWIPERPOPR->OPER_SEQ = CWIPERPOPR_N->OPER_SEQ;
    MEMCPY_DN(CWIPERPOPR->OPER, CWIPERPOPR_N->OPER, sizeof(CWIPERPOPR->OPER));
    MEMCPY_DN(CWIPERPOPR->OPER_DESC, CWIPERPOPR_N->OPER_DESC, sizeof(CWIPERPOPR->OPER_DESC));
    MEMCPY_DN(CWIPERPOPR->INV_OPER, CWIPERPOPR_N->INV_OPER, sizeof(CWIPERPOPR->INV_OPER));
    CWIPERPOPR->PREV_OPER_SEQ = CWIPERPOPR_N->PREV_OPER_SEQ;
    MEMCPY_DN(CWIPERPOPR->PREV_OPER, CWIPERPOPR_N->PREV_OPER, sizeof(CWIPERPOPR->PREV_OPER));
    CWIPERPOPR->NEXT_OPER_SEQ = CWIPERPOPR_N->NEXT_OPER_SEQ;
    MEMCPY_DN(CWIPERPOPR->NEXT_OPER, CWIPERPOPR_N->NEXT_OPER, sizeof(CWIPERPOPR->NEXT_OPER));
    CWIPERPOPR->FIRST_FLAG = CWIPERPOPR_N->FIRST_FLAG[0];
    CWIPERPOPR->LAST_FLAG = CWIPERPOPR_N->LAST_FLAG[0];
    MEMCPY_DN(CWIPERPOPR->CMF_1, CWIPERPOPR_N->CMF_1, sizeof(CWIPERPOPR->CMF_1));
    MEMCPY_DN(CWIPERPOPR->CMF_2, CWIPERPOPR_N->CMF_2, sizeof(CWIPERPOPR->CMF_2));
    MEMCPY_DN(CWIPERPOPR->CMF_3, CWIPERPOPR_N->CMF_3, sizeof(CWIPERPOPR->CMF_3));
    MEMCPY_DN(CWIPERPOPR->CMF_4, CWIPERPOPR_N->CMF_4, sizeof(CWIPERPOPR->CMF_4));
    MEMCPY_DN(CWIPERPOPR->CMF_5, CWIPERPOPR_N->CMF_5, sizeof(CWIPERPOPR->CMF_5));
    MEMCPY_DN(CWIPERPOPR->CMF_6, CWIPERPOPR_N->CMF_6, sizeof(CWIPERPOPR->CMF_6));
    MEMCPY_DN(CWIPERPOPR->CMF_7, CWIPERPOPR_N->CMF_7, sizeof(CWIPERPOPR->CMF_7));
    MEMCPY_DN(CWIPERPOPR->CMF_8, CWIPERPOPR_N->CMF_8, sizeof(CWIPERPOPR->CMF_8));
    MEMCPY_DN(CWIPERPOPR->CMF_9, CWIPERPOPR_N->CMF_9, sizeof(CWIPERPOPR->CMF_9));
    MEMCPY_DN(CWIPERPOPR->CMF_10, CWIPERPOPR_N->CMF_10, sizeof(CWIPERPOPR->CMF_10));
    MEMCPY_DN(CWIPERPOPR->CREATE_USER_ID, CWIPERPOPR_N->CREATE_USER_ID, sizeof(CWIPERPOPR->CREATE_USER_ID));
    MEMCPY_DN(CWIPERPOPR->CREATE_TIME, CWIPERPOPR_N->CREATE_TIME, sizeof(CWIPERPOPR->CREATE_TIME));
    MEMCPY_DN(CWIPERPOPR->UPDATE_USER_ID, CWIPERPOPR_N->UPDATE_USER_ID, sizeof(CWIPERPOPR->UPDATE_USER_ID));
    MEMCPY_DN(CWIPERPOPR->UPDATE_TIME, CWIPERPOPR_N->UPDATE_TIME, sizeof(CWIPERPOPR->UPDATE_TIME));
}


