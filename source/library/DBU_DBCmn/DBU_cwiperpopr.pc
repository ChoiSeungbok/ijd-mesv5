                    OPER ASC;
            EXEC SQL OPEN DBU_CWIPERPOPR_CUR_1;
            break;

		case 2:
            EXEC SQL DECLARE DBU_CWIPERPOPR_CUR_2 CURSOR FOR
                SELECT 
                    A.FACTORY,
                    A.AREA_ID,
                    A.SUB_AREA_ID,
                    A.ORDER_ID,
                    A.OPER_SEQ,
                    A.OPER,
                    A.OPER_DESC,
                    A.INV_OPER,
					A.PREV_OPER_SEQ,
                    A.PREV_OPER,
                    A.NEXT_OPER_SEQ,
                    A.NEXT_OPER,
                    A.FIRST_FLAG,
                    A.LAST_FLAG,
                    A.CMF_1,
                    A.CMF_2,
                    A.CMF_3,
                    A.CMF_4,
                    A.CMF_5,
                    A.CMF_6,
                    A.CMF_7,
                    A.CMF_8,
                    A.CMF_9,
                    A.CMF_10,
                    A.CREATE_USER_ID,
                    A.CREATE_TIME,
                    A.UPDATE_USER_ID,
                    A.UPDATE_TIME
                FROM CWIPERPOPR A, MWIPOPRDEF B
               WHERE A.FACTORY = B.FACTORY 
                 AND A.OPER = B.OPER_CMF_1
                 AND A.FACTORY = :CWIPERPOPR_N.FACTORY
                 AND A.AREA_ID = :CWIPERPOPR_N.AREA_ID
                 AND A.SUB_AREA_ID = :CWIPERPOPR_N.SUB_AREA_ID
                 AND B.OPER =:CWIPERPOPR_N.OPER                    
                ORDER BY A.OPER_SEQ ASC;
            EXEC SQL OPEN DBU_CWIPERPOPR_CUR_2;
            break;

        case 3:
            EXEC SQL DECLARE DBU_CWIPERPOPR_CUR_3 CURSOR FOR
                SELECT 
                    FACTORY,
                    AREA_ID,
                    SUB_AREA_ID,
                    ORDER_ID,
                    OPER_SEQ,
                    OPER,
                    OPER_DESC,
                    INV_OPER,
                    PREV_OPER_SEQ,
                    PREV_OPER,
                    NEXT_OPER_SEQ,
                    NEXT_OPER,
                    FIRST_FLAG,
                    LAST_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPERPOPR
               WHERE FACTORY = :CWIPERPOPR_N.FACTORY
                 AND ORDER_ID = :CWIPERPOPR_N.ORDER_ID
               ORDER BY OPER_SEQ ASC;
            EXEC SQL OPEN DBU_CWIPERPOPR_CUR_3;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cwiperpopr", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_cwiperpopr(int sel_type, struct CWIPERPOPR_TAG *CWIPERPOPR)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CWIPERPOPR_N_TAG CWIPERPOPR_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_CWIPERPOPR_CUR_1 INTO
                :CWIPERPOPR_N.FACTORY,
                :CWIPERPOPR_N.AREA_ID,
                :CWIPERPOPR_N.SUB_AREA_ID,
                :CWIPERPOPR_N.ORDER_ID,
                :CWIPERPOPR_N.OPER_SEQ,
