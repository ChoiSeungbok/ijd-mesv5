    MEMCPY_DN(CSECUSEDAT->FUNC_NAME, CSECUSEDAT_N->FUNC_NAME, sizeof(CSECUSEDAT->FUNC_NAME));
    MEMCPY_DN(CSECUSEDAT->PG_KIND, CSECUSEDAT_N->PG_KIND, sizeof(CSECUSEDAT->PG_KIND));
    CSECUSEDAT->USE_COUNT = CSECUSEDAT_N->USE_COUNT;
    MEMCPY_DN(CSECUSEDAT->UPDATE_TIME, CSECUSEDAT_N->UPDATE_TIME, sizeof(CSECUSEDAT->UPDATE_TIME));
