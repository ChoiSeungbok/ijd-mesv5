/* Add Null Function */
void DBU_add_null_csecusedat(struct CSECUSEDAT_N_TAG *CSECUSEDAT_N, struct CSECUSEDAT_TAG *CSECUSEDAT)
{
    /* memset by NULL */
    memset(CSECUSEDAT_N, '\0', sizeof(struct CSECUSEDAT_N_TAG));
    
    MEMCPY_AN(CSECUSEDAT_N->FACTORY, CSECUSEDAT->FACTORY, sizeof(CSECUSEDAT->FACTORY));
    MEMCPY_AN(CSECUSEDAT_N->USE_DATE, CSECUSEDAT->USE_DATE, sizeof(CSECUSEDAT->USE_DATE));
    MEMCPY_AN(CSECUSEDAT_N->PROGRAM_ID, CSECUSEDAT->PROGRAM_ID, sizeof(CSECUSEDAT->PROGRAM_ID));
    MEMCPY_AN(CSECUSEDAT_N->USER_ID, CSECUSEDAT->USER_ID, sizeof(CSECUSEDAT->USER_ID));
    MEMCPY_AN(CSECUSEDAT_N->PROGRAM_DESC, CSECUSEDAT->PROGRAM_DESC, sizeof(CSECUSEDAT->PROGRAM_DESC));
    MEMCPY_AN(CSECUSEDAT_N->FUNC_NAME, CSECUSEDAT->FUNC_NAME, sizeof(CSECUSEDAT->FUNC_NAME));
    MEMCPY_AN(CSECUSEDAT_N->PG_KIND, CSECUSEDAT->PG_KIND, sizeof(CSECUSEDAT->PG_KIND));
    CSECUSEDAT_N->USE_COUNT = CSECUSEDAT->USE_COUNT;
    MEMCPY_AN(CSECUSEDAT_N->UPDATE_TIME, CSECUSEDAT->UPDATE_TIME, sizeof(CSECUSEDAT->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_csecusedat(struct CSECUSEDAT_N_TAG *CSECUSEDAT_N, struct CSECUSEDAT_TAG *CSECUSEDAT)
{
    MEMCPY_DN(CSECUSEDAT->FACTORY, CSECUSEDAT_N->FACTORY, sizeof(CSECUSEDAT->FACTORY));
    MEMCPY_DN(CSECUSEDAT->USE_DATE, CSECUSEDAT_N->USE_DATE, sizeof(CSECUSEDAT->USE_DATE));
