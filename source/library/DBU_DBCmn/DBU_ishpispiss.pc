                :ISHPISPISS_N.VALUE_8,
                :ISHPISPISS_N.VALUE_9,
                :ISHPISPISS_N.VALUE_10,
                :ISHPISPISS_N.VALUE_11,
                :ISHPISPISS_N.VALUE_12,
                :ISHPISPISS_N.VALUE_13,
                :ISHPISPISS_N.VALUE_14,
                :ISHPISPISS_N.VALUE_15,
                :ISHPISPISS_N.VALUE_16,
                :ISHPISPISS_N.VALUE_17,
                :ISHPISPISS_N.VALUE_18,
                :ISHPISPISS_N.VALUE_19,
                :ISHPISPISS_N.VALUE_20,
                :ISHPISPISS_N.VALUE_21,
                :ISHPISPISS_N.VALUE_22,
                :ISHPISPISS_N.VALUE_23,
                :ISHPISPISS_N.VALUE_24,
                :ISHPISPISS_N.VALUE_25,
                :ISHPISPISS_N.SAMPLE_COUNT,
                :ISHPISPISS_N.SPEC_OUT_MASK,
                :ISHPISPISS_N.INSP_JUDGE_FLAG,
                :ISHPISPISS_N.INSP_JUDGE_TYPE,
                :ISHPISPISS_N.INSP_JUDGE_TIME,
                :ISHPISPISS_N.CMF_1,
                :ISHPISPISS_N.CMF_2,
                :ISHPISPISS_N.CMF_3,
                :ISHPISPISS_N.CMF_4,
                :ISHPISPISS_N.CMF_5,
                :ISHPISPISS_N.CMF_6,
                :ISHPISPISS_N.CMF_7,
                :ISHPISPISS_N.CMF_8,
                :ISHPISPISS_N.CMF_9,
                :ISHPISPISS_N.CMF_10,
                :ISHPISPISS_N.CREATE_USER_ID,
                :ISHPISPISS_N.CREATE_TIME,
                :ISHPISPISS_N.UPDATE_USER_ID,
                :ISHPISPISS_N.UPDATE_TIME;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_ishpispiss(&ISHPISPISS_N, ISHPISPISS);
    }

    DB_stop_query_timer("DBU_fetch_ishpispiss", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_ishpispiss(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_ISHPISPISS_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_ishpispiss", sel_type);
}


/* Initialize Function */
void DBU_init_ishpispiss(struct ISHPISPISS_TAG *ISHPISPISS)
{
    /* memset by Space */
    memset(ISHPISPISS, ' ', sizeof(struct ISHPISPISS_TAG));
    
    ISHPISPISS->COL_SET_VER = 0;
    ISHPISPISS->CHAR_SEQ = 0;
    ISHPISPISS->UNIT_SEQ = 0;
    ISHPISPISS->VALUE_SEQ = 0;
    ISHPISPISS->VALUE_COUNT = 0;
    ISHPISPISS->SAMPLE_COUNT = 0;
}


/* Add Null Function */
void DBU_add_null_ishpispiss(struct ISHPISPISS_N_TAG *ISHPISPISS_N, struct ISHPISPISS_TAG *ISHPISPISS)
{
    /* memset by NULL */
    memset(ISHPISPISS_N, '\0', sizeof(struct ISHPISPISS_N_TAG));
    
    MEMCPY_AN(ISHPISPISS_N->FACTORY, ISHPISPISS->FACTORY, sizeof(ISHPISPISS->FACTORY));
    MEMCPY_AN(ISHPISPISS_N->PACK_LOT_ID, ISHPISPISS->PACK_LOT_ID, sizeof(ISHPISPISS->PACK_LOT_ID));
    MEMCPY_AN(ISHPISPISS_N->ORG_LOT_ID, ISHPISPISS->ORG_LOT_ID, sizeof(ISHPISPISS->ORG_LOT_ID));
