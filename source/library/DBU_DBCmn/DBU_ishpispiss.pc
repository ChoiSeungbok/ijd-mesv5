void DBU_del_null_ishpispiss(struct ISHPISPISS_N_TAG *ISHPISPISS_N, struct ISHPISPISS_TAG *ISHPISPISS)
{
    MEMCPY_DN(ISHPISPISS->FACTORY, ISHPISPISS_N->FACTORY, sizeof(ISHPISPISS->FACTORY));
