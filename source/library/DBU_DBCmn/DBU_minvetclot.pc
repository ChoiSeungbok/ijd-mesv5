/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_minvetclot(int sel_type, struct MINVETCLOT_TAG *MINVETCLOT)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVETCLOT_N_TAG MINVETCLOT_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_minvetclot(&MINVETCLOT_N, MINVETCLOT);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_MINVETCLOT_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    LOT_ID,
                    SEQ,
                    LOT_TYPE,
                    QTY,
                    MAT_ID,
                    MAT_VER,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    VENDOR_ID,
                    VENDOR_SITE_ID,
                    VENDOR_LOT_ID,
                    ETC_TYPE,
                    ETC_DATE,
                    TRAN_SRC_ID,
                    TRAN_SRC_NAME,
                    ETC_COMMENT,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM MINVETCLOT
                ORDER BY FACTORY ASC,
                    LOT_ID ASC,
                    SEQ ASC;
            EXEC SQL OPEN DBU_MINVETCLOT_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_minvetclot", sel_type);
}


