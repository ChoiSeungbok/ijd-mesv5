    MEMCPY_DN(MINVETCLOT->SUB_AREA_ID, MINVETCLOT_N->SUB_AREA_ID, sizeof(MINVETCLOT->SUB_AREA_ID));
    MEMCPY_DN(MINVETCLOT->OPER, MINVETCLOT_N->OPER, sizeof(MINVETCLOT->OPER));
    MEMCPY_DN(MINVETCLOT->VENDOR_ID, MINVETCLOT_N->VENDOR_ID, sizeof(MINVETCLOT->VENDOR_ID));
    MINVETCLOT->VENDOR_SITE_ID = MINVETCLOT_N->VENDOR_SITE_ID;
    MEMCPY_DN(MINVETCLOT->VENDOR_LOT_ID, MINVETCLOT_N->VENDOR_LOT_ID, sizeof(MINVETCLOT->VENDOR_LOT_ID));
    MEMCPY_DN(MINVETCLOT->ETC_TYPE, MINVETCLOT_N->ETC_TYPE, sizeof(MINVETCLOT->ETC_TYPE));
    MEMCPY_DN(MINVETCLOT->ETC_DATE, MINVETCLOT_N->ETC_DATE, sizeof(MINVETCLOT->ETC_DATE));
    MINVETCLOT->TRAN_SRC_ID = MINVETCLOT_N->TRAN_SRC_ID;
    MEMCPY_DN(MINVETCLOT->TRAN_SRC_NAME, MINVETCLOT_N->TRAN_SRC_NAME, sizeof(MINVETCLOT->TRAN_SRC_NAME));
    MEMCPY_DN(MINVETCLOT->ETC_COMMENT, MINVETCLOT_N->ETC_COMMENT, sizeof(MINVETCLOT->ETC_COMMENT));
    MEMCPY_DN(MINVETCLOT->CMF_1, MINVETCLOT_N->CMF_1, sizeof(MINVETCLOT->CMF_1));
    MEMCPY_DN(MINVETCLOT->CMF_2, MINVETCLOT_N->CMF_2, sizeof(MINVETCLOT->CMF_2));
    MEMCPY_DN(MINVETCLOT->CMF_3, MINVETCLOT_N->CMF_3, sizeof(MINVETCLOT->CMF_3));
    MEMCPY_DN(MINVETCLOT->CMF_4, MINVETCLOT_N->CMF_4, sizeof(MINVETCLOT->CMF_4));
    MEMCPY_DN(MINVETCLOT->CMF_5, MINVETCLOT_N->CMF_5, sizeof(MINVETCLOT->CMF_5));
    MEMCPY_DN(MINVETCLOT->CMF_6, MINVETCLOT_N->CMF_6, sizeof(MINVETCLOT->CMF_6));
    MEMCPY_DN(MINVETCLOT->CMF_7, MINVETCLOT_N->CMF_7, sizeof(MINVETCLOT->CMF_7));
    MEMCPY_DN(MINVETCLOT->CMF_8, MINVETCLOT_N->CMF_8, sizeof(MINVETCLOT->CMF_8));
    MEMCPY_DN(MINVETCLOT->CMF_9, MINVETCLOT_N->CMF_9, sizeof(MINVETCLOT->CMF_9));
    MEMCPY_DN(MINVETCLOT->CMF_10, MINVETCLOT_N->CMF_10, sizeof(MINVETCLOT->CMF_10));
    MEMCPY_DN(MINVETCLOT->CREATE_USER_ID, MINVETCLOT_N->CREATE_USER_ID, sizeof(MINVETCLOT->CREATE_USER_ID));
    MEMCPY_DN(MINVETCLOT->CREATE_TIME, MINVETCLOT_N->CREATE_TIME, sizeof(MINVETCLOT->CREATE_TIME));
    MEMCPY_DN(MINVETCLOT->UPDATE_USER_ID, MINVETCLOT_N->UPDATE_USER_ID, sizeof(MINVETCLOT->UPDATE_USER_ID));
