                :MINVETCLOT_N.SUB_AREA_ID,
                :MINVETCLOT_N.OPER,
                :MINVETCLOT_N.VENDOR_ID,
                :MINVETCLOT_N.VENDOR_SITE_ID,
                :MINVETCLOT_N.VENDOR_LOT_ID,
                :MINVETCLOT_N.ETC_TYPE,
                :MINVETCLOT_N.ETC_DATE,
                :MINVETCLOT_N.TRAN_SRC_ID,
                :MINVETCLOT_N.TRAN_SRC_NAME,
                :MINVETCLOT_N.ETC_COMMENT,
                :MINVETCLOT_N.CMF_1,
                :MINVETCLOT_N.CMF_2,
                :MINVETCLOT_N.CMF_3,
                :MINVETCLOT_N.CMF_4,
                :MINVETCLOT_N.CMF_5,
                :MINVETCLOT_N.CMF_6,
                :MINVETCLOT_N.CMF_7,
                :MINVETCLOT_N.CMF_8,
                :MINVETCLOT_N.CMF_9,
                :MINVETCLOT_N.CMF_10,
                :MINVETCLOT_N.CREATE_USER_ID,
                :MINVETCLOT_N.CREATE_TIME,
                :MINVETCLOT_N.UPDATE_USER_ID,
                :MINVETCLOT_N.UPDATE_TIME;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_minvetclot(&MINVETCLOT_N, MINVETCLOT);
    }

    DB_stop_query_timer("DBU_fetch_minvetclot", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_minvetclot(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_MINVETCLOT_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_minvetclot", sel_type);
}


/* Initialize Function */
void DBU_init_minvetclot(struct MINVETCLOT_TAG *MINVETCLOT)
{
    /* memset by Space */
    memset(MINVETCLOT, ' ', sizeof(struct MINVETCLOT_TAG));
    
    MINVETCLOT->SEQ = 0;
    MINVETCLOT->QTY = 0;
    MINVETCLOT->MAT_VER = 0;
    MINVETCLOT->VENDOR_SITE_ID = 0;
    MINVETCLOT->TRAN_SRC_ID = 0;
}


/* Add Null Function */
void DBU_add_null_minvetclot(struct MINVETCLOT_N_TAG *MINVETCLOT_N, struct MINVETCLOT_TAG *MINVETCLOT)
{
    /* memset by NULL */
    memset(MINVETCLOT_N, '\0', sizeof(struct MINVETCLOT_N_TAG));
    
    MEMCPY_AN(MINVETCLOT_N->FACTORY, MINVETCLOT->FACTORY, sizeof(MINVETCLOT->FACTORY));
    MEMCPY_AN(MINVETCLOT_N->LOT_ID, MINVETCLOT->LOT_ID, sizeof(MINVETCLOT->LOT_ID));
    MINVETCLOT_N->SEQ = MINVETCLOT->SEQ;
    MEMCPY_AN(MINVETCLOT_N->LOT_TYPE, MINVETCLOT->LOT_TYPE, sizeof(MINVETCLOT->LOT_TYPE));
    MINVETCLOT_N->QTY = MINVETCLOT->QTY;
    MEMCPY_AN(MINVETCLOT_N->MAT_ID, MINVETCLOT->MAT_ID, sizeof(MINVETCLOT->MAT_ID));
    MINVETCLOT_N->MAT_VER = MINVETCLOT->MAT_VER;
    MEMCPY_AN(MINVETCLOT_N->AREA_ID, MINVETCLOT->AREA_ID, sizeof(MINVETCLOT->AREA_ID));
    MEMCPY_AN(MINVETCLOT_N->SUB_AREA_ID, MINVETCLOT->SUB_AREA_ID, sizeof(MINVETCLOT->SUB_AREA_ID));
    MEMCPY_AN(MINVETCLOT_N->OPER, MINVETCLOT->OPER, sizeof(MINVETCLOT->OPER));
    MEMCPY_AN(MINVETCLOT_N->VENDOR_ID, MINVETCLOT->VENDOR_ID, sizeof(MINVETCLOT->VENDOR_ID));
    MINVETCLOT_N->VENDOR_SITE_ID = MINVETCLOT->VENDOR_SITE_ID;
    MEMCPY_AN(MINVETCLOT_N->VENDOR_LOT_ID, MINVETCLOT->VENDOR_LOT_ID, sizeof(MINVETCLOT->VENDOR_LOT_ID));
    MEMCPY_AN(MINVETCLOT_N->ETC_TYPE, MINVETCLOT->ETC_TYPE, sizeof(MINVETCLOT->ETC_TYPE));
    MEMCPY_AN(MINVETCLOT_N->ETC_DATE, MINVETCLOT->ETC_DATE, sizeof(MINVETCLOT->ETC_DATE));
    MINVETCLOT_N->TRAN_SRC_ID = MINVETCLOT->TRAN_SRC_ID;
    MEMCPY_AN(MINVETCLOT_N->TRAN_SRC_NAME, MINVETCLOT->TRAN_SRC_NAME, sizeof(MINVETCLOT->TRAN_SRC_NAME));
    MEMCPY_AN(MINVETCLOT_N->ETC_COMMENT, MINVETCLOT->ETC_COMMENT, sizeof(MINVETCLOT->ETC_COMMENT));
    MEMCPY_AN(MINVETCLOT_N->CMF_1, MINVETCLOT->CMF_1, sizeof(MINVETCLOT->CMF_1));
    MEMCPY_AN(MINVETCLOT_N->CMF_2, MINVETCLOT->CMF_2, sizeof(MINVETCLOT->CMF_2));
    MEMCPY_AN(MINVETCLOT_N->CMF_3, MINVETCLOT->CMF_3, sizeof(MINVETCLOT->CMF_3));
    MEMCPY_AN(MINVETCLOT_N->CMF_4, MINVETCLOT->CMF_4, sizeof(MINVETCLOT->CMF_4));
    MEMCPY_AN(MINVETCLOT_N->CMF_5, MINVETCLOT->CMF_5, sizeof(MINVETCLOT->CMF_5));
    MEMCPY_AN(MINVETCLOT_N->CMF_6, MINVETCLOT->CMF_6, sizeof(MINVETCLOT->CMF_6));
    MEMCPY_AN(MINVETCLOT_N->CMF_7, MINVETCLOT->CMF_7, sizeof(MINVETCLOT->CMF_7));
    MEMCPY_AN(MINVETCLOT_N->CMF_8, MINVETCLOT->CMF_8, sizeof(MINVETCLOT->CMF_8));
    MEMCPY_AN(MINVETCLOT_N->CMF_9, MINVETCLOT->CMF_9, sizeof(MINVETCLOT->CMF_9));
    MEMCPY_AN(MINVETCLOT_N->CMF_10, MINVETCLOT->CMF_10, sizeof(MINVETCLOT->CMF_10));
    MEMCPY_AN(MINVETCLOT_N->CREATE_USER_ID, MINVETCLOT->CREATE_USER_ID, sizeof(MINVETCLOT->CREATE_USER_ID));
    MEMCPY_AN(MINVETCLOT_N->CREATE_TIME, MINVETCLOT->CREATE_TIME, sizeof(MINVETCLOT->CREATE_TIME));
    MEMCPY_AN(MINVETCLOT_N->UPDATE_USER_ID, MINVETCLOT->UPDATE_USER_ID, sizeof(MINVETCLOT->UPDATE_USER_ID));
    MEMCPY_AN(MINVETCLOT_N->UPDATE_TIME, MINVETCLOT->UPDATE_TIME, sizeof(MINVETCLOT->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_minvetclot(struct MINVETCLOT_N_TAG *MINVETCLOT_N, struct MINVETCLOT_TAG *MINVETCLOT)
{
    MEMCPY_DN(MINVETCLOT->FACTORY, MINVETCLOT_N->FACTORY, sizeof(MINVETCLOT->FACTORY));
    MEMCPY_DN(MINVETCLOT->LOT_ID, MINVETCLOT_N->LOT_ID, sizeof(MINVETCLOT->LOT_ID));
    MINVETCLOT->SEQ = MINVETCLOT_N->SEQ;
    MEMCPY_DN(MINVETCLOT->LOT_TYPE, MINVETCLOT_N->LOT_TYPE, sizeof(MINVETCLOT->LOT_TYPE));
    MINVETCLOT->QTY = MINVETCLOT_N->QTY;
