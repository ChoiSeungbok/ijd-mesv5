    MEMCPY_AN(CRASBASDAT_N->CMF_2, CRASBASDAT->CMF_2, sizeof(CRASBASDAT->CMF_2));
    MEMCPY_AN(CRASBASDAT_N->CMF_3, CRASBASDAT->CMF_3, sizeof(CRASBASDAT->CMF_3));
    MEMCPY_AN(CRASBASDAT_N->CMF_4, CRASBASDAT->CMF_4, sizeof(CRASBASDAT->CMF_4));
    MEMCPY_AN(CRASBASDAT_N->CMF_5, CRASBASDAT->CMF_5, sizeof(CRASBASDAT->CMF_5));
}


/* Del Null Function */
void DBU_del_null_crasbasdat(struct CRASBASDAT_N_TAG *CRASBASDAT_N, struct CRASBASDAT_TAG *CRASBASDAT)
{
    MEMCPY_DN(CRASBASDAT->FACTORY, CRASBASDAT_N->FACTORY, sizeof(CRASBASDAT->FACTORY));
