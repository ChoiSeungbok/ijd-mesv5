/* Add Null Function */
void DBU_add_null_crasbasdat(struct CRASBASDAT_N_TAG *CRASBASDAT_N, struct CRASBASDAT_TAG *CRASBASDAT)
{
    /* memset by NULL */
    memset(CRASBASDAT_N, '\0', sizeof(struct CRASBASDAT_N_TAG));
    
    MEMCPY_AN(CRASBASDAT_N->FACTORY, CRASBASDAT->FACTORY, sizeof(CRASBASDAT->FACTORY));
    MEMCPY_AN(CRASBASDAT_N->RES_ID, CRASBASDAT->RES_ID, sizeof(CRASBASDAT->RES_ID));
    CRASBASDAT_N->PROC_YN[0] = CRASBASDAT->PROC_YN;
    CRASBASDAT_N->NOWORK_TYPE[0] = CRASBASDAT->NOWORK_TYPE;
    CRASBASDAT_N->RUN_TYPE[0] = CRASBASDAT->RUN_TYPE;
