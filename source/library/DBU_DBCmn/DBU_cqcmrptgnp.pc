    DBU_add_null_cqcmrptgnp(&CQCMRPTGNP_N, CQCMRPTGNP);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CQCMRPTGNP_CUR_1 CURSOR FOR
                SELECT 
				    FACTORY,
                    REPORT_NO,
