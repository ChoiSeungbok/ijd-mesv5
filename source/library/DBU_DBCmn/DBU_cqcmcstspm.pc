    MEMCPY_AN(CQCMCSTSPM_N->CREATE_TIME, CQCMCSTSPM->CREATE_TIME, sizeof(CQCMCSTSPM->CREATE_TIME));
    MEMCPY_AN(CQCMCSTSPM_N->UPDATE_USER_ID, CQCMCSTSPM->UPDATE_USER_ID, sizeof(CQCMCSTSPM->UPDATE_USER_ID));
    MEMCPY_AN(CQCMCSTSPM_N->UPDATE_TIME, CQCMCSTSPM->UPDATE_TIME, sizeof(CQCMCSTSPM->UPDATE_TIME));
}


