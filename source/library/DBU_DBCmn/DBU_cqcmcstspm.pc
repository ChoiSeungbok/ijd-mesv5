            EXEC SQL DECLARE DBU_CQCMCSTSPM_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    INSP_TYPE,
                    MAT_ID,
                    MAT_VER,
                    DELIVERY_ID,
