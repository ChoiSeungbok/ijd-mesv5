void DBU_open_mgcmtbldef(int sel_type, struct MGCMTBLDEF_TAG *MGCMTBLDEF)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MGCMTBLDEF_N_TAG MGCMTBLDEF_N;
