                    INV_CMF_2 = :MINVLOTSTS_N.INV_CMF_2,
                    INV_CMF_3 = :MINVLOTSTS_N.INV_CMF_3,
                    INV_CMF_4 = :MINVLOTSTS_N.INV_CMF_4,
                    INV_CMF_5 = :MINVLOTSTS_N.INV_CMF_5,
                    INV_CMF_6 = :MINVLOTSTS_N.INV_CMF_6,
                    INV_CMF_7 = :MINVLOTSTS_N.INV_CMF_7,
                    INV_CMF_8 = :MINVLOTSTS_N.INV_CMF_8,
                    INV_CMF_9 = :MINVLOTSTS_N.INV_CMF_9,
                    INV_CMF_10 = :MINVLOTSTS_N.INV_CMF_10,
                    INV_CMF_11 = :MINVLOTSTS_N.INV_CMF_11,
                    INV_CMF_12 = :MINVLOTSTS_N.INV_CMF_12,
                    INV_CMF_13 = :MINVLOTSTS_N.INV_CMF_13,
                    INV_CMF_14 = :MINVLOTSTS_N.INV_CMF_14,
                    INV_CMF_15 = :MINVLOTSTS_N.INV_CMF_15,
                    INV_CMF_16 = :MINVLOTSTS_N.INV_CMF_16,
                    INV_CMF_17 = :MINVLOTSTS_N.INV_CMF_17,
                    INV_CMF_18 = :MINVLOTSTS_N.INV_CMF_18,
                    INV_CMF_19 = :MINVLOTSTS_N.INV_CMF_19,
                    INV_CMF_20 = :MINVLOTSTS_N.INV_CMF_20,
                    LAST_TRAN_CODE = :MINVLOTSTS_N.LAST_TRAN_CODE,
                    LAST_TRAN_TIME = :MINVLOTSTS_N.LAST_TRAN_TIME,
                    LAST_TRAN_COMMENT = :MINVLOTSTS_N.LAST_TRAN_COMMENT,
                    LAST_ACTIVE_HIST_SEQ = :MINVLOTSTS_N.LAST_ACTIVE_HIST_SEQ,
                    LAST_HIST_SEQ = :MINVLOTSTS_N.LAST_HIST_SEQ,
                    ORG_INV_LOT_ID = :MINVLOTSTS_N.ORG_INV_LOT_ID,
                    FROM_TO_DIV = :MINVLOTSTS_N.FROM_TO_DIV,
                    FROM_TO_INV_LOT_ID = :MINVLOTSTS_N.FROM_TO_INV_LOT_ID,
                    FROM_TO_HIST_SEQ = :MINVLOTSTS_N.FROM_TO_HIST_SEQ,
                    CREATE_QTY = :MINVLOTSTS_N.CREATE_QTY,
                    CREATE_QTY_2 = :MINVLOTSTS_N.CREATE_QTY_2,
                    CREATE_QTY_3 = :MINVLOTSTS_N.CREATE_QTY_3,
                    CREATE_USER_ID = :MINVLOTSTS_N.CREATE_USER_ID,
                    CREATE_TIME = :MINVLOTSTS_N.CREATE_TIME,
                    UPDATE_USER_ID = :MINVLOTSTS_N.UPDATE_USER_ID,
                    UPDATE_TIME = :MINVLOTSTS_N.UPDATE_TIME
                WHERE FACTORY = :MINVLOTSTS_N.FACTORY
                    AND INV_LOT_ID = :MINVLOTSTS_N.INV_LOT_ID;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_update_minvlotsts", sel_type);
}


/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_minvlotsts(int sel_type, struct MINVLOTSTS_TAG *MINVLOTSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVLOTSTS_N_TAG MINVLOTSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_minvlotsts(&MINVLOTSTS_N, MINVLOTSTS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_MINVLOTSTS_CUR_1 CURSOR FOR
