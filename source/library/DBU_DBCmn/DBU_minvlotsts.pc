    MEMCPY_AN(MINVLOTSTS_N->UNIT_3, MINVLOTSTS->UNIT_3, sizeof(MINVLOTSTS->UNIT_3));
    MEMCPY_AN(MINVLOTSTS_N->ORDER_ID, MINVLOTSTS->ORDER_ID, sizeof(MINVLOTSTS->ORDER_ID));
    MEMCPY_AN(MINVLOTSTS_N->ADD_ORDER_ID_1, MINVLOTSTS->ADD_ORDER_ID_1, sizeof(MINVLOTSTS->ADD_ORDER_ID_1));
    MEMCPY_AN(MINVLOTSTS_N->ADD_ORDER_ID_2, MINVLOTSTS->ADD_ORDER_ID_2, sizeof(MINVLOTSTS->ADD_ORDER_ID_2));
