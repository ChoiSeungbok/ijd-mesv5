{
    /* memset by NULL */
    memset(MINVLOTSTS_N, '\0', sizeof(struct MINVLOTSTS_N_TAG));
    
    MEMCPY_AN(MINVLOTSTS_N->FACTORY, MINVLOTSTS->FACTORY, sizeof(MINVLOTSTS->FACTORY));
    MEMCPY_AN(MINVLOTSTS_N->INV_LOT_ID, MINVLOTSTS->INV_LOT_ID, sizeof(MINVLOTSTS->INV_LOT_ID));
    MEMCPY_AN(MINVLOTSTS_N->INV_LOT_DESC, MINVLOTSTS->INV_LOT_DESC, sizeof(MINVLOTSTS->INV_LOT_DESC));
