                    LAST_HIST_SEQ,
                    ORG_INV_LOT_ID,
                    FROM_TO_DIV,
                    FROM_TO_INV_LOT_ID,
                    FROM_TO_HIST_SEQ,
                    CREATE_QTY,
                    CREATE_QTY_2,
                    CREATE_QTY_3,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM MINVLOTSTS
				WHERE FACTORY = :MINVLOTSTS_N.FACTORY
				  AND OPER = :MINVLOTSTS_N.OPER
                  AND INV_CMF_4 = :MINVLOTSTS_N.INV_CMF_4
                  AND INV_LOT_ID >= :MINVLOTSTS_N.INV_LOT_ID
                ORDER BY INV_LOT_ID ASC;
            EXEC SQL OPEN DBU_MINVLOTSTS_CUR_4;
            break;

		case 5:
            EXEC SQL DECLARE DBU_MINVLOTSTS_CUR_5 CURSOR FOR
                SELECT 
                    FACTORY,
                    INV_LOT_ID,
                    INV_LOT_DESC,
                    INV_LOT_TYPE,
                    INV_LOT_STATUS,
                    INV_LOT_PRIORITY,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    QTY_2,
                    QTY_3,
                    UNIT,
                    UNIT_2,
                    UNIT_3,
                    ORDER_ID,
                    ADD_ORDER_ID_1,
                    ADD_ORDER_ID_2,
                    ADD_ORDER_ID_3,
                    VENDOR_ID,
					VENDOR_SITE_ID,
                    VENDOR_LOT_ID,
                    AREA_ID,
                    SUB_AREA_ID,
                    LOCATION_1,
                    LOCATION_2,
                    LOCATION_3,
                    OPER,
                    LOC_NO,
                    RES_ID,
                    PORT_ID,
                    SLOT_NO,
                    CRR_ID,
                    LOT_ID,
                    RECV_DATE,
                    RECV_QTY,
                    REASON_CODE,
                    LOAD_FLAG,
                    TRANSIT_FLAG,
                    DELETE_FLAG,
                    DELETE_CODE,
                    DELETE_USER_ID,
                    DELETE_TIME,
                    HOLD_FLAG,
                    HOLD_CODE,
                    INSP_FLAG,
                    INSP_ID,
                    INSP_RESULT_FLAG,
                    INV_LOT_GRADE,
                    DLV_NO,
                    DLV_SEQ,
                    PO_NO,
                    PO_SEQ,
                    BL_NO,
                    BL_SEQ,
					PO_DISTRIBUTION_ID,
                    INV_CMF_1,
                    INV_CMF_2,
                    INV_CMF_3,
                    INV_CMF_4,
                    INV_CMF_5,
                    INV_CMF_6,
                    INV_CMF_7,
                    INV_CMF_8,
                    INV_CMF_9,
                    INV_CMF_10,
                    INV_CMF_11,
                    INV_CMF_12,
                    INV_CMF_13,
                    INV_CMF_14,
                    INV_CMF_15,
                    INV_CMF_16,
                    INV_CMF_17,
                    INV_CMF_18,
                    INV_CMF_19,
                    INV_CMF_20,
                    LAST_TRAN_CODE,
                    LAST_TRAN_TIME,
                    LAST_TRAN_COMMENT,
                    LAST_ACTIVE_HIST_SEQ,
                    LAST_HIST_SEQ,
                    ORG_INV_LOT_ID,
                    FROM_TO_DIV,
                    FROM_TO_INV_LOT_ID,
                    FROM_TO_HIST_SEQ,
                    CREATE_QTY,
                    CREATE_QTY_2,
                    CREATE_QTY_3,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM MINVLOTSTS
				WHERE FACTORY = :MINVLOTSTS_N.FACTORY
                  AND INV_LOT_ID IN (
										SELECT LABEL_ID INV_LOT_ID
										  FROM MINVDLVLBL
									     WHERE FACTORY = :MINVLOTSTS_N.FACTORY
										   AND DLV_LOT_ID = :MINVLOTSTS_N.ADD_ORDER_ID_1
									)
                ORDER BY INV_LOT_ID ASC;
            EXEC SQL OPEN DBU_MINVLOTSTS_CUR_5;
            break;
      
      case 6:
            EXEC SQL DECLARE DBU_MINVLOTSTS_CUR_6 CURSOR FOR
               SELECT 
                    LOT.FACTORY,
                    LOT.INV_LOT_TYPE,
                    LOT.MAT_ID,
                    LOT.MAT_VER,
                    SUM(LOT.QTY) AS QTY,
                    MAT.UNIT_1 AS UNIT,                  
                    LOT.AREA_ID                   
                FROM MINVLOTSTS LOT, MWIPMATDEF MAT
				WHERE LOT.FACTORY = MAT.FACTORY
                AND LOT.MAT_ID = MAT.MAT_ID
                AND LOT.MAT_VER = MAT.MAT_VER
                AND LOT.FACTORY = :MINVLOTSTS_N.FACTORY
				AND LOT.AREA_ID = :MINVLOTSTS_N.AREA_ID
                AND MAT.MAT_TYPE = :MINVLOTSTS_N.INV_LOT_TYPE
				AND ((:MINVLOTSTS_N.MAT_ID = ' ') OR (LOT.MAT_ID = :MINVLOTSTS_N.MAT_ID))
				AND LOT.DELETE_FLAG <> 'Y'
                GROUP BY LOT.FACTORY,
                    LOT.MAT_ID,
                    LOT.MAT_VER,
                    LOT.INV_LOT_TYPE,
                    LOT.AREA_ID,
                    MAT.UNIT_1
                ORDER BY LOT.MAT_ID ASC;
            EXEC SQL OPEN DBU_MINVLOTSTS_CUR_6;
            break;

		case 7:
            EXEC SQL DECLARE DBU_MINVLOTSTS_CUR_7 CURSOR FOR
                SELECT 
                    FACTORY,
                    INV_LOT_ID,
                    INV_LOT_DESC,
                    INV_LOT_TYPE,
                    INV_LOT_STATUS,
                    INV_LOT_PRIORITY,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    QTY_2,
                    QTY_3,
                    UNIT,
                    UNIT_2,
                    UNIT_3,
                    ORDER_ID,
                    ADD_ORDER_ID_1,
                    ADD_ORDER_ID_2,
                    ADD_ORDER_ID_3,
                    VENDOR_ID,
					VENDOR_SITE_ID,
                    VENDOR_LOT_ID,
                    AREA_ID,
                    SUB_AREA_ID,
                    LOCATION_1,
                    LOCATION_2,
                    LOCATION_3,
                    OPER,
                    LOC_NO,
                    RES_ID,
                    PORT_ID,
                    SLOT_NO,
                    CRR_ID,
                    LOT_ID,
                    RECV_DATE,
                    RECV_QTY,
                    REASON_CODE,
                    LOAD_FLAG,
                    TRANSIT_FLAG,
                    DELETE_FLAG,
                    DELETE_CODE,
                    DELETE_USER_ID,
                    DELETE_TIME,
                    HOLD_FLAG,
                    HOLD_CODE,
