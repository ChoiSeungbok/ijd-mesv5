    MEMCPY_AN(MINVLOTSTS_N->INV_LOT_STATUS, MINVLOTSTS->INV_LOT_STATUS, sizeof(MINVLOTSTS->INV_LOT_STATUS));
    MINVLOTSTS_N->INV_LOT_PRIORITY[0] = MINVLOTSTS->INV_LOT_PRIORITY;
    MEMCPY_AN(MINVLOTSTS_N->MAT_ID, MINVLOTSTS->MAT_ID, sizeof(MINVLOTSTS->MAT_ID));
    MINVLOTSTS_N->MAT_VER = MINVLOTSTS->MAT_VER;
    MINVLOTSTS_N->QTY = MINVLOTSTS->QTY;
    MINVLOTSTS_N->QTY_2 = MINVLOTSTS->QTY_2;
    MINVLOTSTS_N->QTY_3 = MINVLOTSTS->QTY_3;
