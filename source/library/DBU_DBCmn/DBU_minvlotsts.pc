                :MINVLOTSTS_N.CREATE_QTY_3,
                :MINVLOTSTS_N.CREATE_USER_ID,
                :MINVLOTSTS_N.CREATE_TIME,
                :MINVLOTSTS_N.UPDATE_USER_ID,
                :MINVLOTSTS_N.UPDATE_TIME;
            break;

		case 2:
            EXEC SQL FETCH DBU_MINVLOTSTS_CUR_2 INTO
                :MINVLOTSTS_N.FACTORY,
                :MINVLOTSTS_N.INV_LOT_ID,
                :MINVLOTSTS_N.INV_LOT_DESC,
