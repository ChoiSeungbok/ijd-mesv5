    MINVLOTSTS->INV_LOT_PRIORITY = MINVLOTSTS_N->INV_LOT_PRIORITY[0];
    MEMCPY_DN(MINVLOTSTS->MAT_ID, MINVLOTSTS_N->MAT_ID, sizeof(MINVLOTSTS->MAT_ID));
