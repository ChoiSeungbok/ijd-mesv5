                    INV_CMF_2,
                    INV_CMF_3,
                    INV_CMF_4,
                    INV_CMF_5,
                    INV_CMF_6,
                    INV_CMF_7,
                    INV_CMF_8,
                    INV_CMF_9,
                    INV_CMF_10,
                    INV_CMF_11,
                    INV_CMF_12,
                    INV_CMF_13,
                    INV_CMF_14,
                    INV_CMF_15,
                    INV_CMF_16,
                    INV_CMF_17,
                    INV_CMF_18,
                    INV_CMF_19,
                    INV_CMF_20,
                    LAST_TRAN_CODE,
                    LAST_TRAN_TIME,
                    LAST_TRAN_COMMENT,
                    LAST_ACTIVE_HIST_SEQ,
                    LAST_HIST_SEQ,
                    ORG_INV_LOT_ID,
                    FROM_TO_DIV,
                    FROM_TO_INV_LOT_ID,
                    FROM_TO_HIST_SEQ,
                    CREATE_QTY,
                    CREATE_QTY_2,
                    CREATE_QTY_3,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM MINVLOTSTS
				WHERE FACTORY = :MINVLOTSTS_N.FACTORY
				AND AREA_ID = :MINVLOTSTS_N.AREA_ID
				AND MAT_ID = :MINVLOTSTS_N.MAT_ID
                AND MAT_VER = :MINVLOTSTS_N.MAT_VER
				AND DELETE_FLAG <> 'Y'
                ORDER BY FACTORY ASC,
                    INV_LOT_ID ASC;
            EXEC SQL OPEN DBU_MINVLOTSTS_CUR_7;
            break;

		case 8:
            EXEC SQL DECLARE DBU_MINVLOTSTS_CUR_8 CURSOR FOR
                SELECT 
                    FACTORY,
                    INV_LOT_ID,
                    INV_LOT_DESC,
                    INV_LOT_TYPE,
                    INV_LOT_STATUS,
                    INV_LOT_PRIORITY,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    QTY_2,
                    QTY_3,
                    UNIT,
                    UNIT_2,
                    UNIT_3,
                    ORDER_ID,
                    ADD_ORDER_ID_1,
                    ADD_ORDER_ID_2,
                    ADD_ORDER_ID_3,
                    VENDOR_ID,
					VENDOR_SITE_ID,
                    VENDOR_LOT_ID,
                    AREA_ID,
                    SUB_AREA_ID,
                    LOCATION_1,
                    LOCATION_2,
                    LOCATION_3,
                    OPER,
                    LOC_NO,
                    RES_ID,
                    PORT_ID,
                    SLOT_NO,
                    CRR_ID,
                    LOT_ID,
                    RECV_DATE,
                    RECV_QTY,
                    REASON_CODE,
                    LOAD_FLAG,
                    TRANSIT_FLAG,
                    DELETE_FLAG,
                    DELETE_CODE,
                    DELETE_USER_ID,
                    DELETE_TIME,
                    HOLD_FLAG,
                    HOLD_CODE,
                    INSP_FLAG,
                    INSP_ID,
                    INSP_RESULT_FLAG,
                    INV_LOT_GRADE,
                    DLV_NO,
                    DLV_SEQ,
                    PO_NO,
                    PO_SEQ,
                    BL_NO,
                    BL_SEQ,
					PO_DISTRIBUTION_ID,
                    INV_CMF_1,
                    INV_CMF_2,
                    INV_CMF_3,
                    INV_CMF_4,
                    INV_CMF_5,
                    INV_CMF_6,
                    INV_CMF_7,
                    INV_CMF_8,
                    INV_CMF_9,
                    INV_CMF_10,
                    INV_CMF_11,
                    INV_CMF_12,
                    INV_CMF_13,
                    INV_CMF_14,
                    INV_CMF_15,
                    INV_CMF_16,
                    INV_CMF_17,
                    INV_CMF_18,
                    INV_CMF_19,
                    INV_CMF_20,
                    LAST_TRAN_CODE,
                    LAST_TRAN_TIME,
                    LAST_TRAN_COMMENT,
                    LAST_ACTIVE_HIST_SEQ,
                    LAST_HIST_SEQ,
                    ORG_INV_LOT_ID,
                    FROM_TO_DIV,
                    FROM_TO_INV_LOT_ID,
                    FROM_TO_HIST_SEQ,
                    CREATE_QTY,
                    CREATE_QTY_2,
                    CREATE_QTY_3,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM MINVLOTSTS
				WHERE FACTORY = :MINVLOTSTS_N.FACTORY
				AND INV_CMF_4 = :MINVLOTSTS_N.INV_CMF_4
				AND DELETE_FLAG <> 'Y'
                ORDER BY FACTORY ASC,
                    INV_LOT_ID ASC;
            EXEC SQL OPEN DBU_MINVLOTSTS_CUR_8;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_minvlotsts", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_minvlotsts(int sel_type, struct MINVLOTSTS_TAG *MINVLOTSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVLOTSTS_N_TAG MINVLOTSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_MINVLOTSTS_CUR_1 INTO
                :MINVLOTSTS_N.FACTORY,
                :MINVLOTSTS_N.INV_LOT_ID,
                :MINVLOTSTS_N.INV_LOT_DESC,
                :MINVLOTSTS_N.INV_LOT_TYPE,
