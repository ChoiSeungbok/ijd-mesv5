                ORDER BY FACTORY ASC,
                    INV_LOT_ID ASC;
            EXEC SQL OPEN DBU_MINVLOTSTS_CUR_1;
            break;

		case 2:
            EXEC SQL DECLARE DBU_MINVLOTSTS_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
