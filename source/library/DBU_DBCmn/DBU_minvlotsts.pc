                    QTY = :MINVLOTSTS_N.QTY,
                    QTY_2 = :MINVLOTSTS_N.QTY_2,
                    QTY_3 = :MINVLOTSTS_N.QTY_3,
                    UNIT = :MINVLOTSTS_N.UNIT,
                    UNIT_2 = :MINVLOTSTS_N.UNIT_2,
                    UNIT_3 = :MINVLOTSTS_N.UNIT_3,
                    ORDER_ID = :MINVLOTSTS_N.ORDER_ID,
                    ADD_ORDER_ID_1 = :MINVLOTSTS_N.ADD_ORDER_ID_1,
                    ADD_ORDER_ID_2 = :MINVLOTSTS_N.ADD_ORDER_ID_2,
                    ADD_ORDER_ID_3 = :MINVLOTSTS_N.ADD_ORDER_ID_3,
                    VENDOR_ID = :MINVLOTSTS_N.VENDOR_ID,
					VENDOR_SITE_ID = :MINVLOTSTS_N.VENDOR_SITE_ID,
