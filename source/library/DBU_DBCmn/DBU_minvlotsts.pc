                    AREA_ID = :MINVLOTSTS_N.AREA_ID,
                    SUB_AREA_ID = :MINVLOTSTS_N.SUB_AREA_ID,
                    LOCATION_1 = :MINVLOTSTS_N.LOCATION_1,
                    LOCATION_2 = :MINVLOTSTS_N.LOCATION_2,
                    LOCATION_3 = :MINVLOTSTS_N.LOCATION_3,
                    OPER = :MINVLOTSTS_N.OPER,
                    LOC_NO = :MINVLOTSTS_N.LOC_NO,
                    RES_ID = :MINVLOTSTS_N.RES_ID,
                    PORT_ID = :MINVLOTSTS_N.PORT_ID,
                    SLOT_NO = :MINVLOTSTS_N.SLOT_NO,
                    CRR_ID = :MINVLOTSTS_N.CRR_ID,
                    LOT_ID = :MINVLOTSTS_N.LOT_ID,
                    RECV_DATE = :MINVLOTSTS_N.RECV_DATE,
                    RECV_QTY = :MINVLOTSTS_N.RECV_QTY,
                    REASON_CODE = :MINVLOTSTS_N.REASON_CODE,
                    LOAD_FLAG = :MINVLOTSTS_N.LOAD_FLAG,
                    TRANSIT_FLAG = :MINVLOTSTS_N.TRANSIT_FLAG,
                    DELETE_FLAG = :MINVLOTSTS_N.DELETE_FLAG,
                    DELETE_CODE = :MINVLOTSTS_N.DELETE_CODE,
                    DELETE_USER_ID = :MINVLOTSTS_N.DELETE_USER_ID,
