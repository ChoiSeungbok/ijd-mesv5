/* Del Null Function */
void DBU_del_null_minvlotsts(struct MINVLOTSTS_N_TAG *MINVLOTSTS_N, struct MINVLOTSTS_TAG *MINVLOTSTS)
{
    MEMCPY_DN(MINVLOTSTS->FACTORY, MINVLOTSTS_N->FACTORY, sizeof(MINVLOTSTS->FACTORY));
    MEMCPY_DN(MINVLOTSTS->INV_LOT_ID, MINVLOTSTS_N->INV_LOT_ID, sizeof(MINVLOTSTS->INV_LOT_ID));
