/* SQL SELECT_SCALAR Function */
double DBU_select_minvlotsts_scalar(int sel_type, struct MINVLOTSTS_TAG *MINVLOTSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVLOTSTS_N_TAG MINVLOTSTS_N;
        double d_value;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_minvlotsts(&MINVLOTSTS_N, MINVLOTSTS);
    DB_error_code = 0;
    d_value = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MINVLOTSTS
                WHERE FACTORY = :MINVLOTSTS_N.FACTORY
                    AND INV_LOT_ID = :MINVLOTSTS_N.INV_LOT_ID;
            break;

		case 2:
            EXEC SQL  SELECT SUM (LOT.QTY) QTY
                INTO :d_value
				FROM MWIPMATDEF MAT, MINVLOTSTS LOT
			    WHERE     MAT.FACTORY = :MINVLOTSTS_N.FACTORY
					AND MAT.FACTORY = LOT.FACTORY
					AND MAT.MAT_ID = LOT.MAT_ID
					AND MAT.MAT_VER = LOT.MAT_VER
					AND LOT.HOLD_FLAG <> 'Y'
					AND LOT.DELETE_FLAG <> 'Y'
					AND LOT.OPER = :MINVLOTSTS_N.OPER
					AND MAT.MAT_ID = :MINVLOTSTS_N.MAT_ID
					AND MAT.MAT_VER = :MINVLOTSTS_N.MAT_VER;
            break;

		case 3:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MINVLOTSTS
                WHERE FACTORY = :MINVLOTSTS_N.FACTORY
                    AND INV_CMF_4 = :MINVLOTSTS_N.INV_CMF_4
					AND OPER <> 'OR01000';
            break;

		case 4:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MINVLOTSTS
                WHERE FACTORY = :MINVLOTSTS_N.FACTORY
					AND INV_LOT_ID IN (
										SELECT LABEL_ID INV_LOT_ID
										  FROM MINVDLVLBL
									     WHERE FACTORY = :MINVLOTSTS_N.FACTORY
										   AND DLV_LOT_ID = :MINVLOTSTS_N.ADD_ORDER_ID_1
								      )
					AND LAST_TRAN_CODE <> :MINVLOTSTS_N.LAST_TRAN_CODE;
            break;

		case 5:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MINVLOTSTS
                WHERE FACTORY = :MINVLOTSTS_N.FACTORY
                    AND INV_CMF_4 = :MINVLOTSTS_N.INV_CMF_4
					AND DELETE_FLAG <> 'Y';
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_select_minvlotsts_scalar", sel_type);

    return d_value;
}


