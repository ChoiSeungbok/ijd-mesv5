/* SQL UPDATE Function */
void DBU_update_minvlotsts(int sel_type, struct MINVLOTSTS_TAG *MINVLOTSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVLOTSTS_N_TAG MINVLOTSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_minvlotsts(&MINVLOTSTS_N, MINVLOTSTS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL UPDATE MINVLOTSTS SET
                    INV_LOT_DESC = :MINVLOTSTS_N.INV_LOT_DESC,
                    INV_LOT_TYPE = :MINVLOTSTS_N.INV_LOT_TYPE,
                    INV_LOT_STATUS = :MINVLOTSTS_N.INV_LOT_STATUS,
                    INV_LOT_PRIORITY = :MINVLOTSTS_N.INV_LOT_PRIORITY,
                    MAT_ID = :MINVLOTSTS_N.MAT_ID,
