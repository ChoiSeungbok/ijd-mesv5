                :MINVLOTSTS_N.LOT_ID,
                :MINVLOTSTS_N.RECV_DATE,
                :MINVLOTSTS_N.RECV_QTY,
                :MINVLOTSTS_N.REASON_CODE,
                :MINVLOTSTS_N.LOAD_FLAG,
