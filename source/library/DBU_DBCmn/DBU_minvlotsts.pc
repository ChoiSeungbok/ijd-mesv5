                :MINVLOTSTS_N.INV_CMF_6,
                :MINVLOTSTS_N.INV_CMF_7,
                :MINVLOTSTS_N.INV_CMF_8,
                :MINVLOTSTS_N.INV_CMF_9,
                :MINVLOTSTS_N.INV_CMF_10,
                :MINVLOTSTS_N.INV_CMF_11,
                :MINVLOTSTS_N.INV_CMF_12,
                :MINVLOTSTS_N.INV_CMF_13,
                :MINVLOTSTS_N.INV_CMF_14,
                :MINVLOTSTS_N.INV_CMF_15,
                :MINVLOTSTS_N.INV_CMF_16,
                :MINVLOTSTS_N.INV_CMF_17,
                :MINVLOTSTS_N.INV_CMF_18,
                :MINVLOTSTS_N.INV_CMF_19,
                :MINVLOTSTS_N.INV_CMF_20,
                :MINVLOTSTS_N.LAST_TRAN_CODE,
                :MINVLOTSTS_N.LAST_TRAN_TIME,
                :MINVLOTSTS_N.LAST_TRAN_COMMENT,
                :MINVLOTSTS_N.LAST_ACTIVE_HIST_SEQ,
                :MINVLOTSTS_N.LAST_HIST_SEQ,
                :MINVLOTSTS_N.ORG_INV_LOT_ID,
                :MINVLOTSTS_N.FROM_TO_DIV,
                :MINVLOTSTS_N.FROM_TO_INV_LOT_ID,
