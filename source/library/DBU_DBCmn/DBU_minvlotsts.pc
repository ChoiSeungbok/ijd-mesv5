/* SQL CURSOR CLOSE Function */
void DBU_close_minvlotsts(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_MINVLOTSTS_CUR_1;
            break;

		case 2:
            EXEC SQL CLOSE DBU_MINVLOTSTS_CUR_2;
            break;

		case 3:
            EXEC SQL CLOSE DBU_MINVLOTSTS_CUR_3;
            break;

        case 4:
            EXEC SQL CLOSE DBU_MINVLOTSTS_CUR_4;
            break;

		case 5:
            EXEC SQL CLOSE DBU_MINVLOTSTS_CUR_5;
            break;

		case 6:
            EXEC SQL CLOSE DBU_MINVLOTSTS_CUR_6;
            break;

		case 7:
            EXEC SQL CLOSE DBU_MINVLOTSTS_CUR_7;
            break;

		case 8:
            EXEC SQL CLOSE DBU_MINVLOTSTS_CUR_8;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_minvlotsts", sel_type);
}


/* Initialize Function */
void DBU_init_minvlotsts(struct MINVLOTSTS_TAG *MINVLOTSTS)
{
    /* memset by Space */
    memset(MINVLOTSTS, ' ', sizeof(struct MINVLOTSTS_TAG));
    
    MINVLOTSTS->MAT_VER = 0;
    MINVLOTSTS->QTY = 0;
    MINVLOTSTS->QTY_2 = 0;
    MINVLOTSTS->QTY_3 = 0;
    MINVLOTSTS->RECV_QTY = 0;
	MINVLOTSTS->DLV_SEQ = 0;
    MINVLOTSTS->PO_SEQ = 0;
    MINVLOTSTS->BL_SEQ = 0;
	MINVLOTSTS->PO_DISTRIBUTION_ID = 0;
	MINVLOTSTS->VENDOR_SITE_ID = 0;
    MINVLOTSTS->LAST_ACTIVE_HIST_SEQ = 0;
    MINVLOTSTS->LAST_HIST_SEQ = 0;
    MINVLOTSTS->FROM_TO_HIST_SEQ = 0;
    MINVLOTSTS->CREATE_QTY = 0;
    MINVLOTSTS->CREATE_QTY_2 = 0;
    MINVLOTSTS->CREATE_QTY_3 = 0;
}


