                :MINVLOTSTS_N.INV_CMF_4,
                :MINVLOTSTS_N.INV_CMF_5,
                :MINVLOTSTS_N.INV_CMF_6,
                :MINVLOTSTS_N.INV_CMF_7,
                :MINVLOTSTS_N.INV_CMF_8,
                :MINVLOTSTS_N.INV_CMF_9,
                :MINVLOTSTS_N.INV_CMF_10,
                :MINVLOTSTS_N.INV_CMF_11,
                :MINVLOTSTS_N.INV_CMF_12,
                :MINVLOTSTS_N.INV_CMF_13,
