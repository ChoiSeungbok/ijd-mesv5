    MEMCPY_AN(MINVLOTSTS_N->INV_CMF_13, MINVLOTSTS->INV_CMF_13, sizeof(MINVLOTSTS->INV_CMF_13));
    MEMCPY_AN(MINVLOTSTS_N->INV_CMF_14, MINVLOTSTS->INV_CMF_14, sizeof(MINVLOTSTS->INV_CMF_14));
    MEMCPY_AN(MINVLOTSTS_N->INV_CMF_15, MINVLOTSTS->INV_CMF_15, sizeof(MINVLOTSTS->INV_CMF_15));
    MEMCPY_AN(MINVLOTSTS_N->INV_CMF_16, MINVLOTSTS->INV_CMF_16, sizeof(MINVLOTSTS->INV_CMF_16));
