void DBU_add_null_cwiplotprs(struct CWIPLOTPRS_N_TAG *CWIPLOTPRS_N, struct CWIPLOTPRS_TAG *CWIPLOTPRS)
{
    /* memset by NULL */
    memset(CWIPLOTPRS_N, '\0', sizeof(struct CWIPLOTPRS_N_TAG));
    
