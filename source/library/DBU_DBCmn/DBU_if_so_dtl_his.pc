                    PICK_STATUS,
                    SHIP_STATUS,
                    SHIP_TO_LOCATION,
                    PICK_CONFIRM_ID,
                    ORIG_SYS_LINE_REF,
                    DATE_SEQ,
                    SALESPERSON,
                    SHIP_CONFIRM_ID,
