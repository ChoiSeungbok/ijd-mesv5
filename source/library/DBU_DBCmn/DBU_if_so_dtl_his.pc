                :IF_SO_DTL_HIS_N.CMF_7,
                :IF_SO_DTL_HIS_N.CMF_8,
                :IF_SO_DTL_HIS_N.CMF_9,
                :IF_SO_DTL_HIS_N.CMF_10,
                :IF_SO_DTL_HIS_N.CREATE_USER_ID,
                :IF_SO_DTL_HIS_N.CREATE_TIME,
                :IF_SO_DTL_HIS_N.UPDATE_USER_ID,
                :IF_SO_DTL_HIS_N.UPDATE_TIME;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_if_so_dtl_his(&IF_SO_DTL_HIS_N, IF_SO_DTL_HIS);
    }

    DB_stop_query_timer("DBU_fetch_if_so_dtl_his", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_if_so_dtl_his(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_IF_SO_DTL_HIS_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_if_so_dtl_his", sel_type);
}


