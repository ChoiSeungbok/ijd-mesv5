                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM IF_SO_DTL_HIS
                ORDER BY IF_SEQ ASC;
            EXEC SQL OPEN DBU_IF_SO_DTL_HIS_CUR_1;
            break;


        default:
