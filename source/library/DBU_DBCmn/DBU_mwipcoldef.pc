    DB_start_query_timer();

    DBU_add_null_mwipcoldef(&MWIPCOLDEF_N, MWIPCOLDEF);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL SELECT 
                    FACTORY,
                    MAT_ID,
                    MAT_VER,
                    FLOW,
                    OPER,
                    OPT_LEVEL,
                    COL_SET_ID,
                    COLLECTION_MODE,
                    DEFAULT_FLAG,
                    DISABLE_FLAG,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                INTO 
                    :MWIPCOLDEF_N.FACTORY,
                    :MWIPCOLDEF_N.MAT_ID,
                    :MWIPCOLDEF_N.MAT_VER,
                    :MWIPCOLDEF_N.FLOW,
                    :MWIPCOLDEF_N.OPER,
                    :MWIPCOLDEF_N.OPT_LEVEL,
                    :MWIPCOLDEF_N.COL_SET_ID,
                    :MWIPCOLDEF_N.COLLECTION_MODE,
                    :MWIPCOLDEF_N.DEFAULT_FLAG,
                    :MWIPCOLDEF_N.DISABLE_FLAG,
                    :MWIPCOLDEF_N.CREATE_USER_ID,
                    :MWIPCOLDEF_N.CREATE_TIME,
                    :MWIPCOLDEF_N.UPDATE_USER_ID,
                    :MWIPCOLDEF_N.UPDATE_TIME
                FROM MWIPCOLDEF
                WHERE FACTORY = :MWIPCOLDEF_N.FACTORY
                    AND MAT_ID = :MWIPCOLDEF_N.MAT_ID
                    AND MAT_VER = :MWIPCOLDEF_N.MAT_VER
                    AND FLOW = :MWIPCOLDEF_N.FLOW
                    AND OPER = :MWIPCOLDEF_N.OPER
                    AND OPT_LEVEL = :MWIPCOLDEF_N.OPT_LEVEL
                    AND COL_SET_ID = :MWIPCOLDEF_N.COL_SET_ID;
            break;

		case 2:
            EXEC SQL SELECT 
                    COL_SET_ID
                INTO 
                    :MWIPCOLDEF_N.COL_SET_ID
                FROM MWIPCOLDEF
                WHERE FACTORY = :MWIPCOLDEF_N.FACTORY
                    AND MAT_ID = :MWIPCOLDEF_N.MAT_ID
                    AND MAT_VER = :MWIPCOLDEF_N.MAT_VER
                    AND OPER = :MWIPCOLDEF_N.OPER
                    AND OPT_LEVEL = :MWIPCOLDEF_N.OPT_LEVEL
					AND DISABLE_FLAG  = :MWIPCOLDEF_N.DISABLE_FLAG
					AND ROWNUM <= 1;
            break;

		case 3:
            EXEC SQL 
                SELECT A.COL_SET_ID
                  INTO :MWIPCOLDEF_N.COL_SET_ID
                  FROM MWIPCOLDEF A, MEDCCOLDEF B
                 WHERE A.FACTORY = B.FACTORY
                   AND A.COL_SET_ID = B.COL_SET_ID
                   AND B.COL_CMF_1 = ' '
                   AND B.DEFAULT_COL_MODE_FLAG = 'A'
                   AND A.FACTORY = :MWIPCOLDEF_N.FACTORY
                   AND A.MAT_ID = :MWIPCOLDEF_N.MAT_ID
                   AND A.MAT_VER = :MWIPCOLDEF_N.MAT_VER
                   AND A.OPER = :MWIPCOLDEF_N.OPER
                   AND A.OPT_LEVEL = :MWIPCOLDEF_N.OPT_LEVEL
                   AND A.DISABLE_FLAG  = :MWIPCOLDEF_N.DISABLE_FLAG;
            break;

		case 4:
            EXEC SQL 
                SELECT A.COL_SET_ID
                  INTO :MWIPCOLDEF_N.COL_SET_ID
                  FROM MWIPCOLDEF A, MEDCCOLDEF B
                 WHERE A.FACTORY = B.FACTORY
                   AND A.COL_SET_ID = B.COL_SET_ID
                   AND A.FACTORY = :MWIPCOLDEF_N.FACTORY
                   AND A.MAT_ID = :MWIPCOLDEF_N.MAT_ID
                   AND A.MAT_VER = :MWIPCOLDEF_N.MAT_VER
                   AND A.OPER = :MWIPCOLDEF_N.OPER
                   AND A.OPT_LEVEL = :MWIPCOLDEF_N.OPT_LEVEL
                   AND A.DISABLE_FLAG  = :MWIPCOLDEF_N.DISABLE_FLAG;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
