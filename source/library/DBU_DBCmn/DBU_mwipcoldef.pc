/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_mwipcoldef(int sel_type, struct MWIPCOLDEF_TAG *MWIPCOLDEF)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MWIPCOLDEF_N_TAG MWIPCOLDEF_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_mwipcoldef(&MWIPCOLDEF_N, MWIPCOLDEF);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_MWIPCOLDEF_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    MAT_ID,
                    MAT_VER,
                    FLOW,
                    OPER,
                    OPT_LEVEL,
                    COL_SET_ID,
                    COLLECTION_MODE,
                    DEFAULT_FLAG,
                    DISABLE_FLAG,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM MWIPCOLDEF
                ORDER BY FACTORY ASC,
                    MAT_ID ASC,
                    MAT_VER ASC,
                    FLOW ASC,
                    OPER ASC,
                    OPT_LEVEL ASC,
                    COL_SET_ID ASC;
            EXEC SQL OPEN DBU_MWIPCOLDEF_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_mwipcoldef", sel_type);
}


