/* SQL SELECT_SCALAR Function */
double DBU_select_minvlotiss_scalar(int sel_type, struct MINVLOTISS_TAG *MINVLOTISS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVLOTISS_N_TAG MINVLOTISS_N;
        double d_value;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_minvlotiss(&MINVLOTISS_N, MINVLOTISS);
    DB_error_code = 0;
    d_value = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MINVLOTISS
                WHERE FACTORY = :MINVLOTISS_N.FACTORY
                    AND INV_LOT_ID = :MINVLOTISS_N.INV_LOT_ID
                    AND HIST_SEQ = :MINVLOTISS_N.HIST_SEQ;
            break;


        case 2:
            EXEC SQL SELECT NVL(TRAN_QTY_3, 0) AS TRAN_QTY
                INTO :d_value
                FROM MINVLOTISS
               WHERE FACTORY = :MINVLOTISS_N.FACTORY
                 AND LOT_ID = :MINVLOTISS_N.LOT_ID
                 AND HIST_SEQ = (SELECT MAX(HIST_SEQ) 
                                   FROM MINVLOTISS 
                                  WHERE FACTORY = :MINVLOTISS_N.FACTORY
                                    AND LOT_ID = :MINVLOTISS_N.LOT_ID
                                    AND HIST_DEL_FLAG != 'Y');
            break;

        case 3:
            EXEC SQL SELECT count(*)
                INTO :d_value
                FROM MINVLOTISS
               WHERE FACTORY = :MINVLOTISS_N.FACTORY
                 AND LOT_ID = :MINVLOTISS_N.LOT_ID
                 AND MAT_ID = :MINVLOTISS_N.MAT_ID
                 AND OPER = :MINVLOTISS_N.OPER
                 AND ORDER_ID = :MINVLOTISS_N.ORDER_ID
                 AND HIST_DEL_FLAG = ' ';
            break;

        case 4:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MINVLOTISS
                WHERE FACTORY = :MINVLOTISS_N.FACTORY
                    AND LOT_ID = :MINVLOTISS_N.LOT_ID
                    AND CMF_1 != 'Y';
            break;

        case 5:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MINVLOTISS
                WHERE FACTORY = :MINVLOTISS_N.FACTORY
                  AND ORDER_ID = :MINVLOTISS_N.ORDER_ID
                  AND MAT_ID = :MINVLOTISS_N.MAT_ID
                  AND OPER = :MINVLOTISS_N.OPER
                  AND HIST_DEL_FLAG != 'Y';
            break;

        case 6:
            EXEC SQL SELECT SUM(TRAN_QTY) 
                INTO :d_value
                FROM MINVLOTISS
                WHERE FACTORY = :MINVLOTISS_N.FACTORY
                  AND ORDER_ID = :MINVLOTISS_N.ORDER_ID
                  AND MAT_ID = :MINVLOTISS_N.MAT_ID
                  AND OPER = :MINVLOTISS_N.OPER
                  AND INV_LOT_ID = :MINVLOTISS_N.INV_LOT_ID
                  AND HIST_DEL_FLAG != 'Y';
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_select_minvlotiss_scalar", sel_type);

    return d_value;
}


