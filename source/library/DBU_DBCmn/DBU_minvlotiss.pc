                    CMF_4 = :MINVLOTISS_N.CMF_4,
                    CMF_5 = :MINVLOTISS_N.CMF_5
                WHERE FACTORY = :MINVLOTISS_N.FACTORY
                    AND INV_LOT_ID = :MINVLOTISS_N.INV_LOT_ID
                    AND HIST_SEQ = :MINVLOTISS_N.HIST_SEQ;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_update_minvlotiss", sel_type);
}


/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_minvlotiss(int sel_type, struct MINVLOTISS_TAG *MINVLOTISS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVLOTISS_N_TAG MINVLOTISS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_minvlotiss(&MINVLOTISS_N, MINVLOTISS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_MINVLOTISS_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    INV_LOT_ID,
                    HIST_SEQ,
                    TRAN_CODE,
                    TRAN_USER_ID,
                    TRAN_TIME,
                    TRAN_COMMENT,
                    MAT_ID,
                    MAT_VER,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    ERP_OPER,
                    OUT_OPER,
                    REASON_CODE,
                    TRAN_QTY,
                    TRAN_QTY_2,
                    TRAN_QTY_3,
                    TRAN_UNIT,
                    TRAN_UNIT_2,
                    TRAN_UNIT_3,
                    LOT_ID,
                    LOT_HIST_SEQ,
                    ORDER_ID,
                    HIST_DEL_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5
                FROM MINVLOTISS
                ORDER BY FACTORY ASC,
                    INV_LOT_ID ASC,
                    HIST_SEQ ASC;
            EXEC SQL OPEN DBU_MINVLOTISS_CUR_1;
            break;


        case 2:
            EXEC SQL DECLARE DBU_MINVLOTISS_CUR_2 CURSOR FOR
                SELECT
                    MAT_ID,
                    AREA_ID,
                    SUB_AREA_ID,
                    sum(TRAN_QTY) as TRAN_QTY
               FROM MINVLOTISS
               WHERE FACTORY = :MINVLOTISS_N.FACTORY
                 AND ORDER_ID = :MINVLOTISS_N.ORDER_ID
                 AND ERP_OPER = :MINVLOTISS_N.ERP_OPER
                 AND LOT_ID = :MINVLOTISS_N.LOT_ID
                 AND HIST_DEL_FLAG = ' '
                GROUP BY MAT_ID, AREA_ID, SUB_AREA_ID
                ORDER BY MAT_ID;
            EXEC SQL OPEN DBU_MINVLOTISS_CUR_2;
            break;

        case 3:
            EXEC SQL DECLARE DBU_MINVLOTISS_CUR_3 CURSOR FOR
                SELECT 
                    FACTORY,
                    INV_LOT_ID,
                    HIST_SEQ,
                    TRAN_CODE,
                    TRAN_USER_ID,
                    TRAN_TIME,
                    TRAN_COMMENT,
                    MAT_ID,
                    MAT_VER,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    ERP_OPER,
                    OUT_OPER,
                    REASON_CODE,
                    TRAN_QTY,
                    TRAN_QTY_2,
                    TRAN_QTY_3,
                    TRAN_UNIT,
                    TRAN_UNIT_2,
                    TRAN_UNIT_3,
                    LOT_ID,
                    LOT_HIST_SEQ,
                    ORDER_ID,
                    HIST_DEL_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5
                FROM MINVLOTISS
               WHERE FACTORY = :MINVLOTISS_N.FACTORY
                 AND ORDER_ID = :MINVLOTISS_N.ORDER_ID
                 AND OPER = :MINVLOTISS_N.OPER
                 AND LOT_ID = :MINVLOTISS_N.LOT_ID
                 AND MAT_ID = :MINVLOTISS_N.MAT_ID
                 AND HIST_DEL_FLAG = ' '
                ORDER BY INV_LOT_ID ASC;
            EXEC SQL OPEN DBU_MINVLOTISS_CUR_3;
            break;


        case 4:
            EXEC SQL DECLARE DBU_MINVLOTISS_CUR_4 CURSOR FOR
                SELECT 
                    FACTORY,
                    INV_LOT_ID,
                    HIST_SEQ,
                    TRAN_CODE,
                    TRAN_USER_ID,
                    TRAN_TIME,
                    TRAN_COMMENT,
                    MAT_ID,
                    MAT_VER,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    ERP_OPER,
                    OUT_OPER,
                    REASON_CODE,
                    TRAN_QTY,
                    TRAN_QTY_2,
                    TRAN_QTY_3,
                    TRAN_UNIT,
                    TRAN_UNIT_2,
                    TRAN_UNIT_3,
                    LOT_ID,
                    LOT_HIST_SEQ,
                    ORDER_ID,
                    HIST_DEL_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5
                FROM MINVLOTISS
               WHERE FACTORY = :MINVLOTISS_N.FACTORY
                 AND ORDER_ID = :MINVLOTISS_N.ORDER_ID
                 AND ERP_OPER = :MINVLOTISS_N.ERP_OPER
                 AND LOT_ID = :MINVLOTISS_N.LOT_ID
                 AND HIST_DEL_FLAG = ' '
                ORDER BY INV_LOT_ID ASC;
            EXEC SQL OPEN DBU_MINVLOTISS_CUR_4;
            break;

        case 5:
            EXEC SQL DECLARE DBU_MINVLOTISS_CUR_5 CURSOR FOR
                SELECT 
                    FACTORY,
                    INV_LOT_ID,
                    HIST_SEQ,
                    TRAN_CODE,
                    TRAN_USER_ID,
                    TRAN_TIME,
                    TRAN_COMMENT,
                    MAT_ID,
                    MAT_VER,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    ERP_OPER,
                    OUT_OPER,
                    REASON_CODE,
                    TRAN_QTY,
                    TRAN_QTY_2,
                    TRAN_QTY_3,
                    TRAN_UNIT,
                    TRAN_UNIT_2,
                    TRAN_UNIT_3,
                    LOT_ID,
                    LOT_HIST_SEQ,
                    ORDER_ID,
                    HIST_DEL_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5
                FROM MINVLOTISS
               WHERE FACTORY = :MINVLOTISS_N.FACTORY
                 AND ORDER_ID = :MINVLOTISS_N.ORDER_ID
                 AND OPER = :MINVLOTISS_N.OPER
                 AND LOT_ID = :MINVLOTISS_N.LOT_ID
                 AND HIST_DEL_FLAG = ' '
                ORDER BY INV_LOT_ID ASC;
            EXEC SQL OPEN DBU_MINVLOTISS_CUR_5;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_minvlotiss", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_minvlotiss(int sel_type, struct MINVLOTISS_TAG *MINVLOTISS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVLOTISS_N_TAG MINVLOTISS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_MINVLOTISS_CUR_1 INTO
                :MINVLOTISS_N.FACTORY,
                :MINVLOTISS_N.INV_LOT_ID,
                :MINVLOTISS_N.HIST_SEQ,
                :MINVLOTISS_N.TRAN_CODE,
                :MINVLOTISS_N.TRAN_USER_ID,
                :MINVLOTISS_N.TRAN_TIME,
                :MINVLOTISS_N.TRAN_COMMENT,
