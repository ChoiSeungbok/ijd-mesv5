                :MINVLOTISS_N.AREA_ID,
                :MINVLOTISS_N.SUB_AREA_ID,
                :MINVLOTISS_N.OPER,
                :MINVLOTISS_N.ERP_OPER,
                :MINVLOTISS_N.OUT_OPER,
                :MINVLOTISS_N.REASON_CODE,
                :MINVLOTISS_N.TRAN_QTY,
                :MINVLOTISS_N.TRAN_QTY_2,
                :MINVLOTISS_N.TRAN_QTY_3,
                :MINVLOTISS_N.TRAN_UNIT,
                :MINVLOTISS_N.TRAN_UNIT_2,
                :MINVLOTISS_N.TRAN_UNIT_3,
                :MINVLOTISS_N.LOT_ID,
                :MINVLOTISS_N.LOT_HIST_SEQ,
                :MINVLOTISS_N.ORDER_ID,
                :MINVLOTISS_N.HIST_DEL_FLAG,
                :MINVLOTISS_N.CMF_1,
                :MINVLOTISS_N.CMF_2,
                :MINVLOTISS_N.CMF_3,
                :MINVLOTISS_N.CMF_4,
                :MINVLOTISS_N.CMF_5;
            break;

        case 4:
            EXEC SQL FETCH DBU_MINVLOTISS_CUR_4 INTO
                :MINVLOTISS_N.FACTORY,
                :MINVLOTISS_N.INV_LOT_ID,
                :MINVLOTISS_N.HIST_SEQ,
                :MINVLOTISS_N.TRAN_CODE,
                :MINVLOTISS_N.TRAN_USER_ID,
                :MINVLOTISS_N.TRAN_TIME,
                :MINVLOTISS_N.TRAN_COMMENT,
                :MINVLOTISS_N.MAT_ID,
                :MINVLOTISS_N.MAT_VER,
                :MINVLOTISS_N.AREA_ID,
                :MINVLOTISS_N.SUB_AREA_ID,
                :MINVLOTISS_N.OPER,
                :MINVLOTISS_N.ERP_OPER,
                :MINVLOTISS_N.OUT_OPER,
                :MINVLOTISS_N.REASON_CODE,
                :MINVLOTISS_N.TRAN_QTY,
                :MINVLOTISS_N.TRAN_QTY_2,
                :MINVLOTISS_N.TRAN_QTY_3,
                :MINVLOTISS_N.TRAN_UNIT,
                :MINVLOTISS_N.TRAN_UNIT_2,
                :MINVLOTISS_N.TRAN_UNIT_3,
                :MINVLOTISS_N.LOT_ID,
                :MINVLOTISS_N.LOT_HIST_SEQ,
                :MINVLOTISS_N.ORDER_ID,
                :MINVLOTISS_N.HIST_DEL_FLAG,
                :MINVLOTISS_N.CMF_1,
                :MINVLOTISS_N.CMF_2,
                :MINVLOTISS_N.CMF_3,
                :MINVLOTISS_N.CMF_4,
                :MINVLOTISS_N.CMF_5;
            break;

        case 5:
            EXEC SQL FETCH DBU_MINVLOTISS_CUR_5 INTO
                :MINVLOTISS_N.FACTORY,
                :MINVLOTISS_N.INV_LOT_ID,
                :MINVLOTISS_N.HIST_SEQ,
                :MINVLOTISS_N.TRAN_CODE,
                :MINVLOTISS_N.TRAN_USER_ID,
                :MINVLOTISS_N.TRAN_TIME,
                :MINVLOTISS_N.TRAN_COMMENT,
                :MINVLOTISS_N.MAT_ID,
                :MINVLOTISS_N.MAT_VER,
                :MINVLOTISS_N.AREA_ID,
                :MINVLOTISS_N.SUB_AREA_ID,
                :MINVLOTISS_N.OPER,
                :MINVLOTISS_N.ERP_OPER,
                :MINVLOTISS_N.OUT_OPER,
                :MINVLOTISS_N.REASON_CODE,
                :MINVLOTISS_N.TRAN_QTY,
                :MINVLOTISS_N.TRAN_QTY_2,
                :MINVLOTISS_N.TRAN_QTY_3,
                :MINVLOTISS_N.TRAN_UNIT,
                :MINVLOTISS_N.TRAN_UNIT_2,
                :MINVLOTISS_N.TRAN_UNIT_3,
                :MINVLOTISS_N.LOT_ID,
                :MINVLOTISS_N.LOT_HIST_SEQ,
                :MINVLOTISS_N.ORDER_ID,
                :MINVLOTISS_N.HIST_DEL_FLAG,
                :MINVLOTISS_N.CMF_1,
                :MINVLOTISS_N.CMF_2,
                :MINVLOTISS_N.CMF_3,
                :MINVLOTISS_N.CMF_4,
                :MINVLOTISS_N.CMF_5;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_minvlotiss(&MINVLOTISS_N, MINVLOTISS);
    }

    DB_stop_query_timer("DBU_fetch_minvlotiss", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_minvlotiss(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_MINVLOTISS_CUR_1;
            break;

        case 2:
            EXEC SQL CLOSE DBU_MINVLOTISS_CUR_2;
            break;

        case 3:
            EXEC SQL CLOSE DBU_MINVLOTISS_CUR_3;
            break;

        case 4:
            EXEC SQL CLOSE DBU_MINVLOTISS_CUR_4;
            break;

        case 5:
            EXEC SQL CLOSE DBU_MINVLOTISS_CUR_5;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_minvlotiss", sel_type);
}


/* Initialize Function */
void DBU_init_minvlotiss(struct MINVLOTISS_TAG *MINVLOTISS)
{
    /* memset by Space */
    memset(MINVLOTISS, ' ', sizeof(struct MINVLOTISS_TAG));
    
    MINVLOTISS->HIST_SEQ = 0;
    MINVLOTISS->MAT_VER = 0;
    MINVLOTISS->TRAN_QTY = 0;
    MINVLOTISS->TRAN_QTY_2 = 0;
    MINVLOTISS->TRAN_QTY_3 = 0;
    MINVLOTISS->LOT_HIST_SEQ = 0;
}


/* Add Null Function */
void DBU_add_null_minvlotiss(struct MINVLOTISS_N_TAG *MINVLOTISS_N, struct MINVLOTISS_TAG *MINVLOTISS)
{
    /* memset by NULL */
    memset(MINVLOTISS_N, '\0', sizeof(struct MINVLOTISS_N_TAG));
    
    MEMCPY_AN(MINVLOTISS_N->FACTORY, MINVLOTISS->FACTORY, sizeof(MINVLOTISS->FACTORY));
    MEMCPY_AN(MINVLOTISS_N->INV_LOT_ID, MINVLOTISS->INV_LOT_ID, sizeof(MINVLOTISS->INV_LOT_ID));
    MINVLOTISS_N->HIST_SEQ = MINVLOTISS->HIST_SEQ;
    MEMCPY_AN(MINVLOTISS_N->TRAN_CODE, MINVLOTISS->TRAN_CODE, sizeof(MINVLOTISS->TRAN_CODE));
    MEMCPY_AN(MINVLOTISS_N->TRAN_USER_ID, MINVLOTISS->TRAN_USER_ID, sizeof(MINVLOTISS->TRAN_USER_ID));
    MEMCPY_AN(MINVLOTISS_N->TRAN_TIME, MINVLOTISS->TRAN_TIME, sizeof(MINVLOTISS->TRAN_TIME));
    MEMCPY_AN(MINVLOTISS_N->TRAN_COMMENT, MINVLOTISS->TRAN_COMMENT, sizeof(MINVLOTISS->TRAN_COMMENT));
    MEMCPY_AN(MINVLOTISS_N->MAT_ID, MINVLOTISS->MAT_ID, sizeof(MINVLOTISS->MAT_ID));
    MINVLOTISS_N->MAT_VER = MINVLOTISS->MAT_VER;
    MEMCPY_AN(MINVLOTISS_N->AREA_ID, MINVLOTISS->AREA_ID, sizeof(MINVLOTISS->AREA_ID));
    MEMCPY_AN(MINVLOTISS_N->SUB_AREA_ID, MINVLOTISS->SUB_AREA_ID, sizeof(MINVLOTISS->SUB_AREA_ID));
    MEMCPY_AN(MINVLOTISS_N->OPER, MINVLOTISS->OPER, sizeof(MINVLOTISS->OPER));
    MEMCPY_AN(MINVLOTISS_N->ERP_OPER, MINVLOTISS->ERP_OPER, sizeof(MINVLOTISS->ERP_OPER));
    MEMCPY_AN(MINVLOTISS_N->OUT_OPER, MINVLOTISS->OUT_OPER, sizeof(MINVLOTISS->OUT_OPER));
    MEMCPY_AN(MINVLOTISS_N->REASON_CODE, MINVLOTISS->REASON_CODE, sizeof(MINVLOTISS->REASON_CODE));
    MINVLOTISS_N->TRAN_QTY = MINVLOTISS->TRAN_QTY;
    MINVLOTISS_N->TRAN_QTY_2 = MINVLOTISS->TRAN_QTY_2;
    MINVLOTISS_N->TRAN_QTY_3 = MINVLOTISS->TRAN_QTY_3;
    MEMCPY_AN(MINVLOTISS_N->TRAN_UNIT, MINVLOTISS->TRAN_UNIT, sizeof(MINVLOTISS->TRAN_UNIT));
    MEMCPY_AN(MINVLOTISS_N->TRAN_UNIT_2, MINVLOTISS->TRAN_UNIT_2, sizeof(MINVLOTISS->TRAN_UNIT_2));
    MEMCPY_AN(MINVLOTISS_N->TRAN_UNIT_3, MINVLOTISS->TRAN_UNIT_3, sizeof(MINVLOTISS->TRAN_UNIT_3));
    MEMCPY_AN(MINVLOTISS_N->LOT_ID, MINVLOTISS->LOT_ID, sizeof(MINVLOTISS->LOT_ID));
    MINVLOTISS_N->LOT_HIST_SEQ = MINVLOTISS->LOT_HIST_SEQ;
    MEMCPY_AN(MINVLOTISS_N->ORDER_ID, MINVLOTISS->ORDER_ID, sizeof(MINVLOTISS->ORDER_ID));
    MINVLOTISS_N->HIST_DEL_FLAG[0] = MINVLOTISS->HIST_DEL_FLAG;
    MEMCPY_AN(MINVLOTISS_N->CMF_1, MINVLOTISS->CMF_1, sizeof(MINVLOTISS->CMF_1));
    MEMCPY_AN(MINVLOTISS_N->CMF_2, MINVLOTISS->CMF_2, sizeof(MINVLOTISS->CMF_2));
    MEMCPY_AN(MINVLOTISS_N->CMF_3, MINVLOTISS->CMF_3, sizeof(MINVLOTISS->CMF_3));
    MEMCPY_AN(MINVLOTISS_N->CMF_4, MINVLOTISS->CMF_4, sizeof(MINVLOTISS->CMF_4));
    MEMCPY_AN(MINVLOTISS_N->CMF_5, MINVLOTISS->CMF_5, sizeof(MINVLOTISS->CMF_5));
}


/* Del Null Function */
void DBU_del_null_minvlotiss(struct MINVLOTISS_N_TAG *MINVLOTISS_N, struct MINVLOTISS_TAG *MINVLOTISS)
{
    MEMCPY_DN(MINVLOTISS->FACTORY, MINVLOTISS_N->FACTORY, sizeof(MINVLOTISS->FACTORY));
    MEMCPY_DN(MINVLOTISS->INV_LOT_ID, MINVLOTISS_N->INV_LOT_ID, sizeof(MINVLOTISS->INV_LOT_ID));
    MINVLOTISS->HIST_SEQ = MINVLOTISS_N->HIST_SEQ;
    MEMCPY_DN(MINVLOTISS->TRAN_CODE, MINVLOTISS_N->TRAN_CODE, sizeof(MINVLOTISS->TRAN_CODE));
    MEMCPY_DN(MINVLOTISS->TRAN_USER_ID, MINVLOTISS_N->TRAN_USER_ID, sizeof(MINVLOTISS->TRAN_USER_ID));
    MEMCPY_DN(MINVLOTISS->TRAN_TIME, MINVLOTISS_N->TRAN_TIME, sizeof(MINVLOTISS->TRAN_TIME));
    MEMCPY_DN(MINVLOTISS->TRAN_COMMENT, MINVLOTISS_N->TRAN_COMMENT, sizeof(MINVLOTISS->TRAN_COMMENT));
    MEMCPY_DN(MINVLOTISS->MAT_ID, MINVLOTISS_N->MAT_ID, sizeof(MINVLOTISS->MAT_ID));
    MINVLOTISS->MAT_VER = MINVLOTISS_N->MAT_VER;
    MEMCPY_DN(MINVLOTISS->AREA_ID, MINVLOTISS_N->AREA_ID, sizeof(MINVLOTISS->AREA_ID));
    MEMCPY_DN(MINVLOTISS->SUB_AREA_ID, MINVLOTISS_N->SUB_AREA_ID, sizeof(MINVLOTISS->SUB_AREA_ID));
    MEMCPY_DN(MINVLOTISS->OPER, MINVLOTISS_N->OPER, sizeof(MINVLOTISS->OPER));
    MEMCPY_DN(MINVLOTISS->ERP_OPER, MINVLOTISS_N->ERP_OPER, sizeof(MINVLOTISS->ERP_OPER));
    MEMCPY_DN(MINVLOTISS->OUT_OPER, MINVLOTISS_N->OUT_OPER, sizeof(MINVLOTISS->OUT_OPER));
    MEMCPY_DN(MINVLOTISS->REASON_CODE, MINVLOTISS_N->REASON_CODE, sizeof(MINVLOTISS->REASON_CODE));
    MINVLOTISS->TRAN_QTY = MINVLOTISS_N->TRAN_QTY;
    MINVLOTISS->TRAN_QTY_2 = MINVLOTISS_N->TRAN_QTY_2;
    MINVLOTISS->TRAN_QTY_3 = MINVLOTISS_N->TRAN_QTY_3;
    MEMCPY_DN(MINVLOTISS->TRAN_UNIT, MINVLOTISS_N->TRAN_UNIT, sizeof(MINVLOTISS->TRAN_UNIT));
    MEMCPY_DN(MINVLOTISS->TRAN_UNIT_2, MINVLOTISS_N->TRAN_UNIT_2, sizeof(MINVLOTISS->TRAN_UNIT_2));
    MEMCPY_DN(MINVLOTISS->TRAN_UNIT_3, MINVLOTISS_N->TRAN_UNIT_3, sizeof(MINVLOTISS->TRAN_UNIT_3));
    MEMCPY_DN(MINVLOTISS->LOT_ID, MINVLOTISS_N->LOT_ID, sizeof(MINVLOTISS->LOT_ID));
    MINVLOTISS->LOT_HIST_SEQ = MINVLOTISS_N->LOT_HIST_SEQ;
    MEMCPY_DN(MINVLOTISS->ORDER_ID, MINVLOTISS_N->ORDER_ID, sizeof(MINVLOTISS->ORDER_ID));
    MINVLOTISS->HIST_DEL_FLAG = MINVLOTISS_N->HIST_DEL_FLAG[0];
    MEMCPY_DN(MINVLOTISS->CMF_1, MINVLOTISS_N->CMF_1, sizeof(MINVLOTISS->CMF_1));
    MEMCPY_DN(MINVLOTISS->CMF_2, MINVLOTISS_N->CMF_2, sizeof(MINVLOTISS->CMF_2));
    MEMCPY_DN(MINVLOTISS->CMF_3, MINVLOTISS_N->CMF_3, sizeof(MINVLOTISS->CMF_3));
    MEMCPY_DN(MINVLOTISS->CMF_4, MINVLOTISS_N->CMF_4, sizeof(MINVLOTISS->CMF_4));
    MEMCPY_DN(MINVLOTISS->CMF_5, MINVLOTISS_N->CMF_5, sizeof(MINVLOTISS->CMF_5));
}


