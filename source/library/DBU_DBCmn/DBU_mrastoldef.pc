/* SQL CURSOR CLOSE Function */
void DBU_close_mrastoldef(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_MRASTOLDEF_CUR_1;
            break;

        case 2:
            EXEC SQL CLOSE DBU_MRASTOLDEF_CUR_2;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_mrastoldef", sel_type);
}


/* Initialize Function */
void DBU_init_mrastoldef(struct MRASTOLDEF_TAG *MRASTOLDEF)
{
    /* memset by Space */
    memset(MRASTOLDEF, ' ', sizeof(struct MRASTOLDEF_TAG));
    
    MRASTOLDEF->MAT_VER = 0;
    MRASTOLDEF->CELL_COUNT_X = 0;
    MRASTOLDEF->CELL_COUNT_Y = 0;
    MRASTOLDEF->CELL_COUNT_Z = 0;
    MRASTOLDEF->CELL_SIZE_X = 0;
    MRASTOLDEF->CELL_SIZE_Y = 0;
    MRASTOLDEF->CELL_SIZE_Z = 0;
    MRASTOLDEF->LAST_HIST_SEQ = 0;
    MRASTOLDEF->LAST_ACTIVE_HIST_SEQ = 0;
}


/* Add Null Function */
void DBU_add_null_mrastoldef(struct MRASTOLDEF_N_TAG *MRASTOLDEF_N, struct MRASTOLDEF_TAG *MRASTOLDEF)
{
    /* memset by NULL */
    memset(MRASTOLDEF_N, '\0', sizeof(struct MRASTOLDEF_N_TAG));
    
    MEMCPY_AN(MRASTOLDEF_N->FACTORY, MRASTOLDEF->FACTORY, sizeof(MRASTOLDEF->FACTORY));
    MEMCPY_AN(MRASTOLDEF_N->TOOL_ID, MRASTOLDEF->TOOL_ID, sizeof(MRASTOLDEF->TOOL_ID));
    MEMCPY_AN(MRASTOLDEF_N->TOOL_DESC, MRASTOLDEF->TOOL_DESC, sizeof(MRASTOLDEF->TOOL_DESC));
    MEMCPY_AN(MRASTOLDEF_N->TOOL_TYPE, MRASTOLDEF->TOOL_TYPE, sizeof(MRASTOLDEF->TOOL_TYPE));
    MEMCPY_AN(MRASTOLDEF_N->TOOL_GRP, MRASTOLDEF->TOOL_GRP, sizeof(MRASTOLDEF->TOOL_GRP));
    MEMCPY_AN(MRASTOLDEF_N->TOOL_SET_ID, MRASTOLDEF->TOOL_SET_ID, sizeof(MRASTOLDEF->TOOL_SET_ID));
    MEMCPY_AN(MRASTOLDEF_N->TOOL_SET_LOCATION, MRASTOLDEF->TOOL_SET_LOCATION, sizeof(MRASTOLDEF->TOOL_SET_LOCATION));
    MEMCPY_AN(MRASTOLDEF_N->TOOL_STATUS, MRASTOLDEF->TOOL_STATUS, sizeof(MRASTOLDEF->TOOL_STATUS));
