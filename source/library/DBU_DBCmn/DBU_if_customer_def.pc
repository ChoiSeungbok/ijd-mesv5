                :IF_CUSTOMER_DEF_N.ADDRESS,
                :IF_CUSTOMER_DEF_N.LOCATION,
                :IF_CUSTOMER_DEF_N.TAX_REGSTRATION_NUM,
                :IF_CUSTOMER_DEF_N.REPRESENTATIVE,
                :IF_CUSTOMER_DEF_N.BUSINESS_CONDITION,
                :IF_CUSTOMER_DEF_N.TYPE_OF_BUSINESS,
                :IF_CUSTOMER_DEF_N.CUST_ACCT_SITE_ID,
                :IF_CUSTOMER_DEF_N.PARTY_SITE_ID,
                :IF_CUSTOMER_DEF_N.LOCATION_ID,
                :IF_CUSTOMER_DEF_N.PRIMARY_FLAG,
                :IF_CUSTOMER_DEF_N.SITE_USE_CODE,
                :IF_CUSTOMER_DEF_N.STATUS,
                :IF_CUSTOMER_DEF_N.TRAN_FLAG,
                :IF_CUSTOMER_DEF_N.CMF_1,
                :IF_CUSTOMER_DEF_N.CMF_2,
                :IF_CUSTOMER_DEF_N.CMF_3,
                :IF_CUSTOMER_DEF_N.CMF_4,
                :IF_CUSTOMER_DEF_N.CMF_5,
                :IF_CUSTOMER_DEF_N.CMF_6,
                :IF_CUSTOMER_DEF_N.CMF_7,
                :IF_CUSTOMER_DEF_N.CMF_8,
                :IF_CUSTOMER_DEF_N.CMF_9,
                :IF_CUSTOMER_DEF_N.CMF_10,
                :IF_CUSTOMER_DEF_N.CREATE_USER_ID,
                :IF_CUSTOMER_DEF_N.CREATE_TIME,
                :IF_CUSTOMER_DEF_N.UPDATE_USER_ID,
                :IF_CUSTOMER_DEF_N.UPDATE_TIME;
            break;

		case 101:
            EXEC SQL FETCH DBU_IF_CUSTOMER_DEF_CUR_101 INTO
                :IF_CUSTOMER_DEF_N.IF_SEQ,
                :IF_CUSTOMER_DEF_N.IF_TIME,
                :IF_CUSTOMER_DEF_N.IF_CODE,
                :IF_CUSTOMER_DEF_N.IF_MSG,
                :IF_CUSTOMER_DEF_N.FACTORY,
                :IF_CUSTOMER_DEF_N.CUSTOMER_ID,
                :IF_CUSTOMER_DEF_N.SITE_USE_ID,
                :IF_CUSTOMER_DEF_N.CUSTOMER_NAME,
                :IF_CUSTOMER_DEF_N.CUSTOMER_NUMBER,
                :IF_CUSTOMER_DEF_N.PARTY_NUMBER,
                :IF_CUSTOMER_DEF_N.PARTY_SITE_NUMBER,
                :IF_CUSTOMER_DEF_N.ADDRESS,
                :IF_CUSTOMER_DEF_N.LOCATION,
                :IF_CUSTOMER_DEF_N.TAX_REGSTRATION_NUM,
                :IF_CUSTOMER_DEF_N.REPRESENTATIVE,
                :IF_CUSTOMER_DEF_N.BUSINESS_CONDITION,
                :IF_CUSTOMER_DEF_N.TYPE_OF_BUSINESS,
                :IF_CUSTOMER_DEF_N.CUST_ACCT_SITE_ID,
                :IF_CUSTOMER_DEF_N.PARTY_SITE_ID,
                :IF_CUSTOMER_DEF_N.LOCATION_ID,
                :IF_CUSTOMER_DEF_N.PRIMARY_FLAG,
                :IF_CUSTOMER_DEF_N.SITE_USE_CODE,
                :IF_CUSTOMER_DEF_N.STATUS,
                :IF_CUSTOMER_DEF_N.TRAN_FLAG,
                :IF_CUSTOMER_DEF_N.CMF_1,
                :IF_CUSTOMER_DEF_N.CMF_2,
                :IF_CUSTOMER_DEF_N.CMF_3,
                :IF_CUSTOMER_DEF_N.CMF_4,
                :IF_CUSTOMER_DEF_N.CMF_5,
                :IF_CUSTOMER_DEF_N.CMF_6,
                :IF_CUSTOMER_DEF_N.CMF_7,
                :IF_CUSTOMER_DEF_N.CMF_8,
                :IF_CUSTOMER_DEF_N.CMF_9,
                :IF_CUSTOMER_DEF_N.CMF_10,
                :IF_CUSTOMER_DEF_N.CREATE_USER_ID,
                :IF_CUSTOMER_DEF_N.CREATE_TIME,
                :IF_CUSTOMER_DEF_N.UPDATE_USER_ID,
                :IF_CUSTOMER_DEF_N.UPDATE_TIME;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_if_customer_def(&IF_CUSTOMER_DEF_N, IF_CUSTOMER_DEF);
    }

    DB_stop_query_timer("DBU_fetch_if_customer_def", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_if_customer_def(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_IF_CUSTOMER_DEF_CUR_1;
            break;

		case 101:
            EXEC SQL CLOSE DBU_IF_CUSTOMER_DEF_CUR_101;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_if_customer_def", sel_type);
}


/* Initialize Function */
void DBU_init_if_customer_def(struct IF_CUSTOMER_DEF_TAG *IF_CUSTOMER_DEF)
{
    /* memset by Space */
    memset(IF_CUSTOMER_DEF, ' ', sizeof(struct IF_CUSTOMER_DEF_TAG));
    
    IF_CUSTOMER_DEF->IF_SEQ = 0;
    IF_CUSTOMER_DEF->CUSTOMER_ID = 0;
    IF_CUSTOMER_DEF->SITE_USE_ID = 0;
    IF_CUSTOMER_DEF->CUST_ACCT_SITE_ID = 0;
    IF_CUSTOMER_DEF->PARTY_SITE_ID = 0;
    IF_CUSTOMER_DEF->LOCATION_ID = 0;
}


