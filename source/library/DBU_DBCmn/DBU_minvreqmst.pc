/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_minvreqmst(int sel_type, struct MINVREQMST_TAG *MINVREQMST)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVREQMST_N_TAG MINVREQMST_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_minvreqmst(&MINVREQMST_N, MINVREQMST);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_MINVREQMST_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    REQ_NO,
                    REQ_TIME,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
					TO_AREA_ID,
                    TO_SUB_AREA_ID,
                    TO_OPER,
                    REQ_STATUS,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM MINVREQMST
                ORDER BY FACTORY ASC,
                    REQ_NO ASC;
            EXEC SQL OPEN DBU_MINVREQMST_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_minvreqmst", sel_type);
}


