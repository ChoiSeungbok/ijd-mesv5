    MEMCPY_DN(MINVREQMST->CMF_8, MINVREQMST_N->CMF_8, sizeof(MINVREQMST->CMF_8));
    MEMCPY_DN(MINVREQMST->CMF_9, MINVREQMST_N->CMF_9, sizeof(MINVREQMST->CMF_9));
    MEMCPY_DN(MINVREQMST->CMF_10, MINVREQMST_N->CMF_10, sizeof(MINVREQMST->CMF_10));
    MEMCPY_DN(MINVREQMST->CREATE_USER_ID, MINVREQMST_N->CREATE_USER_ID, sizeof(MINVREQMST->CREATE_USER_ID));
    MEMCPY_DN(MINVREQMST->CREATE_TIME, MINVREQMST_N->CREATE_TIME, sizeof(MINVREQMST->CREATE_TIME));
    MEMCPY_DN(MINVREQMST->UPDATE_USER_ID, MINVREQMST_N->UPDATE_USER_ID, sizeof(MINVREQMST->UPDATE_USER_ID));
    MEMCPY_DN(MINVREQMST->UPDATE_TIME, MINVREQMST_N->UPDATE_TIME, sizeof(MINVREQMST->UPDATE_TIME));
}


