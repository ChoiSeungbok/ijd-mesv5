/* SQL SELECT_SCALAR Function */
double DBU_select_mwipoprdef_scalar(int sel_type, struct MWIPOPRDEF_TAG *MWIPOPRDEF)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MWIPOPRDEF_N_TAG MWIPOPRDEF_N;
        double d_value;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_mwipoprdef(&MWIPOPRDEF_N, MWIPOPRDEF);
    DB_error_code = 0;
    d_value = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MWIPOPRDEF
                WHERE FACTORY = :MWIPOPRDEF_N.FACTORY
                    AND OPER = :MWIPOPRDEF_N.OPER;
            break;

        case 2:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM MWIPOPRDEF A, MWIPFLWOPR B
               WHERE A.FACTORY = B.FACTORY
                 AND A.OPER = B.OPER
                 AND A.FACTORY = :MWIPOPRDEF_N.FACTORY
                 AND B.FLOW = :MWIPOPRDEF_N.OPER_CMF_2
                 AND A.OPER_CMF_1 = :MWIPOPRDEF_N.OPER_CMF_1;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_select_mwipoprdef_scalar", sel_type);

    return d_value;
}


