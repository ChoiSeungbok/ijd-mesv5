/* Initialize Function */
void DBU_init_mwipoprdef(struct MWIPOPRDEF_TAG *MWIPOPRDEF)
{
    /* memset by Space */
    memset(MWIPOPRDEF, ' ', sizeof(struct MWIPOPRDEF_TAG));
    
}


