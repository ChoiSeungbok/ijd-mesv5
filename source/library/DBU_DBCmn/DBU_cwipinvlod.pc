    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CWIPINVLOD_CUR_1;
            break;

        case 2:
            EXEC SQL CLOSE DBU_CWIPINVLOD_CUR_2;
            break;

        case 3:
            EXEC SQL CLOSE DBU_CWIPINVLOD_CUR_3;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_cwipinvlod", sel_type);
}


/* Initialize Function */
void DBU_init_cwipinvlod(struct CWIPINVLOD_TAG *CWIPINVLOD)
{
    /* memset by Space */
    memset(CWIPINVLOD, ' ', sizeof(struct CWIPINVLOD_TAG));
    
    CWIPINVLOD->MAT_VER = 0;
}


/* Add Null Function */
void DBU_add_null_cwipinvlod(struct CWIPINVLOD_N_TAG *CWIPINVLOD_N, struct CWIPINVLOD_TAG *CWIPINVLOD)
{
    /* memset by NULL */
    memset(CWIPINVLOD_N, '\0', sizeof(struct CWIPINVLOD_N_TAG));
    
    MEMCPY_AN(CWIPINVLOD_N->FACTORY, CWIPINVLOD->FACTORY, sizeof(CWIPINVLOD->FACTORY));
    MEMCPY_AN(CWIPINVLOD_N->INV_LOT_ID, CWIPINVLOD->INV_LOT_ID, sizeof(CWIPINVLOD->INV_LOT_ID));
