    MEMCPY_AN(CWIPINVLOD_N->CMF_9, CWIPINVLOD->CMF_9, sizeof(CWIPINVLOD->CMF_9));
    MEMCPY_AN(CWIPINVLOD_N->CMF_10, CWIPINVLOD->CMF_10, sizeof(CWIPINVLOD->CMF_10));
    MEMCPY_AN(CWIPINVLOD_N->CREATE_USER_ID, CWIPINVLOD->CREATE_USER_ID, sizeof(CWIPINVLOD->CREATE_USER_ID));
    MEMCPY_AN(CWIPINVLOD_N->CREATE_TIME, CWIPINVLOD->CREATE_TIME, sizeof(CWIPINVLOD->CREATE_TIME));
    MEMCPY_AN(CWIPINVLOD_N->UPDATE_USER_ID, CWIPINVLOD->UPDATE_USER_ID, sizeof(CWIPINVLOD->UPDATE_USER_ID));
    MEMCPY_AN(CWIPINVLOD_N->UPDATE_TIME, CWIPINVLOD->UPDATE_TIME, sizeof(CWIPINVLOD->UPDATE_TIME));
}


