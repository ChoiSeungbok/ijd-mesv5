    MEMCPY_AN(CWIPINVLOD_N->OPER, CWIPINVLOD->OPER, sizeof(CWIPINVLOD->OPER));
    MEMCPY_AN(CWIPINVLOD_N->ORDER_ID, CWIPINVLOD->ORDER_ID, sizeof(CWIPINVLOD->ORDER_ID));
    MEMCPY_AN(CWIPINVLOD_N->RES_ID, CWIPINVLOD->RES_ID, sizeof(CWIPINVLOD->RES_ID));
    MEMCPY_AN(CWIPINVLOD_N->TRAN_TIME, CWIPINVLOD->TRAN_TIME, sizeof(CWIPINVLOD->TRAN_TIME));
    MEMCPY_AN(CWIPINVLOD_N->MAT_ID, CWIPINVLOD->MAT_ID, sizeof(CWIPINVLOD->MAT_ID));
    CWIPINVLOD_N->MAT_VER = CWIPINVLOD->MAT_VER;
    MEMCPY_AN(CWIPINVLOD_N->OUT_OPER, CWIPINVLOD->OUT_OPER, sizeof(CWIPINVLOD->OUT_OPER));
    MEMCPY_AN(CWIPINVLOD_N->LOT_TYPE, CWIPINVLOD->LOT_TYPE, sizeof(CWIPINVLOD->LOT_TYPE));
    MEMCPY_AN(CWIPINVLOD_N->INPUT_TYPE, CWIPINVLOD->INPUT_TYPE, sizeof(CWIPINVLOD->INPUT_TYPE));
    MEMCPY_AN(CWIPINVLOD_N->CMF_1, CWIPINVLOD->CMF_1, sizeof(CWIPINVLOD->CMF_1));
    MEMCPY_AN(CWIPINVLOD_N->CMF_2, CWIPINVLOD->CMF_2, sizeof(CWIPINVLOD->CMF_2));
