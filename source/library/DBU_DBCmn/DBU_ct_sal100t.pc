/* SQL CURSOR FETCH Function */
void DBU_fetch_ct_sal100t(int sel_type, struct CT_SAL100T_TAG *CT_SAL100T)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CT_SAL100T_N_TAG CT_SAL100T_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_CT_SAL100T_CUR_1 INTO
                :CT_SAL100T_N.LOT_ID,
                :CT_SAL100T_N.ORG_CODE,
                :CT_SAL100T_N.WC_CODE,
                :CT_SAL100T_N.CREATE_DATE,
                :CT_SAL100T_N.WO_NUM,
                :CT_SAL100T_N.ITEM_CODE,
                :CT_SAL100T_N.CUST_YN,
                :CT_SAL100T_N.CUST_CODE,
                :CT_SAL100T_N.CUST_SITE_ID,
                :CT_SAL100T_N.LOT_QTY,
                :CT_SAL100T_N.CUST_PO,
                :CT_SAL100T_N.REMAIN_QTY,
                :CT_SAL100T_N.LOT_ADD,
                :CT_SAL100T_N.WH_CODE,
                :CT_SAL100T_N.READ_NUM,
                :CT_SAL100T_N.READ_SEQ,
                :CT_SAL100T_N.STATUS,
                :CT_SAL100T_N.USE_YN,
                :CT_SAL100T_N.WORK_FLAG,
                :CT_SAL100T_N.REMARKS,
                :CT_SAL100T_N.INSERT_DATE,
                :CT_SAL100T_N.INSERT_USER,
                :CT_SAL100T_N.UPDATE_DATE,
                :CT_SAL100T_N.UPDATE_USER,
                :CT_SAL100T_N.SHIPPING_HEADER_ID,
                :CT_SAL100T_N.COATING_RATE,
                :CT_SAL100T_N.ITEM_NAME,
                :CT_SAL100T_N.LABEL_TYPE,
                :CT_SAL100T_N.LABEL_MESH,
                :CT_SAL100T_N.PACK_UOM,
                :CT_SAL100T_N.HEADER_ID,
                :CT_SAL100T_N.LINE_NUMBER,
                :CT_SAL100T_N.TRANS_SEQ,
                :CT_SAL100T_N.END_CUST_ID;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_ct_sal100t(&CT_SAL100T_N, CT_SAL100T);
    }

    DB_stop_query_timer("DBU_fetch_ct_sal100t", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_ct_sal100t(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CT_SAL100T_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_ct_sal100t", sel_type);
}


