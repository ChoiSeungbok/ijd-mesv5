                    F_VALUE_2,
                    TI_VALUE_2,
                    TI_RESULT,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CQCMGRTHLT
                ORDER BY FACTORY ASC,
                    INSP_ID ASC,
                    INSP_DTL_TYPE ASC,
                    INSP_COUNT ASC,
                    INSP_SEQ ASC;
            EXEC SQL OPEN DBU_CQCMGRTHLT_CUR_1;
            break;

		case 2:
            EXEC SQL DECLARE DBU_CQCMGRTHLT_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    INSP_ID,
