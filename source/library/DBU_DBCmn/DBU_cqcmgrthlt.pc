    CQCMGRTHLT_N->TI_VALUE_2 = CQCMGRTHLT->TI_VALUE_2;
    CQCMGRTHLT_N->TI_RESULT = CQCMGRTHLT->TI_RESULT;
    MEMCPY_AN(CQCMGRTHLT_N->CREATE_USER_ID, CQCMGRTHLT->CREATE_USER_ID, sizeof(CQCMGRTHLT->CREATE_USER_ID));
