    MEMCPY_AN(CQCMGRTHLT_N->SIZES_2, CQCMGRTHLT->SIZES_2, sizeof(CQCMGRTHLT->SIZES_2));
    CQCMGRTHLT_N->SIEVE_VALUE_2 = CQCMGRTHLT->SIEVE_VALUE_2;
