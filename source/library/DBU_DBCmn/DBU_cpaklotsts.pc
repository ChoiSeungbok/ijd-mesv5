                :CPAKLOTSTS_N.CMF_2,
                :CPAKLOTSTS_N.CMF_3,
                :CPAKLOTSTS_N.CMF_4,
                :CPAKLOTSTS_N.CMF_5,
                :CPAKLOTSTS_N.CMF_6,
                :CPAKLOTSTS_N.CMF_7,
                :CPAKLOTSTS_N.CMF_8,
                :CPAKLOTSTS_N.CMF_9,
                :CPAKLOTSTS_N.CMF_10,
                :CPAKLOTSTS_N.CREATE_USER_ID,
                :CPAKLOTSTS_N.CREATE_TIME,
                :CPAKLOTSTS_N.UPDATE_USER_ID,
                :CPAKLOTSTS_N.UPDATE_TIME;
            break;

		case 3:
            EXEC SQL FETCH DBU_CPAKLOTSTS_CUR_3 INTO
                :CPAKLOTSTS_N.FACTORY,
