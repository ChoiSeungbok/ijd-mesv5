                :CPAKLOTSTS_N.CMF_5,
                :CPAKLOTSTS_N.CMF_6,
                :CPAKLOTSTS_N.CMF_7,
                :CPAKLOTSTS_N.CMF_8,
                :CPAKLOTSTS_N.CMF_9,
                :CPAKLOTSTS_N.CMF_10,
