/* SQL SELECT_SCALAR Function */
double DBU_select_cpaklotsts_scalar(int sel_type, struct CPAKLOTSTS_TAG *CPAKLOTSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CPAKLOTSTS_N_TAG CPAKLOTSTS_N;
        double d_value;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cpaklotsts(&CPAKLOTSTS_N, CPAKLOTSTS);
    DB_error_code = 0;
    d_value = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND ORG_LOT_ID = :CPAKLOTSTS_N.ORG_LOT_ID
                    AND PACK_LOT_ID = :CPAKLOTSTS_N.PACK_LOT_ID;
            break;

		case 2:
            EXEC SQL SELECT NVL (SUM (QTY), 0) QTY
			    INTO :d_value
				FROM CPAKLOTSTS
				WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND PACK_ORDER_ID = :CPAKLOTSTS_N.PACK_ORDER_ID
					AND PACK_LINE_NO = :CPAKLOTSTS_N.PACK_LINE_NO;
			break;

		case 3:
            EXEC SQL SELECT NVL (SUM (QTY), 0) QTY
                INTO :d_value
                FROM CPAKLOTSTS
				WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND ORG_LOT_ID = :CPAKLOTSTS_N.ORG_LOT_ID
					AND PACK_FLAG <> 'Y'
					AND PACK_ORDER_ID <> ' ';
            break;

		case 4:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND PACK_ORDER_ID = :CPAKLOTSTS_N.PACK_ORDER_ID
					AND PACK_LINE_NO = :CPAKLOTSTS_N.PACK_LINE_NO
					AND BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1
					AND SHIP_FLAG = 'Y';
            break;

		case 5:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND PACK_ORDER_ID = :CPAKLOTSTS_N.PACK_ORDER_ID
					AND PACK_LINE_NO = :CPAKLOTSTS_N.PACK_LINE_NO
					AND BOX_ID_2 = :CPAKLOTSTS_N.BOX_ID_2
					AND BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1
					AND SHIP_FLAG = 'Y';
            break;

		case 6:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND PACK_ORDER_ID = :CPAKLOTSTS_N.PACK_ORDER_ID
					AND PACK_LINE_NO = :CPAKLOTSTS_N.PACK_LINE_NO
					AND SHIP_FLAG <> 'Y';
            break;

		case 8:
            EXEC SQL SELECT COUNT(*) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1;
            break;

		case 9:
            EXEC SQL SELECT COUNT(*) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND BOX_ID_2 = :CPAKLOTSTS_N.BOX_ID_2;
            break;

		case 10:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CPAKLOTSTS PAK, MWIPLOTSTS LOT
                WHERE PAK.FACTORY = :CPAKLOTSTS_N.FACTORY
					AND PAK.FACTORY = LOT.FACTORY
					AND PAK.BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1
					AND PAK.PACK_LOT_ID = LOT.LOT_ID
					AND LOT.HOLD_FLAG = 'Y';
            break;

		case 11:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CPAKLOTSTS PAK, MWIPLOTSTS LOT
                WHERE PAK.FACTORY = :CPAKLOTSTS_N.FACTORY
					AND PAK.FACTORY = LOT.FACTORY
					AND PAK.BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1
					AND PAK.PACK_LOT_ID = LOT.LOT_ID
					AND LOT.LOT_DEL_FLAG = 'Y';
            break;

		case 12:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1
					AND PACK_FLAG <> 'Y';
            break;

		case 13:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1
					AND SHIP_FLAG = 'Y';
            break;

		case 14:
            EXEC SQL SELECT COUNT(*)
				INTO :d_value
			    FROM (SELECT DISTINCT ORD.PACK_ORDER_ID, ORD.LINE_NO
					FROM CPAKLOTSTS PAK, CPAKORDSTS ORD
					WHERE PAK.FACTORY = :CPAKLOTSTS_N.FACTORY
						AND PAK.FACTORY = ORD.FACTORY
						AND PAK.BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1
						AND PAK.PACK_ORDER_ID = ORD.PACK_ORDER_ID
						AND PAK.PACK_LINE_NO = ORD.LINE_NO
						AND ORD.PACK_ORD_STATUS <> 'PACKED');					;
            break;

		case 15:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM (SELECT DISTINCT SHP.SHIP_ORDER_ID, SHP.SEQ
					FROM CPAKLOTSTS PAK, CPAKORDSTS ORD, CSHPORDDTL SHP
					WHERE PAK.FACTORY = ORD.FACTORY
						AND PAK.FACTORY = :CPAKLOTSTS_N.FACTORY
						AND ORD.FACTORY = SHP.FACTORY
						AND PAK.BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1
						AND PAK.PACK_ORDER_ID = ORD.PACK_ORDER_ID
						AND PAK.PACK_LINE_NO = ORD.LINE_NO
						AND PAK.PACK_ORDER_ID = SHP.PACK_ORDER_ID
						AND PAK.PACK_LINE_NO = SHP.PACK_LINE_NO
						AND SHP.SHIP_ORD_STATUS <> 'WAIT');					;
            break;

		case 16:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CPAKLOTSTS PAK, MWIPLOTSTS LOT
                WHERE PAK.FACTORY = :CPAKLOTSTS_N.FACTORY
					AND PAK.FACTORY = LOT.FACTORY
					AND PAK.BOX_ID_2 = :CPAKLOTSTS_N.BOX_ID_2
					AND PAK.PACK_LOT_ID = LOT.LOT_ID
					AND LOT.HOLD_FLAG = 'Y';
            break;

		case 17:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CPAKLOTSTS PAK, MWIPLOTSTS LOT
                WHERE PAK.FACTORY = :CPAKLOTSTS_N.FACTORY
					AND PAK.FACTORY = LOT.FACTORY
					AND PAK.BOX_ID_2 = :CPAKLOTSTS_N.BOX_ID_2
					AND PAK.PACK_LOT_ID = LOT.LOT_ID
					AND LOT.LOT_DEL_FLAG = 'Y';
            break;

		case 18:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND BOX_ID_2 = :CPAKLOTSTS_N.BOX_ID_2
					AND PACK_FLAG <> 'Y';
            break;

		case 19:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND BOX_ID_2 = :CPAKLOTSTS_N.BOX_ID_2
					AND SHIP_FLAG = 'Y';
            break;

		case 20:
            EXEC SQL SELECT COUNT(*)
				INTO :d_value
			    FROM (SELECT DISTINCT ORD.PACK_ORDER_ID, ORD.LINE_NO
					FROM CPAKLOTSTS PAK, CPAKORDSTS ORD
					WHERE PAK.FACTORY = :CPAKLOTSTS_N.FACTORY
						AND PAK.FACTORY = ORD.FACTORY
						AND PAK.BOX_ID_2 = :CPAKLOTSTS_N.BOX_ID_2
						AND PAK.PACK_ORDER_ID = ORD.PACK_ORDER_ID
						AND PAK.PACK_LINE_NO = ORD.LINE_NO
						AND ORD.PACK_ORD_STATUS <> 'PACKED');					;
            break;

		case 21:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM (SELECT DISTINCT SHP.SHIP_ORDER_ID, SHP.SEQ
					FROM CPAKLOTSTS PAK, CPAKORDSTS ORD, CSHPORDDTL SHP
					WHERE PAK.FACTORY = ORD.FACTORY
						AND PAK.FACTORY = :CPAKLOTSTS_N.FACTORY
						AND ORD.FACTORY = SHP.FACTORY
						AND PAK.BOX_ID_2 = :CPAKLOTSTS_N.BOX_ID_2
						AND PAK.PACK_ORDER_ID = ORD.PACK_ORDER_ID
						AND PAK.PACK_LINE_NO = ORD.LINE_NO
						AND PAK.PACK_ORDER_ID = SHP.PACK_ORDER_ID
						AND PAK.PACK_LINE_NO = SHP.PACK_LINE_NO
						AND SHP.SHIP_ORD_STATUS <> 'WAIT');					;
            break;

		case 22:
            EXEC SQL SELECT SUM(QTY) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID
					AND SHIP_ORDER_SEQ = :CPAKLOTSTS_N.SHIP_ORDER_SEQ
					AND SHIP_FLAG <> 'Y';
            break;

		case 23:
            EXEC SQL SELECT SUM(QTY) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID
					AND SHIP_FLAG <> 'Y'
					AND PACK_FLAG = 'Y';
             break;
		case 24:
            EXEC SQL SELECT SUM(QTY) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID
					AND SHIP_ORDER_SEQ = :CPAKLOTSTS_N.SHIP_ORDER_SEQ;
			break;

		case 25:
            EXEC SQL SELECT SUM(QTY) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND ORG_LOT_ID = :CPAKLOTSTS_N.ORG_LOT_ID
                    AND PACK_ORDER_ID <> ' '
					AND PACK_FLAG <> 'Y';
            break;

		case 26:
            EXEC SQL SELECT SUM(QTY) 
                INTO :d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID
					AND SHIP_ORDER_SEQ = :CPAKLOTSTS_N.SHIP_ORDER_SEQ;
            break;

        case 27:
            EXEC SQL SELECT SUM(QTY)
                INTO : d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = : CPAKLOTSTS_N.FACTORY
                AND PACK_ORDER_ID = : CPAKLOTSTS_N.PACK_ORDER_ID
                AND PACK_LINE_NO = : CPAKLOTSTS_N.PACK_LINE_NO
                AND PACK_FLAG = 'Y'
                AND SHIP_FLAG <> 'Y'
                AND SHIP_ORDER_ID <> ' ';
            break;
		case 28:
            EXEC SQL SELECT SUM(QTY)
                INTO : d_value
                FROM CPAKLOTSTS
                WHERE FACTORY = : CPAKLOTSTS_N.FACTORY
                AND PACK_ORDER_ID = :CPAKLOTSTS_N.PACK_ORDER_ID
                AND PACK_LINE_NO = :CPAKLOTSTS_N.PACK_LINE_NO
                AND PACK_FLAG = 'Y'
                AND SHIP_FLAG <> 'Y';
            break;

          case 29:
            EXEC SQL SELECT SUM(QTY)
                INTO :d_value
                FROM CPAKLOTSTS
             WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND ORG_LOT_ID = :CPAKLOTSTS_N.ORG_LOT_ID;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_select_cpaklotsts_scalar", sel_type);

    return d_value;
}


/* SQL DELETE Function */
void DBU_delete_cpaklotsts(int sel_type, struct CPAKLOTSTS_TAG *CPAKLOTSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CPAKLOTSTS_N_TAG CPAKLOTSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cpaklotsts(&CPAKLOTSTS_N, CPAKLOTSTS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DELETE FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND ORG_LOT_ID = :CPAKLOTSTS_N.ORG_LOT_ID
                    AND PACK_LOT_ID = :CPAKLOTSTS_N.PACK_LOT_ID;
            break;

		case 2:
            EXEC SQL DELETE FROM CPAKLOTSTS
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND PACK_ORDER_ID = :CPAKLOTSTS_N.PACK_ORDER_ID
                    AND PACK_LINE_NO = :CPAKLOTSTS_N.PACK_LINE_NO
					AND PACK_FLAG <> 'Y';
            break;
		case 3:
            EXEC SQL DELETE FROM CPAKLOTSTS
                      WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                        AND ORG_LOT_ID = :CPAKLOTSTS_N.ORG_LOT_ID;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_delete_cpaklotsts", sel_type);
}


/* SQL INSERT Function */
void DBU_insert_cpaklotsts(struct CPAKLOTSTS_TAG *CPAKLOTSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CPAKLOTSTS_N_TAG CPAKLOTSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cpaklotsts(&CPAKLOTSTS_N, CPAKLOTSTS);
    DB_error_code = 0;


    EXEC SQL INSERT INTO CPAKLOTSTS( 
                    FACTORY, 
                    ORG_LOT_ID, 
                    PACK_LOT_ID, 
                    MAT_ID, 
                    MAT_VER, 
                    QTY, 
                    UNIT, 
                    PACK_FLAG, 
                    PACK_DATE, 
                    PACK_ORDER_ID, 
                    PACK_LINE_NO, 
                    SHIP_FLAG, 
                    SHIP_DATE, 
                    SHIP_ORDER_ID, 
                    SHIP_ORDER_SEQ, 
					RET_FLAG,
					RETURNED_QTY,
                    BOX_ID_1, 
                    BOX_ID_2, 
                    BOX_ID_3, 
                    CMF_1, 
                    CMF_2, 
                    CMF_3, 
                    CMF_4, 
                    CMF_5, 
                    CMF_6, 
                    CMF_7, 
                    CMF_8, 
                    CMF_9, 
                    CMF_10, 
                    CREATE_USER_ID, 
                    CREATE_TIME, 
                    UPDATE_USER_ID, 
                    UPDATE_TIME
         ) 
        VALUES (
                    :CPAKLOTSTS_N.FACTORY,
                    :CPAKLOTSTS_N.ORG_LOT_ID,
                    :CPAKLOTSTS_N.PACK_LOT_ID,
                    :CPAKLOTSTS_N.MAT_ID,
                    :CPAKLOTSTS_N.MAT_VER,
                    :CPAKLOTSTS_N.QTY,
                    :CPAKLOTSTS_N.UNIT,
                    :CPAKLOTSTS_N.PACK_FLAG,
                    :CPAKLOTSTS_N.PACK_DATE,
                    :CPAKLOTSTS_N.PACK_ORDER_ID,
                    :CPAKLOTSTS_N.PACK_LINE_NO,
                    :CPAKLOTSTS_N.SHIP_FLAG,
                    :CPAKLOTSTS_N.SHIP_DATE,
                    :CPAKLOTSTS_N.SHIP_ORDER_ID,
                    :CPAKLOTSTS_N.SHIP_ORDER_SEQ,
					:CPAKLOTSTS_N.RET_FLAG,
					:CPAKLOTSTS_N.RETURNED_QTY,
                    :CPAKLOTSTS_N.BOX_ID_1,
                    :CPAKLOTSTS_N.BOX_ID_2,
                    :CPAKLOTSTS_N.BOX_ID_3,
                    :CPAKLOTSTS_N.CMF_1,
                    :CPAKLOTSTS_N.CMF_2,
                    :CPAKLOTSTS_N.CMF_3,
                    :CPAKLOTSTS_N.CMF_4,
                    :CPAKLOTSTS_N.CMF_5,
                    :CPAKLOTSTS_N.CMF_6,
                    :CPAKLOTSTS_N.CMF_7,
                    :CPAKLOTSTS_N.CMF_8,
                    :CPAKLOTSTS_N.CMF_9,
                    :CPAKLOTSTS_N.CMF_10,
                    :CPAKLOTSTS_N.CREATE_USER_ID,
                    :CPAKLOTSTS_N.CREATE_TIME,
                    :CPAKLOTSTS_N.UPDATE_USER_ID,
                    :CPAKLOTSTS_N.UPDATE_TIME
         );

    DB_stop_query_timer("DBU_insert_cpaklotsts", 0);
}


/* SQL UPDATE Function */
void DBU_update_cpaklotsts(int sel_type, struct CPAKLOTSTS_TAG *CPAKLOTSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CPAKLOTSTS_N_TAG CPAKLOTSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cpaklotsts(&CPAKLOTSTS_N, CPAKLOTSTS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL UPDATE CPAKLOTSTS SET
                    MAT_ID = :CPAKLOTSTS_N.MAT_ID,
                    MAT_VER = :CPAKLOTSTS_N.MAT_VER,
                    QTY = :CPAKLOTSTS_N.QTY,
                    UNIT = :CPAKLOTSTS_N.UNIT,
                    PACK_FLAG = :CPAKLOTSTS_N.PACK_FLAG,
                    PACK_DATE = :CPAKLOTSTS_N.PACK_DATE,
                    PACK_ORDER_ID = :CPAKLOTSTS_N.PACK_ORDER_ID,
                    PACK_LINE_NO = :CPAKLOTSTS_N.PACK_LINE_NO,
                    SHIP_FLAG = :CPAKLOTSTS_N.SHIP_FLAG,
                    SHIP_DATE = :CPAKLOTSTS_N.SHIP_DATE,
                    SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ = :CPAKLOTSTS_N.SHIP_ORDER_SEQ,
					RET_FLAG = :CPAKLOTSTS_N.RET_FLAG,
					RETURNED_QTY = :CPAKLOTSTS_N.RETURNED_QTY,
                    BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1,
                    BOX_ID_2 = :CPAKLOTSTS_N.BOX_ID_2,
                    BOX_ID_3 = :CPAKLOTSTS_N.BOX_ID_3,
                    CMF_1 = :CPAKLOTSTS_N.CMF_1,
                    CMF_2 = :CPAKLOTSTS_N.CMF_2,
                    CMF_3 = :CPAKLOTSTS_N.CMF_3,
                    CMF_4 = :CPAKLOTSTS_N.CMF_4,
                    CMF_5 = :CPAKLOTSTS_N.CMF_5,
                    CMF_6 = :CPAKLOTSTS_N.CMF_6,
                    CMF_7 = :CPAKLOTSTS_N.CMF_7,
                    CMF_8 = :CPAKLOTSTS_N.CMF_8,
                    CMF_9 = :CPAKLOTSTS_N.CMF_9,
                    CMF_10 = :CPAKLOTSTS_N.CMF_10,
                    CREATE_USER_ID = :CPAKLOTSTS_N.CREATE_USER_ID,
                    CREATE_TIME = :CPAKLOTSTS_N.CREATE_TIME,
                    UPDATE_USER_ID = :CPAKLOTSTS_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CPAKLOTSTS_N.UPDATE_TIME
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND ORG_LOT_ID = :CPAKLOTSTS_N.ORG_LOT_ID
                    AND PACK_LOT_ID = :CPAKLOTSTS_N.PACK_LOT_ID;
            break;

		case 2:
            EXEC SQL UPDATE CPAKLOTSTS SET
                    PACK_FLAG = :CPAKLOTSTS_N.PACK_FLAG,
					PACK_DATE = :CPAKLOTSTS_N.PACK_DATE,
                    UPDATE_USER_ID = :CPAKLOTSTS_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CPAKLOTSTS_N.UPDATE_TIME
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND PACK_ORDER_ID = :CPAKLOTSTS_N.PACK_ORDER_ID
					AND PACK_LINE_NO = :CPAKLOTSTS_N.PACK_LINE_NO;
            break;

		case 3:
            EXEC SQL UPDATE CPAKLOTSTS SET
                    BOX_ID_1 = ' ',
					BOX_ID_2 = ' ',
                    UPDATE_USER_ID = :CPAKLOTSTS_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CPAKLOTSTS_N.UPDATE_TIME
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND PACK_ORDER_ID = :CPAKLOTSTS_N.PACK_ORDER_ID
					AND PACK_LINE_NO = :CPAKLOTSTS_N.PACK_LINE_NO
					AND BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1
					AND SHIP_FLAG <> 'Y';
            break;

		case 4:
            EXEC SQL UPDATE CPAKLOTSTS SET
					BOX_ID_2 = ' ',
                    UPDATE_USER_ID = :CPAKLOTSTS_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CPAKLOTSTS_N.UPDATE_TIME
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND PACK_ORDER_ID = :CPAKLOTSTS_N.PACK_ORDER_ID
					AND PACK_LINE_NO = :CPAKLOTSTS_N.PACK_LINE_NO
					AND BOX_ID_2 = :CPAKLOTSTS_N.BOX_ID_2
					AND BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1
					AND SHIP_FLAG <> 'Y';
            break;

		case 5:
            EXEC SQL UPDATE CPAKLOTSTS SET
					BOX_ID_2 = ' ',
                    UPDATE_USER_ID = :CPAKLOTSTS_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CPAKLOTSTS_N.UPDATE_TIME
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND BOX_ID_2 = :CPAKLOTSTS_N.BOX_ID_2
					AND SHIP_FLAG <> 'Y';
            break;

		case 6:
            EXEC SQL UPDATE CPAKLOTSTS SET
					ORG_LOT_ID = :CPAKLOTSTS_N.ORG_LOT_ID,
                    MAT_ID = :CPAKLOTSTS_N.MAT_ID,
                    MAT_VER = :CPAKLOTSTS_N.MAT_VER,
                    QTY = :CPAKLOTSTS_N.QTY,
                    UNIT = :CPAKLOTSTS_N.UNIT,
                    PACK_FLAG = :CPAKLOTSTS_N.PACK_FLAG,
                    PACK_DATE = :CPAKLOTSTS_N.PACK_DATE,
                    PACK_ORDER_ID = :CPAKLOTSTS_N.PACK_ORDER_ID,
                    PACK_LINE_NO = :CPAKLOTSTS_N.PACK_LINE_NO,
                    SHIP_FLAG = :CPAKLOTSTS_N.SHIP_FLAG,
                    SHIP_DATE = :CPAKLOTSTS_N.SHIP_DATE,
                    SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ = :CPAKLOTSTS_N.SHIP_ORDER_SEQ,
					RET_FLAG = :CPAKLOTSTS_N.RET_FLAG,
					RETURNED_QTY = :CPAKLOTSTS_N.RETURNED_QTY,
                    BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1,
                    BOX_ID_2 = :CPAKLOTSTS_N.BOX_ID_2,
                    BOX_ID_3 = :CPAKLOTSTS_N.BOX_ID_3,
                    CMF_1 = :CPAKLOTSTS_N.CMF_1,
                    CMF_2 = :CPAKLOTSTS_N.CMF_2,
                    CMF_3 = :CPAKLOTSTS_N.CMF_3,
                    CMF_4 = :CPAKLOTSTS_N.CMF_4,
                    CMF_5 = :CPAKLOTSTS_N.CMF_5,
                    CMF_6 = :CPAKLOTSTS_N.CMF_6,
                    CMF_7 = :CPAKLOTSTS_N.CMF_7,
                    CMF_8 = :CPAKLOTSTS_N.CMF_8,
                    CMF_9 = :CPAKLOTSTS_N.CMF_9,
                    CMF_10 = :CPAKLOTSTS_N.CMF_10,
                    CREATE_USER_ID = :CPAKLOTSTS_N.CREATE_USER_ID,
                    CREATE_TIME = :CPAKLOTSTS_N.CREATE_TIME,
                    UPDATE_USER_ID = :CPAKLOTSTS_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CPAKLOTSTS_N.UPDATE_TIME
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND PACK_LOT_ID = :CPAKLOTSTS_N.PACK_LOT_ID;
            break;


            case 7:
                EXEC SQL UPDATE CPAKLOTSTS SET
                    CMF_6 = :CPAKLOTSTS_N.CMF_6
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND PACK_LOT_ID = :CPAKLOTSTS_N.PACK_LOT_ID;
            break;

            case 8:
                EXEC SQL UPDATE CPAKLOTSTS SET
                    QTY = :CPAKLOTSTS_N.QTY
                WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
                    AND PACK_LOT_ID = :CPAKLOTSTS_N.PACK_LOT_ID;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_update_cpaklotsts", sel_type);
}


/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cpaklotsts(int sel_type, struct CPAKLOTSTS_TAG *CPAKLOTSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CPAKLOTSTS_N_TAG CPAKLOTSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cpaklotsts(&CPAKLOTSTS_N, CPAKLOTSTS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CPAKLOTSTS_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    ORG_LOT_ID,
                    PACK_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    PACK_FLAG,
                    PACK_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_FLAG,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
					RET_FLAG,
					RETURNED_QTY,
                    BOX_ID_1,
                    BOX_ID_2,
                    BOX_ID_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CPAKLOTSTS
                ORDER BY FACTORY ASC,
                    ORG_LOT_ID ASC,
                    PACK_LOT_ID ASC;
            EXEC SQL OPEN DBU_CPAKLOTSTS_CUR_1;
            break;

		case 2:
            EXEC SQL DECLARE DBU_CPAKLOTSTS_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    ORG_LOT_ID,
                    PACK_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    PACK_FLAG,
                    PACK_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_FLAG,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
					RET_FLAG,
					RETURNED_QTY,
                    BOX_ID_1,
                    BOX_ID_2,
                    BOX_ID_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CPAKLOTSTS
				WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND PACK_ORDER_ID = :CPAKLOTSTS_N.PACK_ORDER_ID
					AND PACK_LINE_NO = :CPAKLOTSTS_N.PACK_LINE_NO
                ORDER BY FACTORY ASC,
                    ORG_LOT_ID ASC,
                    PACK_LOT_ID ASC;
            EXEC SQL OPEN DBU_CPAKLOTSTS_CUR_2;
            break;

		case 3:
            EXEC SQL DECLARE DBU_CPAKLOTSTS_CUR_3 CURSOR FOR
                SELECT 
                    FACTORY,
                    ORG_LOT_ID,
                    PACK_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    PACK_FLAG,
                    PACK_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_FLAG,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
					RET_FLAG,
					RETURNED_QTY,
                    BOX_ID_1,
                    BOX_ID_2,
                    BOX_ID_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CPAKLOTSTS
				WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND PACK_ORDER_ID = :CPAKLOTSTS_N.PACK_ORDER_ID
					AND PACK_LINE_NO = :CPAKLOTSTS_N.PACK_LINE_NO
					AND BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1
                ORDER BY FACTORY ASC,
                    ORG_LOT_ID ASC,
                    PACK_LOT_ID ASC;
            EXEC SQL OPEN DBU_CPAKLOTSTS_CUR_3;
            break;

		case 4:
            EXEC SQL DECLARE DBU_CPAKLOTSTS_CUR_4 CURSOR FOR
                SELECT 
                    FACTORY,
                    ORG_LOT_ID,
                    PACK_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    PACK_FLAG,
                    PACK_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_FLAG,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
					RET_FLAG,
					RETURNED_QTY,
                    BOX_ID_1,
                    BOX_ID_2,
                    BOX_ID_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CPAKLOTSTS
				WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID
					AND SHIP_FLAG <> 'Y'
                ORDER BY FACTORY ASC,
                    ORG_LOT_ID ASC,
                    PACK_LOT_ID ASC;
            EXEC SQL OPEN DBU_CPAKLOTSTS_CUR_4;
            break;

        case 5:
            EXEC SQL DECLARE DBU_CPAKLOTSTS_CUR_5 CURSOR FOR
                SELECT 
                    A.FACTORY,
                    A.ORG_LOT_ID,
                    A.PACK_LOT_ID,
                    A.MAT_ID,
                    A.MAT_VER,
                    A.QTY,
                    A.UNIT,
                    A.PACK_FLAG,
                    A.PACK_DATE,
                    A.PACK_ORDER_ID,
                    A.PACK_LINE_NO,
                    A.SHIP_FLAG,
                    A.SHIP_DATE,
                    A.SHIP_ORDER_ID,
                    A.SHIP_ORDER_SEQ,
					A.RET_FLAG,
					A.RETURNED_QTY,
                    A.BOX_ID_1,
                    A.BOX_ID_2,
                    A.BOX_ID_3,
                    A.CMF_1,
                    A.CMF_2,
                    A.CMF_3,
                    A.CMF_4,
                    A.CMF_5,
                    A.CMF_6,
                    A.CMF_7,
                    A.CMF_8,
                    A.CMF_9,
                    A.CMF_10,
                    A.CREATE_USER_ID,
                    A.CREATE_TIME,
                    A.UPDATE_USER_ID,
                    A.UPDATE_TIME
                FROM CPAKLOTSTS A, MWIPMATDEF B            
				WHERE A.FACTORY = :CPAKLOTSTS_N.FACTORY
					AND A.SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID
                    AND (:CPAKLOTSTS_N.MAT_ID = ' ' OR A.MAT_ID = :CPAKLOTSTS_N.MAT_ID)
                    AND (:CPAKLOTSTS_N.CMF_5 = ' ' OR A.CMF_5 = :CPAKLOTSTS_N.CMF_5)
					AND A.SHIP_FLAG = :CPAKLOTSTS_N.SHIP_FLAG
					AND A.SHIP_DATE BETWEEN :DBC_Q_COND_N.FROM_TIME  AND :DBC_Q_COND_N.TO_TIME
					AND B.MAT_DESC LIKE '%' || :DBC_Q_COND_N.KEY_1 || '%'
					AND A.FACTORY = B.FACTORY
					AND A.MAT_ID = B.MAT_ID
					AND A.MAT_VER = B.MAT_VER
                ORDER BY A.FACTORY ASC,
                    A.ORG_LOT_ID ASC,
                    A.PACK_LOT_ID ASC;
            EXEC SQL OPEN DBU_CPAKLOTSTS_CUR_5;
            break;

		case 6:
            EXEC SQL DECLARE DBU_CPAKLOTSTS_CUR_6 CURSOR FOR
                SELECT 
                    FACTORY,
                    ORG_LOT_ID,
                    PACK_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    PACK_FLAG,
                    PACK_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_FLAG,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
					RET_FLAG,
					RETURNED_QTY,
                    BOX_ID_1,
                    BOX_ID_2,
                    BOX_ID_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CPAKLOTSTS
				WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND BOX_ID_1 = :CPAKLOTSTS_N.BOX_ID_1
                ORDER BY FACTORY ASC,
                    ORG_LOT_ID ASC,
                    PACK_LOT_ID ASC;
            EXEC SQL OPEN DBU_CPAKLOTSTS_CUR_6;
            break;

		case 7:
            EXEC SQL DECLARE DBU_CPAKLOTSTS_CUR_7 CURSOR FOR
                SELECT 
                    FACTORY,
                    ORG_LOT_ID,
                    PACK_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    PACK_FLAG,
                    PACK_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_FLAG,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
					RET_FLAG,
					RETURNED_QTY,
                    BOX_ID_1,
                    BOX_ID_2,
                    BOX_ID_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CPAKLOTSTS
				WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND BOX_ID_2 = :CPAKLOTSTS_N.BOX_ID_2
                ORDER BY FACTORY ASC,
                    ORG_LOT_ID ASC,
                    PACK_LOT_ID ASC;
            EXEC SQL OPEN DBU_CPAKLOTSTS_CUR_7;
            break;

		case 8:
            EXEC SQL DECLARE DBU_CPAKLOTSTS_CUR_8 CURSOR FOR
                SELECT 
                    FACTORY,
                    ORG_LOT_ID,
                    PACK_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    PACK_FLAG,
                    PACK_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_FLAG,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
					RET_FLAG,
					RETURNED_QTY,
                    BOX_ID_1,
                    BOX_ID_2,
                    BOX_ID_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CPAKLOTSTS
				WHERE PACK_ORDER_ID IN (SELECT
											PACK_ORDER_ID
										FROM CSHPORDDTL
										WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
										 AND SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID)
				AND FACTORY = :CPAKLOTSTS_N.FACTORY
				AND ((SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID) OR (SHIP_ORDER_ID = ' '))
				AND SHIP_FLAG <> 'Y'
                ORDER BY FACTORY ASC,
                    ORG_LOT_ID ASC,
                    PACK_LOT_ID ASC;
            EXEC SQL OPEN DBU_CPAKLOTSTS_CUR_8;
            break;

		case 9:
            EXEC SQL DECLARE DBU_CPAKLOTSTS_CUR_9 CURSOR FOR
                SELECT 
                    FACTORY,
                    ORG_LOT_ID,
                    PACK_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    PACK_FLAG,
                    PACK_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_FLAG,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
					RET_FLAG,
					RETURNED_QTY,
                    BOX_ID_1,
                    BOX_ID_2,
                    BOX_ID_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CPAKLOTSTS
				WHERE (PACK_ORDER_ID, PACK_LINE_NO) IN (SELECT
											PACK_ORDER_ID, PACK_LINE_NO
										FROM CSHPORDDTL
										WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
										 AND SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID
										 AND SEQ = :CPAKLOTSTS_N.SHIP_ORDER_SEQ)
				AND FACTORY = :CPAKLOTSTS_N.FACTORY
				AND ((SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID) OR (SHIP_ORDER_ID = ' '))
				AND ((SHIP_ORDER_SEQ = :CPAKLOTSTS_N.SHIP_ORDER_SEQ) OR (SHIP_ORDER_SEQ = 0))
				AND SHIP_FLAG <> 'Y'
                ORDER BY FACTORY ASC,
                    QTY DESC;
            EXEC SQL OPEN DBU_CPAKLOTSTS_CUR_9;
            break;

		case 10:
            EXEC SQL DECLARE DBU_CPAKLOTSTS_CUR_10 CURSOR FOR
                SELECT 
                    FACTORY,
                    ORG_LOT_ID,
                    PACK_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    PACK_FLAG,
                    PACK_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_FLAG,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
					RET_FLAG,
					RETURNED_QTY,
                    BOX_ID_1,
                    BOX_ID_2,
                    BOX_ID_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CPAKLOTSTS
				WHERE PACK_ORDER_ID IN (SELECT
											PACK_ORDER_ID
										FROM CSHPORDDTL
										WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
										 AND SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID)
				AND FACTORY = :CPAKLOTSTS_N.FACTORY
				AND ((SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID) OR (SHIP_ORDER_ID = ' '))
				AND SHIP_FLAG <> 'Y'
				AND SHIP_ORDER_ID <> ' '
                ORDER BY FACTORY ASC,
                    ORG_LOT_ID ASC,
                    PACK_LOT_ID ASC;
            EXEC SQL OPEN DBU_CPAKLOTSTS_CUR_10;
            break;

		case 11:
            EXEC SQL DECLARE DBU_CPAKLOTSTS_CUR_11 CURSOR FOR
                SELECT 
                    FACTORY,
                    ORG_LOT_ID,
                    PACK_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    PACK_FLAG,
                    PACK_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_FLAG,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
					RET_FLAG,
					RETURNED_QTY,
                    BOX_ID_1,
                    BOX_ID_2,
                    BOX_ID_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CPAKLOTSTS
				WHERE PACK_ORDER_ID IN (SELECT
											PACK_ORDER_ID
										FROM CSHPORDDTL
										WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
										 AND SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID
										 AND SEQ = :CPAKLOTSTS_N.SHIP_ORDER_SEQ)
				AND FACTORY = :CPAKLOTSTS_N.FACTORY
				AND ((SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID) OR (SHIP_ORDER_ID = ' '))
				AND ((SHIP_ORDER_SEQ = :CPAKLOTSTS_N.SHIP_ORDER_SEQ) OR (SHIP_ORDER_SEQ = 0))
				AND SHIP_FLAG <> 'Y'
				AND SHIP_ORDER_ID <> ' '
                ORDER BY FACTORY ASC,
                    ORG_LOT_ID ASC,
                    PACK_LOT_ID ASC;
            EXEC SQL OPEN DBU_CPAKLOTSTS_CUR_11;
            break;

		case 12:
            EXEC SQL DECLARE DBU_CPAKLOTSTS_CUR_12 CURSOR FOR
                SELECT 
                    FACTORY,
                    ORG_LOT_ID,
                    PACK_LOT_ID,
                    MAT_ID,
                    MAT_VER,
                    QTY,
                    UNIT,
                    PACK_FLAG,
                    PACK_DATE,
                    PACK_ORDER_ID,
                    PACK_LINE_NO,
                    SHIP_FLAG,
                    SHIP_DATE,
                    SHIP_ORDER_ID,
                    SHIP_ORDER_SEQ,
					RET_FLAG,
					RETURNED_QTY,
                    BOX_ID_1,
                    BOX_ID_2,
                    BOX_ID_3,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CPAKLOTSTS
				WHERE FACTORY = :CPAKLOTSTS_N.FACTORY
					AND SHIP_ORDER_ID = :CPAKLOTSTS_N.SHIP_ORDER_ID
					AND SHIP_ORDER_SEQ = :CPAKLOTSTS_N.SHIP_ORDER_SEQ
                ORDER BY FACTORY ASC,
                    ORG_LOT_ID ASC,
                    PACK_LOT_ID ASC;
            EXEC SQL OPEN DBU_CPAKLOTSTS_CUR_12;
            break;



        case 13:
            EXEC SQL DECLARE DBU_CPAKLOTSTS_CUR_13 CURSOR FOR
                SELECT 
                    A.FACTORY,
                    A.ORG_LOT_ID,
                    A.PACK_LOT_ID,
                    A.MAT_ID,
                    A.MAT_VER,
                    A.QTY,
                    A.UNIT,
                    A.PACK_FLAG,
                    A.PACK_DATE,
                    A.PACK_ORDER_ID,
                    A.PACK_LINE_NO,
                    A.SHIP_FLAG,
                    A.SHIP_DATE,
                    A.SHIP_ORDER_ID,
                    A.SHIP_ORDER_SEQ,
					A.RET_FLAG,
					A.RETURNED_QTY,
                    A.BOX_ID_1,
                    A.BOX_ID_2,
                    A.BOX_ID_3,
                    SUBSTR(B.LABEL_NAME,1,30)  AS CMF_1,
                    'ORDER ID:' || A.PACK_ORDER_ID || ' LINE: ' || TO_CHAR(A.PACK_LINE_NO) AS  CMF_2,
                    B.DELIVERY_NAME AS CMF_3,
                    TO_CHAR(TO_DATE(A.PACK_DATE, 'YYYYMMDDHH24MISS'), 'YYYY-MM-DD HH24:MI:SS')  AS CMF_4,
                    A.CMF_5,
                    A.CMF_6,
                    A.CMF_7,
                    A.CMF_8,
                    A.CMF_9,
                    A.CMF_10,
                    A.CREATE_USER_ID,
                    A.CREATE_TIME,
                    A.UPDATE_USER_ID,
                    A.UPDATE_TIME
              FROM CPAKLOTSTS  A , CPAKORDSTS B ,CQCMRPTHMM  C
             WHERE  B.PACK_ORDER_ID= A.PACK_ORDER_ID
               AND  B.LINE_NO = A.PACK_LINE_NO
               AND  C.PACK_ORDER_ID(+)  = A.PACK_ORDER_ID
               AND  C.PACK_LOT_ID(+)  = A.PACK_LOT_ID
               AND A.FACTORY = :CPAKLOTSTS_N.FACTORY
               AND A.PACK_ORDER_ID <> ' '
               AND A.SHIP_ORDER_ID = ' ' 
               AND B.AREA_ID ='HM'
               AND C.PACK_LOT_ID is null;
            EXEC SQL OPEN DBU_CPAKLOTSTS_CUR_13;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cpaklotsts", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_cpaklotsts(int sel_type, struct CPAKLOTSTS_TAG *CPAKLOTSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CPAKLOTSTS_N_TAG CPAKLOTSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_CPAKLOTSTS_CUR_1 INTO
                :CPAKLOTSTS_N.FACTORY,
                :CPAKLOTSTS_N.ORG_LOT_ID,
                :CPAKLOTSTS_N.PACK_LOT_ID,
                :CPAKLOTSTS_N.MAT_ID,
                :CPAKLOTSTS_N.MAT_VER,
                :CPAKLOTSTS_N.QTY,
                :CPAKLOTSTS_N.UNIT,
                :CPAKLOTSTS_N.PACK_FLAG,
                :CPAKLOTSTS_N.PACK_DATE,
                :CPAKLOTSTS_N.PACK_ORDER_ID,
                :CPAKLOTSTS_N.PACK_LINE_NO,
                :CPAKLOTSTS_N.SHIP_FLAG,
                :CPAKLOTSTS_N.SHIP_DATE,
                :CPAKLOTSTS_N.SHIP_ORDER_ID,
                :CPAKLOTSTS_N.SHIP_ORDER_SEQ,
				:CPAKLOTSTS_N.RET_FLAG,
