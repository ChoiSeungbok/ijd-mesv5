double DBU_select_cbasfildef_scalar(int sel_type, struct CBASFILDEF_TAG *CBASFILDEF)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CBASFILDEF_N_TAG CBASFILDEF_N;
        double d_value;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cbasfildef(&CBASFILDEF_N, CBASFILDEF);
    DB_error_code = 0;
    d_value = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CBASFILDEF
                WHERE FACTORY = :CBASFILDEF_N.FACTORY
                    AND FILE_NO = :CBASFILDEF_N.FILE_NO;
            break;

		case 2:
            EXEC SQL SELECT count(*) 
                INTO :d_value
                FROM CBASFILDEF
                WHERE FACTORY = :CBASFILDEF_N.FACTORY
                    AND INSP_ID = :CBASFILDEF_N.INSP_ID
					AND LOT_ID =:CBASFILDEF_N.LOT_ID;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_select_cbasfildef_scalar", sel_type);

    return d_value;
}


