void DBU_update_cbasfildef(int sel_type, struct CBASFILDEF_TAG *CBASFILDEF)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CBASFILDEF_N_TAG CBASFILDEF_N;	
	    OCIBlobLocator *blob;
	    unsigned char image[MAXBUFLEN];
	    int amt = 0, iSize = 0;
