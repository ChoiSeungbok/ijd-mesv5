                    CMF_7 = :CBASFILDEF_N.CMF_7,
                    CMF_8 = :CBASFILDEF_N.CMF_8,
                    CMF_9 = :CBASFILDEF_N.CMF_9,
                    CMF_10 = :CBASFILDEF_N.CMF_10,
                    CREATE_USER_ID = :CBASFILDEF_N.CREATE_USER_ID,
                    CREATE_TIME = :CBASFILDEF_N.CREATE_TIME,
                    UPDATE_USER_ID = :CBASFILDEF_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CBASFILDEF_N.UPDATE_TIME
                WHERE FACTORY = :CBASFILDEF_N.FACTORY
                    AND FILE_NO = :CBASFILDEF_N.FILE_NO;
            break;

        case 2:
            EXEC SQL VAR image IS RAW(MAXBUFLEN);

            memset(image, 0x00, sizeof(image));
            memcpy(image, CBASFILDEF_N.IMAGE_DATA, CBASFILDEF_N.IMAGE_SIZE);

            EXEC SQL ALLOCATE :blob;

            EXEC SQL 
                SELECT IMAGE_DATA
                  INTO :blob
                  FROM CBASFILDEF
                 WHERE FACTORY = :CBASFILDEF_N.FACTORY
                   AND FILE_NO = :CBASFILDEF_N.FILE_NO
                   FOR UPDATE;

            amt = CBASFILDEF_N.IMAGE_SIZE;

            EXEC SQL LOB WRITE APPEND :amt FROM :image INTO :blob;

            EXEC SQL 
                UPDATE CBASFILDEF
                   SET IMAGE_DATA = :blob
                 WHERE FACTORY = :CBASFILDEF_N.FACTORY
                   AND FILE_NO = :CBASFILDEF_N.FILE_NO;

            EXEC SQL FREE :blob;

            break;

		case 3:

            EXEC SQL UPDATE CBASFILDEF SET
                    INSP_ID = :CBASFILDEF_N.INSP_ID
                WHERE FACTORY = :CBASFILDEF_N.FACTORY
                    AND FILE_NO = :CBASFILDEF_N.FILE_NO;
            break;

		case 4:

            EXEC SQL UPDATE CBASFILDEF SET
                    INSP_ID = :CBASFILDEF_N.INSP_ID,
					CMF_1 = :CBASFILDEF_N.CMF_1
                WHERE FACTORY = :CBASFILDEF_N.FACTORY
                    AND FILE_NO = :CBASFILDEF_N.FILE_NO;
            break;

        case 5:

            EXEC SQL UPDATE CBASFILDEF SET
                    CMF_1 = :CBASFILDEF_N.CMF_1,
                    CMF_2 = :CBASFILDEF_N.CMF_2,
                    CMF_3 = :CBASFILDEF_N.CMF_3,
                    CMF_4 = :CBASFILDEF_N.CMF_4,
                    CMF_5 = :CBASFILDEF_N.CMF_5,
                    CMF_6 = :CBASFILDEF_N.CMF_6,
                    CMF_7 = :CBASFILDEF_N.CMF_7,
                    CMF_8 = :CBASFILDEF_N.CMF_8,
                    UPDATE_USER_ID = :CBASFILDEF_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CBASFILDEF_N.UPDATE_TIME
                WHERE FACTORY = :CBASFILDEF_N.FACTORY
                    AND FILE_NO = :CBASFILDEF_N.FILE_NO;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_update_cbasfildef", sel_type);
}


/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cbasfildef(int sel_type, struct CBASFILDEF_TAG *CBASFILDEF)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CBASFILDEF_N_TAG CBASFILDEF_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cbasfildef(&CBASFILDEF_N, CBASFILDEF);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CBASFILDEF_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    FILE_NO,
                    FILE_TYPE,
                    FILE_NAME,
                    FILE_PATH,
					TO_FILE_PATH,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    RES_ID,
                    TOOL_ID,
                    MAT_ID,
                    INSP_ID,
                    LOT_ID,
                    LOT_HIST_SEQ,
                    ROUND_FILE_SEQ,
                    ROUND_IMG_TYPE,
                    REAL_COORDINATE_X,
                    REAL_COORDINATE_Y,
                    IMG_COORDINATE_X,
                    IMG_COORDINATE_Y,
                    SCULPTURE_IMG_PATH,
                    CAMERA_TYPE,
                    SIZE_1,
                    SIZE_2,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CBASFILDEF
                ORDER BY FACTORY ASC,
                    FILE_NO ASC;
            EXEC SQL OPEN DBU_CBASFILDEF_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cbasfildef", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_cbasfildef(int sel_type, struct CBASFILDEF_TAG *CBASFILDEF)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CBASFILDEF_N_TAG CBASFILDEF_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_CBASFILDEF_CUR_1 INTO
                :CBASFILDEF_N.FACTORY,
                :CBASFILDEF_N.FILE_NO,
                :CBASFILDEF_N.FILE_TYPE,
                :CBASFILDEF_N.FILE_NAME,
                :CBASFILDEF_N.FILE_PATH,
				:CBASFILDEF_N.TO_FILE_PATH,
                :CBASFILDEF_N.AREA_ID,
                :CBASFILDEF_N.SUB_AREA_ID,
                :CBASFILDEF_N.OPER,
                :CBASFILDEF_N.RES_ID,
                :CBASFILDEF_N.TOOL_ID,
                :CBASFILDEF_N.MAT_ID,
                :CBASFILDEF_N.INSP_ID,
                :CBASFILDEF_N.LOT_ID,
                :CBASFILDEF_N.LOT_HIST_SEQ,
                :CBASFILDEF_N.ROUND_FILE_SEQ,
                :CBASFILDEF_N.ROUND_IMG_TYPE,
                :CBASFILDEF_N.REAL_COORDINATE_X,
                :CBASFILDEF_N.REAL_COORDINATE_Y,
                :CBASFILDEF_N.IMG_COORDINATE_X,
                :CBASFILDEF_N.IMG_COORDINATE_Y,
                :CBASFILDEF_N.SCULPTURE_IMG_PATH,
                :CBASFILDEF_N.CAMERA_TYPE,
                :CBASFILDEF_N.SIZE_1,
                :CBASFILDEF_N.SIZE_2,
                :CBASFILDEF_N.CMF_1,
                :CBASFILDEF_N.CMF_2,
                :CBASFILDEF_N.CMF_3,
                :CBASFILDEF_N.CMF_4,
                :CBASFILDEF_N.CMF_5,
                :CBASFILDEF_N.CMF_6,
                :CBASFILDEF_N.CMF_7,
                :CBASFILDEF_N.CMF_8,
                :CBASFILDEF_N.CMF_9,
                :CBASFILDEF_N.CMF_10,
                :CBASFILDEF_N.CREATE_USER_ID,
                :CBASFILDEF_N.CREATE_TIME,
                :CBASFILDEF_N.UPDATE_USER_ID,
                :CBASFILDEF_N.UPDATE_TIME;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_cbasfildef(&CBASFILDEF_N, CBASFILDEF);
    }

    DB_stop_query_timer("DBU_fetch_cbasfildef", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_cbasfildef(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CBASFILDEF_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_cbasfildef", sel_type);
}


/* Initialize Function */
void DBU_init_cbasfildef(struct CBASFILDEF_TAG *CBASFILDEF)
{
    /* memset by Space */
    memset(CBASFILDEF, ' ', sizeof(struct CBASFILDEF_TAG));
    
    CBASFILDEF->LOT_HIST_SEQ = 0;
    CBASFILDEF->ROUND_FILE_SEQ = 0;
    CBASFILDEF->SIZE_1 = 0;
    CBASFILDEF->SIZE_2 = 0;
}


/* Add Null Function */
void DBU_add_null_cbasfildef(struct CBASFILDEF_N_TAG *CBASFILDEF_N, struct CBASFILDEF_TAG *CBASFILDEF)
{
    /* memset by NULL */
    memset(CBASFILDEF_N, '\0', sizeof(struct CBASFILDEF_N_TAG));
    
    MEMCPY_AN(CBASFILDEF_N->FACTORY, CBASFILDEF->FACTORY, sizeof(CBASFILDEF->FACTORY));
    MEMCPY_AN(CBASFILDEF_N->FILE_NO, CBASFILDEF->FILE_NO, sizeof(CBASFILDEF->FILE_NO));
    MEMCPY_AN(CBASFILDEF_N->FILE_TYPE, CBASFILDEF->FILE_TYPE, sizeof(CBASFILDEF->FILE_TYPE));
    MEMCPY_AN(CBASFILDEF_N->FILE_NAME, CBASFILDEF->FILE_NAME, sizeof(CBASFILDEF->FILE_NAME));
    MEMCPY_AN(CBASFILDEF_N->FILE_PATH, CBASFILDEF->FILE_PATH, sizeof(CBASFILDEF->FILE_PATH));
	MEMCPY_AN(CBASFILDEF_N->TO_FILE_PATH, CBASFILDEF->TO_FILE_PATH, sizeof(CBASFILDEF->TO_FILE_PATH));
    MEMCPY_AN(CBASFILDEF_N->AREA_ID, CBASFILDEF->AREA_ID, sizeof(CBASFILDEF->AREA_ID));
    MEMCPY_AN(CBASFILDEF_N->SUB_AREA_ID, CBASFILDEF->SUB_AREA_ID, sizeof(CBASFILDEF->SUB_AREA_ID));
    MEMCPY_AN(CBASFILDEF_N->OPER, CBASFILDEF->OPER, sizeof(CBASFILDEF->OPER));
    MEMCPY_AN(CBASFILDEF_N->RES_ID, CBASFILDEF->RES_ID, sizeof(CBASFILDEF->RES_ID));
    MEMCPY_AN(CBASFILDEF_N->TOOL_ID, CBASFILDEF->TOOL_ID, sizeof(CBASFILDEF->TOOL_ID));
    MEMCPY_AN(CBASFILDEF_N->MAT_ID, CBASFILDEF->MAT_ID, sizeof(CBASFILDEF->MAT_ID));
    MEMCPY_AN(CBASFILDEF_N->INSP_ID, CBASFILDEF->INSP_ID, sizeof(CBASFILDEF->INSP_ID));
    MEMCPY_AN(CBASFILDEF_N->LOT_ID, CBASFILDEF->LOT_ID, sizeof(CBASFILDEF->LOT_ID));
    CBASFILDEF_N->LOT_HIST_SEQ = CBASFILDEF->LOT_HIST_SEQ;
    CBASFILDEF_N->ROUND_FILE_SEQ = CBASFILDEF->ROUND_FILE_SEQ;
    MEMCPY_AN(CBASFILDEF_N->ROUND_IMG_TYPE, CBASFILDEF->ROUND_IMG_TYPE, sizeof(CBASFILDEF->ROUND_IMG_TYPE));
    MEMCPY_AN(CBASFILDEF_N->REAL_COORDINATE_X, CBASFILDEF->REAL_COORDINATE_X, sizeof(CBASFILDEF->REAL_COORDINATE_X));
    MEMCPY_AN(CBASFILDEF_N->REAL_COORDINATE_Y, CBASFILDEF->REAL_COORDINATE_Y, sizeof(CBASFILDEF->REAL_COORDINATE_Y));
    MEMCPY_AN(CBASFILDEF_N->IMG_COORDINATE_X, CBASFILDEF->IMG_COORDINATE_X, sizeof(CBASFILDEF->IMG_COORDINATE_X));
    MEMCPY_AN(CBASFILDEF_N->IMG_COORDINATE_Y, CBASFILDEF->IMG_COORDINATE_Y, sizeof(CBASFILDEF->IMG_COORDINATE_Y));
    MEMCPY_AN(CBASFILDEF_N->SCULPTURE_IMG_PATH, CBASFILDEF->SCULPTURE_IMG_PATH, sizeof(CBASFILDEF->SCULPTURE_IMG_PATH));
    MEMCPY_AN(CBASFILDEF_N->CAMERA_TYPE, CBASFILDEF->CAMERA_TYPE, sizeof(CBASFILDEF->CAMERA_TYPE));
    CBASFILDEF_N->SIZE_1 = CBASFILDEF->SIZE_1;
    CBASFILDEF_N->SIZE_2 = CBASFILDEF->SIZE_2;
    MEMCPY_AN(CBASFILDEF_N->IMAGE_DATA, CBASFILDEF->IMAGE_DATA, sizeof(CBASFILDEF->IMAGE_DATA));
    CBASFILDEF_N->IMAGE_SIZE = CBASFILDEF->IMAGE_SIZE;
    MEMCPY_AN(CBASFILDEF_N->CMF_1, CBASFILDEF->CMF_1, sizeof(CBASFILDEF->CMF_1));
    MEMCPY_AN(CBASFILDEF_N->CMF_2, CBASFILDEF->CMF_2, sizeof(CBASFILDEF->CMF_2));
    MEMCPY_AN(CBASFILDEF_N->CMF_3, CBASFILDEF->CMF_3, sizeof(CBASFILDEF->CMF_3));
    MEMCPY_AN(CBASFILDEF_N->CMF_4, CBASFILDEF->CMF_4, sizeof(CBASFILDEF->CMF_4));
    MEMCPY_AN(CBASFILDEF_N->CMF_5, CBASFILDEF->CMF_5, sizeof(CBASFILDEF->CMF_5));
    MEMCPY_AN(CBASFILDEF_N->CMF_6, CBASFILDEF->CMF_6, sizeof(CBASFILDEF->CMF_6));
    MEMCPY_AN(CBASFILDEF_N->CMF_7, CBASFILDEF->CMF_7, sizeof(CBASFILDEF->CMF_7));
    MEMCPY_AN(CBASFILDEF_N->CMF_8, CBASFILDEF->CMF_8, sizeof(CBASFILDEF->CMF_8));
    MEMCPY_AN(CBASFILDEF_N->CMF_9, CBASFILDEF->CMF_9, sizeof(CBASFILDEF->CMF_9));
    MEMCPY_AN(CBASFILDEF_N->CMF_10, CBASFILDEF->CMF_10, sizeof(CBASFILDEF->CMF_10));
    MEMCPY_AN(CBASFILDEF_N->CREATE_USER_ID, CBASFILDEF->CREATE_USER_ID, sizeof(CBASFILDEF->CREATE_USER_ID));
    MEMCPY_AN(CBASFILDEF_N->CREATE_TIME, CBASFILDEF->CREATE_TIME, sizeof(CBASFILDEF->CREATE_TIME));
    MEMCPY_AN(CBASFILDEF_N->UPDATE_USER_ID, CBASFILDEF->UPDATE_USER_ID, sizeof(CBASFILDEF->UPDATE_USER_ID));
    MEMCPY_AN(CBASFILDEF_N->UPDATE_TIME, CBASFILDEF->UPDATE_TIME, sizeof(CBASFILDEF->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_cbasfildef(struct CBASFILDEF_N_TAG *CBASFILDEF_N, struct CBASFILDEF_TAG *CBASFILDEF)
{
    MEMCPY_DN(CBASFILDEF->FACTORY, CBASFILDEF_N->FACTORY, sizeof(CBASFILDEF->FACTORY));
    MEMCPY_DN(CBASFILDEF->FILE_NO, CBASFILDEF_N->FILE_NO, sizeof(CBASFILDEF->FILE_NO));
    MEMCPY_DN(CBASFILDEF->FILE_TYPE, CBASFILDEF_N->FILE_TYPE, sizeof(CBASFILDEF->FILE_TYPE));
    MEMCPY_DN(CBASFILDEF->FILE_NAME, CBASFILDEF_N->FILE_NAME, sizeof(CBASFILDEF->FILE_NAME));
    MEMCPY_DN(CBASFILDEF->FILE_PATH, CBASFILDEF_N->FILE_PATH, sizeof(CBASFILDEF->FILE_PATH));
	MEMCPY_DN(CBASFILDEF->TO_FILE_PATH, CBASFILDEF_N->TO_FILE_PATH, sizeof(CBASFILDEF->TO_FILE_PATH));
    MEMCPY_DN(CBASFILDEF->AREA_ID, CBASFILDEF_N->AREA_ID, sizeof(CBASFILDEF->AREA_ID));
    MEMCPY_DN(CBASFILDEF->SUB_AREA_ID, CBASFILDEF_N->SUB_AREA_ID, sizeof(CBASFILDEF->SUB_AREA_ID));
    MEMCPY_DN(CBASFILDEF->OPER, CBASFILDEF_N->OPER, sizeof(CBASFILDEF->OPER));
    MEMCPY_DN(CBASFILDEF->RES_ID, CBASFILDEF_N->RES_ID, sizeof(CBASFILDEF->RES_ID));
