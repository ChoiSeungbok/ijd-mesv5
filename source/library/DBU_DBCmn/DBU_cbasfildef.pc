    MEMCPY_DN(CBASFILDEF->MAT_ID, CBASFILDEF_N->MAT_ID, sizeof(CBASFILDEF->MAT_ID));
    MEMCPY_DN(CBASFILDEF->INSP_ID, CBASFILDEF_N->INSP_ID, sizeof(CBASFILDEF->INSP_ID));
    MEMCPY_DN(CBASFILDEF->LOT_ID, CBASFILDEF_N->LOT_ID, sizeof(CBASFILDEF->LOT_ID));
    CBASFILDEF->LOT_HIST_SEQ = CBASFILDEF_N->LOT_HIST_SEQ;
    CBASFILDEF->ROUND_FILE_SEQ = CBASFILDEF_N->ROUND_FILE_SEQ;
    MEMCPY_DN(CBASFILDEF->ROUND_IMG_TYPE, CBASFILDEF_N->ROUND_IMG_TYPE, sizeof(CBASFILDEF->ROUND_IMG_TYPE));
    MEMCPY_DN(CBASFILDEF->REAL_COORDINATE_X, CBASFILDEF_N->REAL_COORDINATE_X, sizeof(CBASFILDEF->REAL_COORDINATE_X));
    MEMCPY_DN(CBASFILDEF->REAL_COORDINATE_Y, CBASFILDEF_N->REAL_COORDINATE_Y, sizeof(CBASFILDEF->REAL_COORDINATE_Y));
    MEMCPY_DN(CBASFILDEF->IMG_COORDINATE_X, CBASFILDEF_N->IMG_COORDINATE_X, sizeof(CBASFILDEF->IMG_COORDINATE_X));
    MEMCPY_DN(CBASFILDEF->IMG_COORDINATE_Y, CBASFILDEF_N->IMG_COORDINATE_Y, sizeof(CBASFILDEF->IMG_COORDINATE_Y));
    MEMCPY_DN(CBASFILDEF->SCULPTURE_IMG_PATH, CBASFILDEF_N->SCULPTURE_IMG_PATH, sizeof(CBASFILDEF->SCULPTURE_IMG_PATH));
    MEMCPY_DN(CBASFILDEF->CAMERA_TYPE, CBASFILDEF_N->CAMERA_TYPE, sizeof(CBASFILDEF->CAMERA_TYPE));
    CBASFILDEF->SIZE_1 = CBASFILDEF_N->SIZE_1;
    CBASFILDEF->SIZE_2 = CBASFILDEF_N->SIZE_2;
    MEMCPY_DN(CBASFILDEF->IMAGE_DATA, CBASFILDEF_N->IMAGE_DATA, sizeof(CBASFILDEF->IMAGE_DATA));
    CBASFILDEF->IMAGE_SIZE = CBASFILDEF_N->IMAGE_SIZE;
    MEMCPY_DN(CBASFILDEF->CMF_1, CBASFILDEF_N->CMF_1, sizeof(CBASFILDEF->CMF_1));
    MEMCPY_DN(CBASFILDEF->CMF_2, CBASFILDEF_N->CMF_2, sizeof(CBASFILDEF->CMF_2));
    MEMCPY_DN(CBASFILDEF->CMF_3, CBASFILDEF_N->CMF_3, sizeof(CBASFILDEF->CMF_3));
    MEMCPY_DN(CBASFILDEF->CMF_4, CBASFILDEF_N->CMF_4, sizeof(CBASFILDEF->CMF_4));
    MEMCPY_DN(CBASFILDEF->CMF_5, CBASFILDEF_N->CMF_5, sizeof(CBASFILDEF->CMF_5));
    MEMCPY_DN(CBASFILDEF->CMF_6, CBASFILDEF_N->CMF_6, sizeof(CBASFILDEF->CMF_6));
    MEMCPY_DN(CBASFILDEF->CMF_7, CBASFILDEF_N->CMF_7, sizeof(CBASFILDEF->CMF_7));
    MEMCPY_DN(CBASFILDEF->CMF_8, CBASFILDEF_N->CMF_8, sizeof(CBASFILDEF->CMF_8));
    MEMCPY_DN(CBASFILDEF->CMF_9, CBASFILDEF_N->CMF_9, sizeof(CBASFILDEF->CMF_9));
    MEMCPY_DN(CBASFILDEF->CMF_10, CBASFILDEF_N->CMF_10, sizeof(CBASFILDEF->CMF_10));
    MEMCPY_DN(CBASFILDEF->CREATE_USER_ID, CBASFILDEF_N->CREATE_USER_ID, sizeof(CBASFILDEF->CREATE_USER_ID));
    MEMCPY_DN(CBASFILDEF->CREATE_TIME, CBASFILDEF_N->CREATE_TIME, sizeof(CBASFILDEF->CREATE_TIME));
    MEMCPY_DN(CBASFILDEF->UPDATE_USER_ID, CBASFILDEF_N->UPDATE_USER_ID, sizeof(CBASFILDEF->UPDATE_USER_ID));
    MEMCPY_DN(CBASFILDEF->UPDATE_TIME, CBASFILDEF_N->UPDATE_TIME, sizeof(CBASFILDEF->UPDATE_TIME));
}


