/* SQL INSERT Function */
void DBU_insert_cbasfildef(struct CBASFILDEF_TAG *CBASFILDEF)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CBASFILDEF_N_TAG CBASFILDEF_N;
        blob_data *buffer;
    EXEC SQL END DECLARE SECTION;

        
    int iSize;   

    DB_start_query_timer();

    DBU_add_null_cbasfildef(&CBASFILDEF_N, CBASFILDEF);
    DB_error_code = 0;

    iSize = CBASFILDEF_N.IMAGE_SIZE > sizeof(CBASFILDEF_N.IMAGE_DATA) - 1 ? sizeof(CBASFILDEF_N.IMAGE_DATA) - 1 : CBASFILDEF_N.IMAGE_SIZE;

	buffer = (blob_data *)malloc(sizeof(buffer->len)+iSize);
	memcpy((char *)buffer->arr, CBASFILDEF_N.IMAGE_DATA, iSize);
	buffer->len = iSize;

    EXEC SQL INSERT INTO CBASFILDEF( 
                    FACTORY, 
                    FILE_NO, 
                    FILE_TYPE, 
                    FILE_NAME, 
                    FILE_PATH, 
					TO_FILE_PATH,
                    AREA_ID, 
                    SUB_AREA_ID, 
                    OPER, 
                    RES_ID, 
                    TOOL_ID, 
                    MAT_ID, 
                    INSP_ID, 
                    LOT_ID, 
                    LOT_HIST_SEQ, 
                    ROUND_FILE_SEQ, 
                    ROUND_IMG_TYPE, 
                    REAL_COORDINATE_X, 
                    REAL_COORDINATE_Y, 
                    IMG_COORDINATE_X, 
                    IMG_COORDINATE_Y, 
                    SCULPTURE_IMG_PATH, 
                    CAMERA_TYPE, 
                    SIZE_1, 
                    SIZE_2,
                    IMAGE_DATA,
                    IMAGE_SIZE,
                    CMF_1, 
                    CMF_2, 
                    CMF_3, 
                    CMF_4, 
                    CMF_5, 
                    CMF_6, 
                    CMF_7, 
                    CMF_8, 
                    CMF_9, 
                    CMF_10, 
                    CREATE_USER_ID, 
                    CREATE_TIME, 
                    UPDATE_USER_ID, 
                    UPDATE_TIME
         ) 
        VALUES (
                    :CBASFILDEF_N.FACTORY,
                    :CBASFILDEF_N.FILE_NO,
                    :CBASFILDEF_N.FILE_TYPE,
                    :CBASFILDEF_N.FILE_NAME,
                    :CBASFILDEF_N.FILE_PATH,
					:CBASFILDEF_N.TO_FILE_PATH,
                    :CBASFILDEF_N.AREA_ID,
                    :CBASFILDEF_N.SUB_AREA_ID,
                    :CBASFILDEF_N.OPER,
                    :CBASFILDEF_N.RES_ID,
                    :CBASFILDEF_N.TOOL_ID,
                    :CBASFILDEF_N.MAT_ID,
                    :CBASFILDEF_N.INSP_ID,
                    :CBASFILDEF_N.LOT_ID,
                    :CBASFILDEF_N.LOT_HIST_SEQ,
                    :CBASFILDEF_N.ROUND_FILE_SEQ,
                    :CBASFILDEF_N.ROUND_IMG_TYPE,
                    :CBASFILDEF_N.REAL_COORDINATE_X,
                    :CBASFILDEF_N.REAL_COORDINATE_Y,
                    :CBASFILDEF_N.IMG_COORDINATE_X,
                    :CBASFILDEF_N.IMG_COORDINATE_Y,
                    :CBASFILDEF_N.SCULPTURE_IMG_PATH,
                    :CBASFILDEF_N.CAMERA_TYPE,
                    :CBASFILDEF_N.SIZE_1,
                    :CBASFILDEF_N.SIZE_2,
                    :buffer,
                    :CBASFILDEF_N.IMAGE_SIZE,
                    :CBASFILDEF_N.CMF_1,
                    :CBASFILDEF_N.CMF_2,
                    :CBASFILDEF_N.CMF_3,
                    :CBASFILDEF_N.CMF_4,
                    :CBASFILDEF_N.CMF_5,
                    :CBASFILDEF_N.CMF_6,
                    :CBASFILDEF_N.CMF_7,
                    :CBASFILDEF_N.CMF_8,
                    :CBASFILDEF_N.CMF_9,
                    :CBASFILDEF_N.CMF_10,
                    :CBASFILDEF_N.CREATE_USER_ID,
                    :CBASFILDEF_N.CREATE_TIME,
                    :CBASFILDEF_N.UPDATE_USER_ID,
                    :CBASFILDEF_N.UPDATE_TIME
         );

    free(buffer);

    DB_stop_query_timer("DBU_insert_cbasfildef", 0);
}


