    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CBASCHKDEF_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    MAT_ID,
                    SEQ,
                    CHK_COMMENT,
                    CHK_UNIT,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CBASCHKDEF
                ORDER BY FACTORY ASC,
                    AREA_ID ASC,
                    SUB_AREA_ID ASC,
                    OPER ASC,
                    MAT_ID ASC,
                    SEQ ASC;
            EXEC SQL OPEN DBU_CBASCHKDEF_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
