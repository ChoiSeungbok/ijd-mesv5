    MEMCPY_AN(CQCMRPTGMP_N->SUB_CODE, CQCMRPTGMP->SUB_CODE, sizeof(CQCMRPTGMP->SUB_CODE));
    MEMCPY_AN(CQCMRPTGMP_N->CODE_NAME, CQCMRPTGMP->CODE_NAME, sizeof(CQCMRPTGMP->CODE_NAME));
