/* Del Null Function */
void DBU_del_null_cqcmrptgmp(struct CQCMRPTGMP_N_TAG *CQCMRPTGMP_N, struct CQCMRPTGMP_TAG *CQCMRPTGMP)
{
    MEMCPY_DN(CQCMRPTGMP->FACTORY, CQCMRPTGMP_N->FACTORY, sizeof(CQCMRPTGMP->FACTORY));
