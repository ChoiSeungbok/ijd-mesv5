                    ITEM_DESC = :IF_WO_INFO_N.ITEM_DESC,
                    ITEM_UNIT = :IF_WO_INFO_N.ITEM_UNIT,
                    ITEM_TYPE = :IF_WO_INFO_N.ITEM_TYPE,
                    ALTERNATE_BOM_DESIGNATOR = :IF_WO_INFO_N.ALTERNATE_BOM_DESIGNATOR,
