/* Initialize Function */
void DBU_init_if_wo_info(struct IF_WO_INFO_TAG *IF_WO_INFO)
{
    /* memset by Space */
    memset(IF_WO_INFO, ' ', sizeof(struct IF_WO_INFO_TAG));
    
    IF_WO_INFO->IF_SEQ = 0;
    IF_WO_INFO->ORG_ID = 0;
    IF_WO_INFO->WIP_ENTITY_ID = 0;
    IF_WO_INFO->ITEM_ID = 0;
    IF_WO_INFO->OPER_SEQ_NUM = 0;
    IF_WO_INFO->STANDARD_OPER_ID = 0;
    IF_WO_INFO->DEPT_ID = 0;
    IF_WO_INFO->STATUS_TYPE = 0;
    IF_WO_INFO->JOB_TYPE = 0;
    IF_WO_INFO->PLAN_QTY = 0;
    IF_WO_INFO->QTY_IN_QUEUE = 0;
    IF_WO_INFO->QTY_WAITING_TO_MOVE = 0;
    IF_WO_INFO->QTY_SCRAPPED = 0;
    IF_WO_INFO->QTY_COMPLETED = 0;
    IF_WO_INFO->PRE_OPER_SEQ = 0;
    IF_WO_INFO->NEXT_OPER_SEQ = 0;
    IF_WO_INFO->IF_GROUP_ID = 0;
}


/* Add Null Function */
void DBU_add_null_if_wo_info(struct IF_WO_INFO_N_TAG *IF_WO_INFO_N, struct IF_WO_INFO_TAG *IF_WO_INFO)
{
    /* memset by NULL */
    memset(IF_WO_INFO_N, '\0', sizeof(struct IF_WO_INFO_N_TAG));
    
    IF_WO_INFO_N->IF_SEQ = IF_WO_INFO->IF_SEQ;
