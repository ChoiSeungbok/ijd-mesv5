                    QTY_SCRAPPED = :IF_WO_INFO_N.QTY_SCRAPPED,
                    QTY_COMPLETED = :IF_WO_INFO_N.QTY_COMPLETED,
                    CUT_MULTI = :IF_WO_INFO_N.CUT_MULTI,
                    PRE_OPER_SEQ = :IF_WO_INFO_N.PRE_OPER_SEQ,
                    PRE_OPER = :IF_WO_INFO_N.PRE_OPER,
