                    STATUS_TYPE_NAME = :IF_WO_INFO_N.STATUS_TYPE_NAME,
                    JOB_TYPE = :IF_WO_INFO_N.JOB_TYPE,
                    JOB_TYPE_NAME = :IF_WO_INFO_N.JOB_TYPE_NAME,
                    PLAN_START_DATE = :IF_WO_INFO_N.PLAN_START_DATE,
                    PLAN_END_DATE = :IF_WO_INFO_N.PLAN_END_DATE,
                    RELEASED_DATE = :IF_WO_INFO_N.RELEASED_DATE,
                    COMP_DATE = :IF_WO_INFO_N.COMP_DATE,
