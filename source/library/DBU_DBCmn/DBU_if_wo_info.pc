                    SO_NUM = :IF_WO_INFO_N.SO_NUM,
                    LAST_COMP_DATE = :IF_WO_INFO_N.LAST_COMP_DATE,
                    TRAN_FLAG = :IF_WO_INFO_N.TRAN_FLAG,
                    IF_GROUP_ID = :IF_WO_INFO_N.IF_GROUP_ID,
                    CMF_1 = :IF_WO_INFO_N.CMF_1,
