                    UPDATE_TIME = :IF_WO_INFO_N.UPDATE_TIME
                WHERE IF_SEQ = :IF_WO_INFO_N.IF_SEQ;
            break;

		case 101:
            EXEC SQL UPDATE IF_WO_INFO SET
                    IF_CODE = :IF_WO_INFO_N.IF_CODE,
                    IF_MSG = :IF_WO_INFO_N.IF_MSG
                WHERE IF_SEQ = :IF_WO_INFO_N.IF_SEQ;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_update_if_wo_info", sel_type);
}


/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_if_wo_info(int sel_type, struct IF_WO_INFO_TAG *IF_WO_INFO)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct IF_WO_INFO_N_TAG IF_WO_INFO_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_if_wo_info(&IF_WO_INFO_N, IF_WO_INFO);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_IF_WO_INFO_CUR_1 CURSOR FOR
                SELECT 
                    IF_SEQ,
                    IF_TIME,
                    IF_CODE,
                    IF_MSG,
                    FACTORY,
                    ORG_ID,
                    ORG_CODE,
                    WIP_ENTITY_ID,
                    WIP_ENTITY_NAME,
                    ITEM_ID,
                    ITEM_CODE,
                    ITEM_DESC,
                    ITEM_UNIT,
                    ITEM_TYPE,
                    ALTERNATE_BOM_DESIGNATOR,
                    ALTER_RTG_NAME,
                    COMPLETION_INV_OPER,
                    OPER_SEQ_NUM,
                    STANDARD_OPER_ID,
                    OPER,
                    OPER_DESC,
                    DEPT_ID,
                    DEPT_CODE,
                    DEPT_DESC,
                    STATUS_TYPE,
                    STATUS_TYPE_NAME,
                    JOB_TYPE,
                    JOB_TYPE_NAME,
                    PLAN_START_DATE,
                    PLAN_END_DATE,
                    RELEASED_DATE,
                    COMP_DATE,
                    CLOSED_DATE,
                    PLAN_QTY,
                    QTY_IN_QUEUE,
                    QTY_WAITING_TO_MOVE,
                    QTY_SCRAPPED,
                    QTY_COMPLETED,
                    CUT_MULTI,
                    PRE_OPER_SEQ,
                    PRE_OPER,
                    NEXT_OPER_SEQ,
                    NEXT_OPER,
                    FIRST_OPER_YN,
                    LAST_OPER_YN,
                    SRS_YN,
                    PUP_GBN,
                    CUTTING,
                    CUST_NAME,
                    VENDORS,
                    REMARKS,
                    SO_NUM,
                    LAST_COMP_DATE,
                    TRAN_FLAG,
                    IF_GROUP_ID,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM IF_WO_INFO
                ORDER BY IF_SEQ ASC;
            EXEC SQL OPEN DBU_IF_WO_INFO_CUR_1;
            break;

		case 101:
            EXEC SQL DECLARE DBU_IF_WO_INFO_CUR_101 CURSOR FOR
			    SELECT * FROM (
					SELECT 
						IF_SEQ,
						IF_TIME,
						IF_CODE,
						IF_MSG,
						FACTORY,
						ORG_ID,
						ORG_CODE,
						WIP_ENTITY_ID,
						WIP_ENTITY_NAME,
						ITEM_ID,
						ITEM_CODE,
						ITEM_DESC,
						ITEM_UNIT,
						ITEM_TYPE,
						ALTERNATE_BOM_DESIGNATOR,
						ALTER_RTG_NAME,
						COMPLETION_INV_OPER,
						OPER_SEQ_NUM,
						STANDARD_OPER_ID,
						OPER,
						OPER_DESC,
						DEPT_ID,
						DEPT_CODE,
						DEPT_DESC,
						STATUS_TYPE,
						STATUS_TYPE_NAME,
						JOB_TYPE,
						JOB_TYPE_NAME,
						PLAN_START_DATE,
						PLAN_END_DATE,
						RELEASED_DATE,
						COMP_DATE,
						CLOSED_DATE,
						PLAN_QTY,
						QTY_IN_QUEUE,
						QTY_WAITING_TO_MOVE,
						QTY_SCRAPPED,
						QTY_COMPLETED,
						CUT_MULTI,
						PRE_OPER_SEQ,
						PRE_OPER,
						NEXT_OPER_SEQ,
						NEXT_OPER,
						FIRST_OPER_YN,
						LAST_OPER_YN,
						SRS_YN,
						PUP_GBN,
						CUTTING,
						CUST_NAME,
						VENDORS,
						REMARKS,
						SO_NUM,
						LAST_COMP_DATE,
						TRAN_FLAG,
						IF_GROUP_ID,
						CMF_1,
						CMF_2,
						CMF_3,
						CMF_4,
						CMF_5,
						CMF_6,
						CMF_7,
						CMF_8,
						CMF_9,
						CMF_10,
						CREATE_USER_ID,
						CREATE_TIME,
						UPDATE_USER_ID,
						UPDATE_TIME
					FROM IF_WO_INFO
					WHERE IF_CODE in ('N', 'R')
					ORDER BY IF_SEQ ASC )
				WHERE ROWNUM <= 10000
				;
            EXEC SQL OPEN DBU_IF_WO_INFO_CUR_101;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_if_wo_info", sel_type);
}


