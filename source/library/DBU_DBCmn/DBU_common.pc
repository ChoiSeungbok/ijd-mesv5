/*******************************************************************************
    DBU_del_null_condition()
        - Delete Null Condition Struct Function
    Return Value
        - void
    Arguments
        - struct DBU_Q_COND_N_TAG *DBU_Q_COND_N
*******************************************************************************/
void DBU_del_null_condition(struct DBU_Q_COND_TAG *DBU_Q_COND, struct DBU_Q_COND_N_TAG *DBU_Q_COND_N)
{
    MEMCPY_DN(DBU_Q_COND->FROM_DATE, DBU_Q_COND_N->FROM_DATE, sizeof(DBU_Q_COND->FROM_DATE));
    MEMCPY_DN(DBU_Q_COND->TO_DATE, DBU_Q_COND_N->TO_DATE, sizeof(DBU_Q_COND->TO_DATE));
