/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cwiplotmvc(int sel_type, struct CWIPLOTMVC_TAG *CWIPLOTMVC)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CWIPLOTMVC_N_TAG CWIPLOTMVC_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cwiplotmvc(&CWIPLOTMVC_N, CWIPLOTMVC);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CWIPLOTMVC_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    MOVE_ID,
                    LOT_ID,
                    HIST_SEQ,
                    QTY,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPLOTMVC
                ORDER BY FACTORY ASC,
                    MOVE_ID ASC,
                    LOT_ID ASC;
            EXEC SQL OPEN DBU_CWIPLOTMVC_CUR_1;
            break;

        case 2:
            EXEC SQL DECLARE DBU_CWIPLOTMVC_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    MOVE_ID,
                    LOT_ID,
                    HIST_SEQ,
                    QTY,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPLOTMVC
               WHERE FACTORY = :CWIPLOTMVC_N.FACTORY
                 AND MOVE_ID = :CWIPLOTMVC_N.MOVE_ID
                ORDER BY LOT_ID ASC;
            EXEC SQL OPEN DBU_CWIPLOTMVC_CUR_2;
            break;

        case 3:
            EXEC SQL DECLARE DBU_CWIPLOTMVC_CUR_3 CURSOR FOR
                SELECT 
                    A.FACTORY,
                    A.MOVE_ID,
                    A.LOT_ID,
                    A.HIST_SEQ,
                    A.QTY,
                    A.CREATE_USER_ID,
                    A.CREATE_TIME,
                    A.UPDATE_USER_ID,
                    A.UPDATE_TIME
                FROM CWIPLOTMVC A , MWIPLOTSTS B 
               WHERE A.FACTORY = :CWIPLOTMVC_N.FACTORY
                 AND A.LOT_ID = B.LOT_ID
                 AND A.MOVE_ID = :CWIPLOTMVC_N.MOVE_ID
                ORDER BY B.MAT_ID , A.LOT_ID;
            EXEC SQL OPEN DBU_CWIPLOTMVC_CUR_3;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cwiplotmvc", sel_type);
}


