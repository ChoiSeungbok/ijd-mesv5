    MEMCPY_AN(CWIPGRTBLD_N->MAT_ID, CWIPGRTBLD->MAT_ID, sizeof(CWIPGRTBLD->MAT_ID));
    CWIPGRTBLD_N->SHEET_NO = CWIPGRTBLD->SHEET_NO;
    CWIPGRTBLD_N->PSD_UP = CWIPGRTBLD->PSD_UP;
