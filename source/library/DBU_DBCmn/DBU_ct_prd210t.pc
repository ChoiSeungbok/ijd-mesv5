    memset(CT_PRD210T, ' ', sizeof(struct CT_PRD210T_TAG));
    
    CT_PRD210T->OP_SEQ = 0;
    CT_PRD210T->LOT_SEQ = 0;
    CT_PRD210T->WORK_QTY = 0;
    CT_PRD210T->BAD_QTY = 0;
    CT_PRD210T->LOT_QTY = 0;
    CT_PRD210T->READ_TIME = 0;
    CT_PRD210T->TO_OP_SEQ = 0;
    CT_PRD210T->INPUT_QTY = 0;
    CT_PRD210T->STATION_NO = 0;
}


