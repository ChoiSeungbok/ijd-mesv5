    EXEC SQL BEGIN DECLARE SECTION;
        struct CT_PRD210T_N_TAG CT_PRD210T_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_ct_prd210t(&CT_PRD210T_N, CT_PRD210T);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL UPDATE CT_PRD210T SET
                    WORK_QTY = :CT_PRD210T_N.WORK_QTY,
                    BAD_QTY = :CT_PRD210T_N.BAD_QTY,
                    LOT_QTY = :CT_PRD210T_N.LOT_QTY,
                    ACTUAL_DATE = :CT_PRD210T_N.ACTUAL_DATE,
                    WG_CODE = :CT_PRD210T_N.WG_CODE,
                    MACHINE = :CT_PRD210T_N.MACHINE,
                    READ_TIME = :CT_PRD210T_N.READ_TIME,
                    START_DATE = :CT_PRD210T_N.START_DATE,
                    START_TIME = :CT_PRD210T_N.START_TIME,
                    END_DATE = :CT_PRD210T_N.END_DATE,
                    END_TIME = :CT_PRD210T_N.END_TIME,
                    STATUS = :CT_PRD210T_N.STATUS,
                    USE_YN = :CT_PRD210T_N.USE_YN,
                    IF_YN = :CT_PRD210T_N.IF_YN,
                    REMARKS = :CT_PRD210T_N.REMARKS, 
                    CREATE_DATE = :CT_PRD210T_N.CREATE_DATE,
                    CREATE_USER = :CT_PRD210T_N.CREATE_USER,
                    UPDATE_DATE = :CT_PRD210T_N.UPDATE_DATE,
                    UPDATE_USER = :CT_PRD210T_N.UPDATE_USER,
                    ATTRIBUTE01 = :CT_PRD210T_N.ATTRIBUTE01,
                    ATTRIBUTE02 = :CT_PRD210T_N.ATTRIBUTE02,
                    ATTRIBUTE03 = :CT_PRD210T_N.ATTRIBUTE03,
                    ATTRIBUTE04 = :CT_PRD210T_N.ATTRIBUTE04,
                    ATTRIBUTE05 = :CT_PRD210T_N.ATTRIBUTE05,
                    ATTRIBUTE06 = :CT_PRD210T_N.ATTRIBUTE06,
                    ATTRIBUTE07 = :CT_PRD210T_N.ATTRIBUTE07,
                    ATTRIBUTE08 = :CT_PRD210T_N.ATTRIBUTE08,
                    ATTRIBUTE09 = :CT_PRD210T_N.ATTRIBUTE09,
                    ATTRIBUTE10 = :CT_PRD210T_N.ATTRIBUTE10,
                    ATTRIBUTE11 = :CT_PRD210T_N.ATTRIBUTE11,
                    ATTRIBUTE12 = :CT_PRD210T_N.ATTRIBUTE12,
                    ATTRIBUTE13 = :CT_PRD210T_N.ATTRIBUTE13,
                    ATTRIBUTE14 = :CT_PRD210T_N.ATTRIBUTE14,
                    ATTRIBUTE15 = :CT_PRD210T_N.ATTRIBUTE15,
                    TO_WC_CODE = :CT_PRD210T_N.TO_WC_CODE,
                    TO_OP_SEQ = :CT_PRD210T_N.TO_OP_SEQ,
                    TO_OP_CODE = :CT_PRD210T_N.TO_OP_CODE,
                    INPUT_QTY = :CT_PRD210T_N.INPUT_QTY,
                    OVER_YN = :CT_PRD210T_N.OVER_YN,
                    DECISION = :CT_PRD210T_N.DECISION,
                    STATION_NO = :CT_PRD210T_N.STATION_NO,
                    CELL_NO = :CT_PRD210T_N.CELL_NO
                WHERE LOT_ID = :CT_PRD210T_N.LOT_ID
                    AND ORG_CODE = :CT_PRD210T_N.ORG_CODE
                    AND WC_CODE = :CT_PRD210T_N.WC_CODE
                    AND OP_SEQ = :CT_PRD210T_N.OP_SEQ
                    AND OP_CODE = :CT_PRD210T_N.OP_CODE
                    AND LOT_SEQ = :CT_PRD210T_N.LOT_SEQ;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_update_ct_prd210t", sel_type);
}


/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_ct_prd210t(int sel_type, struct CT_PRD210T_TAG *CT_PRD210T)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CT_PRD210T_N_TAG CT_PRD210T_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_ct_prd210t(&CT_PRD210T_N, CT_PRD210T);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CT_PRD210T_CUR_1 CURSOR FOR
                SELECT 
                    LOT_ID,
                    ORG_CODE,
                    WC_CODE,
                    OP_SEQ,
                    OP_CODE,
                    LOT_SEQ,
                    NVL(WORK_QTY, '0'),
                    NVL(BAD_QTY, '0'),
                    NVL(LOT_QTY, '0'),
                    NVL(ACTUAL_DATE, ' '),
                    NVL(WG_CODE, ' '),
                    NVL(MACHINE, ' '),
                    NVL(READ_TIME, '0'),
                    NVL(START_DATE, ' '),
                    NVL(START_TIME, ' '),
                    NVL(END_DATE, ' '),
                    NVL(END_TIME, ' '),
                    NVL(STATUS, ' '),
                    NVL(USE_YN, ' '),
                    NVL(IF_YN, ' '),
                    NVL(REMARKS, ' '),
                    NVL(TO_CHAR(CREATE_DATE, 'YYYYMMDDHH24MISS'), ' '),
                    NVL(CREATE_USER, ' '),
                    NVL(TO_CHAR(UPDATE_DATE, 'YYYYMMDDHH24MISS'), ' '),
                    NVL(UPDATE_USER, ' '),
                    NVL(ATTRIBUTE01, ' '),
                    NVL(ATTRIBUTE02, ' '),
                    NVL(ATTRIBUTE03, ' '),
                    NVL(ATTRIBUTE04, ' '),
                    NVL(ATTRIBUTE05, ' '),
                    NVL(ATTRIBUTE06, ' '),
                    NVL(ATTRIBUTE07, ' '),
                    NVL(ATTRIBUTE08, ' '),
                    NVL(ATTRIBUTE09, ' '),
                    NVL(ATTRIBUTE10, ' '),
                    NVL(ATTRIBUTE11, ' '),
                    NVL(ATTRIBUTE12, ' '),
                    NVL(ATTRIBUTE13, ' '),
                    NVL(ATTRIBUTE14, ' '),
                    NVL(ATTRIBUTE15, ' '),
                    NVL(TO_WC_CODE, ' '),
                    NVL(TO_OP_SEQ, '0'),
                    NVL(TO_OP_CODE, ' '),
                    NVL(INPUT_QTY, '0'),
                    NVL(OVER_YN, ' '),
                    NVL(DECISION, ' '),
                    NVL(STATION_NO, '0'),
                    NVL(CELL_NO, ' ')
                FROM CT_PRD210T
                ORDER BY LOT_ID ASC,
                    ORG_CODE ASC,
                    WC_CODE ASC,
                    OP_SEQ ASC,
                    OP_CODE ASC,
                    LOT_SEQ ASC;
            EXEC SQL OPEN DBU_CT_PRD210T_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_ct_prd210t", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_ct_prd210t(int sel_type, struct CT_PRD210T_TAG *CT_PRD210T)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CT_PRD210T_N_TAG CT_PRD210T_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_CT_PRD210T_CUR_1 INTO
                :CT_PRD210T_N.LOT_ID,
                :CT_PRD210T_N.ORG_CODE,
                :CT_PRD210T_N.WC_CODE,
                :CT_PRD210T_N.OP_SEQ,
                :CT_PRD210T_N.OP_CODE,
                :CT_PRD210T_N.LOT_SEQ,
                :CT_PRD210T_N.WORK_QTY,
                :CT_PRD210T_N.BAD_QTY,
                :CT_PRD210T_N.LOT_QTY,
                :CT_PRD210T_N.ACTUAL_DATE,
                :CT_PRD210T_N.WG_CODE,
                :CT_PRD210T_N.MACHINE,
                :CT_PRD210T_N.READ_TIME,
                :CT_PRD210T_N.START_DATE,
                :CT_PRD210T_N.START_TIME,
                :CT_PRD210T_N.END_DATE,
                :CT_PRD210T_N.END_TIME,
                :CT_PRD210T_N.STATUS,
                :CT_PRD210T_N.USE_YN,
                :CT_PRD210T_N.IF_YN,
                :CT_PRD210T_N.REMARKS,
                :CT_PRD210T_N.CREATE_DATE,
                :CT_PRD210T_N.CREATE_USER,
                :CT_PRD210T_N.UPDATE_DATE,
                :CT_PRD210T_N.UPDATE_USER,
                :CT_PRD210T_N.ATTRIBUTE01,
                :CT_PRD210T_N.ATTRIBUTE02,
                :CT_PRD210T_N.ATTRIBUTE03,
                :CT_PRD210T_N.ATTRIBUTE04,
                :CT_PRD210T_N.ATTRIBUTE05,
                :CT_PRD210T_N.ATTRIBUTE06,
                :CT_PRD210T_N.ATTRIBUTE07,
                :CT_PRD210T_N.ATTRIBUTE08,
                :CT_PRD210T_N.ATTRIBUTE09,
                :CT_PRD210T_N.ATTRIBUTE10,
                :CT_PRD210T_N.ATTRIBUTE11,
                :CT_PRD210T_N.ATTRIBUTE12,
                :CT_PRD210T_N.ATTRIBUTE13,
                :CT_PRD210T_N.ATTRIBUTE14,
                :CT_PRD210T_N.ATTRIBUTE15,
                :CT_PRD210T_N.TO_WC_CODE,
                :CT_PRD210T_N.TO_OP_SEQ,
                :CT_PRD210T_N.TO_OP_CODE,
                :CT_PRD210T_N.INPUT_QTY,
                :CT_PRD210T_N.OVER_YN,
                :CT_PRD210T_N.DECISION,
                :CT_PRD210T_N.STATION_NO,
                :CT_PRD210T_N.CELL_NO;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_ct_prd210t(&CT_PRD210T_N, CT_PRD210T);
    }

    DB_stop_query_timer("DBU_fetch_ct_prd210t", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_ct_prd210t(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CT_PRD210T_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_ct_prd210t", sel_type);
}


/* Initialize Function */
