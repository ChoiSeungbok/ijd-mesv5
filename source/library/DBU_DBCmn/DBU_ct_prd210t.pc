    CT_PRD210T->INPUT_QTY = CT_PRD210T_N->INPUT_QTY;
    CT_PRD210T->OVER_YN = CT_PRD210T_N->OVER_YN[0];
    MEMCPY_DN(CT_PRD210T->DECISION, CT_PRD210T_N->DECISION, sizeof(CT_PRD210T->DECISION));
    CT_PRD210T->STATION_NO = CT_PRD210T_N->STATION_NO;
    MEMCPY_DN(CT_PRD210T->CELL_NO, CT_PRD210T_N->CELL_NO, sizeof(CT_PRD210T->CELL_NO));
}


