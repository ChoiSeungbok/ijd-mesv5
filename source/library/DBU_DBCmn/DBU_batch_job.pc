    EXEC SQL END DECLARE SECTION;
	
    DB_error_code = 0;

   
    sprintf(s_factory, "%s", as_factory);
    sprintf(s_area, "%s", as_area);
    sprintf(s_qcm_insp_type, "%s", as_qcm_insp_type);
    sprintf(s_qcm_oper, "%s", as_qcm_oper);
