void DBU_batch_job_exec(int sel_type)
{
    EXEC SQL BEGIN DECLARE SECTION;
        char s_para[10];
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DB_error_code = 0;

    switch(sel_type)
    {
       case 101:  /*ป๙วร */
           memset(s_para, 0x00, sizeof(s_para));
            
            EXEC SQL EXECUTE
                BEGIN 
                    PR_SUM_WIP_ACTUAL_RESULT(:s_para);
                END;
            END-EXEC;

            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("CST_batch_job_exec", sel_type);
}


