                :CQCMISPDAT_N.CREATE_TIME,
                :CQCMISPDAT_N.UPDATE_USER_ID,
                :CQCMISPDAT_N.UPDATE_TIME;
            break;

		case 7:
            EXEC SQL FETCH DBU_CQCMISPDAT_CUR_7 INTO
                :CQCMISPDAT_N.FACTORY,
                :CQCMISPDAT_N.INSP_ID,
