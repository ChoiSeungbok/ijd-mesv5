void DBU_del_null_minvreqlot(struct MINVREQLOT_N_TAG *MINVREQLOT_N, struct MINVREQLOT_TAG *MINVREQLOT)
{
    MEMCPY_DN(MINVREQLOT->FACTORY, MINVREQLOT_N->FACTORY, sizeof(MINVREQLOT->FACTORY));
    MEMCPY_DN(MINVREQLOT->REQ_NO, MINVREQLOT_N->REQ_NO, sizeof(MINVREQLOT->REQ_NO));
    MEMCPY_DN(MINVREQLOT->REQ_MAT_ID, MINVREQLOT_N->REQ_MAT_ID, sizeof(MINVREQLOT->REQ_MAT_ID));
    MINVREQLOT->REQ_MAT_VER = MINVREQLOT_N->REQ_MAT_VER;
    MEMCPY_DN(MINVREQLOT->INV_LOT_ID, MINVREQLOT_N->INV_LOT_ID, sizeof(MINVREQLOT->INV_LOT_ID));
    MINVREQLOT->REQ_QTY = MINVREQLOT_N->REQ_QTY;
	MEMCPY_DN(MINVREQLOT->UNIT, MINVREQLOT_N->UNIT, sizeof(MINVREQLOT->UNIT));
    MEMCPY_DN(MINVREQLOT->REQ_STATUS, MINVREQLOT_N->REQ_STATUS, sizeof(MINVREQLOT->REQ_STATUS));
    MEMCPY_DN(MINVREQLOT->CREATE_USER_ID, MINVREQLOT_N->CREATE_USER_ID, sizeof(MINVREQLOT->CREATE_USER_ID));
    MEMCPY_DN(MINVREQLOT->CREATE_TIME, MINVREQLOT_N->CREATE_TIME, sizeof(MINVREQLOT->CREATE_TIME));
    MEMCPY_DN(MINVREQLOT->UPDATE_USER_ID, MINVREQLOT_N->UPDATE_USER_ID, sizeof(MINVREQLOT->UPDATE_USER_ID));
    MEMCPY_DN(MINVREQLOT->UPDATE_TIME, MINVREQLOT_N->UPDATE_TIME, sizeof(MINVREQLOT->UPDATE_TIME));
}


