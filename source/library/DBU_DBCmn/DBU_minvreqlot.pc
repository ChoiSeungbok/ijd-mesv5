/* Initialize Function */
void DBU_init_minvreqlot(struct MINVREQLOT_TAG *MINVREQLOT)
{
    /* memset by Space */
    memset(MINVREQLOT, ' ', sizeof(struct MINVREQLOT_TAG));
    
    MINVREQLOT->REQ_MAT_VER = 0;
    MINVREQLOT->REQ_QTY = 0;
}


/* Add Null Function */
void DBU_add_null_minvreqlot(struct MINVREQLOT_N_TAG *MINVREQLOT_N, struct MINVREQLOT_TAG *MINVREQLOT)
{
    /* memset by NULL */
    memset(MINVREQLOT_N, '\0', sizeof(struct MINVREQLOT_N_TAG));
    
    MEMCPY_AN(MINVREQLOT_N->FACTORY, MINVREQLOT->FACTORY, sizeof(MINVREQLOT->FACTORY));
    MEMCPY_AN(MINVREQLOT_N->REQ_NO, MINVREQLOT->REQ_NO, sizeof(MINVREQLOT->REQ_NO));
    MEMCPY_AN(MINVREQLOT_N->REQ_MAT_ID, MINVREQLOT->REQ_MAT_ID, sizeof(MINVREQLOT->REQ_MAT_ID));
    MINVREQLOT_N->REQ_MAT_VER = MINVREQLOT->REQ_MAT_VER;
    MEMCPY_AN(MINVREQLOT_N->INV_LOT_ID, MINVREQLOT->INV_LOT_ID, sizeof(MINVREQLOT->INV_LOT_ID));
    MINVREQLOT_N->REQ_QTY = MINVREQLOT->REQ_QTY;
	MEMCPY_AN(MINVREQLOT_N->UNIT, MINVREQLOT->UNIT, sizeof(MINVREQLOT->UNIT));
    MEMCPY_AN(MINVREQLOT_N->REQ_STATUS, MINVREQLOT->REQ_STATUS, sizeof(MINVREQLOT->REQ_STATUS));
    MEMCPY_AN(MINVREQLOT_N->CREATE_USER_ID, MINVREQLOT->CREATE_USER_ID, sizeof(MINVREQLOT->CREATE_USER_ID));
    MEMCPY_AN(MINVREQLOT_N->CREATE_TIME, MINVREQLOT->CREATE_TIME, sizeof(MINVREQLOT->CREATE_TIME));
    MEMCPY_AN(MINVREQLOT_N->UPDATE_USER_ID, MINVREQLOT->UPDATE_USER_ID, sizeof(MINVREQLOT->UPDATE_USER_ID));
    MEMCPY_AN(MINVREQLOT_N->UPDATE_TIME, MINVREQLOT->UPDATE_TIME, sizeof(MINVREQLOT->UPDATE_TIME));
}


