/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_minvreqlot(int sel_type, struct MINVREQLOT_TAG *MINVREQLOT)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVREQLOT_N_TAG MINVREQLOT_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_minvreqlot(&MINVREQLOT_N, MINVREQLOT);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_MINVREQLOT_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    REQ_NO,
                    REQ_MAT_ID,
                    REQ_MAT_VER,
                    INV_LOT_ID,
                    REQ_QTY,
					UNIT,
                    REQ_STATUS,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM MINVREQLOT
                ORDER BY FACTORY ASC,
                    REQ_NO ASC,
                    REQ_MAT_ID ASC,
                    REQ_MAT_VER ASC,
                    INV_LOT_ID ASC;
            EXEC SQL OPEN DBU_MINVREQLOT_CUR_1;
            break;

		case 2:
            EXEC SQL DECLARE DBU_MINVREQLOT_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    REQ_NO,
                    REQ_MAT_ID,
                    REQ_MAT_VER,
                    INV_LOT_ID,
                    REQ_QTY,
					UNIT,
                    REQ_STATUS,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM MINVREQLOT
				WHERE FACTORY = :MINVREQLOT_N.FACTORY
				 AND REQ_NO = :MINVREQLOT_N.REQ_NO
                ORDER BY FACTORY ASC,
                    REQ_NO ASC,
                    REQ_MAT_ID ASC,
                    REQ_MAT_VER ASC,
                    INV_LOT_ID ASC;
            EXEC SQL OPEN DBU_MINVREQLOT_CUR_2;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_minvreqlot", sel_type);
}


