    ISHPLOTISS_N->PACK_LINE_NO = ISHPLOTISS->PACK_LINE_NO;
    MEMCPY_AN(ISHPLOTISS_N->SHIP_DATE, ISHPLOTISS->SHIP_DATE, sizeof(ISHPLOTISS->SHIP_DATE));
    MEMCPY_AN(ISHPLOTISS_N->SHIP_ORDER_ID, ISHPLOTISS->SHIP_ORDER_ID, sizeof(ISHPLOTISS->SHIP_ORDER_ID));
    ISHPLOTISS_N->SHIP_ORDER_SEQ = ISHPLOTISS->SHIP_ORDER_SEQ;
    MEMCPY_AN(ISHPLOTISS_N->CUSTOMER_ID, ISHPLOTISS->CUSTOMER_ID, sizeof(ISHPLOTISS->CUSTOMER_ID));
    ISHPLOTISS_N->CUSTOMER_SITE_ID = ISHPLOTISS->CUSTOMER_SITE_ID;
    MEMCPY_AN(ISHPLOTISS_N->CUSTOMER_NUMBER, ISHPLOTISS->CUSTOMER_NUMBER, sizeof(ISHPLOTISS->CUSTOMER_NUMBER));
    MEMCPY_AN(ISHPLOTISS_N->CUSTOMER_NAME, ISHPLOTISS->CUSTOMER_NAME, sizeof(ISHPLOTISS->CUSTOMER_NAME));
