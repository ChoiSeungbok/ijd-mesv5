/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_ishplotiss(int sel_type, struct ISHPLOTISS_TAG *ISHPLOTISS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct ISHPLOTISS_N_TAG ISHPLOTISS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_ishplotiss(&ISHPLOTISS_N, ISHPLOTISS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_ISHPLOTISS_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    ORG_LOT_ID,
                    PACK_LOT_ID,
                    IF_TIME,
                    IF_CODE,
                    IF_MSG,
                    TO_FACTORY,
                    MAT_ID,
                    MAT_VER,
