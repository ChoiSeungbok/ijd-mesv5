    MEMCPY_AN(ISHPLOTISS_N->DELIVERY_LOCATION, ISHPLOTISS->DELIVERY_LOCATION, sizeof(ISHPLOTISS->DELIVERY_LOCATION));
    MEMCPY_AN(ISHPLOTISS_N->DELIVERY_PHONE_NO, ISHPLOTISS->DELIVERY_PHONE_NO, sizeof(ISHPLOTISS->DELIVERY_PHONE_NO));
    MEMCPY_AN(ISHPLOTISS_N->DELIVERY_USER_ID, ISHPLOTISS->DELIVERY_USER_ID, sizeof(ISHPLOTISS->DELIVERY_USER_ID));
    ISHPLOTISS_N->SHIPPING_LINE_ID = ISHPLOTISS->SHIPPING_LINE_ID;
    MEMCPY_AN(ISHPLOTISS_N->PRS_WORK_DATE, ISHPLOTISS->PRS_WORK_DATE, sizeof(ISHPLOTISS->PRS_WORK_DATE));
    MEMCPY_AN(ISHPLOTISS_N->RES_ID, ISHPLOTISS->RES_ID, sizeof(ISHPLOTISS->RES_ID));
    MEMCPY_AN(ISHPLOTISS_N->RES_DESC, ISHPLOTISS->RES_DESC, sizeof(ISHPLOTISS->RES_DESC));
    ISHPLOTISS_N->RUN_COUNT = ISHPLOTISS->RUN_COUNT;
    MEMCPY_AN(ISHPLOTISS_N->CELL_ID, ISHPLOTISS->CELL_ID, sizeof(ISHPLOTISS->CELL_ID));
    ISHPLOTISS_N->MAPPING_SEQ = ISHPLOTISS->MAPPING_SEQ;
    MEMCPY_AN(ISHPLOTISS_N->CAR, ISHPLOTISS->CAR, sizeof(ISHPLOTISS->CAR));
    ISHPLOTISS_N->DAY_NIGHT[0] = ISHPLOTISS->DAY_NIGHT;
    MEMCPY_AN(ISHPLOTISS_N->PRS_TRAN_TIME, ISHPLOTISS->PRS_TRAN_TIME, sizeof(ISHPLOTISS->PRS_TRAN_TIME));
    MEMCPY_AN(ISHPLOTISS_N->CMF_1, ISHPLOTISS->CMF_1, sizeof(ISHPLOTISS->CMF_1));
    MEMCPY_AN(ISHPLOTISS_N->CMF_2, ISHPLOTISS->CMF_2, sizeof(ISHPLOTISS->CMF_2));
