    MEMCPY_AN(ISHPLOTISS_N->CMF_4, ISHPLOTISS->CMF_4, sizeof(ISHPLOTISS->CMF_4));
    MEMCPY_AN(ISHPLOTISS_N->CMF_5, ISHPLOTISS->CMF_5, sizeof(ISHPLOTISS->CMF_5));
    MEMCPY_AN(ISHPLOTISS_N->CMF_6, ISHPLOTISS->CMF_6, sizeof(ISHPLOTISS->CMF_6));
