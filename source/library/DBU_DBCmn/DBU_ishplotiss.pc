                    CUSTOMER_NAME,
                    DELIVERY,
                    DELIVERY_ID,
                    DELIVERY_NAME,
                    DELIVERY_LOCATION,
                    DELIVERY_PHONE_NO,
                    DELIVERY_USER_ID,
                    SHIPPING_LINE_ID,
                    PRS_WORK_DATE,
                    RES_ID,
                    RES_DESC,
                    RUN_COUNT,
                    CELL_ID,
                    MAPPING_SEQ,
                    CAR,
                    DAY_NIGHT,
                    PRS_TRAN_TIME,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM ISHPLOTISS
                ORDER BY FACTORY ASC,
                    ORG_LOT_ID ASC,
                    PACK_LOT_ID ASC;
            EXEC SQL OPEN DBU_ISHPLOTISS_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
