/* Del Null Function */
void DBU_del_null_ishplotiss(struct ISHPLOTISS_N_TAG *ISHPLOTISS_N, struct ISHPLOTISS_TAG *ISHPLOTISS)
{
    MEMCPY_DN(ISHPLOTISS->FACTORY, ISHPLOTISS_N->FACTORY, sizeof(ISHPLOTISS->FACTORY));
