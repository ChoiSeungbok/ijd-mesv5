                :ISHPLOTISS_N.TO_FACTORY,
                :ISHPLOTISS_N.MAT_ID,
                :ISHPLOTISS_N.MAT_VER,
                :ISHPLOTISS_N.QTY,
                :ISHPLOTISS_N.UNIT,
                :ISHPLOTISS_N.PACK_ORDER_ID,
                :ISHPLOTISS_N.PACK_LINE_NO,
                :ISHPLOTISS_N.SHIP_DATE,
                :ISHPLOTISS_N.SHIP_ORDER_ID,
                :ISHPLOTISS_N.SHIP_ORDER_SEQ,
                :ISHPLOTISS_N.CUSTOMER_ID,
                :ISHPLOTISS_N.CUSTOMER_SITE_ID,
                :ISHPLOTISS_N.CUSTOMER_NUMBER,
                :ISHPLOTISS_N.CUSTOMER_NAME,
                :ISHPLOTISS_N.DELIVERY,
                :ISHPLOTISS_N.DELIVERY_ID,
                :ISHPLOTISS_N.DELIVERY_NAME,
                :ISHPLOTISS_N.DELIVERY_LOCATION,
                :ISHPLOTISS_N.DELIVERY_PHONE_NO,
                :ISHPLOTISS_N.DELIVERY_USER_ID,
                :ISHPLOTISS_N.SHIPPING_LINE_ID,
                :ISHPLOTISS_N.PRS_WORK_DATE,
                :ISHPLOTISS_N.RES_ID,
                :ISHPLOTISS_N.RES_DESC,
                :ISHPLOTISS_N.RUN_COUNT,
                :ISHPLOTISS_N.CELL_ID,
                :ISHPLOTISS_N.MAPPING_SEQ,
                :ISHPLOTISS_N.CAR,
                :ISHPLOTISS_N.DAY_NIGHT,
                :ISHPLOTISS_N.PRS_TRAN_TIME,
                :ISHPLOTISS_N.CMF_1,
                :ISHPLOTISS_N.CMF_2,
                :ISHPLOTISS_N.CMF_3,
                :ISHPLOTISS_N.CMF_4,
                :ISHPLOTISS_N.CMF_5,
                :ISHPLOTISS_N.CMF_6,
                :ISHPLOTISS_N.CMF_7,
                :ISHPLOTISS_N.CMF_8,
                :ISHPLOTISS_N.CMF_9,
                :ISHPLOTISS_N.CMF_10,
                :ISHPLOTISS_N.CREATE_USER_ID,
                :ISHPLOTISS_N.CREATE_TIME,
                :ISHPLOTISS_N.UPDATE_USER_ID,
                :ISHPLOTISS_N.UPDATE_TIME;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_ishplotiss(&ISHPLOTISS_N, ISHPLOTISS);
    }

    DB_stop_query_timer("DBU_fetch_ishplotiss", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_ishplotiss(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_ISHPLOTISS_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_ishplotiss", sel_type);
}


/* Initialize Function */
void DBU_init_ishplotiss(struct ISHPLOTISS_TAG *ISHPLOTISS)
{
    /* memset by Space */
    memset(ISHPLOTISS, ' ', sizeof(struct ISHPLOTISS_TAG));
    
    ISHPLOTISS->MAT_VER = 0;
    ISHPLOTISS->QTY = 0;
    ISHPLOTISS->PACK_LINE_NO = 0;
    ISHPLOTISS->SHIP_ORDER_SEQ = 0;
    ISHPLOTISS->CUSTOMER_SITE_ID = 0;
    ISHPLOTISS->DELIVERY_ID = 0;
    ISHPLOTISS->SHIPPING_LINE_ID = 0;
    ISHPLOTISS->RUN_COUNT = 0;
    ISHPLOTISS->MAPPING_SEQ = 0;
}


/* Add Null Function */
void DBU_add_null_ishplotiss(struct ISHPLOTISS_N_TAG *ISHPLOTISS_N, struct ISHPLOTISS_TAG *ISHPLOTISS)
{
    /* memset by NULL */
    memset(ISHPLOTISS_N, '\0', sizeof(struct ISHPLOTISS_N_TAG));
    
    MEMCPY_AN(ISHPLOTISS_N->FACTORY, ISHPLOTISS->FACTORY, sizeof(ISHPLOTISS->FACTORY));
    MEMCPY_AN(ISHPLOTISS_N->ORG_LOT_ID, ISHPLOTISS->ORG_LOT_ID, sizeof(ISHPLOTISS->ORG_LOT_ID));
    MEMCPY_AN(ISHPLOTISS_N->PACK_LOT_ID, ISHPLOTISS->PACK_LOT_ID, sizeof(ISHPLOTISS->PACK_LOT_ID));
    MEMCPY_AN(ISHPLOTISS_N->IF_TIME, ISHPLOTISS->IF_TIME, sizeof(ISHPLOTISS->IF_TIME));
    ISHPLOTISS_N->IF_CODE[0] = ISHPLOTISS->IF_CODE;
    MEMCPY_AN(ISHPLOTISS_N->IF_MSG, ISHPLOTISS->IF_MSG, sizeof(ISHPLOTISS->IF_MSG));
    MEMCPY_AN(ISHPLOTISS_N->TO_FACTORY, ISHPLOTISS->TO_FACTORY, sizeof(ISHPLOTISS->TO_FACTORY));
