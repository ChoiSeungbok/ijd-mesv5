/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_mwipflwopr(int sel_type, struct MWIPFLWOPR_TAG *MWIPFLWOPR)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MWIPFLWOPR_N_TAG MWIPFLWOPR_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_mwipflwopr(&MWIPFLWOPR_N, MWIPFLWOPR);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_MWIPFLWOPR_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    FLOW,
                    OPER,
                    OPT_OPER_GROUP,
                    OPT_OPER_OPTION_FLAG,
                    SEQ_NUM,
                    PREV_OPER,
                    NEXT_OPER,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM MWIPFLWOPR
                ORDER BY FACTORY ASC,
                    FLOW ASC,
                    OPER ASC;
            EXEC SQL OPEN DBU_MWIPFLWOPR_CUR_1;
            break;

        case 2:
            EXEC SQL DECLARE DBU_MWIPFLWOPR_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    FLOW,
                    OPER,
                    OPT_OPER_GROUP,
                    OPT_OPER_OPTION_FLAG,
                    SEQ_NUM,
                    PREV_OPER,
                    NEXT_OPER,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM MWIPFLWOPR
               WHERE FACTORY = :MWIPFLWOPR_N.FACTORY
                 AND FLOW = :MWIPFLWOPR_N.FLOW
               ORDER BY SEQ_NUM DESC;
            EXEC SQL OPEN DBU_MWIPFLWOPR_CUR_2;
            break;

		case 3:
            EXEC SQL DECLARE DBU_MWIPFLWOPR_CUR_3 CURSOR FOR
                SELECT 
                    A.FACTORY,
                    A.FLOW,
                    A.OPER,
                    A.OPT_OPER_GROUP,
                    A.OPT_OPER_OPTION_FLAG,
                    A.SEQ_NUM,
                    A.PREV_OPER,
                    A.NEXT_OPER,
                    A.CREATE_USER_ID,
                    A.CREATE_TIME,
                    A.UPDATE_USER_ID,
                    A.UPDATE_TIME
                FROM MWIPFLWOPR A, MWIPOPRDEF B
               WHERE A.FACTORY = :MWIPFLWOPR_N.FACTORY
                 AND A.FLOW = :MWIPFLWOPR_N.FLOW
				 AND A.FACTORY = B.FACTORY
				 AND A.OPER = B.OPER
				 AND B.OPER_CMF_1 = :MWIPFLWOPR_N.NEXT_OPER
               ORDER BY A.FACTORY ASC,
                    A.FLOW ASC,
                    A.OPER ASC;
				EXEC SQL OPEN DBU_MWIPFLWOPR_CUR_3;
				break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_mwipflwopr", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_mwipflwopr(int sel_type, struct MWIPFLWOPR_TAG *MWIPFLWOPR)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MWIPFLWOPR_N_TAG MWIPFLWOPR_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_MWIPFLWOPR_CUR_1 INTO
                :MWIPFLWOPR_N.FACTORY,
                :MWIPFLWOPR_N.FLOW,
                :MWIPFLWOPR_N.OPER,
                :MWIPFLWOPR_N.OPT_OPER_GROUP,
                :MWIPFLWOPR_N.OPT_OPER_OPTION_FLAG,
                :MWIPFLWOPR_N.SEQ_NUM,
                :MWIPFLWOPR_N.PREV_OPER,
                :MWIPFLWOPR_N.NEXT_OPER,
                :MWIPFLWOPR_N.CREATE_USER_ID,
                :MWIPFLWOPR_N.CREATE_TIME,
                :MWIPFLWOPR_N.UPDATE_USER_ID,
                :MWIPFLWOPR_N.UPDATE_TIME;
            break;

        case 2:
            EXEC SQL FETCH DBU_MWIPFLWOPR_CUR_2 INTO
                :MWIPFLWOPR_N.FACTORY,
                :MWIPFLWOPR_N.FLOW,
                :MWIPFLWOPR_N.OPER,
                :MWIPFLWOPR_N.OPT_OPER_GROUP,
                :MWIPFLWOPR_N.OPT_OPER_OPTION_FLAG,
                :MWIPFLWOPR_N.SEQ_NUM,
                :MWIPFLWOPR_N.PREV_OPER,
                :MWIPFLWOPR_N.NEXT_OPER,
                :MWIPFLWOPR_N.CREATE_USER_ID,
                :MWIPFLWOPR_N.CREATE_TIME,
                :MWIPFLWOPR_N.UPDATE_USER_ID,
                :MWIPFLWOPR_N.UPDATE_TIME;
            break;

		case 3:
            EXEC SQL FETCH DBU_MWIPFLWOPR_CUR_3 INTO
                :MWIPFLWOPR_N.FACTORY,
                :MWIPFLWOPR_N.FLOW,
                :MWIPFLWOPR_N.OPER,
                :MWIPFLWOPR_N.OPT_OPER_GROUP,
                :MWIPFLWOPR_N.OPT_OPER_OPTION_FLAG,
                :MWIPFLWOPR_N.SEQ_NUM,
                :MWIPFLWOPR_N.PREV_OPER,
                :MWIPFLWOPR_N.NEXT_OPER,
                :MWIPFLWOPR_N.CREATE_USER_ID,
                :MWIPFLWOPR_N.CREATE_TIME,
                :MWIPFLWOPR_N.UPDATE_USER_ID,
                :MWIPFLWOPR_N.UPDATE_TIME;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_mwipflwopr(&MWIPFLWOPR_N, MWIPFLWOPR);
    }

    DB_stop_query_timer("DBU_fetch_mwipflwopr", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_mwipflwopr(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_MWIPFLWOPR_CUR_1;
            break;

        case 2:
            EXEC SQL CLOSE DBU_MWIPFLWOPR_CUR_2;
            break;

		case 3:
            EXEC SQL CLOSE DBU_MWIPFLWOPR_CUR_3;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_mwipflwopr", sel_type);
}


/* Initialize Function */
void DBU_init_mwipflwopr(struct MWIPFLWOPR_TAG *MWIPFLWOPR)
{
    /* memset by Space */
    memset(MWIPFLWOPR, ' ', sizeof(struct MWIPFLWOPR_TAG));
    
    MWIPFLWOPR->SEQ_NUM = 0;
}


/* Add Null Function */
void DBU_add_null_mwipflwopr(struct MWIPFLWOPR_N_TAG *MWIPFLWOPR_N, struct MWIPFLWOPR_TAG *MWIPFLWOPR)
{
    /* memset by NULL */
    memset(MWIPFLWOPR_N, '\0', sizeof(struct MWIPFLWOPR_N_TAG));
    
    MEMCPY_AN(MWIPFLWOPR_N->FACTORY, MWIPFLWOPR->FACTORY, sizeof(MWIPFLWOPR->FACTORY));
    MEMCPY_AN(MWIPFLWOPR_N->FLOW, MWIPFLWOPR->FLOW, sizeof(MWIPFLWOPR->FLOW));
    MEMCPY_AN(MWIPFLWOPR_N->OPER, MWIPFLWOPR->OPER, sizeof(MWIPFLWOPR->OPER));
    MEMCPY_AN(MWIPFLWOPR_N->OPT_OPER_GROUP, MWIPFLWOPR->OPT_OPER_GROUP, sizeof(MWIPFLWOPR->OPT_OPER_GROUP));
    MWIPFLWOPR_N->OPT_OPER_OPTION_FLAG[0] = MWIPFLWOPR->OPT_OPER_OPTION_FLAG;
    MWIPFLWOPR_N->SEQ_NUM = MWIPFLWOPR->SEQ_NUM;
    MEMCPY_AN(MWIPFLWOPR_N->PREV_OPER, MWIPFLWOPR->PREV_OPER, sizeof(MWIPFLWOPR->PREV_OPER));
    MEMCPY_AN(MWIPFLWOPR_N->NEXT_OPER, MWIPFLWOPR->NEXT_OPER, sizeof(MWIPFLWOPR->NEXT_OPER));
    MEMCPY_AN(MWIPFLWOPR_N->CREATE_USER_ID, MWIPFLWOPR->CREATE_USER_ID, sizeof(MWIPFLWOPR->CREATE_USER_ID));
    MEMCPY_AN(MWIPFLWOPR_N->CREATE_TIME, MWIPFLWOPR->CREATE_TIME, sizeof(MWIPFLWOPR->CREATE_TIME));
    MEMCPY_AN(MWIPFLWOPR_N->UPDATE_USER_ID, MWIPFLWOPR->UPDATE_USER_ID, sizeof(MWIPFLWOPR->UPDATE_USER_ID));
    MEMCPY_AN(MWIPFLWOPR_N->UPDATE_TIME, MWIPFLWOPR->UPDATE_TIME, sizeof(MWIPFLWOPR->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_mwipflwopr(struct MWIPFLWOPR_N_TAG *MWIPFLWOPR_N, struct MWIPFLWOPR_TAG *MWIPFLWOPR)
{
    MEMCPY_DN(MWIPFLWOPR->FACTORY, MWIPFLWOPR_N->FACTORY, sizeof(MWIPFLWOPR->FACTORY));
    MEMCPY_DN(MWIPFLWOPR->FLOW, MWIPFLWOPR_N->FLOW, sizeof(MWIPFLWOPR->FLOW));
    MEMCPY_DN(MWIPFLWOPR->OPER, MWIPFLWOPR_N->OPER, sizeof(MWIPFLWOPR->OPER));
    MEMCPY_DN(MWIPFLWOPR->OPT_OPER_GROUP, MWIPFLWOPR_N->OPT_OPER_GROUP, sizeof(MWIPFLWOPR->OPT_OPER_GROUP));
    MWIPFLWOPR->OPT_OPER_OPTION_FLAG = MWIPFLWOPR_N->OPT_OPER_OPTION_FLAG[0];
    MWIPFLWOPR->SEQ_NUM = MWIPFLWOPR_N->SEQ_NUM;
    MEMCPY_DN(MWIPFLWOPR->PREV_OPER, MWIPFLWOPR_N->PREV_OPER, sizeof(MWIPFLWOPR->PREV_OPER));
    MEMCPY_DN(MWIPFLWOPR->NEXT_OPER, MWIPFLWOPR_N->NEXT_OPER, sizeof(MWIPFLWOPR->NEXT_OPER));
    MEMCPY_DN(MWIPFLWOPR->CREATE_USER_ID, MWIPFLWOPR_N->CREATE_USER_ID, sizeof(MWIPFLWOPR->CREATE_USER_ID));
    MEMCPY_DN(MWIPFLWOPR->CREATE_TIME, MWIPFLWOPR_N->CREATE_TIME, sizeof(MWIPFLWOPR->CREATE_TIME));
    MEMCPY_DN(MWIPFLWOPR->UPDATE_USER_ID, MWIPFLWOPR_N->UPDATE_USER_ID, sizeof(MWIPFLWOPR->UPDATE_USER_ID));
    MEMCPY_DN(MWIPFLWOPR->UPDATE_TIME, MWIPFLWOPR_N->UPDATE_TIME, sizeof(MWIPFLWOPR->UPDATE_TIME));
}


