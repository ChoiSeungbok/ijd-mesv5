/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_ct_sal110t(int sel_type, struct CT_SAL110T_TAG *CT_SAL110T)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CT_SAL110T_N_TAG CT_SAL110T_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_ct_sal110t(&CT_SAL110T_N, CT_SAL110T);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CT_SAL110T_CUR_1 CURSOR FOR
                SELECT 
                    A.LOT_ID,
                    A.LOT_SEQ,
                    NVL(A.LOT_QTY, 0),
                    NVL(A.STATUS, ' '),
                    NVL(A.USE_YN, ' '),
                    NVL(A.ORDER_NUM, 0),
                    NVL(A.HEADER_ID, 0),
                    NVL(A.LINE_NUMBER, 0),
                    NVL(A.ITEM_NAME, ' '),
                    NVL(A.LABEL_TYPE, ' '),
                    NVL(A.LABEL_MESH, ' '),
                    NVL(A.TRANS_SEQ, ' '),
                    NVL(A.COATING_RATE, 0),
                    NVL(TO_CHAR(A.INSERT_DATE, 'YYYYMMDDHH24MISS'), ' '),
                    NVL(A.INSERT_USER, ' '),
                    NVL(TO_CHAR(A.UPDATE_DATE, 'YYYYMMDDHH24MISS'), ' '),
                    NVL(A.UPDATE_USER, ' '),
                    NVL(A.INCLUDE_INSPECTION, ' '),
                    NVL(A.DRAWING_FLAG, ' '),
                    NVL(B.LOT_ADD, A.LOT_ID),
                    NVL(A.CUST_CODE, ' '),
                    NVL(A.CUST_SITE_ID, 0),
                    NVL(A.END_CUST_ID, 0)
                FROM CT_SAL110T A, CT_SAL100T B
               WHERE A.LOT_ID = B.LOT_ID
                 AND B.WH_CODE LIKE 'B-STG%'
                 AND A.USE_YN = 'Y'
                 AND A.LOT_ID = :CT_SAL110T_N.LOT_ID
                 AND A.HEADER_ID IS NOT NULL
                ORDER BY A.LOT_ID ASC,
                    A.LOT_SEQ ASC;
            EXEC SQL OPEN DBU_CT_SAL110T_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_ct_sal110t", sel_type);
}


