    CQCMISPLOS->LOSS_QTY = 0;
    CQCMISPLOS->HIST_SEQ = 0;
    CQCMISPLOS->MAT_VER = 0;
    CQCMISPLOS->FLOW_SEQ = 0;
}


/* Add Null Function */
void DBU_add_null_cqcmisplos(struct CQCMISPLOS_N_TAG *CQCMISPLOS_N, struct CQCMISPLOS_TAG *CQCMISPLOS)
{
    /* memset by NULL */
    memset(CQCMISPLOS_N, '\0', sizeof(struct CQCMISPLOS_N_TAG));
    
    MEMCPY_AN(CQCMISPLOS_N->FACTORY, CQCMISPLOS->FACTORY, sizeof(CQCMISPLOS->FACTORY));
    MEMCPY_AN(CQCMISPLOS_N->INSP_ID, CQCMISPLOS->INSP_ID, sizeof(CQCMISPLOS->INSP_ID));
    CQCMISPLOS_N->SEQ = CQCMISPLOS->SEQ;
    CQCMISPLOS_N->QTY_FLAG[0] = CQCMISPLOS->QTY_FLAG;
    MEMCPY_AN(CQCMISPLOS_N->LOSS_CODE, CQCMISPLOS->LOSS_CODE, sizeof(CQCMISPLOS->LOSS_CODE));
    CQCMISPLOS_N->LOSS_QTY = CQCMISPLOS->LOSS_QTY;
    MEMCPY_AN(CQCMISPLOS_N->LOT_ID, CQCMISPLOS->LOT_ID, sizeof(CQCMISPLOS->LOT_ID));
    CQCMISPLOS_N->HIST_SEQ = CQCMISPLOS->HIST_SEQ;
    MEMCPY_AN(CQCMISPLOS_N->TRAN_TIME, CQCMISPLOS->TRAN_TIME, sizeof(CQCMISPLOS->TRAN_TIME));
    MEMCPY_AN(CQCMISPLOS_N->MAT_ID, CQCMISPLOS->MAT_ID, sizeof(CQCMISPLOS->MAT_ID));
    CQCMISPLOS_N->MAT_VER = CQCMISPLOS->MAT_VER;
    MEMCPY_AN(CQCMISPLOS_N->FLOW, CQCMISPLOS->FLOW, sizeof(CQCMISPLOS->FLOW));
    CQCMISPLOS_N->FLOW_SEQ = CQCMISPLOS->FLOW_SEQ;
    MEMCPY_AN(CQCMISPLOS_N->OPER, CQCMISPLOS->OPER, sizeof(CQCMISPLOS->OPER));
    MEMCPY_AN(CQCMISPLOS_N->RES_ID, CQCMISPLOS->RES_ID, sizeof(CQCMISPLOS->RES_ID));
    CQCMISPLOS_N->MAIN_FLAG[0] = CQCMISPLOS->MAIN_FLAG;
}


/* Del Null Function */
void DBU_del_null_cqcmisplos(struct CQCMISPLOS_N_TAG *CQCMISPLOS_N, struct CQCMISPLOS_TAG *CQCMISPLOS)
{
    MEMCPY_DN(CQCMISPLOS->FACTORY, CQCMISPLOS_N->FACTORY, sizeof(CQCMISPLOS->FACTORY));
    MEMCPY_DN(CQCMISPLOS->INSP_ID, CQCMISPLOS_N->INSP_ID, sizeof(CQCMISPLOS->INSP_ID));
    CQCMISPLOS->SEQ = CQCMISPLOS_N->SEQ;
    CQCMISPLOS->QTY_FLAG = CQCMISPLOS_N->QTY_FLAG[0];
    MEMCPY_DN(CQCMISPLOS->LOSS_CODE, CQCMISPLOS_N->LOSS_CODE, sizeof(CQCMISPLOS->LOSS_CODE));
    CQCMISPLOS->LOSS_QTY = CQCMISPLOS_N->LOSS_QTY;
    MEMCPY_DN(CQCMISPLOS->LOT_ID, CQCMISPLOS_N->LOT_ID, sizeof(CQCMISPLOS->LOT_ID));
    CQCMISPLOS->HIST_SEQ = CQCMISPLOS_N->HIST_SEQ;
    MEMCPY_DN(CQCMISPLOS->TRAN_TIME, CQCMISPLOS_N->TRAN_TIME, sizeof(CQCMISPLOS->TRAN_TIME));
    MEMCPY_DN(CQCMISPLOS->MAT_ID, CQCMISPLOS_N->MAT_ID, sizeof(CQCMISPLOS->MAT_ID));
    CQCMISPLOS->MAT_VER = CQCMISPLOS_N->MAT_VER;
    MEMCPY_DN(CQCMISPLOS->FLOW, CQCMISPLOS_N->FLOW, sizeof(CQCMISPLOS->FLOW));
    CQCMISPLOS->FLOW_SEQ = CQCMISPLOS_N->FLOW_SEQ;
    MEMCPY_DN(CQCMISPLOS->OPER, CQCMISPLOS_N->OPER, sizeof(CQCMISPLOS->OPER));
    MEMCPY_DN(CQCMISPLOS->RES_ID, CQCMISPLOS_N->RES_ID, sizeof(CQCMISPLOS->RES_ID));
    CQCMISPLOS->MAIN_FLAG = CQCMISPLOS_N->MAIN_FLAG[0];
}


