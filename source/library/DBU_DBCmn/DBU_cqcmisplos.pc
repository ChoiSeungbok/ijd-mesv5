void DBU_open_cqcmisplos(int sel_type, struct CQCMISPLOS_TAG *CQCMISPLOS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CQCMISPLOS_N_TAG CQCMISPLOS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cqcmisplos(&CQCMISPLOS_N, CQCMISPLOS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CQCMISPLOS_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    INSP_ID,
                    SEQ,
                    QTY_FLAG,
                    LOSS_CODE,
                    LOSS_QTY,
                    LOT_ID,
                    HIST_SEQ,
                    TRAN_TIME,
                    MAT_ID,
                    MAT_VER,
                    FLOW,
                    FLOW_SEQ,
                    OPER,
                    RES_ID,
                    MAIN_FLAG
                FROM CQCMISPLOS
                ORDER BY FACTORY ASC,
                    INSP_ID ASC,
                    SEQ ASC,
                    QTY_FLAG ASC;
            EXEC SQL OPEN DBU_CQCMISPLOS_CUR_1;
            break;

		 case 2:
            EXEC SQL DECLARE DBU_CQCMISPLOS_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    INSP_ID,
                    SEQ,
                    QTY_FLAG,
                    LOSS_CODE,
                    LOSS_QTY,
                    LOT_ID,
                    HIST_SEQ,
                    TRAN_TIME,
                    MAT_ID,
                    MAT_VER,
                    FLOW,
                    FLOW_SEQ,
                    OPER,
                    RES_ID,
                    MAIN_FLAG
                FROM CQCMISPLOS
			  WHERE FACTORY = :CQCMISPLOS_N.FACTORY
			       AND INSP_ID = :CQCMISPLOS_N.INSP_ID
				   AND LOSS_CODE <> :CQCMISPLOS_N.LOSS_CODE
				   AND MAIN_FLAG = 'Y'
                ORDER BY SEQ ASC,
                                QTY_FLAG ASC;
            EXEC SQL OPEN DBU_CQCMISPLOS_CUR_2;
            break;

		case 3:
            EXEC SQL DECLARE DBU_CQCMISPLOS_CUR_3 CURSOR FOR
                SELECT 
                    FACTORY,
                    INSP_ID,
                    SEQ,
                    QTY_FLAG,
                    LOSS_CODE,
                    LOSS_QTY,
                    LOT_ID,
                    HIST_SEQ,
                    TRAN_TIME,
                    MAT_ID,
                    MAT_VER,
                    FLOW,
                    FLOW_SEQ,
                    OPER,
                    RES_ID,
                    MAIN_FLAG
                FROM CQCMISPLOS
			  WHERE FACTORY = :CQCMISPLOS_N.FACTORY
			       AND INSP_ID = :CQCMISPLOS_N.INSP_ID
				   AND LOSS_CODE <> :CQCMISPLOS_N.LOSS_CODE
                ORDER BY SEQ ASC,
                                QTY_FLAG ASC;
            EXEC SQL OPEN DBU_CQCMISPLOS_CUR_3;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
