                FROM CT_MTL100T
                ORDER BY ORG_CODE ASC,
                    TRANS_MASTER_SEQ ASC,
                    LOT_ID ASC;
            EXEC SQL OPEN DBU_CT_MTL100T_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_ct_mtl100t", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_ct_mtl100t(int sel_type, struct CT_MTL100T_TAG *CT_MTL100T)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CT_MTL100T_N_TAG CT_MTL100T_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_CT_MTL100T_CUR_1 INTO
                :CT_MTL100T_N.ORG_CODE,
                :CT_MTL100T_N.TRANS_MASTER_SEQ,
                :CT_MTL100T_N.LOT_ID,
                :CT_MTL100T_N.ITEM_CODE,
                :CT_MTL100T_N.CREATE_DATE,
                :CT_MTL100T_N.INSP_TYPE,
                :CT_MTL100T_N.INSP_RESULT,
                :CT_MTL100T_N.INSP_DATE,
                :CT_MTL100T_N.INSP_USER,
                :CT_MTL100T_N.LOT_QTY,
                :CT_MTL100T_N.ACCT_QTY,
                :CT_MTL100T_N.SUCC_QTY,
                :CT_MTL100T_N.BAD_QTY,
                :CT_MTL100T_N.INPUT_QTY,
                :CT_MTL100T_N.OUTPUT_QTY,
                :CT_MTL100T_N.INPUT_DATE,
                :CT_MTL100T_N.SUPPLIER_LOT_ID,
                :CT_MTL100T_N.UP_LOT_ID,
                :CT_MTL100T_N.REMARKS,
                :CT_MTL100T_N.STATUS,
                :CT_MTL100T_N.USE_YN,
                :CT_MTL100T_N.LOT_SHAPE,
                :CT_MTL100T_N.WH_CODE,
                :CT_MTL100T_N.DIRECT_WH_CODE,
                :CT_MTL100T_N.DIRECT_YN,
                :CT_MTL100T_N.INSERT_DATE,
                :CT_MTL100T_N.INSERT_USER,
                :CT_MTL100T_N.UPDATE_DATE,
                :CT_MTL100T_N.UPDATE_USER,
                :CT_MTL100T_N.INTERFACE_YN,
                :CT_MTL100T_N.INPUT_GBN,
                :CT_MTL100T_N.QC_START_DT,
                :CT_MTL100T_N.QC_END_DT;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_ct_mtl100t(&CT_MTL100T_N, CT_MTL100T);
    }

    DB_stop_query_timer("DBU_fetch_ct_mtl100t", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_ct_mtl100t(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CT_MTL100T_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_ct_mtl100t", sel_type);
}


/* Initialize Function */
void DBU_init_ct_mtl100t(struct CT_MTL100T_TAG *CT_MTL100T)
{
    /* memset by Space */
    memset(CT_MTL100T, ' ', sizeof(struct CT_MTL100T_TAG));
    
    CT_MTL100T->LOT_QTY = 0;
    CT_MTL100T->ACCT_QTY = 0;
    CT_MTL100T->SUCC_QTY = 0;
    CT_MTL100T->BAD_QTY = 0;
    CT_MTL100T->INPUT_QTY = 0;
    CT_MTL100T->OUTPUT_QTY = 0;
}


