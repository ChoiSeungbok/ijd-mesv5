								   WHERE FACTORY = :CWIPLOTMVR_N.FACTORY
									 AND LOT_ID = :CWIPLOTMVR_N.LOT_ID
								  )
				  AND MOVE_STATUS = 'O';
		break;

		case 4:
            EXEC SQL SELECT COUNT(*)
                       INTO :d_value
                       FROM CWIPLOTMVR
                      WHERE FACTORY = :CWIPLOTMVR_N.FACTORY
                        AND MOVE_ID IN (SELECT MOVE_ID
                                          FROM CWIPLOTMVM
                                         WHERE FACTORY = :CWIPLOTMVR_N.FACTORY
                                           AND MOVE_STATUS = 'O'
                                        )
                       AND LOT_ID = :CWIPLOTMVR_N.LOT_ID;
