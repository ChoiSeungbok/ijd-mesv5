                    AND MOVE_ID = :CWIPLOTMVR_N.MOVE_ID
                    AND LOT_ID = :CWIPLOTMVR_N.LOT_ID;
            break;

        case 2:
            EXEC SQL SELECT NVL(SUM(QTY),0)
                INTO :d_value
                FROM CWIPLOTMVR
                WHERE FACTORY = :CWIPLOTMVR_N.FACTORY
                    AND MOVE_ID = :CWIPLOTMVR_N.MOVE_ID
                    AND MERGE_FLAG = 'Y';
