/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cwiplotmvr(int sel_type, struct CWIPLOTMVR_TAG *CWIPLOTMVR)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CWIPLOTMVR_N_TAG CWIPLOTMVR_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cwiplotmvr(&CWIPLOTMVR_N, CWIPLOTMVR);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CWIPLOTMVR_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    MOVE_ID,
                    LOT_ID,
                    HIST_SEQ,
                    MERGE_LOT_FLAG,
                    MERGE_FLAG,
                    QTY,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPLOTMVR
                ORDER BY FACTORY ASC,
                    MOVE_ID ASC,
                    LOT_ID ASC;
            EXEC SQL OPEN DBU_CWIPLOTMVR_CUR_1;
            break;

        case 2:
            EXEC SQL DECLARE DBU_CWIPLOTMVR_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    MOVE_ID,
                    LOT_ID,
                    HIST_SEQ,
                    MERGE_LOT_FLAG,
                    MERGE_FLAG,
                    QTY,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPLOTMVR
               WHERE FACTORY = :CWIPLOTMVR_N.FACTORY
                 AND MOVE_ID = :CWIPLOTMVR_N.MOVE_ID
                 AND MERGE_LOT_FLAG != 'Y'
               ORDER BY LOT_ID ASC;
            EXEC SQL OPEN DBU_CWIPLOTMVR_CUR_2;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cwiplotmvr", sel_type);
}


