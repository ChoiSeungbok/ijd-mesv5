/* Initialize Function */
void DBU_init_minvlotmvh(struct MINVLOTMVH_TAG *MINVLOTMVH)
{
    /* memset by Space */
    memset(MINVLOTMVH, ' ', sizeof(struct MINVLOTMVH_TAG));
    
    MINVLOTMVH->HIST_SEQ = 0;
    MINVLOTMVH->MAT_VER = 0;
    MINVLOTMVH->TRAN_QTY = 0;
    MINVLOTMVH->TRAN_QTY_2 = 0;
    MINVLOTMVH->TRAN_QTY_3 = 0;
}


/* Add Null Function */
void DBU_add_null_minvlotmvh(struct MINVLOTMVH_N_TAG *MINVLOTMVH_N, struct MINVLOTMVH_TAG *MINVLOTMVH)
{
    /* memset by NULL */
    memset(MINVLOTMVH_N, '\0', sizeof(struct MINVLOTMVH_N_TAG));
    
    MEMCPY_AN(MINVLOTMVH_N->FACTORY, MINVLOTMVH->FACTORY, sizeof(MINVLOTMVH->FACTORY));
    MEMCPY_AN(MINVLOTMVH_N->INV_LOT_ID, MINVLOTMVH->INV_LOT_ID, sizeof(MINVLOTMVH->INV_LOT_ID));
    MINVLOTMVH_N->HIST_SEQ = MINVLOTMVH->HIST_SEQ;
    MEMCPY_AN(MINVLOTMVH_N->TRAN_CODE, MINVLOTMVH->TRAN_CODE, sizeof(MINVLOTMVH->TRAN_CODE));
    MEMCPY_AN(MINVLOTMVH_N->TRAN_USER_ID, MINVLOTMVH->TRAN_USER_ID, sizeof(MINVLOTMVH->TRAN_USER_ID));
    MEMCPY_AN(MINVLOTMVH_N->TRAN_TIME, MINVLOTMVH->TRAN_TIME, sizeof(MINVLOTMVH->TRAN_TIME));
    MEMCPY_AN(MINVLOTMVH_N->MAT_ID, MINVLOTMVH->MAT_ID, sizeof(MINVLOTMVH->MAT_ID));
    MINVLOTMVH_N->MAT_VER = MINVLOTMVH->MAT_VER;
    MEMCPY_AN(MINVLOTMVH_N->AREA_ID, MINVLOTMVH->AREA_ID, sizeof(MINVLOTMVH->AREA_ID));
    MEMCPY_AN(MINVLOTMVH_N->SUB_AREA_ID, MINVLOTMVH->SUB_AREA_ID, sizeof(MINVLOTMVH->SUB_AREA_ID));
    MEMCPY_AN(MINVLOTMVH_N->OPER, MINVLOTMVH->OPER, sizeof(MINVLOTMVH->OPER));
    MEMCPY_AN(MINVLOTMVH_N->TO_AREA_ID, MINVLOTMVH->TO_AREA_ID, sizeof(MINVLOTMVH->TO_AREA_ID));
    MEMCPY_AN(MINVLOTMVH_N->TO_SUB_AREA_ID, MINVLOTMVH->TO_SUB_AREA_ID, sizeof(MINVLOTMVH->TO_SUB_AREA_ID));
    MEMCPY_AN(MINVLOTMVH_N->TO_OPER, MINVLOTMVH->TO_OPER, sizeof(MINVLOTMVH->TO_OPER));
    MINVLOTMVH_N->TRAN_QTY = MINVLOTMVH->TRAN_QTY;
    MINVLOTMVH_N->TRAN_QTY_2 = MINVLOTMVH->TRAN_QTY_2;
    MINVLOTMVH_N->TRAN_QTY_3 = MINVLOTMVH->TRAN_QTY_3;
    MINVLOTMVH_N->HIST_DEL_FLAG[0] = MINVLOTMVH->HIST_DEL_FLAG;
}


/* Del Null Function */
void DBU_del_null_minvlotmvh(struct MINVLOTMVH_N_TAG *MINVLOTMVH_N, struct MINVLOTMVH_TAG *MINVLOTMVH)
{
    MEMCPY_DN(MINVLOTMVH->FACTORY, MINVLOTMVH_N->FACTORY, sizeof(MINVLOTMVH->FACTORY));
    MEMCPY_DN(MINVLOTMVH->INV_LOT_ID, MINVLOTMVH_N->INV_LOT_ID, sizeof(MINVLOTMVH->INV_LOT_ID));
