/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_minvlotmvh(int sel_type, struct MINVLOTMVH_TAG *MINVLOTMVH)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVLOTMVH_N_TAG MINVLOTMVH_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_minvlotmvh(&MINVLOTMVH_N, MINVLOTMVH);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_MINVLOTMVH_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    INV_LOT_ID,
                    HIST_SEQ,
                    TRAN_CODE,
                    TRAN_USER_ID,
                    TRAN_TIME,
                    MAT_ID,
                    MAT_VER,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    TO_AREA_ID,
                    TO_SUB_AREA_ID,
                    TO_OPER,
                    TRAN_QTY,
                    TRAN_QTY_2,
                    TRAN_QTY_3,
                    HIST_DEL_FLAG
                FROM MINVLOTMVH
                ORDER BY FACTORY ASC,
                    INV_LOT_ID ASC,
                    HIST_SEQ ASC;
            EXEC SQL OPEN DBU_MINVLOTMVH_CUR_1;
            break;
        
        case 2:
            EXEC SQL DECLARE DBU_MINVLOTMVH_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    INV_LOT_ID,
                    HIST_SEQ,
                    TRAN_CODE,
                    TRAN_USER_ID,
                    TRAN_TIME,
                    MAT_ID,
                    MAT_VER,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    TO_AREA_ID,
                    TO_SUB_AREA_ID,
                    TO_OPER,
                    TRAN_QTY,
                    TRAN_QTY_2,
                    TRAN_QTY_3,
                    HIST_DEL_FLAG
                FROM MINVLOTMVH
                    WHERE FACTORY = :MINVLOTMVH_N.FACTORY
                    AND AREA_ID = :MINVLOTMVH_N.AREA_ID
                    AND ((:MINVLOTMVH_N.OPER = ' ') OR (OPER = :MINVLOTMVH_N.OPER))
                    AND ((:MINVLOTMVH_N.MAT_ID = ' ') OR (MAT_ID = :MINVLOTMVH_N.MAT_ID))
                    AND ((:MINVLOTMVH_N.TO_OPER = ' ') OR (TO_OPER = :MINVLOTMVH_N.TO_OPER)) 
                    AND ((:MINVLOTMVH_N.INV_LOT_ID = ' ') OR (INV_LOT_ID = :MINVLOTMVH_N.INV_LOT_ID)) 
					AND TRAN_TIME BETWEEN :DBC_Q_COND_N.FROM_TIME  AND :DBC_Q_COND_N.TO_TIME
                ORDER BY TRAN_TIME DESC,
                    HIST_SEQ DESC,
                    INV_LOT_ID ASC;
            EXEC SQL OPEN DBU_MINVLOTMVH_CUR_2;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_minvlotmvh", sel_type);
}


