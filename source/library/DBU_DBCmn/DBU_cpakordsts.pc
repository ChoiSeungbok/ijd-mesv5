/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cpakordsts(int sel_type, struct CPAKORDSTS_TAG *CPAKORDSTS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CPAKORDSTS_N_TAG CPAKORDSTS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cpakordsts(&CPAKORDSTS_N, CPAKORDSTS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CPAKORDSTS_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    PACK_ORDER_ID,
                    LINE_NO,
                    PACK_ORD_DATE,
                    MAT_ID,
                    MAT_VER,
                    CUSTOMER_ID,
					CUSTOMER_SITE_ID,
