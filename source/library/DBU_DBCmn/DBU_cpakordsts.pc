	MEMCPY_DN(CPAKORDSTS->SCHEDULE_SHIP_DATE, CPAKORDSTS_N->SCHEDULE_SHIP_DATE, sizeof(CPAKORDSTS->SCHEDULE_SHIP_DATE));
