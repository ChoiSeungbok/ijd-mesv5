				:CPAKORDSTS_N.PACKED_QTY,
                :CPAKORDSTS_N.UNIT,
                :CPAKORDSTS_N.PACK_ORD_STATUS,
                :CPAKORDSTS_N.PACK_DATE,
				:CPAKORDSTS_N.LABEL_NAME,
				:CPAKORDSTS_N.LABEL_TYPE,
				:CPAKORDSTS_N.LABEL_MESH,
				:CPAKORDSTS_N.PACKING_INSTRUCTIONS,
				:CPAKORDSTS_N.DRAWING_FLAG,
				:CPAKORDSTS_N.ORDER_TYPE,
				:CPAKORDSTS_N.REQUEST_DATE,
				:CPAKORDSTS_N.SCHEDULE_SHIP_DATE,
                :CPAKORDSTS_N.EXPECT_SHIP_DATE,
				:CPAKORDSTS_N.PO_GUBUN,
				:CPAKORDSTS_N.LINE_DESC,
				:CPAKORDSTS_N.INCLUDE_INSPECTION,
                :CPAKORDSTS_N.CMF_1,
                :CPAKORDSTS_N.CMF_2,
                :CPAKORDSTS_N.CMF_3,
                :CPAKORDSTS_N.CMF_4,
                :CPAKORDSTS_N.CMF_5,
                :CPAKORDSTS_N.CMF_6,
                :CPAKORDSTS_N.CMF_7,
                :CPAKORDSTS_N.CMF_8,
                :CPAKORDSTS_N.CMF_9,
                :CPAKORDSTS_N.CMF_10,
                :CPAKORDSTS_N.PACK_COMMENT,
                :CPAKORDSTS_N.CREATE_USER_ID,
                :CPAKORDSTS_N.CREATE_TIME,
                :CPAKORDSTS_N.UPDATE_USER_ID,
                :CPAKORDSTS_N.UPDATE_TIME;
            break;
      
        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_cpakordsts(&CPAKORDSTS_N, CPAKORDSTS);
    }

    DB_stop_query_timer("DBU_fetch_cpakordsts", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_cpakordsts(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CPAKORDSTS_CUR_1;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_cpakordsts", sel_type);
}


/* Initialize Function */
void DBU_init_cpakordsts(struct CPAKORDSTS_TAG *CPAKORDSTS)
{
    /* memset by Space */
    memset(CPAKORDSTS, ' ', sizeof(struct CPAKORDSTS_TAG));
    
    CPAKORDSTS->LINE_NO = 0;
    CPAKORDSTS->MAT_VER = 0;
    CPAKORDSTS->QTY = 0;
	CPAKORDSTS->REG_QTY = 0;
	CPAKORDSTS->PACKED_QTY = 0;
	CPAKORDSTS->CUSTOMER_SITE_ID = 0;
}


/* Add Null Function */
void DBU_add_null_cpakordsts(struct CPAKORDSTS_N_TAG *CPAKORDSTS_N, struct CPAKORDSTS_TAG *CPAKORDSTS)
{
    /* memset by NULL */
    memset(CPAKORDSTS_N, '\0', sizeof(struct CPAKORDSTS_N_TAG));
    
    MEMCPY_AN(CPAKORDSTS_N->FACTORY, CPAKORDSTS->FACTORY, sizeof(CPAKORDSTS->FACTORY));
    MEMCPY_AN(CPAKORDSTS_N->PACK_ORDER_ID, CPAKORDSTS->PACK_ORDER_ID, sizeof(CPAKORDSTS->PACK_ORDER_ID));
    CPAKORDSTS_N->LINE_NO = CPAKORDSTS->LINE_NO;
    MEMCPY_AN(CPAKORDSTS_N->PACK_ORD_DATE, CPAKORDSTS->PACK_ORD_DATE, sizeof(CPAKORDSTS->PACK_ORD_DATE));
    MEMCPY_AN(CPAKORDSTS_N->MAT_ID, CPAKORDSTS->MAT_ID, sizeof(CPAKORDSTS->MAT_ID));
    CPAKORDSTS_N->MAT_VER = CPAKORDSTS->MAT_VER;
    MEMCPY_AN(CPAKORDSTS_N->CUSTOMER_ID, CPAKORDSTS->CUSTOMER_ID, sizeof(CPAKORDSTS->CUSTOMER_ID));
	CPAKORDSTS_N->CUSTOMER_SITE_ID = CPAKORDSTS->CUSTOMER_SITE_ID;
    MEMCPY_AN(CPAKORDSTS_N->DELIVERY_ID, CPAKORDSTS->DELIVERY_ID, sizeof(CPAKORDSTS->DELIVERY_ID));
	MEMCPY_AN(CPAKORDSTS_N->DELIVERY_NAME, CPAKORDSTS->DELIVERY_NAME, sizeof(CPAKORDSTS->DELIVERY_NAME));
