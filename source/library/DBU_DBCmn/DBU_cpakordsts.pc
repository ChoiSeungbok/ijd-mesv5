                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    QTY,
					REG_QTY,
					PACKED_QTY,
                    UNIT,
                    PACK_ORD_STATUS,
                    PACK_DATE,
					LABEL_NAME,
					LABEL_TYPE,
					LABEL_MESH,
					PACKING_INSTRUCTIONS,
					DRAWING_FLAG,
					ORDER_TYPE,
					REQUEST_DATE,
					SCHEDULE_SHIP_DATE,
                    EXPECT_SHIP_DATE,
					PO_GUBUN,
					LINE_DESC,
					INCLUDE_INSPECTION,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    PACK_COMMENT,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CPAKORDSTS
                ORDER BY FACTORY ASC,
                    PACK_ORDER_ID ASC,
                    LINE_NO ASC;
            EXEC SQL OPEN DBU_CPAKORDSTS_CUR_1;
            break;
       
        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cpakordsts", sel_type);
}


