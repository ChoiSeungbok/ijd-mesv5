	MEMCPY_AN(CPAKORDSTS_N->DRAWING_FLAG, CPAKORDSTS->DRAWING_FLAG, sizeof(CPAKORDSTS->DRAWING_FLAG));
	MEMCPY_AN(CPAKORDSTS_N->ORDER_TYPE, CPAKORDSTS->ORDER_TYPE, sizeof(CPAKORDSTS->ORDER_TYPE));
	MEMCPY_AN(CPAKORDSTS_N->REQUEST_DATE, CPAKORDSTS->REQUEST_DATE, sizeof(CPAKORDSTS->REQUEST_DATE));
	MEMCPY_AN(CPAKORDSTS_N->SCHEDULE_SHIP_DATE, CPAKORDSTS->SCHEDULE_SHIP_DATE, sizeof(CPAKORDSTS->SCHEDULE_SHIP_DATE));
    MEMCPY_AN(CPAKORDSTS_N->EXPECT_SHIP_DATE, CPAKORDSTS->EXPECT_SHIP_DATE, sizeof(CPAKORDSTS->EXPECT_SHIP_DATE));
	MEMCPY_AN(CPAKORDSTS_N->PO_GUBUN, CPAKORDSTS->PO_GUBUN, sizeof(CPAKORDSTS->PO_GUBUN));
	MEMCPY_AN(CPAKORDSTS_N->LINE_DESC, CPAKORDSTS->LINE_DESC, sizeof(CPAKORDSTS->LINE_DESC));
	MEMCPY_AN(CPAKORDSTS_N->INCLUDE_INSPECTION, CPAKORDSTS->INCLUDE_INSPECTION, sizeof(CPAKORDSTS->INCLUDE_INSPECTION));
    MEMCPY_AN(CPAKORDSTS_N->CMF_1, CPAKORDSTS->CMF_1, sizeof(CPAKORDSTS->CMF_1));
