    MEMCPY_AN(CPAKORDSTS_N->SUB_AREA_ID, CPAKORDSTS->SUB_AREA_ID, sizeof(CPAKORDSTS->SUB_AREA_ID));
    MEMCPY_AN(CPAKORDSTS_N->OPER, CPAKORDSTS->OPER, sizeof(CPAKORDSTS->OPER));
    CPAKORDSTS_N->QTY = CPAKORDSTS->QTY;
	CPAKORDSTS_N->REG_QTY = CPAKORDSTS->REG_QTY;
	CPAKORDSTS_N->PACKED_QTY = CPAKORDSTS->PACKED_QTY;
    MEMCPY_AN(CPAKORDSTS_N->UNIT, CPAKORDSTS->UNIT, sizeof(CPAKORDSTS->UNIT));
    MEMCPY_AN(CPAKORDSTS_N->PACK_ORD_STATUS, CPAKORDSTS->PACK_ORD_STATUS, sizeof(CPAKORDSTS->PACK_ORD_STATUS));
    MEMCPY_AN(CPAKORDSTS_N->PACK_DATE, CPAKORDSTS->PACK_DATE, sizeof(CPAKORDSTS->PACK_DATE));
	MEMCPY_AN(CPAKORDSTS_N->LABEL_NAME, CPAKORDSTS->LABEL_NAME, sizeof(CPAKORDSTS->LABEL_NAME));
