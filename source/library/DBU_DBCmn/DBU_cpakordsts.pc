/* Del Null Function */
void DBU_del_null_cpakordsts(struct CPAKORDSTS_N_TAG *CPAKORDSTS_N, struct CPAKORDSTS_TAG *CPAKORDSTS)
{
    MEMCPY_DN(CPAKORDSTS->FACTORY, CPAKORDSTS_N->FACTORY, sizeof(CPAKORDSTS->FACTORY));
    MEMCPY_DN(CPAKORDSTS->PACK_ORDER_ID, CPAKORDSTS_N->PACK_ORDER_ID, sizeof(CPAKORDSTS->PACK_ORDER_ID));
    CPAKORDSTS->LINE_NO = CPAKORDSTS_N->LINE_NO;
