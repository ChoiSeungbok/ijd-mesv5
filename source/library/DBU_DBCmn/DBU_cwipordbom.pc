                :CWIPORDBOM_N.QTY,
                :CWIPORDBOM_N.UNIT,
                :CWIPORDBOM_N.UNIT_QTY,
                :CWIPORDBOM_N.OUT_OPER,
                :CWIPORDBOM_N.CMF_1,
                :CWIPORDBOM_N.CMF_2,
                :CWIPORDBOM_N.CMF_3,
                :CWIPORDBOM_N.CMF_4,
                :CWIPORDBOM_N.CMF_5,
                :CWIPORDBOM_N.CMF_6,
                :CWIPORDBOM_N.CMF_7,
                :CWIPORDBOM_N.CMF_8,
                :CWIPORDBOM_N.CMF_9,
                :CWIPORDBOM_N.CMF_10,
                :CWIPORDBOM_N.CREATE_USER_ID,
                :CWIPORDBOM_N.CREATE_TIME,
                :CWIPORDBOM_N.UPDATE_USER_ID,
                :CWIPORDBOM_N.UPDATE_TIME;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_cwipordbom(&CWIPORDBOM_N, CWIPORDBOM);
    }

    DB_stop_query_timer("DBU_fetch_cwipordbom", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_cwipordbom(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CWIPORDBOM_CUR_1;
            break;

        case 2:
            EXEC SQL CLOSE DBU_CWIPORDBOM_CUR_2;
            break;

        case 3:
            EXEC SQL CLOSE DBU_CWIPORDBOM_CUR_2;
            break;

		case 4:
            EXEC SQL CLOSE DBU_CWIPORDBOM_CUR_4;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_cwipordbom", sel_type);
}


/* Initialize Function */
void DBU_init_cwipordbom(struct CWIPORDBOM_TAG *CWIPORDBOM)
{
    /* memset by Space */
    memset(CWIPORDBOM, ' ', sizeof(struct CWIPORDBOM_TAG));
    
    CWIPORDBOM->MAT_VER = 0;
    CWIPORDBOM->QTY = 0;
    CWIPORDBOM->UNIT_QTY = 0;
}


/* Add Null Function */
void DBU_add_null_cwipordbom(struct CWIPORDBOM_N_TAG *CWIPORDBOM_N, struct CWIPORDBOM_TAG *CWIPORDBOM)
{
    /* memset by NULL */
    memset(CWIPORDBOM_N, '\0', sizeof(struct CWIPORDBOM_N_TAG));
    
    MEMCPY_AN(CWIPORDBOM_N->FACTORY, CWIPORDBOM->FACTORY, sizeof(CWIPORDBOM->FACTORY));
    MEMCPY_AN(CWIPORDBOM_N->ORDER_ID, CWIPORDBOM->ORDER_ID, sizeof(CWIPORDBOM->ORDER_ID));
    MEMCPY_AN(CWIPORDBOM_N->FLOW, CWIPORDBOM->FLOW, sizeof(CWIPORDBOM->FLOW));
    MEMCPY_AN(CWIPORDBOM_N->OPER, CWIPORDBOM->OPER, sizeof(CWIPORDBOM->OPER));
    MEMCPY_AN(CWIPORDBOM_N->MAT_ID, CWIPORDBOM->MAT_ID, sizeof(CWIPORDBOM->MAT_ID));
    CWIPORDBOM_N->MAT_VER = CWIPORDBOM->MAT_VER;
    CWIPORDBOM_N->QTY = CWIPORDBOM->QTY;
    MEMCPY_AN(CWIPORDBOM_N->UNIT, CWIPORDBOM->UNIT, sizeof(CWIPORDBOM->UNIT));
    CWIPORDBOM_N->UNIT_QTY = CWIPORDBOM->UNIT_QTY;
    MEMCPY_AN(CWIPORDBOM_N->OUT_OPER, CWIPORDBOM->OUT_OPER, sizeof(CWIPORDBOM->OUT_OPER));
    MEMCPY_AN(CWIPORDBOM_N->CMF_1, CWIPORDBOM->CMF_1, sizeof(CWIPORDBOM->CMF_1));
    MEMCPY_AN(CWIPORDBOM_N->CMF_2, CWIPORDBOM->CMF_2, sizeof(CWIPORDBOM->CMF_2));
    MEMCPY_AN(CWIPORDBOM_N->CMF_3, CWIPORDBOM->CMF_3, sizeof(CWIPORDBOM->CMF_3));
    MEMCPY_AN(CWIPORDBOM_N->CMF_4, CWIPORDBOM->CMF_4, sizeof(CWIPORDBOM->CMF_4));
    MEMCPY_AN(CWIPORDBOM_N->CMF_5, CWIPORDBOM->CMF_5, sizeof(CWIPORDBOM->CMF_5));
    MEMCPY_AN(CWIPORDBOM_N->CMF_6, CWIPORDBOM->CMF_6, sizeof(CWIPORDBOM->CMF_6));
    MEMCPY_AN(CWIPORDBOM_N->CMF_7, CWIPORDBOM->CMF_7, sizeof(CWIPORDBOM->CMF_7));
    MEMCPY_AN(CWIPORDBOM_N->CMF_8, CWIPORDBOM->CMF_8, sizeof(CWIPORDBOM->CMF_8));
    MEMCPY_AN(CWIPORDBOM_N->CMF_9, CWIPORDBOM->CMF_9, sizeof(CWIPORDBOM->CMF_9));
    MEMCPY_AN(CWIPORDBOM_N->CMF_10, CWIPORDBOM->CMF_10, sizeof(CWIPORDBOM->CMF_10));
    MEMCPY_AN(CWIPORDBOM_N->CREATE_USER_ID, CWIPORDBOM->CREATE_USER_ID, sizeof(CWIPORDBOM->CREATE_USER_ID));
    MEMCPY_AN(CWIPORDBOM_N->CREATE_TIME, CWIPORDBOM->CREATE_TIME, sizeof(CWIPORDBOM->CREATE_TIME));
    MEMCPY_AN(CWIPORDBOM_N->UPDATE_USER_ID, CWIPORDBOM->UPDATE_USER_ID, sizeof(CWIPORDBOM->UPDATE_USER_ID));
    MEMCPY_AN(CWIPORDBOM_N->UPDATE_TIME, CWIPORDBOM->UPDATE_TIME, sizeof(CWIPORDBOM->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_cwipordbom(struct CWIPORDBOM_N_TAG *CWIPORDBOM_N, struct CWIPORDBOM_TAG *CWIPORDBOM)
{
    MEMCPY_DN(CWIPORDBOM->FACTORY, CWIPORDBOM_N->FACTORY, sizeof(CWIPORDBOM->FACTORY));
    MEMCPY_DN(CWIPORDBOM->ORDER_ID, CWIPORDBOM_N->ORDER_ID, sizeof(CWIPORDBOM->ORDER_ID));
    MEMCPY_DN(CWIPORDBOM->FLOW, CWIPORDBOM_N->FLOW, sizeof(CWIPORDBOM->FLOW));
    MEMCPY_DN(CWIPORDBOM->OPER, CWIPORDBOM_N->OPER, sizeof(CWIPORDBOM->OPER));
    MEMCPY_DN(CWIPORDBOM->MAT_ID, CWIPORDBOM_N->MAT_ID, sizeof(CWIPORDBOM->MAT_ID));
    CWIPORDBOM->MAT_VER = CWIPORDBOM_N->MAT_VER;
    CWIPORDBOM->QTY = CWIPORDBOM_N->QTY;
    MEMCPY_DN(CWIPORDBOM->UNIT, CWIPORDBOM_N->UNIT, sizeof(CWIPORDBOM->UNIT));
    CWIPORDBOM->UNIT_QTY = CWIPORDBOM_N->UNIT_QTY;
    MEMCPY_DN(CWIPORDBOM->OUT_OPER, CWIPORDBOM_N->OUT_OPER, sizeof(CWIPORDBOM->OUT_OPER));
    MEMCPY_DN(CWIPORDBOM->CMF_1, CWIPORDBOM_N->CMF_1, sizeof(CWIPORDBOM->CMF_1));
    MEMCPY_DN(CWIPORDBOM->CMF_2, CWIPORDBOM_N->CMF_2, sizeof(CWIPORDBOM->CMF_2));
    MEMCPY_DN(CWIPORDBOM->CMF_3, CWIPORDBOM_N->CMF_3, sizeof(CWIPORDBOM->CMF_3));
    MEMCPY_DN(CWIPORDBOM->CMF_4, CWIPORDBOM_N->CMF_4, sizeof(CWIPORDBOM->CMF_4));
    MEMCPY_DN(CWIPORDBOM->CMF_5, CWIPORDBOM_N->CMF_5, sizeof(CWIPORDBOM->CMF_5));
    MEMCPY_DN(CWIPORDBOM->CMF_6, CWIPORDBOM_N->CMF_6, sizeof(CWIPORDBOM->CMF_6));
    MEMCPY_DN(CWIPORDBOM->CMF_7, CWIPORDBOM_N->CMF_7, sizeof(CWIPORDBOM->CMF_7));
    MEMCPY_DN(CWIPORDBOM->CMF_8, CWIPORDBOM_N->CMF_8, sizeof(CWIPORDBOM->CMF_8));
    MEMCPY_DN(CWIPORDBOM->CMF_9, CWIPORDBOM_N->CMF_9, sizeof(CWIPORDBOM->CMF_9));
