    MEMCPY_DN(CWIPORDBOM->UPDATE_USER_ID, CWIPORDBOM_N->UPDATE_USER_ID, sizeof(CWIPORDBOM->UPDATE_USER_ID));
    MEMCPY_DN(CWIPORDBOM->UPDATE_TIME, CWIPORDBOM_N->UPDATE_TIME, sizeof(CWIPORDBOM->UPDATE_TIME));
}


