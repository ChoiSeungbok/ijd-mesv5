/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cwipgrplot(int sel_type, struct CWIPGRPLOT_TAG *CWIPGRPLOT)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CWIPGRPLOT_N_TAG CWIPGRPLOT_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cwipgrplot(&CWIPGRPLOT_N, CWIPGRPLOT);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CWIPGRPLOT_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    GROUP_ID,
                    LOT_ID,
                    MAPPING_SEQ,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPGRPLOT
                ORDER BY FACTORY ASC,
                    GROUP_ID ASC,
                    LOT_ID ASC;
            EXEC SQL OPEN DBU_CWIPGRPLOT_CUR_1;
            break;

        case 2:
            EXEC SQL DECLARE DBU_CWIPGRPLOT_CUR_2 CURSOR FOR
                SELECT 
                    A.FACTORY,
                    A.GROUP_ID,
                    A.LOT_ID,
                    A.MAPPING_SEQ,
                    A.AREA_ID,
                    A.SUB_AREA_ID,
                    A.OPER,
                    A.CREATE_USER_ID,
                    A.CREATE_TIME,
                    A.UPDATE_USER_ID,
                    A.UPDATE_TIME
                FROM CWIPGRPLOT A , CWIPGRPLOT B
               WHERE A.FACTORY = B.FACTORY
                 AND A.GROUP_ID = B.LOT_ID
                 AND A.FACTORY = (CASE WHEN :CWIPGRPLOT_N.FACTORY = 'IJDK1'THEN 'IJDK1' ELSE '' END)                 
                 AND B.GROUP_ID = :CWIPGRPLOT_N.GROUP_ID
			  UNION ALL
               SELECT  DISTINCT
                    A.FACTORY,
                    A.GROUP_ID,
                    A.LOT_ID,
                    A.MAPPING_SEQ,
                    A.AREA_ID,
                    A.SUB_AREA_ID,
                    A.OPER,
                    A.CREATE_USER_ID,
                    A.CREATE_TIME,
                    A.UPDATE_USER_ID,
                    A.UPDATE_TIME
                FROM CWIPGRPLOT A , CWIPGRPLOT B
               WHERE A.FACTORY = B.FACTORY
                 AND A.GROUP_ID = B.LOT_ID
                 AND A.FACTORY = (CASE WHEN :CWIPGRPLOT_N.FACTORY = 'IJDV1'THEN 'IJDV1' ELSE '' END)              
                 AND B.GROUP_ID = :CWIPGRPLOT_N.GROUP_ID
                 UNION ALL
                SELECT DISTINCT 
                    A.FACTORY,
                    A.GROUP_ID,
                    A.LOT_ID,
                    A.MAPPING_SEQ,
                    A.AREA_ID,
                    A.SUB_AREA_ID,
                    A.OPER,
                    A.CREATE_USER_ID,
                    A.CREATE_TIME,
                    A.UPDATE_USER_ID,
                    A.UPDATE_TIME
                FROM CWIPGRPLOT A ,CWIPGRPSTS B
               WHERE A.FACTORY = B.FACTORY(+)
                 AND A.LOT_ID = B.GROUP_ID(+)
                 AND A.FACTORY = (CASE WHEN :CWIPGRPLOT_N.FACTORY = 'IJDV1'THEN 'IJDV1' ELSE '' END)   
                 AND NVL(B.GROUP_TYPE,'CELL') <> 'D12'
                 AND A.GROUP_ID = :CWIPGRPLOT_N.GROUP_ID
			  ORDER BY 3;
            EXEC SQL OPEN DBU_CWIPGRPLOT_CUR_2;
            break;

        case 3:
            EXEC SQL DECLARE DBU_CWIPGRPLOT_CUR_3 CURSOR FOR
                SELECT 
                    FACTORY,
                    GROUP_ID,
                    LOT_ID,
                    MAPPING_SEQ,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPGRPLOT
              WHERE FACTORY = :CWIPGRPLOT_N.FACTORY
                AND GROUP_ID = :CWIPGRPLOT_N.GROUP_ID
              ORDER BY MAPPING_SEQ;
            EXEC SQL OPEN DBU_CWIPGRPLOT_CUR_3;
            break;

        case 4:
            EXEC SQL DECLARE DBU_CWIPGRPLOT_CUR_4 CURSOR FOR
                SELECT FACTORY, LOT_ID
                  FROM CWIPGRPLOT
                 WHERE (FACTORY, GROUP_ID) IN (
                                               SELECT FACTORY, LOT_ID
                                                 FROM CWIPGRPLOT
                                                WHERE FACTORY = :CWIPGRPLOT_N.FACTORY
                                                  AND GROUP_ID = :CWIPGRPLOT_N.GROUP_ID
                                              )
                UNION ALL
                SELECT FACTORY, LOT_ID
                  FROM MWIPLOTSTS
                 WHERE LOT_ID = :CWIPGRPLOT_N.GROUP_ID;

                EXEC SQL OPEN DBU_CWIPGRPLOT_CUR_4;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cwipgrplot", sel_type);
}


