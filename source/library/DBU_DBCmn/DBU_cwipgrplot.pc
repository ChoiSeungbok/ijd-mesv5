}


/* Add Null Function */
void DBU_add_null_cwipgrplot(struct CWIPGRPLOT_N_TAG *CWIPGRPLOT_N, struct CWIPGRPLOT_TAG *CWIPGRPLOT)
{
    /* memset by NULL */
    memset(CWIPGRPLOT_N, '\0', sizeof(struct CWIPGRPLOT_N_TAG));
    
    MEMCPY_AN(CWIPGRPLOT_N->FACTORY, CWIPGRPLOT->FACTORY, sizeof(CWIPGRPLOT->FACTORY));
    MEMCPY_AN(CWIPGRPLOT_N->GROUP_ID, CWIPGRPLOT->GROUP_ID, sizeof(CWIPGRPLOT->GROUP_ID));
    MEMCPY_AN(CWIPGRPLOT_N->LOT_ID, CWIPGRPLOT->LOT_ID, sizeof(CWIPGRPLOT->LOT_ID));
    CWIPGRPLOT_N->MAPPING_SEQ = CWIPGRPLOT->MAPPING_SEQ;
    MEMCPY_AN(CWIPGRPLOT_N->AREA_ID, CWIPGRPLOT->AREA_ID, sizeof(CWIPGRPLOT->AREA_ID));
    MEMCPY_AN(CWIPGRPLOT_N->SUB_AREA_ID, CWIPGRPLOT->SUB_AREA_ID, sizeof(CWIPGRPLOT->SUB_AREA_ID));
    MEMCPY_AN(CWIPGRPLOT_N->OPER, CWIPGRPLOT->OPER, sizeof(CWIPGRPLOT->OPER));
    MEMCPY_AN(CWIPGRPLOT_N->CREATE_USER_ID, CWIPGRPLOT->CREATE_USER_ID, sizeof(CWIPGRPLOT->CREATE_USER_ID));
    MEMCPY_AN(CWIPGRPLOT_N->CREATE_TIME, CWIPGRPLOT->CREATE_TIME, sizeof(CWIPGRPLOT->CREATE_TIME));
    MEMCPY_AN(CWIPGRPLOT_N->UPDATE_USER_ID, CWIPGRPLOT->UPDATE_USER_ID, sizeof(CWIPGRPLOT->UPDATE_USER_ID));
    MEMCPY_AN(CWIPGRPLOT_N->UPDATE_TIME, CWIPGRPLOT->UPDATE_TIME, sizeof(CWIPGRPLOT->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_cwipgrplot(struct CWIPGRPLOT_N_TAG *CWIPGRPLOT_N, struct CWIPGRPLOT_TAG *CWIPGRPLOT)
{
    MEMCPY_DN(CWIPGRPLOT->FACTORY, CWIPGRPLOT_N->FACTORY, sizeof(CWIPGRPLOT->FACTORY));
    MEMCPY_DN(CWIPGRPLOT->GROUP_ID, CWIPGRPLOT_N->GROUP_ID, sizeof(CWIPGRPLOT->GROUP_ID));
    MEMCPY_DN(CWIPGRPLOT->LOT_ID, CWIPGRPLOT_N->LOT_ID, sizeof(CWIPGRPLOT->LOT_ID));
    CWIPGRPLOT->MAPPING_SEQ = CWIPGRPLOT_N->MAPPING_SEQ;
    MEMCPY_DN(CWIPGRPLOT->AREA_ID, CWIPGRPLOT_N->AREA_ID, sizeof(CWIPGRPLOT->AREA_ID));
    MEMCPY_DN(CWIPGRPLOT->SUB_AREA_ID, CWIPGRPLOT_N->SUB_AREA_ID, sizeof(CWIPGRPLOT->SUB_AREA_ID));
    MEMCPY_DN(CWIPGRPLOT->OPER, CWIPGRPLOT_N->OPER, sizeof(CWIPGRPLOT->OPER));
    MEMCPY_DN(CWIPGRPLOT->CREATE_USER_ID, CWIPGRPLOT_N->CREATE_USER_ID, sizeof(CWIPGRPLOT->CREATE_USER_ID));
    MEMCPY_DN(CWIPGRPLOT->CREATE_TIME, CWIPGRPLOT_N->CREATE_TIME, sizeof(CWIPGRPLOT->CREATE_TIME));
    MEMCPY_DN(CWIPGRPLOT->UPDATE_USER_ID, CWIPGRPLOT_N->UPDATE_USER_ID, sizeof(CWIPGRPLOT->UPDATE_USER_ID));
    MEMCPY_DN(CWIPGRPLOT->UPDATE_TIME, CWIPGRPLOT_N->UPDATE_TIME, sizeof(CWIPGRPLOT->UPDATE_TIME));
}


