                    LINE_LOCATION_ID,
                    PO_DISTRIBUTION_ID,
                    PO_NUM,
                    REVISION_NUM,
                    LINE_NUM,
                    RELEASE_NUM,
                    SHIPMENT_NUM,
                    INVENTORY_ITEM_ID,
                    ITEM_CODE,
                    ITEM_DESC,
                    ITEM_UNIT,
                    PO_UNIT,
                    PO_DATE,
                    NEED_BY_DATE,
                    ORDER_QTY,
                    DELIVERY_QTY,
                    REMAIN_QTY,
                    QTY_RCV_TOLERANCE,
                    INSPECT_FLAG,
                    PLLA_CANCEL_FLAG,
                    PLA_CANCEL_FLAG,
                    PHA_CANCEL_FLAG,
                    PO_TYPE,
                    WIP_ENTITY_ID,
                    WIP_ENTITY_NAME,
                    OPER_SEQ,
                    STD_OPER_ID,
                    OPER,
                    OPER_DESC,
                    CONSIGNMENT_FLAG,
                    APPROVED_FLAG_HEADER,
                    APPROVED_FLAG_LOCATION,
                    APPROVED_DATE_HEADER,
                    APPROVED_DATE_LOCATION,
                    CLOSED_CODE_HEADER,
                    CLOSED_CODE_LOCATION,
                    USER_HOLD_FLAG,
                    FROZEN_FLAG,
                    TRAN_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM IF_PO_INFO_HIS
                ORDER BY IF_SEQ ASC;
            EXEC SQL OPEN DBU_IF_PO_INFO_HIS_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
