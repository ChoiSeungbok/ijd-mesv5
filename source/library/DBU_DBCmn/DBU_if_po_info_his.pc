/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_if_po_info_his(int sel_type, struct IF_PO_INFO_HIS_TAG *IF_PO_INFO_HIS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct IF_PO_INFO_HIS_N_TAG IF_PO_INFO_HIS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_if_po_info_his(&IF_PO_INFO_HIS_N, IF_PO_INFO_HIS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_IF_PO_INFO_HIS_CUR_1 CURSOR FOR
                SELECT 
                    IF_SEQ,
                    IF_TIME,
                    IF_CODE,
                    IF_MSG,
                    FACTORY,
                    SHIPMENT_TYPE,
                    ORG_ID,
