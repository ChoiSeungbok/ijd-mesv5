                    CREATE_USER_ID = :CWIPLOTREC_N.CREATE_USER_ID,
                    CREATE_TIME = :CWIPLOTREC_N.CREATE_TIME,
                    UPDATE_USER_ID = :CWIPLOTREC_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CWIPLOTREC_N.UPDATE_TIME
                WHERE FACTORY = :CWIPLOTREC_N.FACTORY
                    AND LOT_ID = :CWIPLOTREC_N.LOT_ID
					AND DELETE_FLAG <> 'Y';
            break;

		case 5:
            EXEC SQL UPDATE CWIPLOTREC SET
                    DELETE_FLAG = 'Y',
                    UPDATE_USER_ID = :CWIPLOTREC_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CWIPLOTREC_N.UPDATE_TIME
                WHERE FACTORY = :CWIPLOTREC_N.FACTORY
                    AND LOT_ID = :CWIPLOTREC_N.LOT_ID
					AND DELETE_FLAG = ' ';
            break;
	    case 6:
            EXEC SQL UPDATE CWIPLOTREC SET
                    HIST_SEQ = :CWIPLOTREC_N.HIST_SEQ,
                    AREA_ID = :CWIPLOTREC_N.AREA_ID,
                    ORDER_ID = :CWIPLOTREC_N.ORDER_ID,
                    INV_OPER = :CWIPLOTREC_N.INV_OPER,
                    TRAN_OPER = :CWIPLOTREC_N.TRAN_OPER,
                    TRAN_FLOW = :CWIPLOTREC_N.TRAN_FLOW,
                    TRAN_TIME = :CWIPLOTREC_N.TRAN_TIME,
                    WORK_DATE = :CWIPLOTREC_N.WORK_DATE,
                    MAT_ID = :CWIPLOTREC_N.MAT_ID,
                    MAT_VER = :CWIPLOTREC_N.MAT_VER,
                    UNIT = :CWIPLOTREC_N.UNIT,
                    QTY = :CWIPLOTREC_N.QTY,
                    DELETE_FLAG = :CWIPLOTREC_N.DELETE_FLAG,
                    CMF_1 = :CWIPLOTREC_N.CMF_1,
                    CMF_2 = :CWIPLOTREC_N.CMF_2,
                    CMF_3 = :CWIPLOTREC_N.CMF_3,
                    CMF_4 = :CWIPLOTREC_N.CMF_4,
                    CMF_5 = :CWIPLOTREC_N.CMF_5,
                    CMF_6 = :CWIPLOTREC_N.CMF_6,
                    CMF_7 = :CWIPLOTREC_N.CMF_7,
                    CMF_8 = :CWIPLOTREC_N.CMF_8,
                    CMF_9 = :CWIPLOTREC_N.CMF_9,
                    CMF_10 = :CWIPLOTREC_N.CMF_10,
                    CREATE_USER_ID = :CWIPLOTREC_N.CREATE_USER_ID,
                    CREATE_TIME = :CWIPLOTREC_N.CREATE_TIME,
                    UPDATE_USER_ID = :CWIPLOTREC_N.UPDATE_USER_ID,
                    UPDATE_TIME = :CWIPLOTREC_N.UPDATE_TIME
                WHERE FACTORY = :CWIPLOTREC_N.FACTORY
                    AND LOT_ID = :CWIPLOTREC_N.LOT_ID
					AND HIST_SEQ = :CWIPLOTREC_N.HIST_SEQ;
            break;
        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_update_cwiplotrec", sel_type);
}


/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cwiplotrec(int sel_type, struct CWIPLOTREC_TAG *CWIPLOTREC)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CWIPLOTREC_N_TAG CWIPLOTREC_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cwiplotrec(&CWIPLOTREC_N, CWIPLOTREC);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CWIPLOTREC_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    LOT_ID,
                    HIST_SEQ,
                    AREA_ID,
                    ORDER_ID,
                    INV_OPER,
                    TRAN_OPER,
                    TRAN_FLOW,
                    TRAN_TIME,
                    WORK_DATE,
                    MAT_ID,
                    MAT_VER,
                    UNIT,
                    QTY,
                    DELETE_FLAG,
                    CMF_1,
                    CMF_2,
                    CMF_3,
                    CMF_4,
                    CMF_5,
                    CMF_6,
                    CMF_7,
                    CMF_8,
                    CMF_9,
                    CMF_10,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CWIPLOTREC
                ORDER BY FACTORY ASC,
                    LOT_ID ASC;
            EXEC SQL OPEN DBU_CWIPLOTREC_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cwiplotrec", sel_type);
}


/* SQL CURSOR FETCH Function */
void DBU_fetch_cwiplotrec(int sel_type, struct CWIPLOTREC_TAG *CWIPLOTREC)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CWIPLOTREC_N_TAG CWIPLOTREC_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL FETCH DBU_CWIPLOTREC_CUR_1 INTO
                :CWIPLOTREC_N.FACTORY,
                :CWIPLOTREC_N.LOT_ID,
                :CWIPLOTREC_N.HIST_SEQ,
                :CWIPLOTREC_N.AREA_ID,
                :CWIPLOTREC_N.ORDER_ID,
                :CWIPLOTREC_N.INV_OPER,
                :CWIPLOTREC_N.TRAN_OPER,
                :CWIPLOTREC_N.TRAN_FLOW,
                :CWIPLOTREC_N.TRAN_TIME,
                :CWIPLOTREC_N.WORK_DATE,
                :CWIPLOTREC_N.MAT_ID,
                :CWIPLOTREC_N.MAT_VER,
                :CWIPLOTREC_N.UNIT,
                :CWIPLOTREC_N.QTY,
                :CWIPLOTREC_N.DELETE_FLAG,
                :CWIPLOTREC_N.CMF_1,
                :CWIPLOTREC_N.CMF_2,
                :CWIPLOTREC_N.CMF_3,
                :CWIPLOTREC_N.CMF_4,
                :CWIPLOTREC_N.CMF_5,
                :CWIPLOTREC_N.CMF_6,
                :CWIPLOTREC_N.CMF_7,
                :CWIPLOTREC_N.CMF_8,
                :CWIPLOTREC_N.CMF_9,
                :CWIPLOTREC_N.CMF_10,
                :CWIPLOTREC_N.CREATE_USER_ID,
                :CWIPLOTREC_N.CREATE_TIME,
                :CWIPLOTREC_N.UPDATE_USER_ID,
                :CWIPLOTREC_N.UPDATE_TIME;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_cwiplotrec(&CWIPLOTREC_N, CWIPLOTREC);
    }

    DB_stop_query_timer("DBU_fetch_cwiplotrec", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_cwiplotrec(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CWIPLOTREC_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_cwiplotrec", sel_type);
}


/* Initialize Function */
void DBU_init_cwiplotrec(struct CWIPLOTREC_TAG *CWIPLOTREC)
{
    /* memset by Space */
    memset(CWIPLOTREC, ' ', sizeof(struct CWIPLOTREC_TAG));
    
    CWIPLOTREC->HIST_SEQ = 0;
    CWIPLOTREC->MAT_VER = 0;
    CWIPLOTREC->QTY = 0;
}


/* Add Null Function */
void DBU_add_null_cwiplotrec(struct CWIPLOTREC_N_TAG *CWIPLOTREC_N, struct CWIPLOTREC_TAG *CWIPLOTREC)
{
    /* memset by NULL */
    memset(CWIPLOTREC_N, '\0', sizeof(struct CWIPLOTREC_N_TAG));
    
    MEMCPY_AN(CWIPLOTREC_N->FACTORY, CWIPLOTREC->FACTORY, sizeof(CWIPLOTREC->FACTORY));
    MEMCPY_AN(CWIPLOTREC_N->LOT_ID, CWIPLOTREC->LOT_ID, sizeof(CWIPLOTREC->LOT_ID));
    CWIPLOTREC_N->HIST_SEQ = CWIPLOTREC->HIST_SEQ;
    MEMCPY_AN(CWIPLOTREC_N->AREA_ID, CWIPLOTREC->AREA_ID, sizeof(CWIPLOTREC->AREA_ID));
    MEMCPY_AN(CWIPLOTREC_N->ORDER_ID, CWIPLOTREC->ORDER_ID, sizeof(CWIPLOTREC->ORDER_ID));
    MEMCPY_AN(CWIPLOTREC_N->INV_OPER, CWIPLOTREC->INV_OPER, sizeof(CWIPLOTREC->INV_OPER));
    MEMCPY_AN(CWIPLOTREC_N->TRAN_OPER, CWIPLOTREC->TRAN_OPER, sizeof(CWIPLOTREC->TRAN_OPER));
    MEMCPY_AN(CWIPLOTREC_N->TRAN_FLOW, CWIPLOTREC->TRAN_FLOW, sizeof(CWIPLOTREC->TRAN_FLOW));
    MEMCPY_AN(CWIPLOTREC_N->TRAN_TIME, CWIPLOTREC->TRAN_TIME, sizeof(CWIPLOTREC->TRAN_TIME));
    MEMCPY_AN(CWIPLOTREC_N->WORK_DATE, CWIPLOTREC->WORK_DATE, sizeof(CWIPLOTREC->WORK_DATE));
    MEMCPY_AN(CWIPLOTREC_N->MAT_ID, CWIPLOTREC->MAT_ID, sizeof(CWIPLOTREC->MAT_ID));
    CWIPLOTREC_N->MAT_VER = CWIPLOTREC->MAT_VER;
    MEMCPY_AN(CWIPLOTREC_N->UNIT, CWIPLOTREC->UNIT, sizeof(CWIPLOTREC->UNIT));
    CWIPLOTREC_N->QTY = CWIPLOTREC->QTY;
    CWIPLOTREC_N->DELETE_FLAG[0] = CWIPLOTREC->DELETE_FLAG;
    MEMCPY_AN(CWIPLOTREC_N->CMF_1, CWIPLOTREC->CMF_1, sizeof(CWIPLOTREC->CMF_1));
    MEMCPY_AN(CWIPLOTREC_N->CMF_2, CWIPLOTREC->CMF_2, sizeof(CWIPLOTREC->CMF_2));
    MEMCPY_AN(CWIPLOTREC_N->CMF_3, CWIPLOTREC->CMF_3, sizeof(CWIPLOTREC->CMF_3));
    MEMCPY_AN(CWIPLOTREC_N->CMF_4, CWIPLOTREC->CMF_4, sizeof(CWIPLOTREC->CMF_4));
    MEMCPY_AN(CWIPLOTREC_N->CMF_5, CWIPLOTREC->CMF_5, sizeof(CWIPLOTREC->CMF_5));
    MEMCPY_AN(CWIPLOTREC_N->CMF_6, CWIPLOTREC->CMF_6, sizeof(CWIPLOTREC->CMF_6));
    MEMCPY_AN(CWIPLOTREC_N->CMF_7, CWIPLOTREC->CMF_7, sizeof(CWIPLOTREC->CMF_7));
    MEMCPY_AN(CWIPLOTREC_N->CMF_8, CWIPLOTREC->CMF_8, sizeof(CWIPLOTREC->CMF_8));
    MEMCPY_AN(CWIPLOTREC_N->CMF_9, CWIPLOTREC->CMF_9, sizeof(CWIPLOTREC->CMF_9));
    MEMCPY_AN(CWIPLOTREC_N->CMF_10, CWIPLOTREC->CMF_10, sizeof(CWIPLOTREC->CMF_10));
    MEMCPY_AN(CWIPLOTREC_N->CREATE_USER_ID, CWIPLOTREC->CREATE_USER_ID, sizeof(CWIPLOTREC->CREATE_USER_ID));
    MEMCPY_AN(CWIPLOTREC_N->CREATE_TIME, CWIPLOTREC->CREATE_TIME, sizeof(CWIPLOTREC->CREATE_TIME));
    MEMCPY_AN(CWIPLOTREC_N->UPDATE_USER_ID, CWIPLOTREC->UPDATE_USER_ID, sizeof(CWIPLOTREC->UPDATE_USER_ID));
    MEMCPY_AN(CWIPLOTREC_N->UPDATE_TIME, CWIPLOTREC->UPDATE_TIME, sizeof(CWIPLOTREC->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_cwiplotrec(struct CWIPLOTREC_N_TAG *CWIPLOTREC_N, struct CWIPLOTREC_TAG *CWIPLOTREC)
{
    MEMCPY_DN(CWIPLOTREC->FACTORY, CWIPLOTREC_N->FACTORY, sizeof(CWIPLOTREC->FACTORY));
    MEMCPY_DN(CWIPLOTREC->LOT_ID, CWIPLOTREC_N->LOT_ID, sizeof(CWIPLOTREC->LOT_ID));
    CWIPLOTREC->HIST_SEQ = CWIPLOTREC_N->HIST_SEQ;
    MEMCPY_DN(CWIPLOTREC->AREA_ID, CWIPLOTREC_N->AREA_ID, sizeof(CWIPLOTREC->AREA_ID));
    MEMCPY_DN(CWIPLOTREC->ORDER_ID, CWIPLOTREC_N->ORDER_ID, sizeof(CWIPLOTREC->ORDER_ID));
    MEMCPY_DN(CWIPLOTREC->INV_OPER, CWIPLOTREC_N->INV_OPER, sizeof(CWIPLOTREC->INV_OPER));
    MEMCPY_DN(CWIPLOTREC->TRAN_OPER, CWIPLOTREC_N->TRAN_OPER, sizeof(CWIPLOTREC->TRAN_OPER));
    MEMCPY_DN(CWIPLOTREC->TRAN_FLOW, CWIPLOTREC_N->TRAN_FLOW, sizeof(CWIPLOTREC->TRAN_FLOW));
    MEMCPY_DN(CWIPLOTREC->TRAN_TIME, CWIPLOTREC_N->TRAN_TIME, sizeof(CWIPLOTREC->TRAN_TIME));
    MEMCPY_DN(CWIPLOTREC->WORK_DATE, CWIPLOTREC_N->WORK_DATE, sizeof(CWIPLOTREC->WORK_DATE));
    MEMCPY_DN(CWIPLOTREC->MAT_ID, CWIPLOTREC_N->MAT_ID, sizeof(CWIPLOTREC->MAT_ID));
    CWIPLOTREC->MAT_VER = CWIPLOTREC_N->MAT_VER;
    MEMCPY_DN(CWIPLOTREC->UNIT, CWIPLOTREC_N->UNIT, sizeof(CWIPLOTREC->UNIT));
    CWIPLOTREC->QTY = CWIPLOTREC_N->QTY;
    CWIPLOTREC->DELETE_FLAG = CWIPLOTREC_N->DELETE_FLAG[0];
    MEMCPY_DN(CWIPLOTREC->CMF_1, CWIPLOTREC_N->CMF_1, sizeof(CWIPLOTREC->CMF_1));
    MEMCPY_DN(CWIPLOTREC->CMF_2, CWIPLOTREC_N->CMF_2, sizeof(CWIPLOTREC->CMF_2));
    MEMCPY_DN(CWIPLOTREC->CMF_3, CWIPLOTREC_N->CMF_3, sizeof(CWIPLOTREC->CMF_3));
    MEMCPY_DN(CWIPLOTREC->CMF_4, CWIPLOTREC_N->CMF_4, sizeof(CWIPLOTREC->CMF_4));
    MEMCPY_DN(CWIPLOTREC->CMF_5, CWIPLOTREC_N->CMF_5, sizeof(CWIPLOTREC->CMF_5));
    MEMCPY_DN(CWIPLOTREC->CMF_6, CWIPLOTREC_N->CMF_6, sizeof(CWIPLOTREC->CMF_6));
    MEMCPY_DN(CWIPLOTREC->CMF_7, CWIPLOTREC_N->CMF_7, sizeof(CWIPLOTREC->CMF_7));
    MEMCPY_DN(CWIPLOTREC->CMF_8, CWIPLOTREC_N->CMF_8, sizeof(CWIPLOTREC->CMF_8));
    MEMCPY_DN(CWIPLOTREC->CMF_9, CWIPLOTREC_N->CMF_9, sizeof(CWIPLOTREC->CMF_9));
    MEMCPY_DN(CWIPLOTREC->CMF_10, CWIPLOTREC_N->CMF_10, sizeof(CWIPLOTREC->CMF_10));
    MEMCPY_DN(CWIPLOTREC->CREATE_USER_ID, CWIPLOTREC_N->CREATE_USER_ID, sizeof(CWIPLOTREC->CREATE_USER_ID));
    MEMCPY_DN(CWIPLOTREC->CREATE_TIME, CWIPLOTREC_N->CREATE_TIME, sizeof(CWIPLOTREC->CREATE_TIME));
    MEMCPY_DN(CWIPLOTREC->UPDATE_USER_ID, CWIPLOTREC_N->UPDATE_USER_ID, sizeof(CWIPLOTREC->UPDATE_USER_ID));
    MEMCPY_DN(CWIPLOTREC->UPDATE_TIME, CWIPLOTREC_N->UPDATE_TIME, sizeof(CWIPLOTREC->UPDATE_TIME));
}


