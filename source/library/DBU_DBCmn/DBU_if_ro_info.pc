                :IF_RO_INFO_N.ORDERED_QTY,
                :IF_RO_INFO_N.SHIPPED_QTY,
                :IF_RO_INFO_N.SHIPPED_DATE,
                :IF_RO_INFO_N.CUSTOMER_NUMBER,
                :IF_RO_INFO_N.CUSTOMER_NAME,
                :IF_RO_INFO_N.ORDERED_DATE,
                :IF_RO_INFO_N.CUSTOMER_ID,
                :IF_RO_INFO_N.CUSTOMER_SITE_ID,
                :IF_RO_INFO_N.OE_ORDER_HEADER_ID,
                :IF_RO_INFO_N.OE_ORDER_LINE_ID,
                :IF_RO_INFO_N.REFERENCE_LINE_ID,
                :IF_RO_INFO_N.SHIPPING_HEADER_ID,
                :IF_RO_INFO_N.SHIPPING_LINE_ID,
                :IF_RO_INFO_N.SHIP_LINE_IF_ID,
                :IF_RO_INFO_N.SHIP_LINE_LOT_IF_ID,
                :IF_RO_INFO_N.TRAN_FLAG,
                :IF_RO_INFO_N.CMF_1,
                :IF_RO_INFO_N.CMF_2,
                :IF_RO_INFO_N.CMF_3,
                :IF_RO_INFO_N.CMF_4,
                :IF_RO_INFO_N.CMF_5,
                :IF_RO_INFO_N.CMF_6,
                :IF_RO_INFO_N.CMF_7,
                :IF_RO_INFO_N.CMF_8,
                :IF_RO_INFO_N.CMF_9,
                :IF_RO_INFO_N.CMF_10,
                :IF_RO_INFO_N.CREATE_USER_ID,
                :IF_RO_INFO_N.CREATE_TIME,
                :IF_RO_INFO_N.UPDATE_USER_ID,
                :IF_RO_INFO_N.UPDATE_TIME;
            break;

		case 101:
            EXEC SQL FETCH DBU_IF_RO_INFO_CUR_101 INTO
                :IF_RO_INFO_N.IF_SEQ,
                :IF_RO_INFO_N.IF_TIME,
                :IF_RO_INFO_N.IF_CODE,
                :IF_RO_INFO_N.IF_MSG,
                :IF_RO_INFO_N.FACTORY,
                :IF_RO_INFO_N.ORG_ID,
                :IF_RO_INFO_N.ORG_CODE,
                :IF_RO_INFO_N.ORDER_NUMBER,
                :IF_RO_INFO_N.LINE_NUMBER,
                :IF_RO_INFO_N.LOT_ID,
                :IF_RO_INFO_N.ITEM_CODE,
                :IF_RO_INFO_N.ITEM_DESC,
                :IF_RO_INFO_N.UNIT,
                :IF_RO_INFO_N.ORDERED_QTY,
                :IF_RO_INFO_N.SHIPPED_QTY,
                :IF_RO_INFO_N.SHIPPED_DATE,
                :IF_RO_INFO_N.CUSTOMER_NUMBER,
                :IF_RO_INFO_N.CUSTOMER_NAME,
                :IF_RO_INFO_N.ORDERED_DATE,
                :IF_RO_INFO_N.CUSTOMER_ID,
                :IF_RO_INFO_N.CUSTOMER_SITE_ID,
                :IF_RO_INFO_N.OE_ORDER_HEADER_ID,
                :IF_RO_INFO_N.OE_ORDER_LINE_ID,
                :IF_RO_INFO_N.REFERENCE_LINE_ID,
                :IF_RO_INFO_N.SHIPPING_HEADER_ID,
                :IF_RO_INFO_N.SHIPPING_LINE_ID,
                :IF_RO_INFO_N.SHIP_LINE_IF_ID,
                :IF_RO_INFO_N.SHIP_LINE_LOT_IF_ID,
                :IF_RO_INFO_N.TRAN_FLAG,
                :IF_RO_INFO_N.CMF_1,
                :IF_RO_INFO_N.CMF_2,
                :IF_RO_INFO_N.CMF_3,
                :IF_RO_INFO_N.CMF_4,
                :IF_RO_INFO_N.CMF_5,
                :IF_RO_INFO_N.CMF_6,
                :IF_RO_INFO_N.CMF_7,
                :IF_RO_INFO_N.CMF_8,
                :IF_RO_INFO_N.CMF_9,
                :IF_RO_INFO_N.CMF_10,
                :IF_RO_INFO_N.CREATE_USER_ID,
                :IF_RO_INFO_N.CREATE_TIME,
                :IF_RO_INFO_N.UPDATE_USER_ID,
                :IF_RO_INFO_N.UPDATE_TIME;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_if_ro_info(&IF_RO_INFO_N, IF_RO_INFO);
    }

    DB_stop_query_timer("DBU_fetch_if_ro_info", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_if_ro_info(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_IF_RO_INFO_CUR_1;
            break;

		case 101:
            EXEC SQL CLOSE DBU_IF_RO_INFO_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_if_ro_info", sel_type);
}


/* Initialize Function */
void DBU_init_if_ro_info(struct IF_RO_INFO_TAG *IF_RO_INFO)
{
    /* memset by Space */
    memset(IF_RO_INFO, ' ', sizeof(struct IF_RO_INFO_TAG));
    
    IF_RO_INFO->IF_SEQ = 0;
    IF_RO_INFO->ORG_ID = 0;
    IF_RO_INFO->ORDER_NUMBER = 0;
    IF_RO_INFO->LINE_NUMBER = 0;
    IF_RO_INFO->ORDERED_QTY = 0;
    IF_RO_INFO->SHIPPED_QTY = 0;
    IF_RO_INFO->CUSTOMER_ID = 0;
    IF_RO_INFO->CUSTOMER_SITE_ID = 0;
    IF_RO_INFO->OE_ORDER_HEADER_ID = 0;
    IF_RO_INFO->OE_ORDER_LINE_ID = 0;
    IF_RO_INFO->REFERENCE_LINE_ID = 0;
    IF_RO_INFO->SHIPPING_HEADER_ID = 0;
    IF_RO_INFO->SHIPPING_LINE_ID = 0;
    IF_RO_INFO->SHIP_LINE_IF_ID = 0;
    IF_RO_INFO->SHIP_LINE_LOT_IF_ID = 0;
}


