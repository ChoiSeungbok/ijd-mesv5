/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_minvmatiss(int sel_type, struct MINVMATISS_TAG *MINVMATISS)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MINVMATISS_N_TAG MINVMATISS_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_minvmatiss(&MINVMATISS_N, MINVMATISS);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_MINVMATISS_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    INV_LOT_ID,
                    HIST_SEQ,
                    REQ_NO,
                    REQ_MAT_ID,
                    REQ_MAT_VER,
                    ISSUE_TIME,
                    ISSUE_QTY,
					UNIT,
                    AREA_ID,
                    SUB_AREA_ID,
                    OPER,
                    TO_AREA_ID,
                    TO_SUB_AREA_ID,
                    TO_OPER,
                    TRAN_COMMENT,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM MINVMATISS
                ORDER BY FACTORY ASC,
                    INV_LOT_ID ASC,
                    HIST_SEQ ASC;
            EXEC SQL OPEN DBU_MINVMATISS_CUR_1;
            break;

		case 2:
            EXEC SQL DECLARE DBU_MINVMATISS_CUR_2 CURSOR FOR
                SELECT 
					ISS.FACTORY,
					ISS.INV_LOT_ID,
					ISS.HIST_SEQ,
					ISS.REQ_NO,
					ISS.REQ_MAT_ID,
					ISS.REQ_MAT_VER,
					ISS.ISSUE_TIME,
					ISS.ISSUE_QTY,
					ISS.UNIT,
					ISS.AREA_ID,
					ISS.SUB_AREA_ID,
					ISS.OPER,
					ISS.TO_AREA_ID,
					ISS.TO_SUB_AREA_ID,
					ISS.TO_OPER,
					MAT.MAT_DESC TRAN_COMMENT,
					ISS.CREATE_USER_ID,
					ISS.CREATE_TIME,
					ISS.UPDATE_USER_ID,
					ISS.UPDATE_TIME
				FROM MINVMATISS ISS, MWIPMATDEF MAT
				WHERE     ISS.FACTORY = :MINVMATISS_N.FACTORY
				 AND ISS.FACTORY = MAT.FACTORY
				 AND ISS.REQ_MAT_ID = MAT.MAT_ID
				 AND ISS.REQ_MAT_VER = MAT.MAT_VER
				 AND ISS.AREA_ID = :MINVMATISS_N.AREA_ID
				 AND (( :MINVMATISS_N.INV_LOT_ID = ' ') OR (ISS.INV_LOT_ID = :MINVMATISS_N.INV_LOT_ID))
				 AND (( :MINVMATISS_N.REQ_MAT_ID = ' ') OR (ISS.REQ_MAT_ID = :MINVMATISS_N.REQ_MAT_ID))
				 AND (( :MINVMATISS_N.TO_OPER = ' ') OR (ISS.TO_OPER = :MINVMATISS_N.TO_OPER))
				 AND ISS.CREATE_TIME BETWEEN :DBC_Q_COND_N.FROM_TIME  AND :DBC_Q_COND_N.TO_TIME
				ORDER BY ISS.FACTORY, 
						 ISS.INV_LOT_ID, 
						 ISS.HIST_SEQ DESC;
            EXEC SQL OPEN DBU_MINVMATISS_CUR_2;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_minvmatiss", sel_type);
}


