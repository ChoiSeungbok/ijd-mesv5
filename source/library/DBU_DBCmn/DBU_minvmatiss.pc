/* Initialize Function */
void DBU_init_minvmatiss(struct MINVMATISS_TAG *MINVMATISS)
{
    /* memset by Space */
    memset(MINVMATISS, ' ', sizeof(struct MINVMATISS_TAG));
    
    MINVMATISS->HIST_SEQ = 0;
    MINVMATISS->REQ_MAT_VER = 0;
    MINVMATISS->ISSUE_QTY = 0;
}


/* Add Null Function */
void DBU_add_null_minvmatiss(struct MINVMATISS_N_TAG *MINVMATISS_N, struct MINVMATISS_TAG *MINVMATISS)
{
    /* memset by NULL */
    memset(MINVMATISS_N, '\0', sizeof(struct MINVMATISS_N_TAG));
    
    MEMCPY_AN(MINVMATISS_N->FACTORY, MINVMATISS->FACTORY, sizeof(MINVMATISS->FACTORY));
    MEMCPY_AN(MINVMATISS_N->INV_LOT_ID, MINVMATISS->INV_LOT_ID, sizeof(MINVMATISS->INV_LOT_ID));
    MINVMATISS_N->HIST_SEQ = MINVMATISS->HIST_SEQ;
    MEMCPY_AN(MINVMATISS_N->REQ_NO, MINVMATISS->REQ_NO, sizeof(MINVMATISS->REQ_NO));
    MEMCPY_AN(MINVMATISS_N->REQ_MAT_ID, MINVMATISS->REQ_MAT_ID, sizeof(MINVMATISS->REQ_MAT_ID));
    MINVMATISS_N->REQ_MAT_VER = MINVMATISS->REQ_MAT_VER;
    MEMCPY_AN(MINVMATISS_N->ISSUE_TIME, MINVMATISS->ISSUE_TIME, sizeof(MINVMATISS->ISSUE_TIME));
    MINVMATISS_N->ISSUE_QTY = MINVMATISS->ISSUE_QTY;
	MEMCPY_AN(MINVMATISS_N->UNIT, MINVMATISS->UNIT, sizeof(MINVMATISS->UNIT));
    MEMCPY_AN(MINVMATISS_N->AREA_ID, MINVMATISS->AREA_ID, sizeof(MINVMATISS->AREA_ID));
    MEMCPY_AN(MINVMATISS_N->SUB_AREA_ID, MINVMATISS->SUB_AREA_ID, sizeof(MINVMATISS->SUB_AREA_ID));
    MEMCPY_AN(MINVMATISS_N->OPER, MINVMATISS->OPER, sizeof(MINVMATISS->OPER));
    MEMCPY_AN(MINVMATISS_N->TO_AREA_ID, MINVMATISS->TO_AREA_ID, sizeof(MINVMATISS->TO_AREA_ID));
    MEMCPY_AN(MINVMATISS_N->TO_SUB_AREA_ID, MINVMATISS->TO_SUB_AREA_ID, sizeof(MINVMATISS->TO_SUB_AREA_ID));
    MEMCPY_AN(MINVMATISS_N->TO_OPER, MINVMATISS->TO_OPER, sizeof(MINVMATISS->TO_OPER));
    MEMCPY_AN(MINVMATISS_N->TRAN_COMMENT, MINVMATISS->TRAN_COMMENT, sizeof(MINVMATISS->TRAN_COMMENT));
    MEMCPY_AN(MINVMATISS_N->CREATE_USER_ID, MINVMATISS->CREATE_USER_ID, sizeof(MINVMATISS->CREATE_USER_ID));
    MEMCPY_AN(MINVMATISS_N->CREATE_TIME, MINVMATISS->CREATE_TIME, sizeof(MINVMATISS->CREATE_TIME));
    MEMCPY_AN(MINVMATISS_N->UPDATE_USER_ID, MINVMATISS->UPDATE_USER_ID, sizeof(MINVMATISS->UPDATE_USER_ID));
    MEMCPY_AN(MINVMATISS_N->UPDATE_TIME, MINVMATISS->UPDATE_TIME, sizeof(MINVMATISS->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_minvmatiss(struct MINVMATISS_N_TAG *MINVMATISS_N, struct MINVMATISS_TAG *MINVMATISS)
{
    MEMCPY_DN(MINVMATISS->FACTORY, MINVMATISS_N->FACTORY, sizeof(MINVMATISS->FACTORY));
    MEMCPY_DN(MINVMATISS->INV_LOT_ID, MINVMATISS_N->INV_LOT_ID, sizeof(MINVMATISS->INV_LOT_ID));
    MINVMATISS->HIST_SEQ = MINVMATISS_N->HIST_SEQ;
    MEMCPY_DN(MINVMATISS->REQ_NO, MINVMATISS_N->REQ_NO, sizeof(MINVMATISS->REQ_NO));
    MEMCPY_DN(MINVMATISS->REQ_MAT_ID, MINVMATISS_N->REQ_MAT_ID, sizeof(MINVMATISS->REQ_MAT_ID));
    MINVMATISS->REQ_MAT_VER = MINVMATISS_N->REQ_MAT_VER;
    MEMCPY_DN(MINVMATISS->ISSUE_TIME, MINVMATISS_N->ISSUE_TIME, sizeof(MINVMATISS->ISSUE_TIME));
    MINVMATISS->ISSUE_QTY = MINVMATISS_N->ISSUE_QTY;
	MEMCPY_DN(MINVMATISS->UNIT, MINVMATISS_N->UNIT, sizeof(MINVMATISS->UNIT));
    MEMCPY_DN(MINVMATISS->AREA_ID, MINVMATISS_N->AREA_ID, sizeof(MINVMATISS->AREA_ID));
    MEMCPY_DN(MINVMATISS->SUB_AREA_ID, MINVMATISS_N->SUB_AREA_ID, sizeof(MINVMATISS->SUB_AREA_ID));
    MEMCPY_DN(MINVMATISS->OPER, MINVMATISS_N->OPER, sizeof(MINVMATISS->OPER));
    MEMCPY_DN(MINVMATISS->TO_AREA_ID, MINVMATISS_N->TO_AREA_ID, sizeof(MINVMATISS->TO_AREA_ID));
    MEMCPY_DN(MINVMATISS->TO_SUB_AREA_ID, MINVMATISS_N->TO_SUB_AREA_ID, sizeof(MINVMATISS->TO_SUB_AREA_ID));
    MEMCPY_DN(MINVMATISS->TO_OPER, MINVMATISS_N->TO_OPER, sizeof(MINVMATISS->TO_OPER));
    MEMCPY_DN(MINVMATISS->TRAN_COMMENT, MINVMATISS_N->TRAN_COMMENT, sizeof(MINVMATISS->TRAN_COMMENT));
    MEMCPY_DN(MINVMATISS->CREATE_USER_ID, MINVMATISS_N->CREATE_USER_ID, sizeof(MINVMATISS->CREATE_USER_ID));
    MEMCPY_DN(MINVMATISS->CREATE_TIME, MINVMATISS_N->CREATE_TIME, sizeof(MINVMATISS->CREATE_TIME));
    MEMCPY_DN(MINVMATISS->UPDATE_USER_ID, MINVMATISS_N->UPDATE_USER_ID, sizeof(MINVMATISS->UPDATE_USER_ID));
    MEMCPY_DN(MINVMATISS->UPDATE_TIME, MINVMATISS_N->UPDATE_TIME, sizeof(MINVMATISS->UPDATE_TIME));
}


