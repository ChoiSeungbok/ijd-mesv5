                 AND KEY_2 = :MGCMTBLDAT_N.KEY_2
                 AND KEY_3 = :MGCMTBLDAT_N.KEY_3
                 AND KEY_4 = :MGCMTBLDAT_N.KEY_4
                ORDER BY TO_NUMBER(TRIM(DATA_1));
            EXEC SQL OPEN DBU_MGCMTBLDAT_CUR_4;
            break;

		case 5:
            EXEC SQL DECLARE DBU_MGCMTBLDAT_CUR_5 CURSOR FOR
