    MEMCPY_AN(MGCMTBLDAT_N->DATA_1, MGCMTBLDAT->DATA_1, sizeof(MGCMTBLDAT->DATA_1));
    MEMCPY_AN(MGCMTBLDAT_N->DATA_2, MGCMTBLDAT->DATA_2, sizeof(MGCMTBLDAT->DATA_2));
