                :IF_VENDOR_DEF_N.CREATE_TIME,
                :IF_VENDOR_DEF_N.UPDATE_USER_ID,
                :IF_VENDOR_DEF_N.UPDATE_TIME;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_if_vendor_def(&IF_VENDOR_DEF_N, IF_VENDOR_DEF);
    }

    DB_stop_query_timer("DBU_fetch_if_vendor_def", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_if_vendor_def(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_IF_VENDOR_DEF_CUR_1;
            break;

		case 101:
            EXEC SQL CLOSE DBU_IF_VENDOR_DEF_CUR_101;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_if_vendor_def", sel_type);
}


/* Initialize Function */
void DBU_init_if_vendor_def(struct IF_VENDOR_DEF_TAG *IF_VENDOR_DEF)
{
    /* memset by Space */
    memset(IF_VENDOR_DEF, ' ', sizeof(struct IF_VENDOR_DEF_TAG));
    
    IF_VENDOR_DEF->IF_SEQ = 0;
    IF_VENDOR_DEF->VENDOR_ID = 0;
    IF_VENDOR_DEF->VENDOR_SITE_ID = 0;
}


/* Add Null Function */
void DBU_add_null_if_vendor_def(struct IF_VENDOR_DEF_N_TAG *IF_VENDOR_DEF_N, struct IF_VENDOR_DEF_TAG *IF_VENDOR_DEF)
{
    /* memset by NULL */
    memset(IF_VENDOR_DEF_N, '\0', sizeof(struct IF_VENDOR_DEF_N_TAG));
    
    IF_VENDOR_DEF_N->IF_SEQ = IF_VENDOR_DEF->IF_SEQ;
    MEMCPY_AN(IF_VENDOR_DEF_N->IF_TIME, IF_VENDOR_DEF->IF_TIME, sizeof(IF_VENDOR_DEF->IF_TIME));
    IF_VENDOR_DEF_N->IF_CODE[0] = IF_VENDOR_DEF->IF_CODE;
    MEMCPY_AN(IF_VENDOR_DEF_N->IF_MSG, IF_VENDOR_DEF->IF_MSG, sizeof(IF_VENDOR_DEF->IF_MSG));
    MEMCPY_AN(IF_VENDOR_DEF_N->FACTORY, IF_VENDOR_DEF->FACTORY, sizeof(IF_VENDOR_DEF->FACTORY));
    IF_VENDOR_DEF_N->VENDOR_ID = IF_VENDOR_DEF->VENDOR_ID;
    MEMCPY_AN(IF_VENDOR_DEF_N->VENDOE_CODE, IF_VENDOR_DEF->VENDOE_CODE, sizeof(IF_VENDOR_DEF->VENDOE_CODE));
    MEMCPY_AN(IF_VENDOR_DEF_N->VENDOR_NAME, IF_VENDOR_DEF->VENDOR_NAME, sizeof(IF_VENDOR_DEF->VENDOR_NAME));
    MEMCPY_AN(IF_VENDOR_DEF_N->VENDOR_TYPE, IF_VENDOR_DEF->VENDOR_TYPE, sizeof(IF_VENDOR_DEF->VENDOR_TYPE));
    IF_VENDOR_DEF_N->VENDOR_SITE_ID = IF_VENDOR_DEF->VENDOR_SITE_ID;
    MEMCPY_AN(IF_VENDOR_DEF_N->VENDOR_SITE_CODE, IF_VENDOR_DEF->VENDOR_SITE_CODE, sizeof(IF_VENDOR_DEF->VENDOR_SITE_CODE));
    MEMCPY_AN(IF_VENDOR_DEF_N->VAT_REGISTRATION_NUM, IF_VENDOR_DEF->VAT_REGISTRATION_NUM, sizeof(IF_VENDOR_DEF->VAT_REGISTRATION_NUM));
    IF_VENDOR_DEF_N->PURCHASING_SITE_FLAG[0] = IF_VENDOR_DEF->PURCHASING_SITE_FLAG;
    IF_VENDOR_DEF_N->ENABLED_FLAG[0] = IF_VENDOR_DEF->ENABLED_FLAG;
    MEMCPY_AN(IF_VENDOR_DEF_N->START_DATE_ACTIVE, IF_VENDOR_DEF->START_DATE_ACTIVE, sizeof(IF_VENDOR_DEF->START_DATE_ACTIVE));
    MEMCPY_AN(IF_VENDOR_DEF_N->END_DATE_ACTIVE, IF_VENDOR_DEF->END_DATE_ACTIVE, sizeof(IF_VENDOR_DEF->END_DATE_ACTIVE));
    IF_VENDOR_DEF_N->TRAN_FLAG[0] = IF_VENDOR_DEF->TRAN_FLAG;
    MEMCPY_AN(IF_VENDOR_DEF_N->CMF_1, IF_VENDOR_DEF->CMF_1, sizeof(IF_VENDOR_DEF->CMF_1));
    MEMCPY_AN(IF_VENDOR_DEF_N->CMF_2, IF_VENDOR_DEF->CMF_2, sizeof(IF_VENDOR_DEF->CMF_2));
    MEMCPY_AN(IF_VENDOR_DEF_N->CMF_3, IF_VENDOR_DEF->CMF_3, sizeof(IF_VENDOR_DEF->CMF_3));
    MEMCPY_AN(IF_VENDOR_DEF_N->CMF_4, IF_VENDOR_DEF->CMF_4, sizeof(IF_VENDOR_DEF->CMF_4));
    MEMCPY_AN(IF_VENDOR_DEF_N->CMF_5, IF_VENDOR_DEF->CMF_5, sizeof(IF_VENDOR_DEF->CMF_5));
    MEMCPY_AN(IF_VENDOR_DEF_N->CMF_6, IF_VENDOR_DEF->CMF_6, sizeof(IF_VENDOR_DEF->CMF_6));
    MEMCPY_AN(IF_VENDOR_DEF_N->CMF_7, IF_VENDOR_DEF->CMF_7, sizeof(IF_VENDOR_DEF->CMF_7));
    MEMCPY_AN(IF_VENDOR_DEF_N->CMF_8, IF_VENDOR_DEF->CMF_8, sizeof(IF_VENDOR_DEF->CMF_8));
    MEMCPY_AN(IF_VENDOR_DEF_N->CMF_9, IF_VENDOR_DEF->CMF_9, sizeof(IF_VENDOR_DEF->CMF_9));
    MEMCPY_AN(IF_VENDOR_DEF_N->CMF_10, IF_VENDOR_DEF->CMF_10, sizeof(IF_VENDOR_DEF->CMF_10));
    MEMCPY_AN(IF_VENDOR_DEF_N->CREATE_USER_ID, IF_VENDOR_DEF->CREATE_USER_ID, sizeof(IF_VENDOR_DEF->CREATE_USER_ID));
    MEMCPY_AN(IF_VENDOR_DEF_N->CREATE_TIME, IF_VENDOR_DEF->CREATE_TIME, sizeof(IF_VENDOR_DEF->CREATE_TIME));
    MEMCPY_AN(IF_VENDOR_DEF_N->UPDATE_USER_ID, IF_VENDOR_DEF->UPDATE_USER_ID, sizeof(IF_VENDOR_DEF->UPDATE_USER_ID));
    MEMCPY_AN(IF_VENDOR_DEF_N->UPDATE_TIME, IF_VENDOR_DEF->UPDATE_TIME, sizeof(IF_VENDOR_DEF->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_if_vendor_def(struct IF_VENDOR_DEF_N_TAG *IF_VENDOR_DEF_N, struct IF_VENDOR_DEF_TAG *IF_VENDOR_DEF)
{
    IF_VENDOR_DEF->IF_SEQ = IF_VENDOR_DEF_N->IF_SEQ;
    MEMCPY_DN(IF_VENDOR_DEF->IF_TIME, IF_VENDOR_DEF_N->IF_TIME, sizeof(IF_VENDOR_DEF->IF_TIME));
    IF_VENDOR_DEF->IF_CODE = IF_VENDOR_DEF_N->IF_CODE[0];
    MEMCPY_DN(IF_VENDOR_DEF->IF_MSG, IF_VENDOR_DEF_N->IF_MSG, sizeof(IF_VENDOR_DEF->IF_MSG));
    MEMCPY_DN(IF_VENDOR_DEF->FACTORY, IF_VENDOR_DEF_N->FACTORY, sizeof(IF_VENDOR_DEF->FACTORY));
    IF_VENDOR_DEF->VENDOR_ID = IF_VENDOR_DEF_N->VENDOR_ID;
    MEMCPY_DN(IF_VENDOR_DEF->VENDOE_CODE, IF_VENDOR_DEF_N->VENDOE_CODE, sizeof(IF_VENDOR_DEF->VENDOE_CODE));
    MEMCPY_DN(IF_VENDOR_DEF->VENDOR_NAME, IF_VENDOR_DEF_N->VENDOR_NAME, sizeof(IF_VENDOR_DEF->VENDOR_NAME));
    MEMCPY_DN(IF_VENDOR_DEF->VENDOR_TYPE, IF_VENDOR_DEF_N->VENDOR_TYPE, sizeof(IF_VENDOR_DEF->VENDOR_TYPE));
    IF_VENDOR_DEF->VENDOR_SITE_ID = IF_VENDOR_DEF_N->VENDOR_SITE_ID;
    MEMCPY_DN(IF_VENDOR_DEF->VENDOR_SITE_CODE, IF_VENDOR_DEF_N->VENDOR_SITE_CODE, sizeof(IF_VENDOR_DEF->VENDOR_SITE_CODE));
    MEMCPY_DN(IF_VENDOR_DEF->VAT_REGISTRATION_NUM, IF_VENDOR_DEF_N->VAT_REGISTRATION_NUM, sizeof(IF_VENDOR_DEF->VAT_REGISTRATION_NUM));
    IF_VENDOR_DEF->PURCHASING_SITE_FLAG = IF_VENDOR_DEF_N->PURCHASING_SITE_FLAG[0];
    IF_VENDOR_DEF->ENABLED_FLAG = IF_VENDOR_DEF_N->ENABLED_FLAG[0];
    MEMCPY_DN(IF_VENDOR_DEF->START_DATE_ACTIVE, IF_VENDOR_DEF_N->START_DATE_ACTIVE, sizeof(IF_VENDOR_DEF->START_DATE_ACTIVE));
    MEMCPY_DN(IF_VENDOR_DEF->END_DATE_ACTIVE, IF_VENDOR_DEF_N->END_DATE_ACTIVE, sizeof(IF_VENDOR_DEF->END_DATE_ACTIVE));
    IF_VENDOR_DEF->TRAN_FLAG = IF_VENDOR_DEF_N->TRAN_FLAG[0];
    MEMCPY_DN(IF_VENDOR_DEF->CMF_1, IF_VENDOR_DEF_N->CMF_1, sizeof(IF_VENDOR_DEF->CMF_1));
    MEMCPY_DN(IF_VENDOR_DEF->CMF_2, IF_VENDOR_DEF_N->CMF_2, sizeof(IF_VENDOR_DEF->CMF_2));
    MEMCPY_DN(IF_VENDOR_DEF->CMF_3, IF_VENDOR_DEF_N->CMF_3, sizeof(IF_VENDOR_DEF->CMF_3));
    MEMCPY_DN(IF_VENDOR_DEF->CMF_4, IF_VENDOR_DEF_N->CMF_4, sizeof(IF_VENDOR_DEF->CMF_4));
    MEMCPY_DN(IF_VENDOR_DEF->CMF_5, IF_VENDOR_DEF_N->CMF_5, sizeof(IF_VENDOR_DEF->CMF_5));
    MEMCPY_DN(IF_VENDOR_DEF->CMF_6, IF_VENDOR_DEF_N->CMF_6, sizeof(IF_VENDOR_DEF->CMF_6));
    MEMCPY_DN(IF_VENDOR_DEF->CMF_7, IF_VENDOR_DEF_N->CMF_7, sizeof(IF_VENDOR_DEF->CMF_7));
    MEMCPY_DN(IF_VENDOR_DEF->CMF_8, IF_VENDOR_DEF_N->CMF_8, sizeof(IF_VENDOR_DEF->CMF_8));
    MEMCPY_DN(IF_VENDOR_DEF->CMF_9, IF_VENDOR_DEF_N->CMF_9, sizeof(IF_VENDOR_DEF->CMF_9));
    MEMCPY_DN(IF_VENDOR_DEF->CMF_10, IF_VENDOR_DEF_N->CMF_10, sizeof(IF_VENDOR_DEF->CMF_10));
    MEMCPY_DN(IF_VENDOR_DEF->CREATE_USER_ID, IF_VENDOR_DEF_N->CREATE_USER_ID, sizeof(IF_VENDOR_DEF->CREATE_USER_ID));
    MEMCPY_DN(IF_VENDOR_DEF->CREATE_TIME, IF_VENDOR_DEF_N->CREATE_TIME, sizeof(IF_VENDOR_DEF->CREATE_TIME));
    MEMCPY_DN(IF_VENDOR_DEF->UPDATE_USER_ID, IF_VENDOR_DEF_N->UPDATE_USER_ID, sizeof(IF_VENDOR_DEF->UPDATE_USER_ID));
    MEMCPY_DN(IF_VENDOR_DEF->UPDATE_TIME, IF_VENDOR_DEF_N->UPDATE_TIME, sizeof(IF_VENDOR_DEF->UPDATE_TIME));
}


