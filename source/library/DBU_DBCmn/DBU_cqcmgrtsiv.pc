    MEMCPY_DN(CQCMGRTSIV->SIEVE_CODE, CQCMGRTSIV_N->SIEVE_CODE, sizeof(CQCMGRTSIV->SIEVE_CODE));
    MEMCPY_DN(CQCMGRTSIV->SIZES, CQCMGRTSIV_N->SIZES, sizeof(CQCMGRTSIV->SIZES));
    CQCMGRTSIV->SIEVE_VALUE = CQCMGRTSIV_N->SIEVE_VALUE;
    CQCMGRTSIV->COUNT_1 = CQCMGRTSIV_N->COUNT_1;
    CQCMGRTSIV->NOT_SIEVE_1 = CQCMGRTSIV_N->NOT_SIEVE_1;
