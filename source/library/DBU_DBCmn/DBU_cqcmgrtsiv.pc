                :CQCMGRTSIV_N.TI_VALUE_2,
                :CQCMGRTSIV_N.SUM_DIFF_SIEVE,
                :CQCMGRTSIV_N.RATIO_SIEVE,
                :CQCMGRTSIV_N.AVG_SIEVE,
                :CQCMGRTSIV_N.TI_CHANGE,
                :CQCMGRTSIV_N.CREATE_USER_ID,
                :CQCMGRTSIV_N.CREATE_TIME,
                :CQCMGRTSIV_N.UPDATE_USER_ID,
                :CQCMGRTSIV_N.UPDATE_TIME;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }


    if(DB_error_code == 0)
    {
        DBU_del_null_cqcmgrtsiv(&CQCMGRTSIV_N, CQCMGRTSIV);
    }

    DB_stop_query_timer("DBU_fetch_cqcmgrtsiv", sel_type);
}


/* SQL CURSOR CLOSE Function */
void DBU_close_cqcmgrtsiv(int sel_type)
{
    DB_start_query_timer();
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL CLOSE DBU_CQCMGRTSIV_CUR_1;
            break;

		case 2:
            EXEC SQL CLOSE DBU_CQCMGRTSIV_CUR_2;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 32);
            break;
    }

    DB_stop_query_timer("DBU_close_cqcmgrtsiv", sel_type);
}


/* Initialize Function */
void DBU_init_cqcmgrtsiv(struct CQCMGRTSIV_TAG *CQCMGRTSIV)
{
    /* memset by Space */
    memset(CQCMGRTSIV, ' ', sizeof(struct CQCMGRTSIV_TAG));
    
    CQCMGRTSIV->INSP_COUNT = 0;
    CQCMGRTSIV->INSP_SEQ = 0;
    CQCMGRTSIV->SIEVE_VALUE = 0;
    CQCMGRTSIV->COUNT_1 = 0;
    CQCMGRTSIV->NOT_SIEVE_1 = 0;
    CQCMGRTSIV->EXIST_SIEVE_1 = 0;
    CQCMGRTSIV->DIFF_SIEVE_1 = 0;
    CQCMGRTSIV->TI_VALUE_1 = 0;
    CQCMGRTSIV->COUNT_2 = 0;
    CQCMGRTSIV->NOT_SIEVE_2 = 0;
    CQCMGRTSIV->EXIST_SIEVE_2 = 0;
    CQCMGRTSIV->DIFF_SIEVE_2 = 0;
    CQCMGRTSIV->TI_VALUE_2 = 0;
    CQCMGRTSIV->SUM_DIFF_SIEVE = 0;
    CQCMGRTSIV->RATIO_SIEVE = 0;
    CQCMGRTSIV->AVG_SIEVE = 0;
    CQCMGRTSIV->TI_CHANGE = 0;
}


/* Add Null Function */
void DBU_add_null_cqcmgrtsiv(struct CQCMGRTSIV_N_TAG *CQCMGRTSIV_N, struct CQCMGRTSIV_TAG *CQCMGRTSIV)
{
    /* memset by NULL */
    memset(CQCMGRTSIV_N, '\0', sizeof(struct CQCMGRTSIV_N_TAG));
    
    MEMCPY_AN(CQCMGRTSIV_N->FACTORY, CQCMGRTSIV->FACTORY, sizeof(CQCMGRTSIV->FACTORY));
    MEMCPY_AN(CQCMGRTSIV_N->INSP_ID, CQCMGRTSIV->INSP_ID, sizeof(CQCMGRTSIV->INSP_ID));
    MEMCPY_AN(CQCMGRTSIV_N->INSP_DTL_TYPE, CQCMGRTSIV->INSP_DTL_TYPE, sizeof(CQCMGRTSIV->INSP_DTL_TYPE));
    CQCMGRTSIV_N->INSP_COUNT = CQCMGRTSIV->INSP_COUNT;
    CQCMGRTSIV_N->INSP_SEQ = CQCMGRTSIV->INSP_SEQ;
    MEMCPY_AN(CQCMGRTSIV_N->SIEVE_CODE, CQCMGRTSIV->SIEVE_CODE, sizeof(CQCMGRTSIV->SIEVE_CODE));
    MEMCPY_AN(CQCMGRTSIV_N->SIZES, CQCMGRTSIV->SIZES, sizeof(CQCMGRTSIV->SIZES));
    CQCMGRTSIV_N->SIEVE_VALUE = CQCMGRTSIV->SIEVE_VALUE;
    CQCMGRTSIV_N->COUNT_1 = CQCMGRTSIV->COUNT_1;
    CQCMGRTSIV_N->NOT_SIEVE_1 = CQCMGRTSIV->NOT_SIEVE_1;
    CQCMGRTSIV_N->EXIST_SIEVE_1 = CQCMGRTSIV->EXIST_SIEVE_1;
    CQCMGRTSIV_N->DIFF_SIEVE_1 = CQCMGRTSIV->DIFF_SIEVE_1;
    CQCMGRTSIV_N->TI_VALUE_1 = CQCMGRTSIV->TI_VALUE_1;
    CQCMGRTSIV_N->COUNT_2 = CQCMGRTSIV->COUNT_2;
    CQCMGRTSIV_N->NOT_SIEVE_2 = CQCMGRTSIV->NOT_SIEVE_2;
    CQCMGRTSIV_N->EXIST_SIEVE_2 = CQCMGRTSIV->EXIST_SIEVE_2;
    CQCMGRTSIV_N->DIFF_SIEVE_2 = CQCMGRTSIV->DIFF_SIEVE_2;
    CQCMGRTSIV_N->TI_VALUE_2 = CQCMGRTSIV->TI_VALUE_2;
    CQCMGRTSIV_N->SUM_DIFF_SIEVE = CQCMGRTSIV->SUM_DIFF_SIEVE;
    CQCMGRTSIV_N->RATIO_SIEVE = CQCMGRTSIV->RATIO_SIEVE;
    CQCMGRTSIV_N->AVG_SIEVE = CQCMGRTSIV->AVG_SIEVE;
    CQCMGRTSIV_N->TI_CHANGE = CQCMGRTSIV->TI_CHANGE;
    MEMCPY_AN(CQCMGRTSIV_N->CREATE_USER_ID, CQCMGRTSIV->CREATE_USER_ID, sizeof(CQCMGRTSIV->CREATE_USER_ID));
    MEMCPY_AN(CQCMGRTSIV_N->CREATE_TIME, CQCMGRTSIV->CREATE_TIME, sizeof(CQCMGRTSIV->CREATE_TIME));
    MEMCPY_AN(CQCMGRTSIV_N->UPDATE_USER_ID, CQCMGRTSIV->UPDATE_USER_ID, sizeof(CQCMGRTSIV->UPDATE_USER_ID));
    MEMCPY_AN(CQCMGRTSIV_N->UPDATE_TIME, CQCMGRTSIV->UPDATE_TIME, sizeof(CQCMGRTSIV->UPDATE_TIME));
}


/* Del Null Function */
void DBU_del_null_cqcmgrtsiv(struct CQCMGRTSIV_N_TAG *CQCMGRTSIV_N, struct CQCMGRTSIV_TAG *CQCMGRTSIV)
{
    MEMCPY_DN(CQCMGRTSIV->FACTORY, CQCMGRTSIV_N->FACTORY, sizeof(CQCMGRTSIV->FACTORY));
    MEMCPY_DN(CQCMGRTSIV->INSP_ID, CQCMGRTSIV_N->INSP_ID, sizeof(CQCMGRTSIV->INSP_ID));
    MEMCPY_DN(CQCMGRTSIV->INSP_DTL_TYPE, CQCMGRTSIV_N->INSP_DTL_TYPE, sizeof(CQCMGRTSIV->INSP_DTL_TYPE));
    CQCMGRTSIV->INSP_COUNT = CQCMGRTSIV_N->INSP_COUNT;
