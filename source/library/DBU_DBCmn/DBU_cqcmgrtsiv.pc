/* SQL CURSOR DECLARE & OPEN Function */
void DBU_open_cqcmgrtsiv(int sel_type, struct CQCMGRTSIV_TAG *CQCMGRTSIV)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct CQCMGRTSIV_N_TAG CQCMGRTSIV_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBU_add_null_cqcmgrtsiv(&CQCMGRTSIV_N, CQCMGRTSIV);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBU_CQCMGRTSIV_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    INSP_ID,
                    INSP_DTL_TYPE,
                    INSP_COUNT,
                    INSP_SEQ,
                    SIEVE_CODE,
                    SIZES,
                    SIEVE_VALUE,
                    COUNT_1,
                    NOT_SIEVE_1,
                    EXIST_SIEVE_1,
                    DIFF_SIEVE_1,
                    TI_VALUE_1,
                    COUNT_2,
                    NOT_SIEVE_2,
                    EXIST_SIEVE_2,
                    DIFF_SIEVE_2,
                    TI_VALUE_2,
                    SUM_DIFF_SIEVE,
                    RATIO_SIEVE,
                    AVG_SIEVE,
                    TI_CHANGE,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CQCMGRTSIV
                ORDER BY FACTORY ASC,
                    INSP_ID ASC,
                    INSP_DTL_TYPE ASC,
                    INSP_COUNT ASC,
                    INSP_SEQ ASC;
            EXEC SQL OPEN DBU_CQCMGRTSIV_CUR_1;
            break;

		case 2:
            EXEC SQL DECLARE DBU_CQCMGRTSIV_CUR_2 CURSOR FOR
                SELECT 
                    FACTORY,
                    INSP_ID,
                    INSP_DTL_TYPE,
                    INSP_COUNT,
                    INSP_SEQ,
                    SIEVE_CODE,
                    SIZES,
                    SIEVE_VALUE,
                    COUNT_1,
                    NOT_SIEVE_1,
                    EXIST_SIEVE_1,
                    DIFF_SIEVE_1,
                    TI_VALUE_1,
                    COUNT_2,
                    NOT_SIEVE_2,
                    EXIST_SIEVE_2,
                    DIFF_SIEVE_2,
                    TI_VALUE_2,
                    SUM_DIFF_SIEVE,
                    RATIO_SIEVE,
                    AVG_SIEVE,
                    TI_CHANGE,
                    CREATE_USER_ID,
                    CREATE_TIME,
                    UPDATE_USER_ID,
                    UPDATE_TIME
                FROM CQCMGRTSIV
			  WHERE FACTORY = :CQCMGRTSIV_N.FACTORY
			      AND INSP_ID = :CQCMGRTSIV_N.INSP_ID;

            EXEC SQL OPEN DBU_CQCMGRTSIV_CUR_2;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBU_open_cqcmgrtsiv", sel_type);
}


