		case 2:
            EXEC SQL SELECT NVL(MAX(INSP_COUNT),0)
                INTO :d_value
                FROM CQCMGRTSIV
                WHERE FACTORY = :CQCMGRTSIV_N.FACTORY
                    AND INSP_ID = :CQCMGRTSIV_N.INSP_ID
                    AND INSP_DTL_TYPE = :CQCMGRTSIV_N.INSP_DTL_TYPE;
