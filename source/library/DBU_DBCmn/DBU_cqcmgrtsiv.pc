    CQCMGRTSIV->TI_VALUE_1 = CQCMGRTSIV_N->TI_VALUE_1;
    CQCMGRTSIV->COUNT_2 = CQCMGRTSIV_N->COUNT_2;
    CQCMGRTSIV->NOT_SIEVE_2 = CQCMGRTSIV_N->NOT_SIEVE_2;
    CQCMGRTSIV->EXIST_SIEVE_2 = CQCMGRTSIV_N->EXIST_SIEVE_2;
    CQCMGRTSIV->DIFF_SIEVE_2 = CQCMGRTSIV_N->DIFF_SIEVE_2;
    CQCMGRTSIV->TI_VALUE_2 = CQCMGRTSIV_N->TI_VALUE_2;
    CQCMGRTSIV->SUM_DIFF_SIEVE = CQCMGRTSIV_N->SUM_DIFF_SIEVE;
    CQCMGRTSIV->RATIO_SIEVE = CQCMGRTSIV_N->RATIO_SIEVE;
    CQCMGRTSIV->AVG_SIEVE = CQCMGRTSIV_N->AVG_SIEVE;
    CQCMGRTSIV->TI_CHANGE = CQCMGRTSIV_N->TI_CHANGE;
    MEMCPY_DN(CQCMGRTSIV->CREATE_USER_ID, CQCMGRTSIV_N->CREATE_USER_ID, sizeof(CQCMGRTSIV->CREATE_USER_ID));
    MEMCPY_DN(CQCMGRTSIV->CREATE_TIME, CQCMGRTSIV_N->CREATE_TIME, sizeof(CQCMGRTSIV->CREATE_TIME));
    MEMCPY_DN(CQCMGRTSIV->UPDATE_USER_ID, CQCMGRTSIV_N->UPDATE_USER_ID, sizeof(CQCMGRTSIV->UPDATE_USER_ID));
    MEMCPY_DN(CQCMGRTSIV->UPDATE_TIME, CQCMGRTSIV_N->UPDATE_TIME, sizeof(CQCMGRTSIV->UPDATE_TIME));
}


