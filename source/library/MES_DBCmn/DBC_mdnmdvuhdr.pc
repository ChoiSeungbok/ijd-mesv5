        struct MDNMDVUHDR_N_TAG MDNMDVUHDR_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBC_add_null_mdnmdvuhdr(&MDNMDVUHDR_N, MDNMDVUHDR);
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBC_MDNMDVUHDR_CUR_1 CURSOR FOR
                SELECT 
                    FACTORY,
                    VIEW_ID,
                    USER_ID,
                    COL_NAME,
                    COL_SEQ,
                    CREATE_TIME,
                    CREATE_USER_ID,
                    UPDATE_TIME,
                    UPDATE_USER_ID
                FROM MDNMDVUHDR
                WHERE FACTORY = :MDNMDVUHDR_N.FACTORY
                    AND VIEW_ID = :MDNMDVUHDR_N.VIEW_ID
                    AND USER_ID = :MDNMDVUHDR_N.USER_ID
                ORDER BY FACTORY ASC,
                    VIEW_ID ASC,
                    USER_ID ASC,
                    COL_SEQ ASC;
            EXEC SQL OPEN DBC_MDNMDVUHDR_CUR_1;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBC_open_mdnmdvuhdr", sel_type);
}


