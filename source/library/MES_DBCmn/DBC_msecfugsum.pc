/* Add Null Function */
void DBC_add_null_msecfugsum(struct MSECFUGSUM_N_TAG *MSECFUGSUM_N, struct MSECFUGSUM_TAG *MSECFUGSUM)
{
    /* memset by NULL */
    memset(MSECFUGSUM_N, '\0', sizeof(struct MSECFUGSUM_N_TAG));
    
    MEMCPY_AN(MSECFUGSUM_N->TRAN_DATE, MSECFUGSUM->TRAN_DATE, sizeof(MSECFUGSUM->TRAN_DATE));
    MEMCPY_AN(MSECFUGSUM_N->FUNC_NAME, MSECFUGSUM->FUNC_NAME, sizeof(MSECFUGSUM->FUNC_NAME));
    MEMCPY_AN(MSECFUGSUM_N->FACTORY, MSECFUGSUM->FACTORY, sizeof(MSECFUGSUM->FACTORY));
    MEMCPY_AN(MSECFUGSUM_N->PROGRAM_ID, MSECFUGSUM->PROGRAM_ID, sizeof(MSECFUGSUM->PROGRAM_ID));
    MSECFUGSUM_N->USAGE_COUNT = MSECFUGSUM->USAGE_COUNT;
}


/* Del Null Function */
void DBC_del_null_msecfugsum(struct MSECFUGSUM_N_TAG *MSECFUGSUM_N, struct MSECFUGSUM_TAG *MSECFUGSUM)
{
    MEMCPY_DN(MSECFUGSUM->TRAN_DATE, MSECFUGSUM_N->TRAN_DATE, sizeof(MSECFUGSUM->TRAN_DATE));
    MEMCPY_DN(MSECFUGSUM->FUNC_NAME, MSECFUGSUM_N->FUNC_NAME, sizeof(MSECFUGSUM->FUNC_NAME));
    MEMCPY_DN(MSECFUGSUM->FACTORY, MSECFUGSUM_N->FACTORY, sizeof(MSECFUGSUM->FACTORY));
    MEMCPY_DN(MSECFUGSUM->PROGRAM_ID, MSECFUGSUM_N->PROGRAM_ID, sizeof(MSECFUGSUM->PROGRAM_ID));
    MSECFUGSUM->USAGE_COUNT = MSECFUGSUM_N->USAGE_COUNT;
}


