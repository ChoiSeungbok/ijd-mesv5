    switch(sel_type)
    {
        case 1:
            EXEC SQL UPDATE MSECFUGSUM SET
                    USAGE_COUNT = :MSECFUGSUM_N.USAGE_COUNT
                WHERE TRAN_DATE = :MSECFUGSUM_N.TRAN_DATE
                    AND FUNC_NAME = :MSECFUGSUM_N.FUNC_NAME
                    AND FACTORY = :MSECFUGSUM_N.FACTORY
                    AND PROGRAM_ID = :MSECFUGSUM_N.PROGRAM_ID;
            break;

        case 2:
            DB_add_null_condition(&DBC_Q_COND, &DBC_Q_COND_N);
            sprintf(sql + strlen(sql), "MERGE INTO MSECFUGSUM S USING ");
            sprintf(sql + strlen(sql), "(SELECT SUBSTR(TRAN_TIME, 1, 8) AS TRAN_DATE, ");
            sprintf(sql + strlen(sql), "  FUNC_NAME, ");
            sprintf(sql + strlen(sql), "  FACTORY, ");
            sprintf(sql + strlen(sql), "  PROGRAM_ID, ");
            sprintf(sql + strlen(sql), "  COUNT(*) CNT ");
