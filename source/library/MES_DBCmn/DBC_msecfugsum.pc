/* SQL CURSOR DECLARE & OPEN Function */
void DBC_open_msecfugsum(int sel_type, struct MSECFUGSUM_TAG *MSECFUGSUM)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MSECFUGSUM_N_TAG MSECFUGSUM_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBC_add_null_msecfugsum(&MSECFUGSUM_N, MSECFUGSUM);
    DB_error_code = 0;


    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBC_MSECFUGSUM_CUR_1 CURSOR FOR
                SELECT 
                    TRAN_DATE,
                    FUNC_NAME,
                    FACTORY,
                    PROGRAM_ID,
                    USAGE_COUNT
                FROM MSECFUGSUM
                ORDER BY TRAN_DATE ASC,
                    FUNC_NAME ASC,
                    FACTORY ASC,
                    PROGRAM_ID ASC;
            EXEC SQL OPEN DBC_MSECFUGSUM_CUR_1;
            break;

        case 2:
            EXEC SQL DECLARE DBC_MSECFUGSUM_CUR_2 CURSOR FOR
                SELECT 
                    TRAN_DATE,
                    FUNC_NAME,
                    FACTORY,
                    PROGRAM_ID,
                    USAGE_COUNT
                FROM MSECFUGSUM
                WHERE FACTORY = :MSECFUGSUM_N.FACTORY
                AND PROGRAM_ID LIKE :MSECFUGSUM_N.PROGRAM_ID
                AND FUNC_NAME LIKE :MSECFUGSUM_N.FUNC_NAME
                AND TRAN_DATE >= :DBC_Q_COND_N.FROM_DATE
                AND TRAN_DATE <= :DBC_Q_COND_N.TO_DATE
                AND (
                        TRAN_DATE > :MSECFUGSUM_N.TRAN_DATE OR
                        (TRAN_DATE = :MSECFUGSUM_N.TRAN_DATE AND PROGRAM_ID > :DBC_Q_COND_N.KEY_1) OR
                        (TRAN_DATE = :MSECFUGSUM_N.TRAN_DATE AND PROGRAM_ID = :DBC_Q_COND_N.KEY_1 AND FUNC_NAME > :DBC_Q_COND_N.KEY_2)
                    )
                ORDER BY TRAN_DATE ASC,
                        PROGRAM_ID ASC,
                        FUNC_NAME ASC;
            EXEC SQL OPEN DBC_MSECFUGSUM_CUR_2;
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBC_open_msecfugsum", sel_type);
}


