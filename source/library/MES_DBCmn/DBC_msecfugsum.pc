            {
                make_valid_quote(ts, MSECFUGSUM_N.PROGRAM_ID);
                sprintf(sql + strlen(sql), "AND PROGRAM_ID = '%s' ", ts);
            }
            if(ISSPACE(DBC_Q_COND.FROM_DATE, sizeof(DBC_Q_COND.FROM_DATE)) == DB_FALSE)
            {
                make_valid_quote(ts, DBC_Q_COND_N.FROM_DATE);
                sprintf(sql + strlen(sql), "AND TRAN_TIME >= '%s' ", ts);
            }
            if(ISSPACE(DBC_Q_COND.TO_DATE, sizeof(DBC_Q_COND.TO_DATE)) == DB_FALSE)
            {
                make_valid_quote(ts, DBC_Q_COND_N.TO_DATE);
                sprintf(sql + strlen(sql), "AND TRAN_TIME < '%s999999' ", ts);
            }
            if(ISSPACE(DBC_Q_COND.TO_TIME, sizeof(DBC_Q_COND.TO_TIME)) == DB_FALSE)
            {
                make_valid_quote(ts, DBC_Q_COND_N.TO_TIME);
                sprintf(sql + strlen(sql), "AND TRAN_TIME < '%s' ", ts);
            }
            sprintf(sql + strlen(sql), "GROUP BY SUBSTR(TRAN_TIME, 1, 8), ");
            sprintf(sql + strlen(sql), "  FUNC_NAME, ");
            sprintf(sql + strlen(sql), "  FACTORY, ");
            sprintf(sql + strlen(sql), "  PROGRAM_ID ");
            sprintf(sql + strlen(sql), ") A ON (S.TRAN_DATE = A.TRAN_DATE AND S.FUNC_NAME = A.FUNC_NAME AND S.FACTORY = A.FACTORY AND S.PROGRAM_ID = A.PROGRAM_ID) ");
            sprintf(sql + strlen(sql), "WHEN MATCHED THEN ");
            sprintf(sql + strlen(sql), "  UPDATE SET USAGE_COUNT = USAGE_COUNT + A.CNT WHEN NOT MATCHED THEN ");
            sprintf(sql + strlen(sql), "  INSERT ");
            sprintf(sql + strlen(sql), "    ( ");
            sprintf(sql + strlen(sql), "      S.TRAN_DATE, ");
            sprintf(sql + strlen(sql), "      S.FUNC_NAME, ");
            sprintf(sql + strlen(sql), "      S.FACTORY, ");
            sprintf(sql + strlen(sql), "      S.PROGRAM_ID, ");
            sprintf(sql + strlen(sql), "      S.USAGE_COUNT ");
            sprintf(sql + strlen(sql), "    ) ");
            sprintf(sql + strlen(sql), "    VALUES ");
            sprintf(sql + strlen(sql), "    ( ");
            sprintf(sql + strlen(sql), "      A.TRAN_DATE, ");
            sprintf(sql + strlen(sql), "      A.FUNC_NAME, ");
            sprintf(sql + strlen(sql), "      A.FACTORY, ");
            sprintf(sql + strlen(sql), "      A.PROGRAM_ID, ");
            sprintf(sql + strlen(sql), "      A.CNT ");
            sprintf(sql + strlen(sql), "    )");

            EXEC SQL EXECUTE IMMEDIATE :sql;

            if(DB_error_code == DB_SUCCESS && sqlca.sqlerrd[2] != 0)
            {
                memset(sql, 0x00, sizeof(sql));
                sprintf(sql + strlen(sql), "DELETE MSECFUNUSG ");
                make_valid_quote(ts, MSECFUGSUM_N.FACTORY);
                sprintf(sql + strlen(sql), "WHERE FACTORY  = '%s' ", ts);
                if(ISSPACE(MSECFUGSUM->PROGRAM_ID, sizeof(MSECFUGSUM->PROGRAM_ID)) == DB_FALSE)
                {
                    make_valid_quote(ts, MSECFUGSUM_N.PROGRAM_ID);
                    sprintf(sql + strlen(sql), "AND PROGRAM_ID = '%s' ", ts);
                }
                if(ISSPACE(DBC_Q_COND.FROM_DATE, sizeof(DBC_Q_COND.FROM_DATE)) == DB_FALSE)
                {
                    make_valid_quote(ts, DBC_Q_COND_N.FROM_DATE);
                    sprintf(sql + strlen(sql), "AND TRAN_TIME >= '%s' ", ts);
                }
                if(ISSPACE(DBC_Q_COND.TO_DATE, sizeof(DBC_Q_COND.TO_DATE)) == DB_FALSE)
                {
                    make_valid_quote(ts, DBC_Q_COND_N.TO_DATE);
                    sprintf(sql + strlen(sql), "AND TRAN_TIME < '%s999999' ", ts);
                }
                if(ISSPACE(DBC_Q_COND.TO_TIME, sizeof(DBC_Q_COND.TO_TIME)) == DB_FALSE)
                {
                    make_valid_quote(ts, DBC_Q_COND_N.TO_TIME);
                    sprintf(sql + strlen(sql), "AND TRAN_TIME < '%s' ", ts);
                }

                EXEC SQL EXECUTE IMMEDIATE :sql;
            }
            break;

        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
