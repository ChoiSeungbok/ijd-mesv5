/* Add Null Function */
void DBC_add_null_mdnmsqldef(struct MDNMSQLDEF_N_TAG *MDNMSQLDEF_N, struct MDNMSQLDEF_TAG *MDNMSQLDEF)
{
    /* memset by NULL */
    memset(MDNMSQLDEF_N, '\0', sizeof(struct MDNMSQLDEF_N_TAG));
    
    MEMCPY_AN(MDNMSQLDEF_N->VIEW_ID, MDNMSQLDEF->VIEW_ID, sizeof(MDNMSQLDEF->VIEW_ID));
    MEMCPY_AN(MDNMSQLDEF_N->VIEW_DESC, MDNMSQLDEF->VIEW_DESC, sizeof(MDNMSQLDEF->VIEW_DESC));
