                SELECT 
                    VIEW_ID,
                    VIEW_DESC,
                    SQL_TEXT,
                    USE_ICON_FLAG,
                    USE_BGCOLOR_FLAG,
                    CREATE_TIME,
                    CREATE_USER_ID,
                    UPDATE_TIME,
                    UPDATE_USER_ID
