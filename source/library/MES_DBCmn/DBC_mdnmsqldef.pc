    MDNMSQLDEF_N->USE_ICON_FLAG[0] = MDNMSQLDEF->USE_ICON_FLAG;
    MDNMSQLDEF_N->USE_BGCOLOR_FLAG[0] = MDNMSQLDEF->USE_BGCOLOR_FLAG;
    MEMCPY_AN(MDNMSQLDEF_N->CREATE_TIME, MDNMSQLDEF->CREATE_TIME, sizeof(MDNMSQLDEF->CREATE_TIME));
    MEMCPY_AN(MDNMSQLDEF_N->CREATE_USER_ID, MDNMSQLDEF->CREATE_USER_ID, sizeof(MDNMSQLDEF->CREATE_USER_ID));
    MEMCPY_AN(MDNMSQLDEF_N->UPDATE_TIME, MDNMSQLDEF->UPDATE_TIME, sizeof(MDNMSQLDEF->UPDATE_TIME));
    MEMCPY_AN(MDNMSQLDEF_N->UPDATE_USER_ID, MDNMSQLDEF->UPDATE_USER_ID, sizeof(MDNMSQLDEF->UPDATE_USER_ID));
}


/* Del Null Function */
void DBC_del_null_mdnmsqldef(struct MDNMSQLDEF_N_TAG *MDNMSQLDEF_N, struct MDNMSQLDEF_TAG *MDNMSQLDEF)
{
