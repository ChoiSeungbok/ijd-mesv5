    MEMCPY_AN(MDNMSQLHIS_N->VIEW_DESC, MDNMSQLHIS->VIEW_DESC, sizeof(MDNMSQLHIS->VIEW_DESC));
    MEMCPY_AN(MDNMSQLHIS_N->SQL_TEXT, MDNMSQLHIS->SQL_TEXT, sizeof(MDNMSQLHIS->SQL_TEXT));
    MDNMSQLHIS_N->USE_ICON_FLAG[0] = MDNMSQLHIS->USE_ICON_FLAG;
    MDNMSQLHIS_N->USE_BGCOLOR_FLAG[0] = MDNMSQLHIS->USE_BGCOLOR_FLAG;
    MEMCPY_AN(MDNMSQLHIS_N->CREATE_TIME, MDNMSQLHIS->CREATE_TIME, sizeof(MDNMSQLHIS->CREATE_TIME));
    MEMCPY_AN(MDNMSQLHIS_N->CREATE_USER_ID, MDNMSQLHIS->CREATE_USER_ID, sizeof(MDNMSQLHIS->CREATE_USER_ID));
    MEMCPY_AN(MDNMSQLHIS_N->UPDATE_TIME, MDNMSQLHIS->UPDATE_TIME, sizeof(MDNMSQLHIS->UPDATE_TIME));
    MEMCPY_AN(MDNMSQLHIS_N->UPDATE_USER_ID, MDNMSQLHIS->UPDATE_USER_ID, sizeof(MDNMSQLHIS->UPDATE_USER_ID));
}


/* Del Null Function */
void DBC_del_null_mdnmsqlhis(struct MDNMSQLHIS_N_TAG *MDNMSQLHIS_N, struct MDNMSQLHIS_TAG *MDNMSQLHIS)
{
