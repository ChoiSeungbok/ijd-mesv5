    MEMCPY_DN(MDNMSQLHIS->TRAN_TIME, MDNMSQLHIS_N->TRAN_TIME, sizeof(MDNMSQLHIS->TRAN_TIME));
    MEMCPY_DN(MDNMSQLHIS->VIEW_DESC, MDNMSQLHIS_N->VIEW_DESC, sizeof(MDNMSQLHIS->VIEW_DESC));
    MEMCPY_DN(MDNMSQLHIS->SQL_TEXT, MDNMSQLHIS_N->SQL_TEXT, sizeof(MDNMSQLHIS->SQL_TEXT));
    MDNMSQLHIS->USE_ICON_FLAG = MDNMSQLHIS_N->USE_ICON_FLAG[0];
    MDNMSQLHIS->USE_BGCOLOR_FLAG = MDNMSQLHIS_N->USE_BGCOLOR_FLAG[0];
    MEMCPY_DN(MDNMSQLHIS->CREATE_TIME, MDNMSQLHIS_N->CREATE_TIME, sizeof(MDNMSQLHIS->CREATE_TIME));
    MEMCPY_DN(MDNMSQLHIS->CREATE_USER_ID, MDNMSQLHIS_N->CREATE_USER_ID, sizeof(MDNMSQLHIS->CREATE_USER_ID));
    MEMCPY_DN(MDNMSQLHIS->UPDATE_TIME, MDNMSQLHIS_N->UPDATE_TIME, sizeof(MDNMSQLHIS->UPDATE_TIME));
