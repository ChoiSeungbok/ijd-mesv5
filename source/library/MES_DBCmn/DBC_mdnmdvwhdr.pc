/* SQL CURSOR DECLARE & OPEN Function */
void DBC_open_mdnmdvwhdr(int sel_type, struct MDNMDVWHDR_TAG *MDNMDVWHDR)
{
    EXEC SQL BEGIN DECLARE SECTION;
        struct MDNMDVWHDR_N_TAG MDNMDVWHDR_N;
    EXEC SQL END DECLARE SECTION;

    DB_start_query_timer();

    DBC_add_null_mdnmdvwhdr(&MDNMDVWHDR_N, MDNMDVWHDR);
    DB_error_code = 0;

    switch(sel_type)
    {
        case 1:
            EXEC SQL DECLARE DBC_MDNMDVWHDR_CUR_1 CURSOR FOR
                SELECT 
                    VIEW_ID,
                    COL_NAME,
                    DISPLAY_NAME,
                    COL_DESC,
                    CREATE_TIME,
                    CREATE_USER_ID,
                    UPDATE_TIME,
                    UPDATE_USER_ID
                FROM MDNMDVWHDR
                WHERE VIEW_ID = :MDNMDVWHDR_N.VIEW_ID
                ORDER BY VIEW_ID ASC,
                    COL_NAME ASC;
            EXEC SQL OPEN DBC_MDNMDVWHDR_CUR_1;
            break;

        case 2:
            EXEC SQL DECLARE DBC_MDNMDVWHDR_CUR_2 CURSOR FOR
                SELECT 
                    W.VIEW_ID,
                    W.COL_NAME,
                    W.DISPLAY_NAME,
                    W.COL_DESC,
                    TO_CHAR(NVL(U.COL_SEQ,99999)),
                    W.CREATE_USER_ID,
                    W.UPDATE_TIME,
                    W.UPDATE_USER_ID
                FROM MDNMDVWHDR W, MDNMDVUHDR U
                WHERE  W.VIEW_ID=U.VIEW_ID(+)
                AND W.COL_NAME = U.COL_NAME(+)
                AND W.VIEW_ID=:MDNMDVWHDR_N.VIEW_ID
                AND U.VIEW_ID(+)=:MDNMDVWHDR_N.VIEW_ID
                AND U.FACTORY(+)=:MDNMDVWHDR_N.COL_NAME
                AND U.USER_ID(+)=:MDNMDVWHDR_N.DISPLAY_NAME
                ORDER BY U.COL_SEQ;
            EXEC SQL OPEN DBC_MDNMDVWHDR_CUR_2;
            break;


        default:
            DB_error_code = 9999;
            memset(DB_error_msg, ' ', sizeof(DB_error_msg));
            memcpy(DB_error_msg, "Error : Invalid Argument(sel_type)", 34);
            break;
    }

    DB_stop_query_timer("DBC_open_mdnmdvwhdr", sel_type);
}


