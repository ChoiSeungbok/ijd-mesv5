<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="280dp"
        android:background="#ffffffff"
        android:gravity="center"
        android:orientation="vertical">

        <com.pda.mes.widget.FontTextView
            android:id="@+id/dialogTitleLabel"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:textColor="@drawable/text_selector_language"
            android:textSize="17dp"
            app:custom_font="@string/FONT_NANUM_SQUARE_OTFB"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_line_size"
            android:background="#30777777"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingLeft="17dp"
            android:paddingRight="17dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="25dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.pda.mes.widget.FontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="80dp"
                    android:textColor="#ff4D4F5C"
                    android:textSize="18dp"
                    android:background="@null"
                    app:custom_font="@string/FONT_NANUM_SQUARE_OTFB"/>

                <com.pda.mes.widget.FontEditTextView
                    android:id="@+id/dialogInputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="right|center"
                    android:minHeight="80dp"
                    android:textColor="#ff4D4F5C"
                    android:textSize="18dp"
                    android:background="@null"
                    android:inputType="numberDecimal"
                    app:custom_font="@string/FONT_NANUM_SQUARE_OTFB"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_line_size"
            android:background="#E1E1E1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <com.pda.mes.widget.FontTextView
                android:id="@+id/closeButton"
                android:background="@drawable/raised_selector_white_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/cancel"
                android:textColor="@drawable/text_selector_language"
                android:textSize="15dp"
                app:custom_font="@string/FONT_NANUM_SQUARE_OTFR"/>

            <View
                android:layout_width="@dimen/default_line_size"
                android:layout_height="match_parent"
                android:background="#E1E1E1"/>

            <com.pda.mes.widget.FontTextView
                android:id="@+id/doneButton"
                android:background="@drawable/raised_selector_white_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/okay"
                android:textColor="@drawable/text_selector_language"
                android:textSize="15dp"
                app:custom_font="@string/FONT_NANUM_SQUARE_OTFB"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>