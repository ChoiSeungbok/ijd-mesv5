                android:orientation="horizontal">
                <com.pda.mes.widget.FontTextView
                    style="@style/InputBox_Title_Split"
                    android:text="@string/common_word_area"/>

                <com.pda.mes.widget.FontTextView
                    android:id="@+id/area"
                    android:clickable="true"
                    android:onClick="onClickArea"
                    android:layout_weight="1"
                    style="@style/InputBox_Content.Dropdown.Split"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/subAreaLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/selector_white_btn_split"
                android:layout_weight="5">

                <com.pda.mes.widget.FontTextView
                    style="@style/InputBox_Title_Split"
                    android:text="@string/common_word_sub_area" />

                <com.pda.mes.widget.FontTextView
                    android:id="@+id/subArea"
                    android:clickable="true"
                    android:onClick="onClickSubArea"
                    android:layout_weight="1"
                    style="@style/InputBox_Content.Dropdown.Split"/>
            </LinearLayout>
        </LinearLayout>
