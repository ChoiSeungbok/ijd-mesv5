        <RelativeLayout
            android:id="@+id/operLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_text_box_height"
            android:background="@drawable/selector_white_btn"
            android:clickable="true"
            android:onClick="onClickOper"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/border_gray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <com.pda.mes.widget.FontTextView
                    style="@style/InputBox_Title_Split"
                    android:text="@string/common_word_oper_d" />

                <com.pda.mes.widget.FontTextView
                    android:id="@+id/oper"
                    style="@style/InputBox_Content.Dropdown"/>
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/machineLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_text_box_height"
            android:background="@drawable/selector_white_btn"
            android:clickable="true"
            android:onClick="onClickMachine"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/border_gray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <com.pda.mes.widget.FontTextView
                    style="@style/InputBox_Title_Split"
                    android:text="@string/common_word_machine" />

                <com.pda.mes.widget.FontTextView
                    android:id="@+id/machine"
                    style="@style/InputBox_Content.Dropdown"/>
            </LinearLayout>
        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="5dp">
            <LinearLayout
                android:id="@+id/workShiftLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/selector_white_btn_split"
                android:layout_weight="5"
                android:orientation="horizontal">
                <com.pda.mes.widget.FontTextView
                    style="@style/InputBox_Title_Split"
                    android:text="@string/common_word_work_shift"/>

                <com.pda.mes.widget.FontTextView
                    android:id="@+id/workShift"
                    android:clickable="true"
                    android:onClick="onClickWorkShift"
                    android:layout_weight="1"
                    style="@style/InputBox_Content.Dropdown.Split"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/workerLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/selector_white_btn_split"
                android:layout_weight="5">

                <com.pda.mes.widget.FontTextView
