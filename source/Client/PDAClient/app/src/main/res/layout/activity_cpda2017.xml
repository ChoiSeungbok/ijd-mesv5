                    android:text="@string/common_word_worker" />

                <com.pda.mes.widget.FontTextView
                    android:id="@+id/worker"
                    android:clickable="true"
                    android:onClick="onClickWorker"
                    android:layout_weight="1"
                    style="@style/InputBox_Content.Dropdown.Split"/>
            </LinearLayout>
        </LinearLayout>
